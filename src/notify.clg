// pronao -- Notifications (toasts): the arguments of notification.show and the Notifier that checks and shows one, shared by the application and the page command.

#include "cjson_item.clh"
#include "cjson_api.clh"
#include "cjson_parse.clh"
#include "cjson_print.clh"
#include "text.clh"
#include "core.clh"
#include "files.clh"
#include "menu.clh"

ext_fn int app_tray_notify(int handle, string title, string text, int kind, string id);
ext_fn double app_now_ms();

struct NotifyArgs {
public:
    string title;
    string text;
    string kind;
    string id;
    NotifyArgs() {
        title = "";
        text = "";
        kind = "info";
        id = "";
    }
};

// Notifications (toasts). One object, shared by the application and by the page command, so the command does not have to hold the whole App.
class Notifier {
public:
    int handle;                // the tray icon the notifications come from (0 = none yet)
    double lastMs;
    double gapMs;              // the least time between two notifications
    int asker;                 // the window whose page asked for the last notification (0 = the application did): its page hears of the click
    Notifier() {
        handle = 0;
        lastMs = -1.0e9;
        gapMs = 2000.0;
        asker = 0;
    }

    // text with no control character in it (a line break is allowed when `lines`)
    bool cleanText(string s, int maxBytes, bool lines) {
        if (!plainText(s, maxBytes)) {
            return false;
        }
        int i = 0;
        while (i < s.length()) {
            int c = int(s[i]);
            if ((c >= 0 && c < 32 && !(lines && c == 10)) || c == 127) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    // Shows a notification. "" on success, else the error as "code: message". kind: info, warning, error. id: "" or a name (1 to 64 letters, digits, . _ -) that comes
    // back when the user clicks THIS notification. At most one every gapMs (2 seconds unless the application changed it), so a program (or a page) cannot flood the screen.
    string show(string title, string text, string kind, string id) {
        if (title.length() == 0 || !cleanText(title, 63, false)) {
            return "invalid_argument: `title` must be 1 to 63 bytes of text on one line";
        }
        if (text.length() == 0 || !cleanText(text, 255, true)) {
            return "invalid_argument: `text` must be 1 to 255 bytes of text";
        }
        int level = 0;
        if (kind == "warning") {
            level = 1;
        } else if (kind == "error") {
            level = 2;
        } else if (kind != "info") {
            return "invalid_argument: `kind` must be info, warning or error";
        }
        if (id.length() > 0 && !menuId(id)) {
            return "invalid_argument: `id` must be 1 to 64 letters, digits, `.`, `_` or `-`";
        }
        if (handle == 0) {
            return "not_ready: notifications were not enabled";
        }
        double now = app_now_ms();
        if (now - lastMs < gapMs) {
            return "too_many: notifications are shown too often";
        }
        lastMs = now;
        int st = app_tray_notify(handle, title, text, level, id);
        if (st == -1) {
            return "unsupported: notifications cannot be shown on this system";
        }
        if (st != 0) {
            return "io_error: the system did not take the notification";
        }
        return "";
    }
};

// (a struct is decoded in the file that declares it: other files call this)
NotifyArgs readNotifyArgs(Item args) {
    return decodeNotifyArgs(args);
}
