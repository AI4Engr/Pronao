// app-cling -- the CeeLing layer: command table, dispatch and the run loop.
//
// This is the only part of an app-cling program that CeeLing checks. Everything native (the window, the
// browser engine, the queue between threads) is behind the six `ext_fn`s below and is trusted, not checked.
//
// A command is a class with one virtual method, `call(Item args)`, that returns the JSON value to send back
// (or throws a string, which becomes a rejected promise). Register one with a closure:
//
//     app.command("add", closure Command [] (Item args) {
//         return createNumber(getArrayItem(args, 0).valuedouble + getArrayItem(args, 1).valuedouble);
//     });
//
// A request arrives as the JSON array ["command", args]; the reply is a status (0 = resolve, 1 = reject) and a
// JSON text. Reply texts are built with the JSON library, never by string concatenation, so they are always
// valid JSON whatever the command or the error message contains.
#include "cjson_item.clh"
#include "cjson_api.clh"
#include "cjson_parse.clh"
#include "cjson_print.clh"
#include "../shim/app_shim.h"

ext_fn int app_open(string title, int width, int height, string html, string initJs, int debug);
ext_fn int app_next_call(int handle, int timeoutMs, ref string id, ref string request);
ext_fn int app_return(int handle, string id, int status, string json);
ext_fn int app_eval(int handle, string js);
ext_fn int app_terminate(int handle);
ext_fn int app_close(int handle);
ext_fn int app_sleep_ms(int ms);
ext_fn int app_gauge_enter();
ext_fn int app_gauge_leave();
ext_fn int app_gauge_peak();

// file access with the allowed-folder policy enforced inside the shim (shim/app_fs.h)
ext_fn int app_fs_allow(string dir);
ext_fn int app_fs_clear();
ext_fn int app_fs_read(string path, int maxBytes, ref string out);
ext_fn int app_fs_write(string path, string data, int mode);
ext_fn int app_fs_list(string dir, ref string out);
ext_fn int app_fs_stat(string path, ref string out);
ext_fn int app_fs_mkdir(string path, int parents);
ext_fn int app_fs_remove(string path);
ext_fn int app_fs_is_utf8(string s);
ext_fn int app_fs_grant_file(string path, ref string canonical);
ext_fn int app_fs_grant_folder(string path, ref string canonical);
ext_fn int app_fs_revoke_grants();
ext_fn int app_fs_resolve(string path, int kind, ref string canonical);

// running programs (shim/app_proc.h)
ext_fn int app_proc_resolve(string name, ref string absolute);
ext_fn int app_proc_run(string exe, string args, string cwd, int timeoutMs, int maxBytes, ref string out, ref string err, ref int exitCode, ref int flags);
ext_fn int app_proc_clean_text(string in, ref string out);

// native dialogs (shim/app_dialog.h)
ext_fn int app_dialog_open_file(int handle, string title, string filters, ref string path);
ext_fn int app_dialog_save_file(int handle, string title, string defaultName, string filters, ref string path);
ext_fn int app_dialog_pick_folder(int handle, string title, ref string path);
ext_fn int app_dialog_message(int handle, string title, string message, string kind, string buttons);
// the page and the bridge script, compiled into the program by scripts/build.sh
ext_fn string app_page_html();
ext_fn string app_bridge_js();

// What a handler produces. status 0 resolves the page's promise with `json`; 1 rejects it.
class Reply {
public:
    int status;
    string json;
    Reply(int s, string j) {
        status = s;
        json = j;
    }
};

// A command. Override `call`; the default answers null.
class Command {
public:
    Command() { }
    virtual Item call(Item args) {
        return createNull();
    }
};

// {"code": code, "message": message} as JSON text
string errorJson(string code, string message) {
    Item e = createObject();
    addStringToObject(e, "code", code);
    addStringToObject(e, "message", message);
    return printUnformatted(e);
}

// A thrown message may start with "<code>: " (lower-case letters, digits and underscores, at most 40): the code becomes
// the reply's error code and the rest its message, so a page can tell "not_found" from "forbidden". Anything else keeps
// the code "command_failed" and the whole message.
int errorPrefixLength(string thrown) {
    int i = 0;
    while (i < thrown.length() && i < 40) {
        char c = thrown[i];
        bool lower = c >= 'a' && c <= 'z';
        bool digit = c >= '0' && c <= '9';
        if (lower || (i > 0 && (digit || c == '_'))) {
            i = i + 1;
        } else {
            break;
        }
    }
    if (i > 0 && i + 1 < thrown.length() && thrown[i] == ':' && thrown[i + 1] == ' ') {
        return i + 2;
    }
    return 0;
}

string errorCodeOf(string thrown) {
    int n = errorPrefixLength(thrown);
    if (n == 0) {
        return "command_failed";
    }
    return thrown.substr(0, n - 2);
}

string errorTextOf(string thrown) {
    int n = errorPrefixLength(thrown);
    if (n == 0) {
        return thrown;
    }
    return thrown.substr(n, thrown.length() - n);
}

// ---- argument helpers --------------------------------------------------------------------------
// A command receives whatever the page sent. Reading a missing or wrongly typed value straight off the
// JSON would dereference a null handle and stop the application (the runtime null check turns that into a
// clean abort naming the line, but a web page should not be able to end the program). These helpers reject
// the call instead: the page's promise is rejected with the message.

string intToString(int v) {
    if (v == 0) {
        return "0";
    }
    int n = v;
    string digits = "";
    bool negative = n < 0;
    if (negative) {
        n = 0 - n;
    }
    while (n > 0) {
        digits.push_back(char(48 + n % 10));
        n = n / 10;
    }
    string text = "";
    if (negative) {
        text.push_back('-');
    }
    int i = digits.length() - 1;
    while (i >= 0) {
        text.push_back(digits[i]);
        i = i - 1;
    }
    return text;
}

string argName(int index) {
    return "argument " + intToString(index);
}

// args[index] as a number, or throws "argument N must be a number"
double numberAt(Item args, int index) {
    Item v = getArrayItem(args, index);
    if (!isNumber(v)) {
        string message = argName(index) + " must be a number";
        throw message;
    }
    return v.valuedouble;
}

string stringAt(Item args, int index) {
    Item v = getArrayItem(args, index);
    if (!isString(v)) {
        string message = argName(index) + " must be a string";
        throw message;
    }
    return v.valuestring;
}

bool boolAt(Item args, int index) {
    Item v = getArrayItem(args, index);
    if (!isBool(v)) {
        string message = argName(index) + " must be a boolean";
        throw message;
    }
    return isTrue(v);
}

// the member `name` of an object argument, or throws "missing field NAME"
Item fieldOf(Item object, string name) {
    Item v = getObjectItem(object, name);
    if (v == nullptr) {
        string message = "missing field " + name;
        throw message;
    }
    return v;
}

// ---- background work ---------------------------------------------------------------------------
// A command that must not block the window loop is an AsyncCommand. `start` runs on the main thread, copies
// what it needs out of `args` into plain values, and hands them to a worker:
//
//     app.asyncCommand("scan", closure AsyncCommand [] (Item args, string id, int handle) {
//         string payload = printUnformatted(args);
//         spawn(closure Job [payload, id, handle] () {
//             Item mine = parse(payload);            // the worker builds its OWN tree
//             replyOk(handle, id, printUnformatted(mine));
//         });
//     });
//
// `spawn` accepts only primitives, string and vectors of primitives in the capture list (the compiler refuses
// an Item or any other object), so the worker shares no CeeLing memory with the main thread; it answers the
// page itself through replyOk / replyError, which go through the mutex-protected shim. `start` must either
// spawn and return, or throw BEFORE spawning -- a promise is answered exactly once.
class Job {
public:
    Job() { }
    virtual void run() { }
};

class AsyncCommand {
public:
    AsyncCommand() { }
    virtual void start(Item args, string id, int handle) { }
};

// What runs when a spawned job throws (see spawn's optional second argument and onJobFailure). The dispatcher
// installs one around every AsyncCommand.start, so a job that throws answers the page with a rejection
// {code: "command_failed", message} instead of leaving its promise pending.
class Failure {
public:
    Failure() { }
    virtual void fail(string message) { }
};

// Answers a call from any thread. status 0 resolves the page's promise with `json`, 1 rejects it.
void replyOk(int handle, string id, string json) {
    app_return(handle, id, 0, json);
}

void replyError(int handle, string id, string code, string message) {
    app_return(handle, id, 1, errorJson(code, message));
}

// ---- events: CeeLing -> page -------------------------------------------------------------------
// emitEvent(handle, "progress", "{\"done\":3}") runs `cling.on("progress", fn)` listeners on the page with the payload
// {done: 3}. It takes only an int and strings, so a worker job can call it (capture the handle):
//
//     spawn(closure Job [handle, payload] () { ... emitEvent(handle, "progress", text); ... });
//
// The payload must be valid JSON text; the script handed to the page is built ONLY with the JSON printer (the name
// and the payload are re-printed, never pasted), so a name or a string containing quotes, backslashes or script text
// stays a string literal and cannot become code. Returns false, and sends nothing, if the payload is not valid JSON or
// the window is gone. An event sent before the page has loaded and registered its listener is dropped.
bool emitEvent(int handle, string name, string payloadJson) {
    Item payload = parseWithOpts(payloadJson, true);   // strict: trailing text after the JSON value is an error
    if (payload == nullptr) {
        return false;
    }
    Item message = createArray();
    addItemToArray(message, createString(name));
    addItemToArray(message, payload);
    string text = printUnformatted(message);
    if (text.length() == 0) {
        return false;
    }
    return app_eval(handle, "window.__cling_emit(" + text + ");") == 1;
}

class Dispatcher {
public:
    std::vector<string> names;
    std::vector<Command> handlers;
    std::vector<string> asyncNames;
    std::vector<AsyncCommand> asyncHandlers;

    Dispatcher() { }

    void add(string name, Command handler) {
        names.push_back(name);
        handlers.push_back(handler);
    }

    void addAsync(string name, AsyncCommand handler) {
        asyncNames.push_back(name);
        asyncHandlers.push_back(handler);
    }

    // The index of the async command called `name`, or -1.
    int indexOfAsync(string name) {
        int i = 0;
        while (i < asyncNames.size()) {
            if (asyncNames[i] == name) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    // The index of the command called `name`, or -1.
    int indexOf(string name) {
        int i = 0;
        while (i < names.size()) {
            if (names[i] == name) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    // One request in, one reply out. Never throws and never aborts on a malformed request: a bad
    // request is a rejected promise, not a dead application. For an async command the reply has status 2
    // ("deferred"): nothing is sent now, the worker answers later.
    Reply handle(int appHandle, string id, string request) {
        Item parsed = parse(request);
        if (parsed == nullptr) {
            return new Reply(1, errorJson("bad_request", "the request is not valid JSON"));
        }
        if (!isArray(parsed) || getArraySize(parsed) < 1) {
            return new Reply(1, errorJson("bad_request", "the request must be a JSON array [command, args]"));
        }
        Item nameItem = getArrayItem(parsed, 0);
        if (!isString(nameItem)) {
            return new Reply(1, errorJson("bad_request", "the command name must be a string"));
        }
        int index = indexOf(nameItem.valuestring);
        int asyncIndex = indexOfAsync(nameItem.valuestring);
        if (index < 0 && asyncIndex < 0) {
            return new Reply(1, errorJson("unknown_command", "no command named " + nameItem.valuestring));
        }
        Item args = getArrayItem(parsed, 1);
        if (args == nullptr) {
            args = createNull();
        }
        if (index < 0) {
            try {
                AsyncCommand starter = asyncHandlers[asyncIndex];
                // every job this start() spawns inherits this: a throw inside it rejects the page's promise
                onJobFailure(closure Failure [id, appHandle] (string message) {
                    replyError(appHandle, id, errorCodeOf(message), errorTextOf(message));
                });
                starter.start(args, id, appHandle);
                cling::clearJobFailure();
                return new Reply(2, "");
            } catch (string message) {
                cling::clearJobFailure();
                return new Reply(1, errorJson(errorCodeOf(message), errorTextOf(message)));
            }
        }
        try {
            // (a local first: the checker cannot resolve a method call made directly on `handlers[index]`)
            Command handler = handlers[index];
            Item result = handler.call(args);
            if (result == nullptr) {
                return new Reply(0, "null");
            }
            string text = printUnformatted(result);
            if (text.length() == 0) {
                return new Reply(1, errorJson("command_failed", "the command returned a value that cannot be printed"));
            }
            return new Reply(0, text);
        } catch (string message) {
            return new Reply(1, errorJson(errorCodeOf(message), errorTextOf(message)));
        }
        return new Reply(1, errorJson("internal", "unreachable"));
    }
};

// ---- file commands --------------------------------------------------------------------------------
// The allowed folders and every check on a path live in the C++ shim (shim/app_fs.cpp): it decides on what the
// operating system actually opened, which a CeeLing string comparison cannot do. These helpers only map its status
// codes to error codes and shape the JSON.

string fsCodeFor(int status) {
    if (status == 1) { return "forbidden"; }
    if (status == 2) { return "not_found"; }
    if (status == 3) { return "too_large"; }
    if (status == 5) { return "invalid_path"; }
    if (status == 6) { return "already_exists"; }
    if (status == 7) { return "not_empty"; }
    if (status == 8) { return "is_directory"; }
    if (status == 9) { return "not_directory"; }
    if (status == 10) { return "permission_denied"; }
    return "io_error";
}

void fsCheck(int status, string what) {
    if (status != 0) {
        string message = fsCodeFor(status) + ": " + what;
        throw message;
    }
}

Item objectArg(Item args) {
    if (args == nullptr || !isObject(args)) {
        throw "invalid_argument: expected an object such as {path: \"...\"}";
    }
    return args;
}

string requiredString(Item args, string name) {
    Item v = getObjectItem(objectArg(args), name);
    if (v == nullptr || !isString(v)) {
        string message = "invalid_argument: `" + name + "` must be a string";
        throw message;
    }
    return v.valuestring;
}

string optionalString(Item args, string name, string fallback) {
    Item v = getObjectItem(objectArg(args), name);
    if (v == nullptr) {
        return fallback;
    }
    if (!isString(v)) {
        string message = "invalid_argument: `" + name + "` must be a string";
        throw message;
    }
    return v.valuestring;
}

bool optionalBool(Item args, string name, bool fallback) {
    Item v = getObjectItem(objectArg(args), name);
    if (v == nullptr) {
        return fallback;
    }
    if (!isBool(v)) {
        string message = "invalid_argument: `" + name + "` must be true or false";
        throw message;
    }
    return isTrue(v);
}

// The NUL-separated fields the shim returns, as a vector.
std::vector<string> splitFields(string records) {
    std::vector<string> parts;
    string current = "";
    int i = 0;
    while (i < records.length()) {
        if (records[i] == char(0)) {
            parts.push_back(current);
            current = "";
        } else {
            current.push_back(records[i]);
        }
        i = i + 1;
    }
    return parts;
}

double decimalValue(string digits) {
    double value = 0.0;
    int i = 0;
    while (i < digits.length()) {
        char c = digits[i];
        if (c >= '0' && c <= '9') {
            value = value * 10.0 + double(int(c) - 48);
        }
        i = i + 1;
    }
    return value;
}

string kindName(string code) {
    if (code == "d") { return "dir"; }
    if (code == "l") { return "link"; }
    return "file";
}

// {name, kind: "file" | "dir" | "link", size, modified (seconds since 1970)}
Item entryItem(string kind, string size, string modified, string name) {
    Item e = createObject();
    addStringToObject(e, "name", name);
    addStringToObject(e, "kind", kindName(kind));
    addNumberToObject(e, "size", decimalValue(size));
    addNumberToObject(e, "modified", decimalValue(modified));
    return e;
}

// ---- dialog commands ------------------------------------------------------------------------------
// The user's choice in a native dialog is a grant: exactly the file (or folder) they picked becomes reachable through
// the file commands, and nothing around it. A page cannot reach a file it has not been given, by the app or by the
// user; and a dialog is the only way the user can give one.

// [{name: "Text", extensions: ["txt", "md"]}, {name: "Everything"}] -> the shim's "label NUL extensions NUL ..." form
string filterText(Item args) {
    Item list = getObjectItem(objectArg(args), "filters");
    if (list == nullptr) {
        return "";
    }
    if (!isArray(list)) {
        throw "invalid_argument: `filters` must be an array";
    }
    string text = "";
    int i = 0;
    while (i < getArraySize(list)) {
        Item f = getArrayItem(list, i);
        Item name = nullptr;
        if (isObject(f)) {
            name = getObjectItem(f, "name");
        }
        if (name == nullptr || !isString(name)) {
            throw "invalid_argument: every filter needs a string `name`";
        }
        string extensions = "*";
        Item exts = getObjectItem(f, "extensions");
        if (exts != nullptr) {
            if (!isArray(exts)) {
                throw "invalid_argument: `extensions` must be an array of strings";
            }
            if (getArraySize(exts) > 0) {
                extensions = "";
                int j = 0;
                while (j < getArraySize(exts)) {
                    Item e = getArrayItem(exts, j);
                    if (!isString(e)) {
                        throw "invalid_argument: `extensions` must be an array of strings";
                    }
                    if (j > 0) {
                        extensions.push_back(',');
                    }
                    extensions = extensions + e.valuestring;
                    j = j + 1;
                }
            }
        }
        text = text + name.valuestring;
        text.push_back(char(0));
        text = text + extensions;
        text.push_back(char(0));
        i = i + 1;
    }
    return text;
}

// Answers a picker: null if the user cancelled, {path} (the form the file commands accept) after granting it.
void finishPick(int handle, string id, int status, string chosen, bool folder) {
    if (status == 0) {
        replyOk(handle, id, "null");
    } else if (status < 0) {
        if (status == -2) {
            replyError(handle, id, "invalid_argument", "the dialog arguments were refused (title or filter too long or malformed)");
        } else {
            replyError(handle, id, "unsupported", "the dialog could not be shown");
        }
    } else {
        string canonical = "";
        int granted = 0;
        if (folder) {
            granted = app_fs_grant_folder(chosen, canonical);
        } else {
            granted = app_fs_grant_file(chosen, canonical);
        }
        if (granted != 0) {
            replyError(handle, id, fsCodeFor(granted), "the chosen path cannot be used");
        } else {
            Item result = createObject();
            addStringToObject(result, "path", canonical);
            replyOk(handle, id, printUnformatted(result));
        }
    }
}

string buttonName(int button) {
    if (button == 1) { return "ok"; }
    if (button == 3) { return "yes"; }
    if (button == 4) { return "no"; }
    return "cancel";
}

// ---- program commands -----------------------------------------------------------------------------
// The application declares WHICH programs may run and with what arguments (allowProgram); a page can only ask for one
// of them by name and fill in the named slots of its argument template. It never supplies a program name, a command
// line or an option: there is no shell, every argument is a separate string, and a slot value that could be read as an
// option (a leading '-') is refused when the slot is a whole argument. The shim (app_proc.cpp) runs the program with no
// stdin, a time limit, an output cap, and kills everything it started.
//
//     app.allowProgram("git.log", "git",
//         ["log", "-n", "{count:int:1:500}", "--format=%H%x09%s", "--", "{file:file}", "@cwd={repo:folder}"], 10000, 1000000);
//     // page:  cling.proc.run({ program: "git.log", args: { count: 20, repo: ".", file: "src/a.txt" } })
//
// An argument is literal text, or literal text around ONE slot  {name:kind[:a[:b]]}  with kind
//   int:min:max   a whole number from min to max        token   letters, digits and . _ - / @ ~ ^ + = (max 200)
//   text:maxLen   any text of at most maxLen bytes      file / folder / path   an existing file, folder or either that
//                                                       the file commands could reach (passed as its absolute path)
// The element "@cwd={name:folder}" (at most one) names the working folder; without it the program runs in the first
// folder the application allowed.

class ProgramSpec {
public:
    string name;
    string exe;
    std::vector<string> elements;
    std::vector<string> slotNames;
    int timeoutMs;
    int maxBytes;
    ProgramSpec(string n, string e, int t, int m) {
        name = n;
        exe = e;
        timeoutMs = t;
        maxBytes = m;
    }
};

class ProgramRegistry {
public:
    std::vector<ProgramSpec> specs;
    ProgramRegistry() { }
    int indexOf(string name) {
        int i = 0;
        while (i < specs.size()) {
            ProgramSpec spec = specs[i];
            if (spec.name == name) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }
};

std::vector<string> splitOn(string s, char sep) {
    std::vector<string> parts;
    string current = "";
    int i = 0;
    while (i < s.length()) {
        if (s[i] == sep) {
            parts.push_back(current);
            current = "";
        } else {
            current.push_back(s[i]);
        }
        i = i + 1;
    }
    parts.push_back(current);
    return parts;
}

int indexOfChar(string s, char c) {
    int i = 0;
    while (i < s.length()) {
        if (s[i] == c) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

bool isDigits(string s) {
    if (s.length() == 0 || s.length() > 9) {
        return false;
    }
    int i = 0;
    while (i < s.length()) {
        if (s[i] < '0' || s[i] > '9') {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// "count:int:1:500", "ref:token", "msg:text:80", "f:file" -- is the slot text well formed?
bool slotSpecOk(string text) {
    std::vector<string> p = splitOn(text, ':');
    if (p.size() < 2) {
        return false;
    }
    string slotName = p[0];
    if (slotName.length() == 0 || slotName.length() > 40) {
        return false;
    }
    int i = 0;
    while (i < slotName.length()) {
        char c = slotName[i];
        bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
        if (!ok) {
            return false;
        }
        i = i + 1;
    }
    if (p[1] == "int") {
        return p.size() == 4 && isDigits(p[2]) && isDigits(p[3]) && decimalValue(p[2]) <= decimalValue(p[3]);
    }
    if (p[1] == "text") {
        return p.size() == 3 && isDigits(p[2]) && decimalValue(p[2]) >= 1.0 && decimalValue(p[2]) <= 100000.0;
    }
    if (p[1] == "token" || p[1] == "file" || p[1] == "folder" || p[1] == "path") {
        return p.size() == 2;
    }
    return false;
}

// where the slot sits in an element: the index of '{' (or -1) -- an element has at most one, and it must close
int slotOpen(string element) {
    return indexOfChar(element, '{');
}

int slotClose(string element) {
    return indexOfChar(element, '}');
}

void argError(string name, string what) {
    string message = "invalid_argument: `" + name + "` " + what;
    throw message;
}

bool tokenChar(char c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '.' || c == '_' || c == '-' ||
           c == '/' || c == '@' || c == '~' || c == '^' || c == '+' || c == '=';
}

// The checked text for one slot. `whole` = the slot is the entire argument, so a leading '-' could be read as an option.
string slotValue(string slotText, Item args, bool whole) {
    std::vector<string> p = splitOn(slotText, ':');
    string name = p[0];
    string kind = p[1];
    Item v = getObjectItem(args, name);
    if (v == nullptr) {
        argError(name, "is missing");
        return "";
    }
    if (kind == "int") {
        if (!isNumber(v)) {
            argError(name, "must be a number");
            return "";
        }
        double x = v.valuedouble;
        double lo = decimalValue(p[2]);
        double hi = decimalValue(p[3]);
        if (x != double(int(x)) || x < lo || x > hi) {
            argError(name, "must be a whole number from " + p[2] + " to " + p[3]);
            return "";
        }
        return intToString(int(x));
    }
    if (!isString(v)) {
        argError(name, "must be a string");
        return "";
    }
    string text = v.valuestring;
    if (kind == "token") {
        if (text.length() == 0 || text.length() > 200) {
            argError(name, "must be 1 to 200 characters");
            return "";
        }
        int i = 0;
        while (i < text.length()) {
            if (!tokenChar(text[i])) {
                argError(name, "may only contain letters, digits and . _ - / @ ~ ^ + =");
                return "";
            }
            i = i + 1;
        }
    } else if (kind == "text") {
        if (text.length() > int(decimalValue(p[2]))) {
            argError(name, "is too long");
            return "";
        }
        if (app_fs_is_utf8(text) == 0 || indexOfChar(text, char(0)) >= 0) {
            argError(name, "must be plain text");
            return "";
        }
    } else {
        int want = 0;
        if (kind == "file") {
            want = 1;
        } else if (kind == "folder") {
            want = 2;
        }
        string canonical = "";
        int status = app_fs_resolve(text, want, canonical);
        if (status != 0) {
            string message = fsCodeFor(status) + ": cannot use " + text;
            throw message;
        }
        return canonical;
    }
    if (whole && text.length() > 0 && text[0] == '-') {
        argError(name, "must not start with '-'");
        return "";
    }
    return text;
}

// The element with its slot replaced by the checked value.
string renderElement(string element, Item args) {
    int open = slotOpen(element);
    if (open < 0) {
        return element;
    }
    int close = slotClose(element);
    string slotText = element.substr(open + 1, close - open - 1);
    bool whole = open == 0 && close == element.length() - 1;
    string value = slotValue(slotText, args, whole);
    return element.substr(0, open) + value + element.substr(close + 1, element.length() - close - 1);
}

// Replies for a finished program: {exitCode, stdout, stderr, timedOut, truncated: {stdout, stderr}, lossy}.
void finishRun(int handle, string id, int status, string out, string err, int exitCode, int flags) {
    if (status == 0) {
        Item result = createObject();
        string cleanOut = "";
        string cleanErr = "";
        int lossyOut = app_proc_clean_text(out, cleanOut);
        int lossyErr = app_proc_clean_text(err, cleanErr);
        addNumberToObject(result, "exitCode", double(exitCode));
        addStringToObject(result, "stdout", cleanOut);
        addStringToObject(result, "stderr", cleanErr);
        addBoolToObject(result, "timedOut", (flags % 2) == 1);
        Item cut = addObjectToObject(result, "truncated");
        addBoolToObject(cut, "stdout", ((flags / 2) % 2) == 1);
        addBoolToObject(cut, "stderr", ((flags / 4) % 2) == 1);
        addBoolToObject(result, "lossy", lossyOut == 1 || lossyErr == 1);
        replyOk(handle, id, printUnformatted(result));
    } else if (status == 2) {
        replyError(handle, id, "program_not_found", "the program or its working folder does not exist");
    } else if (status == 5) {
        replyError(handle, id, "invalid_argument", "the arguments could not be passed to the program");
    } else {
        replyError(handle, id, "spawn_failed", "the program could not be started");
    }
}

bool programNameOk(string name) {
    if (name.length() == 0 || name.length() > 60) {
        return false;
    }
    int i = 0;
    while (i < name.length()) {
        char c = name[i];
        bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '.' || c == '_' || c == '-';
        if (!ok) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

bool startsWithText(string text, string prefix) {
    return text.length() >= prefix.length() && text.substr(0, prefix.length()) == prefix;
}

// The slot text inside an element's braces, or "" if it has none (-1: malformed braces).
int elementSlotCheck(string element) {
    int open = slotOpen(element);
    int close = slotClose(element);
    if (open < 0 && close < 0) {
        return 0;
    }
    if (open < 0 || close < open) {
        return -1;
    }
    string slotText = element.substr(open + 1, close - open - 1);
    string rest = element.substr(0, open) + element.substr(close + 1, element.length() - close - 1);
    if (indexOfChar(rest, '{') >= 0 || indexOfChar(rest, '}') >= 0) {
        return -1;
    }
    if (!slotSpecOk(slotText)) {
        return -1;
    }
    return 1;
}

// A running application: a window plus a command table.
class App {
public:
    int handle;
    Dispatcher dispatcher;
    ProgramRegistry programs;

    App() {
        handle = 0;
        dispatcher = new Dispatcher();
        programs = new ProgramRegistry();
    }

    void command(string name, Command handler) {
        dispatcher.add(name, handler);
    }

    void asyncCommand(string name, AsyncCommand handler) {
        dispatcher.addAsync(name, handler);
    }

    // Pushes an event to the page (see emitEvent). Safe to call from the main thread only through this method;
    // worker jobs use emitEvent with a captured handle.
    bool emit(string name, string payloadJson) {
        return emitEvent(handle, name, payloadJson);
    }

    // Adds a folder the page may reach through the file commands. Nothing is reachable until at least one is added;
    // a relative path from the page means "inside the first folder added". false if the folder does not exist.
    bool allowFolder(string dir) {
        return app_fs_allow(dir) == 0;
    }

    // Registers fs.read, fs.write, fs.list, fs.stat, fs.exists, fs.mkdir and fs.remove. Every path is checked by the
    // shim against the folders added with allowFolder. fs.read refuses files larger than maxReadBytes and files that
    // are not valid UTF-8 (text only; binary needs its own command).
    void enableFileCommands(int maxReadBytes) {
        command("fs.read", closure Command [maxReadBytes] (Item args) {
            string path = requiredString(args, "path");
            string content = "";
            fsCheck(app_fs_read(path, maxReadBytes, content), "cannot read " + path);
            if (app_fs_is_utf8(content) == 0) {
                throw "not_text: the file is not valid UTF-8";
            }
            Item result = createObject();
            addStringToObject(result, "text", content);
            return result;
        });
        command("fs.write", closure Command [] (Item args) {
            string path = requiredString(args, "path");
            string text = requiredString(args, "text");
            string mode = optionalString(args, "mode", "replace");
            int code = 0;
            if (mode == "append") {
                code = 1;
            } else if (mode == "create") {
                code = 2;
            } else if (mode != "replace") {
                throw "invalid_argument: `mode` must be \"replace\", \"append\" or \"create\"";
            }
            fsCheck(app_fs_write(path, text, code), "cannot write " + path);
            return createNull();
        });
        command("fs.list", closure Command [] (Item args) {
            string path = requiredString(args, "path");
            string records = "";
            fsCheck(app_fs_list(path, records), "cannot list " + path);
            std::vector<string> parts = splitFields(records);
            Item listing = createArray();
            int i = 0;
            while (i + 3 < parts.size()) {
                string name = parts[i + 3];
                if (app_fs_is_utf8(name) == 1) {
                    addItemToArray(listing, entryItem(parts[i], parts[i + 1], parts[i + 2], name));
                }
                i = i + 4;
            }
            return listing;
        });
        command("fs.stat", closure Command [] (Item args) {
            string path = requiredString(args, "path");
            string record = "";
            fsCheck(app_fs_stat(path, record), "cannot stat " + path);
            std::vector<string> parts = splitFields(record);
            if (parts.size() < 4 || app_fs_is_utf8(parts[3]) == 0) {
                throw "io_error: unreadable file entry";
            }
            return entryItem(parts[0], parts[1], parts[2], parts[3]);
        });
        command("fs.exists", closure Command [] (Item args) {
            string path = requiredString(args, "path");
            string record = "";
            int status = app_fs_stat(path, record);
            if (status == 2) {
                return createBool(false);
            }
            fsCheck(status, "cannot stat " + path);
            return createBool(true);
        });
        command("fs.mkdir", closure Command [] (Item args) {
            string path = requiredString(args, "path");
            bool parents = optionalBool(args, "parents", false);
            int flag = 0;
            if (parents) {
                flag = 1;
            }
            int status = app_fs_mkdir(path, flag);
            if (!(parents && status == 6)) {
                fsCheck(status, "cannot create " + path);
            }
            return createNull();
        });
        command("fs.remove", closure Command [] (Item args) {
            string path = requiredString(args, "path");
            fsCheck(app_fs_remove(path), "cannot remove " + path);
            return createNull();
        });
    }

    // Declares a program the page may run, by name, with an argument template (see the comment above ProgramSpec).
    // `exe` is an absolute path to a .exe, or a bare name searched for on PATH only. Returns false, and registers
    // nothing, if the name or the template is malformed, the program cannot be found, or the name is taken.
    bool allowProgram(string name, string exe, std::vector<string> elements, int timeoutMs, int maxOutputBytes) {
        if (!programNameOk(name) || programs.indexOf(name) >= 0 || elements.size() > 64) {
            return false;
        }
        if (timeoutMs < 100 || timeoutMs > 600000 || maxOutputBytes < 0 || maxOutputBytes > 67108864) {
            return false;
        }
        string resolved = "";
        if (app_proc_resolve(exe, resolved) != 0) {
            return false;
        }
        ProgramSpec spec = new ProgramSpec(name, resolved, timeoutMs, maxOutputBytes);
        std::vector<string> names;
        int cwdCount = 0;
        int i = 0;
        while (i < elements.size()) {
            string element = elements[i];
            if (element.length() > 1000 || app_fs_is_utf8(element) == 0 || indexOfChar(element, char(0)) >= 0) {
                return false;
            }
            if (startsWithText(element, "@cwd=")) {
                string inner = element.substr(5, element.length() - 5);
                if (elementSlotCheck(inner) != 1 || slotOpen(inner) != 0 || slotClose(inner) != inner.length() - 1) {
                    return false;
                }
                std::vector<string> parts = splitOn(inner.substr(1, inner.length() - 2), ':');
                if (parts.size() != 2 || parts[1] != "folder") {
                    return false;
                }
                cwdCount = cwdCount + 1;
                string cwdName = parts[0];
                names.push_back(cwdName);
            } else {
                int has = elementSlotCheck(element);
                if (has < 0) {
                    return false;
                }
                if (has == 1) {
                    int open = slotOpen(element);
                    int close = slotClose(element);
                    std::vector<string> parts = splitOn(element.substr(open + 1, close - open - 1), ':');
                    string slotName = parts[0];
                    names.push_back(slotName);
                }
            }
            spec.elements.push_back(element);
            i = i + 1;
        }
        if (cwdCount > 1) {
            return false;
        }
        int a = 0;
        while (a < names.size()) {
            int b = a + 1;
            while (b < names.size()) {
                if (names[a] == names[b]) {
                    return false;
                }
                b = b + 1;
            }
            a = a + 1;
        }
        spec.slotNames = names;
        programs.specs.push_back(spec);
        return true;
    }

    // Registers proc.run: {program: "git.log", args: {count: 20, ...}} -> {exitCode, stdout, stderr, timedOut,
    // truncated: {stdout, stderr}, lossy}. A non-zero exit code is a result, not an error. Asynchronous: the program
    // runs on a worker, so the command loop keeps serving.
    void enableProcessCommands() {
        ProgramRegistry registry = programs;
        asyncCommand("proc.run", closure AsyncCommand [registry] (Item args, string id, int handle) {
            string program = requiredString(args, "program");
            Item given = getObjectItem(args, "args");
            if (given == nullptr) {
                given = createObject();
            }
            if (!isObject(given)) {
                throw "invalid_argument: `args` must be an object";
            }
            int index = registry.indexOf(program);
            if (index < 0) {
                throw "unknown_program: no program is allowed under that name";
            }
            ProgramSpec spec = registry.specs[index];
            // every value in `args` must belong to a slot: nothing extra is passed along
            Item child = given.child;
            while (child != nullptr) {
                bool known = false;
                int k = 0;
                while (k < spec.slotNames.size()) {
                    if (spec.slotNames[k] == child.key) {
                        known = true;
                    }
                    k = k + 1;
                }
                if (!known) {
                    string message = "invalid_argument: `" + child.key + "` is not a parameter of " + program;
                    throw message;
                }
                child = child.next;
            }
            string packed = "";
            string cwd = "";
            int e = 0;
            while (e < spec.elements.size()) {
                string element = spec.elements[e];
                if (startsWithText(element, "@cwd=")) {
                    string inner = element.substr(5, element.length() - 5);
                    cwd = slotValue(inner.substr(1, inner.length() - 2), given, false);
                } else {
                    packed = packed + renderElement(element, given);
                    packed.push_back(char(0));
                }
                e = e + 1;
            }
            if (cwd.length() == 0) {
                int where = app_fs_resolve(".", 2, cwd);
                if (where != 0) {
                    string message = fsCodeFor(where) + ": no folder is allowed to run programs in";
                    throw message;
                }
            }
            string exe = spec.exe;
            int timeoutMs = spec.timeoutMs;
            int maxBytes = spec.maxBytes;
            spawn(closure Job [exe, packed, cwd, timeoutMs, maxBytes, id, handle] () {
                string out = "";
                string err = "";
                int exitCode = 0;
                int flags = 0;
                int status = app_proc_run(exe, packed, cwd, timeoutMs, maxBytes, out, err, exitCode, flags);
                finishRun(handle, id, status, out, err, exitCode, flags);
            });
        });
    }

    // Withdraws everything the user granted through dialogs (the folders added with allowFolder stay).
    void revokeGrants() {
        app_fs_revoke_grants();
    }

    // Registers dialog.open, dialog.save, dialog.folder and dialog.message. They are asynchronous commands, so the
    // command loop keeps serving while a dialog is open. A pick answers null on cancel, else {path} and grants that
    // one file (or folder) to the file commands.
    void enableDialogCommands() {
        asyncCommand("dialog.open", closure AsyncCommand [] (Item args, string id, int handle) {
            string title = optionalString(args, "title", "");
            string filters = filterText(args);
            spawn(closure Job [title, filters, id, handle] () {
                string chosen = "";
                int status = app_dialog_open_file(handle, title, filters, chosen);
                finishPick(handle, id, status, chosen, false);
            });
        });
        asyncCommand("dialog.save", closure AsyncCommand [] (Item args, string id, int handle) {
            string title = optionalString(args, "title", "");
            string suggested = optionalString(args, "defaultName", "");
            string filters = filterText(args);
            spawn(closure Job [title, suggested, filters, id, handle] () {
                string chosen = "";
                int status = app_dialog_save_file(handle, title, suggested, filters, chosen);
                finishPick(handle, id, status, chosen, false);
            });
        });
        asyncCommand("dialog.folder", closure AsyncCommand [] (Item args, string id, int handle) {
            string title = optionalString(args, "title", "");
            spawn(closure Job [title, id, handle] () {
                string chosen = "";
                int status = app_dialog_pick_folder(handle, title, chosen);
                finishPick(handle, id, status, chosen, true);
            });
        });
        asyncCommand("dialog.message", closure AsyncCommand [] (Item args, string id, int handle) {
            string title = optionalString(args, "title", "");
            string message = requiredString(args, "message");
            string kind = optionalString(args, "kind", "info");
            string buttons = optionalString(args, "buttons", "ok");
            spawn(closure Job [title, message, kind, buttons, id, handle] () {
                int button = app_dialog_message(handle, title, message, kind, buttons);
                if (button > 0) {
                    Item result = createObject();
                    addStringToObject(result, "button", buttonName(button));
                    replyOk(handle, id, printUnformatted(result));
                } else if (button == -2) {
                    replyError(handle, id, "invalid_argument", "the dialog arguments were refused (text too long, or an unknown kind or buttons)");
                } else {
                    replyError(handle, id, "unsupported", "the dialog could not be shown");
                }
            });
        });
    }

    // At most n async jobs run at the same time (the rest wait in a queue, oldest first); 0 = the default,
    // max(4, number of cores). A job is never dropped: on exit every queued job still runs.
    void setWorkerLimit(int n) {
        cling::setWorkerLimit(n);
    }

    // Opens the window. false if it could not be created (the shim has printed why on stderr).
    bool open(string title, int width, int height, string html, string bridgeJs, bool debug) {
        int d = 0;
        if (debug) {
            d = 1;
        }
        handle = app_open(title, width, height, html, bridgeJs, d);
        return handle != 0;
    }

    // Opens the window on the page embedded at build time, with the standard bridge script.
    bool openPage(string title, int width, int height, bool debug) {
        return open(title, width, height, app_page_html(), app_bridge_js(), debug);
    }

    // Serves calls until the window closes. Returns how many calls were answered.
    int run() {
        int served = 0;
        string id = "";
        string request = "";
        while (true) {
            int r = app_next_call(handle, -1, id, request);
            if (r == 0) {
                break;
            }
            if (r == 1) {
                Reply reply = dispatcher.handle(handle, id, request);
                if (reply.status != 2) {
                    app_return(handle, id, reply.status, reply.json);
                }
                served = served + 1;
            }
        }
        return served;
    }

    void quit() {
        app_terminate(handle);
    }

    void close() {
        app_close(handle);
        handle = 0;
    }
};
