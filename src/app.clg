// app-cling -- the CeeLing layer: command table, dispatch and the run loop.
//
// This is the only part of an app-cling program that CeeLing checks. Everything native (the window, the
// browser engine, the queue between threads) is behind the six `ext_fn`s below and is trusted, not checked.
//
// A command is a class with one virtual method, `call(Item args)`, that returns the JSON value to send back
// (or throws a string, which becomes a rejected promise). Register one with a closure:
//
//     app.command("add", closure Command [] (Item args) {
//         return createNumber(getArrayItem(args, 0).valuedouble + getArrayItem(args, 1).valuedouble);
//     });
//
// A request arrives as the JSON array ["command", args]; the reply is a status (0 = resolve, 1 = reject) and a
// JSON text. Reply texts are built with the JSON library, never by string concatenation, so they are always
// valid JSON whatever the command or the error message contains.
#include "cjson_item.clh"
#include "cjson_api.clh"
#include "cjson_parse.clh"
#include "cjson_print.clh"
#include "../shim/app_shim.h"

ext_fn int app_open(string title, int width, int height, string html, string initJs, int debug);
ext_fn int app_next_call(int handle, int timeoutMs, ref string id, ref string request);
ext_fn int app_return(int handle, string id, int status, string json);
ext_fn int app_eval(int handle, string js);
ext_fn int app_terminate(int handle);
ext_fn int app_close(int handle);
ext_fn int app_sleep_ms(int ms);
ext_fn int app_gauge_enter();
ext_fn int app_gauge_leave();
ext_fn int app_gauge_peak();

// file access with the allowed-folder policy enforced inside the shim (shim/app_fs.h)
ext_fn int app_fs_allow(string dir);
ext_fn int app_fs_clear();
ext_fn int app_fs_read(string path, int maxBytes, ref string out);
ext_fn int app_fs_write(string path, string data, int mode);
ext_fn int app_fs_list(string dir, ref string out);
ext_fn int app_fs_stat(string path, ref string out);
ext_fn int app_fs_mkdir(string path, int parents);
ext_fn int app_fs_remove(string path);
ext_fn int app_fs_is_utf8(string s);
// the page and the bridge script, compiled into the program by scripts/build.sh
ext_fn string app_page_html();
ext_fn string app_bridge_js();

// What a handler produces. status 0 resolves the page's promise with `json`; 1 rejects it.
class Reply {
public:
    int status;
    string json;
    Reply(int s, string j) {
        status = s;
        json = j;
    }
};

// A command. Override `call`; the default answers null.
class Command {
public:
    Command() { }
    virtual Item call(Item args) {
        return createNull();
    }
};

// {"code": code, "message": message} as JSON text
string errorJson(string code, string message) {
    Item e = createObject();
    addStringToObject(e, "code", code);
    addStringToObject(e, "message", message);
    return printUnformatted(e);
}

// A thrown message may start with "<code>: " (lower-case letters, digits and underscores, at most 40): the code becomes
// the reply's error code and the rest its message, so a page can tell "not_found" from "forbidden". Anything else keeps
// the code "command_failed" and the whole message.
int errorPrefixLength(string thrown) {
    int i = 0;
    while (i < thrown.length() && i < 40) {
        char c = thrown[i];
        bool lower = c >= 'a' && c <= 'z';
        bool digit = c >= '0' && c <= '9';
        if (lower || (i > 0 && (digit || c == '_'))) {
            i = i + 1;
        } else {
            break;
        }
    }
    if (i > 0 && i + 1 < thrown.length() && thrown[i] == ':' && thrown[i + 1] == ' ') {
        return i + 2;
    }
    return 0;
}

string errorCodeOf(string thrown) {
    int n = errorPrefixLength(thrown);
    if (n == 0) {
        return "command_failed";
    }
    return thrown.substr(0, n - 2);
}

string errorTextOf(string thrown) {
    int n = errorPrefixLength(thrown);
    if (n == 0) {
        return thrown;
    }
    return thrown.substr(n, thrown.length() - n);
}

// ---- argument helpers --------------------------------------------------------------------------
// A command receives whatever the page sent. Reading a missing or wrongly typed value straight off the
// JSON would dereference a null handle and stop the application (the runtime null check turns that into a
// clean abort naming the line, but a web page should not be able to end the program). These helpers reject
// the call instead: the page's promise is rejected with the message.

string intToString(int v) {
    if (v == 0) {
        return "0";
    }
    int n = v;
    string digits = "";
    bool negative = n < 0;
    if (negative) {
        n = 0 - n;
    }
    while (n > 0) {
        digits.push_back(char(48 + n % 10));
        n = n / 10;
    }
    string text = "";
    if (negative) {
        text.push_back('-');
    }
    int i = digits.length() - 1;
    while (i >= 0) {
        text.push_back(digits[i]);
        i = i - 1;
    }
    return text;
}

string argName(int index) {
    return "argument " + intToString(index);
}

// args[index] as a number, or throws "argument N must be a number"
double numberAt(Item args, int index) {
    Item v = getArrayItem(args, index);
    if (!isNumber(v)) {
        string message = argName(index) + " must be a number";
        throw message;
    }
    return v.valuedouble;
}

string stringAt(Item args, int index) {
    Item v = getArrayItem(args, index);
    if (!isString(v)) {
        string message = argName(index) + " must be a string";
        throw message;
    }
    return v.valuestring;
}

bool boolAt(Item args, int index) {
    Item v = getArrayItem(args, index);
    if (!isBool(v)) {
        string message = argName(index) + " must be a boolean";
        throw message;
    }
    return isTrue(v);
}

// the member `name` of an object argument, or throws "missing field NAME"
Item fieldOf(Item object, string name) {
    Item v = getObjectItem(object, name);
    if (v == nullptr) {
        string message = "missing field " + name;
        throw message;
    }
    return v;
}

// ---- background work ---------------------------------------------------------------------------
// A command that must not block the window loop is an AsyncCommand. `start` runs on the main thread, copies
// what it needs out of `args` into plain values, and hands them to a worker:
//
//     app.asyncCommand("scan", closure AsyncCommand [] (Item args, string id, int handle) {
//         string payload = printUnformatted(args);
//         spawn(closure Job [payload, id, handle] () {
//             Item mine = parse(payload);            // the worker builds its OWN tree
//             replyOk(handle, id, printUnformatted(mine));
//         });
//     });
//
// `spawn` accepts only primitives, string and vectors of primitives in the capture list (the compiler refuses
// an Item or any other object), so the worker shares no CeeLing memory with the main thread; it answers the
// page itself through replyOk / replyError, which go through the mutex-protected shim. `start` must either
// spawn and return, or throw BEFORE spawning -- a promise is answered exactly once.
class Job {
public:
    Job() { }
    virtual void run() { }
};

class AsyncCommand {
public:
    AsyncCommand() { }
    virtual void start(Item args, string id, int handle) { }
};

// What runs when a spawned job throws (see spawn's optional second argument and onJobFailure). The dispatcher
// installs one around every AsyncCommand.start, so a job that throws answers the page with a rejection
// {code: "command_failed", message} instead of leaving its promise pending.
class Failure {
public:
    Failure() { }
    virtual void fail(string message) { }
};

// Answers a call from any thread. status 0 resolves the page's promise with `json`, 1 rejects it.
void replyOk(int handle, string id, string json) {
    app_return(handle, id, 0, json);
}

void replyError(int handle, string id, string code, string message) {
    app_return(handle, id, 1, errorJson(code, message));
}

// ---- events: CeeLing -> page -------------------------------------------------------------------
// emitEvent(handle, "progress", "{\"done\":3}") runs `cling.on("progress", fn)` listeners on the page with the payload
// {done: 3}. It takes only an int and strings, so a worker job can call it (capture the handle):
//
//     spawn(closure Job [handle, payload] () { ... emitEvent(handle, "progress", text); ... });
//
// The payload must be valid JSON text; the script handed to the page is built ONLY with the JSON printer (the name
// and the payload are re-printed, never pasted), so a name or a string containing quotes, backslashes or script text
// stays a string literal and cannot become code. Returns false, and sends nothing, if the payload is not valid JSON or
// the window is gone. An event sent before the page has loaded and registered its listener is dropped.
bool emitEvent(int handle, string name, string payloadJson) {
    Item payload = parseWithOpts(payloadJson, true);   // strict: trailing text after the JSON value is an error
    if (payload == nullptr) {
        return false;
    }
    Item message = createArray();
    addItemToArray(message, createString(name));
    addItemToArray(message, payload);
    string text = printUnformatted(message);
    if (text.length() == 0) {
        return false;
    }
    return app_eval(handle, "window.__cling_emit(" + text + ");") == 1;
}

class Dispatcher {
public:
    std::vector<string> names;
    std::vector<Command> handlers;
    std::vector<string> asyncNames;
    std::vector<AsyncCommand> asyncHandlers;

    Dispatcher() { }

    void add(string name, Command handler) {
        names.push_back(name);
        handlers.push_back(handler);
    }

    void addAsync(string name, AsyncCommand handler) {
        asyncNames.push_back(name);
        asyncHandlers.push_back(handler);
    }

    // The index of the async command called `name`, or -1.
    int indexOfAsync(string name) {
        int i = 0;
        while (i < asyncNames.size()) {
            if (asyncNames[i] == name) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    // The index of the command called `name`, or -1.
    int indexOf(string name) {
        int i = 0;
        while (i < names.size()) {
            if (names[i] == name) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    // One request in, one reply out. Never throws and never aborts on a malformed request: a bad
    // request is a rejected promise, not a dead application. For an async command the reply has status 2
    // ("deferred"): nothing is sent now, the worker answers later.
    Reply handle(int appHandle, string id, string request) {
        Item parsed = parse(request);
        if (parsed == nullptr) {
            return new Reply(1, errorJson("bad_request", "the request is not valid JSON"));
        }
        if (!isArray(parsed) || getArraySize(parsed) < 1) {
            return new Reply(1, errorJson("bad_request", "the request must be a JSON array [command, args]"));
        }
        Item nameItem = getArrayItem(parsed, 0);
        if (!isString(nameItem)) {
            return new Reply(1, errorJson("bad_request", "the command name must be a string"));
        }
        int index = indexOf(nameItem.valuestring);
        int asyncIndex = indexOfAsync(nameItem.valuestring);
        if (index < 0 && asyncIndex < 0) {
            return new Reply(1, errorJson("unknown_command", "no command named " + nameItem.valuestring));
        }
        Item args = getArrayItem(parsed, 1);
        if (args == nullptr) {
            args = createNull();
        }
        if (index < 0) {
            try {
                AsyncCommand starter = asyncHandlers[asyncIndex];
                // every job this start() spawns inherits this: a throw inside it rejects the page's promise
                onJobFailure(closure Failure [id, appHandle] (string message) {
                    replyError(appHandle, id, errorCodeOf(message), errorTextOf(message));
                });
                starter.start(args, id, appHandle);
                cling::clearJobFailure();
                return new Reply(2, "");
            } catch (string message) {
                cling::clearJobFailure();
                return new Reply(1, errorJson(errorCodeOf(message), errorTextOf(message)));
            }
        }
        try {
            // (a local first: the checker cannot resolve a method call made directly on `handlers[index]`)
            Command handler = handlers[index];
            Item result = handler.call(args);
            if (result == nullptr) {
                return new Reply(0, "null");
            }
            string text = printUnformatted(result);
            if (text.length() == 0) {
                return new Reply(1, errorJson("command_failed", "the command returned a value that cannot be printed"));
            }
            return new Reply(0, text);
        } catch (string message) {
            return new Reply(1, errorJson(errorCodeOf(message), errorTextOf(message)));
        }
        return new Reply(1, errorJson("internal", "unreachable"));
    }
};

// ---- file commands --------------------------------------------------------------------------------
// The allowed folders and every check on a path live in the C++ shim (shim/app_fs.cpp): it decides on what the
// operating system actually opened, which a CeeLing string comparison cannot do. These helpers only map its status
// codes to error codes and shape the JSON.

string fsCodeFor(int status) {
    if (status == 1) { return "forbidden"; }
    if (status == 2) { return "not_found"; }
    if (status == 3) { return "too_large"; }
    if (status == 5) { return "invalid_path"; }
    if (status == 6) { return "already_exists"; }
    if (status == 7) { return "not_empty"; }
    if (status == 8) { return "is_directory"; }
    if (status == 9) { return "not_directory"; }
    if (status == 10) { return "permission_denied"; }
    return "io_error";
}

void fsCheck(int status, string what) {
    if (status != 0) {
        string message = fsCodeFor(status) + ": " + what;
        throw message;
    }
}

Item objectArg(Item args) {
    if (args == nullptr || !isObject(args)) {
        throw "invalid_argument: expected an object such as {path: \"...\"}";
    }
    return args;
}

string requiredString(Item args, string name) {
    Item v = getObjectItem(objectArg(args), name);
    if (v == nullptr || !isString(v)) {
        string message = "invalid_argument: `" + name + "` must be a string";
        throw message;
    }
    return v.valuestring;
}

string optionalString(Item args, string name, string fallback) {
    Item v = getObjectItem(objectArg(args), name);
    if (v == nullptr) {
        return fallback;
    }
    if (!isString(v)) {
        string message = "invalid_argument: `" + name + "` must be a string";
        throw message;
    }
    return v.valuestring;
}

bool optionalBool(Item args, string name, bool fallback) {
    Item v = getObjectItem(objectArg(args), name);
    if (v == nullptr) {
        return fallback;
    }
    if (!isBool(v)) {
        string message = "invalid_argument: `" + name + "` must be true or false";
        throw message;
    }
    return isTrue(v);
}

// The NUL-separated fields the shim returns, as a vector.
std::vector<string> splitFields(string records) {
    std::vector<string> parts;
    string current = "";
    int i = 0;
    while (i < records.length()) {
        if (records[i] == char(0)) {
            parts.push_back(current);
            current = "";
        } else {
            current.push_back(records[i]);
        }
        i = i + 1;
    }
    return parts;
}

double decimalValue(string digits) {
    double value = 0.0;
    int i = 0;
    while (i < digits.length()) {
        char c = digits[i];
        if (c >= '0' && c <= '9') {
            value = value * 10.0 + double(int(c) - 48);
        }
        i = i + 1;
    }
    return value;
}

string kindName(string code) {
    if (code == "d") { return "dir"; }
    if (code == "l") { return "link"; }
    return "file";
}

// {name, kind: "file" | "dir" | "link", size, modified (seconds since 1970)}
Item entryItem(string kind, string size, string modified, string name) {
    Item e = createObject();
    addStringToObject(e, "name", name);
    addStringToObject(e, "kind", kindName(kind));
    addNumberToObject(e, "size", decimalValue(size));
    addNumberToObject(e, "modified", decimalValue(modified));
    return e;
}

// A running application: a window plus a command table.
class App {
public:
    int handle;
    Dispatcher dispatcher;

    App() {
        handle = 0;
        dispatcher = new Dispatcher();
    }

    void command(string name, Command handler) {
        dispatcher.add(name, handler);
    }

    void asyncCommand(string name, AsyncCommand handler) {
        dispatcher.addAsync(name, handler);
    }

    // Pushes an event to the page (see emitEvent). Safe to call from the main thread only through this method;
    // worker jobs use emitEvent with a captured handle.
    bool emit(string name, string payloadJson) {
        return emitEvent(handle, name, payloadJson);
    }

    // Adds a folder the page may reach through the file commands. Nothing is reachable until at least one is added;
    // a relative path from the page means "inside the first folder added". false if the folder does not exist.
    bool allowFolder(string dir) {
        return app_fs_allow(dir) == 0;
    }

    // Registers fs.read, fs.write, fs.list, fs.stat, fs.exists, fs.mkdir and fs.remove. Every path is checked by the
    // shim against the folders added with allowFolder. fs.read refuses files larger than maxReadBytes and files that
    // are not valid UTF-8 (text only; binary needs its own command).
    void enableFileCommands(int maxReadBytes) {
        command("fs.read", closure Command [maxReadBytes] (Item args) {
            string path = requiredString(args, "path");
            string content = "";
            fsCheck(app_fs_read(path, maxReadBytes, content), "cannot read " + path);
            if (app_fs_is_utf8(content) == 0) {
                throw "not_text: the file is not valid UTF-8";
            }
            Item result = createObject();
            addStringToObject(result, "text", content);
            return result;
        });
        command("fs.write", closure Command [] (Item args) {
            string path = requiredString(args, "path");
            string text = requiredString(args, "text");
            string mode = optionalString(args, "mode", "replace");
            int code = 0;
            if (mode == "append") {
                code = 1;
            } else if (mode == "create") {
                code = 2;
            } else if (mode != "replace") {
                throw "invalid_argument: `mode` must be \"replace\", \"append\" or \"create\"";
            }
            fsCheck(app_fs_write(path, text, code), "cannot write " + path);
            return createNull();
        });
        command("fs.list", closure Command [] (Item args) {
            string path = requiredString(args, "path");
            string records = "";
            fsCheck(app_fs_list(path, records), "cannot list " + path);
            std::vector<string> parts = splitFields(records);
            Item listing = createArray();
            int i = 0;
            while (i + 3 < parts.size()) {
                string name = parts[i + 3];
                if (app_fs_is_utf8(name) == 1) {
                    addItemToArray(listing, entryItem(parts[i], parts[i + 1], parts[i + 2], name));
                }
                i = i + 4;
            }
            return listing;
        });
        command("fs.stat", closure Command [] (Item args) {
            string path = requiredString(args, "path");
            string record = "";
            fsCheck(app_fs_stat(path, record), "cannot stat " + path);
            std::vector<string> parts = splitFields(record);
            if (parts.size() < 4 || app_fs_is_utf8(parts[3]) == 0) {
                throw "io_error: unreadable file entry";
            }
            return entryItem(parts[0], parts[1], parts[2], parts[3]);
        });
        command("fs.exists", closure Command [] (Item args) {
            string path = requiredString(args, "path");
            string record = "";
            int status = app_fs_stat(path, record);
            if (status == 2) {
                return createBool(false);
            }
            fsCheck(status, "cannot stat " + path);
            return createBool(true);
        });
        command("fs.mkdir", closure Command [] (Item args) {
            string path = requiredString(args, "path");
            bool parents = optionalBool(args, "parents", false);
            int flag = 0;
            if (parents) {
                flag = 1;
            }
            int status = app_fs_mkdir(path, flag);
            if (!(parents && status == 6)) {
                fsCheck(status, "cannot create " + path);
            }
            return createNull();
        });
        command("fs.remove", closure Command [] (Item args) {
            string path = requiredString(args, "path");
            fsCheck(app_fs_remove(path), "cannot remove " + path);
            return createNull();
        });
    }

    // At most n async jobs run at the same time (the rest wait in a queue, oldest first); 0 = the default,
    // max(4, number of cores). A job is never dropped: on exit every queued job still runs.
    void setWorkerLimit(int n) {
        cling::setWorkerLimit(n);
    }

    // Opens the window. false if it could not be created (the shim has printed why on stderr).
    bool open(string title, int width, int height, string html, string bridgeJs, bool debug) {
        int d = 0;
        if (debug) {
            d = 1;
        }
        handle = app_open(title, width, height, html, bridgeJs, d);
        return handle != 0;
    }

    // Opens the window on the page embedded at build time, with the standard bridge script.
    bool openPage(string title, int width, int height, bool debug) {
        return open(title, width, height, app_page_html(), app_bridge_js(), debug);
    }

    // Serves calls until the window closes. Returns how many calls were answered.
    int run() {
        int served = 0;
        string id = "";
        string request = "";
        while (true) {
            int r = app_next_call(handle, -1, id, request);
            if (r == 0) {
                break;
            }
            if (r == 1) {
                Reply reply = dispatcher.handle(handle, id, request);
                if (reply.status != 2) {
                    app_return(handle, id, reply.status, reply.json);
                }
                served = served + 1;
            }
        }
        return served;
    }

    void quit() {
        app_terminate(handle);
    }

    void close() {
        app_close(handle);
        handle = 0;
    }
};
