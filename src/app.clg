// app-cling -- the CeeLing layer: command table, dispatch and the run loop.
//
// This is the part of an app-cling program that CeeLing checks, and it holds every decision: which files a page may reach
// (files.clg), which programs it may start, what a dialog may say, what a folder watch reports. The native layer (shim/) only
// opens, runs, shows and waits, behind the `ext_fn`s below, and is trusted, not checked.
//
// A command is a class with one virtual method, `call(Item args)`, that returns the JSON value to send back
// (or throws a string, which becomes a rejected promise). Register one with a closure:
//
//     app.command("add", closure Command [] (Item args) {
//         return createNumber(getArrayItem(args, 0).valuedouble + getArrayItem(args, 1).valuedouble);
//     });
#include "cjson_item.clh"
#include "cjson_api.clh"
#include "cjson_parse.clh"
#include "cjson_print.clh"
#include "text.clh"
#include "core.clh"
#include "files.clh"
#include "assets.clh"

ext_fn int app_open(string title, int width, int height, string html, string url, string initJs, int debug);
ext_fn int app_next_call(int handle, int timeoutMs, ref string id, ref string request);
ext_fn int app_push(int handle, string id, string request, int maxQueued);
ext_fn int app_terminate(int handle);
ext_fn int app_close(int handle);
ext_fn int app_window_title(int handle, string title);
ext_fn int app_window_size(int handle, int width, int height);
ext_fn int app_window_state(int handle, int state);
ext_fn int app_window_guard(int handle, int on);
ext_fn int app_cancel(int handle, string call);
ext_fn int app_cancel_all(int handle);
ext_fn int app_pending(int handle, string call);
ext_fn int app_limits(int handle, int maxRequest, int maxQueued);
ext_fn int app_navigation_allow(int handle, std::vector<string> prefixes);
ext_fn int app_watch_start(int handle, string root, int recursive, ref int watchId);
ext_fn int app_watch_stop(int handle, int watchId);
ext_fn int app_os_windows();
ext_fn int app_os_env(string name, ref string out);
ext_fn int app_os_path_kind(string path);
ext_fn double app_now_ms();
ext_fn int app_proc_run(int handle, string call, string exe, std::vector<string> args, string cwd, std::vector<string> env, int timeoutMs, int maxBytes, ref string out, ref string err, ref int exitCode, ref int flags);
ext_fn int app_dialog_pick(int handle, int mode, string title, string defaultName, string defaultExt, std::vector<string> filters, ref string path);
ext_fn int app_dialog_message(int handle, string title, string message, int kind, int buttons);
// the page and the bridge script, compiled into the program by scripts/build.sh
ext_fn string app_page_html();
ext_fn string app_bridge_js();
ext_fn string app_extra_js();

class Dispatcher {
public:
    std::vector<string> names;
    std::vector<Command> handlers;
    std::vector<string> asyncNames;
    std::vector<AsyncCommand> asyncHandlers;
    // How long the page waits for an async command before it is answered {code: "timed_out"} (0 = as long as it takes), per command name
    // with a default for the rest, and the calls that are waiting against their deadline.
    std::vector<string> timeoutNames;
    std::vector<int> timeoutValues;
    int defaultTimeoutMs;
    std::vector<string> dueIds;
    std::vector<double> dueAt;
    // The tag a page gave an async call (cling.invoke(..., {signal})) and the call it names, newest last, at most 256 of them.
    std::vector<string> tags;
    std::vector<string> tagCalls;

    // The commands this window's page may call, once restrict() has been used (before that: every registered command). Anything else
    // is answered {code: "forbidden"}, whether or not such a command exists, so the page cannot probe for names.
    std::vector<string> allowed;
    bool restricted;

    Dispatcher() {
        defaultTimeoutMs = 0;
        restricted = false;
    }

    bool mayCall(string name) {
        if (!restricted) {
            return true;
        }
        int i = 0;
        while (i < allowed.size()) {
            if (allowed[i] == name) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    int timeoutFor(string name) {
        int i = 0;
        while (i < timeoutNames.size()) {
            if (timeoutNames[i] == name) {
                return timeoutValues[i];
            }
            i = i + 1;
        }
        return defaultTimeoutMs;
    }

    void setTimeout(string name, int ms) {
        int i = 0;
        while (i < timeoutNames.size()) {
            if (timeoutNames[i] == name) {
                timeoutValues[i] = ms;
                return;
            }
            i = i + 1;
        }
        timeoutNames.push_back(name);
        timeoutValues.push_back(ms);
    }

    void rememberTag(string tag, string call) {
        if (tags.size() >= 256) {
            int i = 0;
            while (i + 1 < tags.size()) {
                tags[i] = tags[i + 1];
                tagCalls[i] = tagCalls[i + 1];
                i = i + 1;
            }
            tags.pop_back();
            tagCalls.pop_back();
        }
        tags.push_back(tag);
        tagCalls.push_back(call);
    }

    // The page abandons the call it tagged: the work is told to stop. Unknown or finished tags are ignored.
    void cancelTag(int handle, string tag) {
        int i = 0;
        while (i < tags.size()) {
            if (tags[i] == tag) {
                app_cancel(handle, tagCalls[i]);
                return;
            }
            i = i + 1;
        }
    }

    void dropDue(int index) {
        int last = dueIds.size() - 1;
        if (index != last) {
            dueIds[index] = dueIds[last];
            dueAt[index] = dueAt[last];
        }
        dueIds.pop_back();
        dueAt.pop_back();
    }

    // Answers every call whose time is up {code: "timed_out"} and tells the work to stop (callCancelled, and a program it started is
    // killed). A call that was answered meanwhile is just forgotten; the late answer of a job that kept going is dropped by the shim
    // (a page call is answered once).
    void sweep(int handle) {
        double now = app_now_ms();
        int i = dueIds.size() - 1;
        while (i >= 0) {
            string id = dueIds[i];
            if (app_pending(handle, id) == 0) {
                dropDue(i);
            } else if (now >= dueAt[i]) {
                replyError(handle, id, "timed_out", "the command took longer than the application allows");
                app_cancel(handle, id);      // (after the reply: replying forgets a cancel; the job's own late reply forgets this one)
                dropDue(i);
            }
            i = i - 1;
        }
    }

    // Milliseconds until the first deadline, or -1 if no call is waiting against one.
    int nextDueMs() {
        if (dueAt.size() == 0) {
            return -1;
        }
        double now = app_now_ms();
        double first = dueAt[0];
        int i = 1;
        while (i < dueAt.size()) {
            if (dueAt[i] < first) {
                first = dueAt[i];
            }
            i = i + 1;
        }
        if (first <= now) {
            return 0;
        }
        return int(first - now);
    }

    void add(string name, Command handler) {
        names.push_back(name);
        handlers.push_back(handler);
    }

    void addAsync(string name, AsyncCommand handler) {
        asyncNames.push_back(name);
        asyncHandlers.push_back(handler);
    }

    // The index of the async command called `name`, or -1.
    int indexOfAsync(string name) {
        int i = 0;
        while (i < asyncNames.size()) {
            if (asyncNames[i] == name) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    // The index of the command called `name`, or -1.
    int indexOf(string name) {
        int i = 0;
        while (i < names.size()) {
            if (names[i] == name) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    // One request in, one reply out. Never throws and never aborts on a malformed request: a bad
    // request is a rejected promise, not a dead application. For an async command the reply has status 2
    // ("deferred"): nothing is sent now, the worker answers later.
    Reply handle(int appHandle, string id, string request) {
        Item parsed = parse(request);
        if (parsed == nullptr) {
            return new Reply(1, errorJson("bad_request", "the request is not valid JSON"));
        }
        if (!isArray(parsed) || getArraySize(parsed) < 1) {
            return new Reply(1, errorJson("bad_request", "the request must be a JSON array [command, args]"));
        }
        Item nameItem = getArrayItem(parsed, 0);
        if (!isString(nameItem)) {
            return new Reply(1, errorJson("bad_request", "the command name must be a string"));
        }
        if (nameItem.valuestring == "$cancel") {
            Item which = getArrayItem(parsed, 1);
            if (which != nullptr && isString(which) && which.valuestring.length() <= 64) {
                cancelTag(appHandle, which.valuestring);
            }
            return new Reply(0, "null");
        }
        string tag = "";
        Item tagItem = getArrayItem(parsed, 2);
        if (tagItem != nullptr && isString(tagItem) && tagItem.valuestring.length() <= 64) {
            tag = tagItem.valuestring;
        }
        if (!mayCall(nameItem.valuestring)) {
            return new Reply(1, errorJson("forbidden", "this window may not call that command"));
        }
        int index = indexOf(nameItem.valuestring);
        int asyncIndex = indexOfAsync(nameItem.valuestring);
        if (index < 0 && asyncIndex < 0) {
            return new Reply(1, errorJson("unknown_command", "no command named " + nameItem.valuestring));
        }
        Item args = getArrayItem(parsed, 1);
        if (args == nullptr) {
            args = createNull();
        }
        if (index < 0) {
            try {
                AsyncCommand starter = asyncHandlers[asyncIndex];
                // every job this start() spawns inherits this: a throw inside it rejects the page's promise
                onJobFailure(closure Failure [id, appHandle] (string message) {
                    replyError(appHandle, id, errorCodeOf(message), errorTextOf(message));
                });
                starter.start(args, id, appHandle);
                cling::clearJobFailure();
                if (tag.length() > 0) {
                    rememberTag(tag, id);
                }
                int limitMs = timeoutFor(nameItem.valuestring);
                if (limitMs > 0) {
                    dueIds.push_back(id);
                    dueAt.push_back(app_now_ms() + double(limitMs));
                }
                return new Reply(2, "");
            } catch (string message) {
                cling::clearJobFailure();
                return new Reply(1, errorJson(errorCodeOf(message), errorTextOf(message)));
            }
        }
        try {
            // (a local first: the checker cannot resolve a method call made directly on `handlers[index]`)
            Command handler = handlers[index];
            Item result = handler.call(args);
            if (result == nullptr) {
                return new Reply(0, "null");
            }
            string text = printUnformatted(result);
            if (text.length() == 0) {
                return new Reply(1, errorJson("command_failed", "the command returned a value that cannot be printed"));
            }
            return new Reply(0, text);
        } catch (string message) {
            return new Reply(1, errorJson(errorCodeOf(message), errorTextOf(message)));
        }
        return new Reply(1, errorJson("internal", "unreachable"));
    }
};

// ---- file commands --------------------------------------------------------------------------------
// The allowed folders and every check on a path live in FileGate (files.clg), which decides on what the operating system
// actually opened. These helpers only map its status codes to error codes and shape the JSON.

string fsCodeFor(int status) {
    if (status == 1) { return "forbidden"; }
    if (status == 2) { return "not_found"; }
    if (status == 3) { return "too_large"; }
    if (status == 5) { return "invalid_path"; }
    if (status == 6) { return "already_exists"; }
    if (status == 7) { return "not_empty"; }
    if (status == 8) { return "is_directory"; }
    if (status == 9) { return "not_directory"; }
    if (status == 10) { return "permission_denied"; }
    if (status == 11) { return "too_many"; }
    return "io_error";
}

void fsCheck(int status, string what) {
    if (status != 0) {
        string message = fsCodeFor(status) + ": " + what;
        throw message;
    }
}

string kindName(string code) {
    if (code == "d") { return "dir"; }
    if (code == "l") { return "link"; }
    return "file";
}

// {name, kind: "file" | "dir" | "link", size, modified (seconds since 1970)}
Item entryItem(string kind, string size, string modified, string name) {
    Item e = createObject();
    addStringToObject(e, "name", name);
    addStringToObject(e, "kind", kindName(kind));
    addNumberToObject(e, "size", decimalValue(size));
    addNumberToObject(e, "modified", decimalValue(modified));
    return e;
}

// ---- dialog commands ------------------------------------------------------------------------------
// The user's choice in a native dialog is a grant: exactly the file (or folder) they picked becomes reachable through
// the file commands, and nothing around it. A page cannot reach a file it has not been given, by the app or by the
// user; and a dialog is the only way the user can give one. What a dialog may say is decided here: the native layer shows
// whatever it is handed.

bool extensionOk(string e) {
    if (e.length() == 0 || e.length() > 16) {
        return false;
    }
    int i = 0;
    while (i < e.length()) {
        char c = e[i];
        bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '-';
        if (!ok) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// a file name with no folder in it and none of the characters Windows refuses
bool plainFileName(string name) {
    if (name.length() == 0 || !plainText(name, 200) || name == "." || name == "..") {
        return false;
    }
    int i = 0;
    while (i < name.length()) {
        char c = name[i];
        if (int(c) >= 0 && int(c) < 32) {
            return false;
        }
        if (c == '/' || c == '\\' || c == ':' || c == '*' || c == '?' || c == '"' || c == '<' || c == '>' || c == '|') {
            return false;
        }
        i = i + 1;
    }
    return true;
}

string dialogTitle(Item args) {
    string title = optionalString(args, "title", "");
    if (!plainText(title, 200)) {
        throw "invalid_argument: `title` must be plain text of at most 200 bytes";
    }
    return title;
}

// [{name: "Text", extensions: ["txt", "md"]}, {name: "Everything"}] -> label, pattern, label, pattern ... ("*.txt;*.md", "*.*")
std::vector<string> filterList(Item args) {
    std::vector<string> out;
    Item list = getObjectItem(objectArg(args), "filters");
    if (list == nullptr) {
        return out;
    }
    if (!isArray(list)) {
        throw "invalid_argument: `filters` must be an array";
    }
    if (getArraySize(list) > 20) {
        throw "invalid_argument: at most 20 filters";
    }
    int i = 0;
    while (i < getArraySize(list)) {
        Item f = getArrayItem(list, i);
        Item name = nullptr;
        if (isObject(f)) {
            name = getObjectItem(f, "name");
        }
        if (name == nullptr || !isString(name)) {
            throw "invalid_argument: every filter needs a string `name`";
        }
        if (name.valuestring.length() == 0 || !plainText(name.valuestring, 80)) {
            throw "invalid_argument: a filter `name` must be plain text of 1 to 80 bytes";
        }
        string pattern = "*.*";
        Item exts = getObjectItem(f, "extensions");
        if (exts != nullptr) {
            if (!isArray(exts)) {
                throw "invalid_argument: `extensions` must be an array of strings";
            }
            if (getArraySize(exts) > 0) {
                pattern = "";
                int j = 0;
                while (j < getArraySize(exts)) {
                    Item e = getArrayItem(exts, j);
                    if (!isString(e) || !extensionOk(e.valuestring)) {
                        throw "invalid_argument: an extension is 1 to 16 letters, digits, _ or -";
                    }
                    if (j > 0) {
                        pattern = pattern + ";";
                    }
                    pattern = pattern + "*." + e.valuestring;
                    j = j + 1;
                }
            }
        }
        out.push_back(name.valuestring);
        out.push_back(pattern);
        i = i + 1;
    }
    return out;
}

// the first extension of the first filter, which a "save as" dialog appends to a name typed without one
string defaultExtension(Item args) {
    Item list = getObjectItem(objectArg(args), "filters");
    if (list == nullptr || !isArray(list) || getArraySize(list) == 0) {
        return "";
    }
    Item exts = getObjectItem(getArrayItem(list, 0), "extensions");
    if (exts == nullptr || !isArray(exts) || getArraySize(exts) == 0) {
        return "";
    }
    Item first = getArrayItem(exts, 0);
    if (first == nullptr || !isString(first)) {
        return "";
    }
    return first.valuestring;
}

// What the worker that showed a dialog sends the main loop when the user chose something: the main loop applies the grant
// (the allow-list is touched by one thread only) and answers the page.
string pickRecord(string id, bool folder, string chosen) {
    string record = "pick";
    record.push_back(char(0));
    record = record + id;
    record.push_back(char(0));
    if (folder) {
        record.push_back('1');
    } else {
        record.push_back('0');
    }
    record.push_back(char(0));
    record = record + chosen;
    record.push_back(char(0));
    return record;
}

// Runs on the worker that showed the dialog.
void finishPick(int handle, string id, int status, string chosen, bool folder) {
    if (status == 0) {
        replyOk(handle, id, "null");
    } else if (status < 0) {
        replyError(handle, id, "unsupported", "the dialog could not be shown");
    } else if (app_push(handle, "", pickRecord(id, folder, chosen), 100000) != 1) {
        replyError(handle, id, "busy", "the application is not keeping up");
    }
}

string buttonName(int button) {
    if (button == 1) { return "ok"; }
    if (button == 3) { return "yes"; }
    if (button == 4) { return "no"; }
    return "cancel";
}

int dialogKind(string kind) {
    if (kind == "info") { return 0; }
    if (kind == "warning") { return 1; }
    if (kind == "error") { return 2; }
    if (kind == "question") { return 3; }
    return -1;
}

int dialogButtons(string buttons) {
    if (buttons == "ok") { return 0; }
    if (buttons == "okcancel") { return 1; }
    if (buttons == "yesno") { return 2; }
    return -1;
}

// ---- program commands -----------------------------------------------------------------------------
// The application declares WHICH programs may run and with what arguments (allowProgram); a page can only ask for one
// of them by name and fill in the named slots of its argument template. It never supplies a program name, a command
// line or an option: there is no shell, every argument is a separate string, and a slot value that could be read as an
// option (a leading '-') is refused when the slot is a whole argument. The shim (app_proc.cpp) runs the program with no
// stdin, a time limit, an output cap, and kills everything it started.
//
//     app.allowProgram("git.log", "git",
//         ["log", "-n", "{count:int:1:500}", "--format=%H%x09%s", "--", "{file:file}", "@cwd={repo:folder}"], 10000, 1000000);
//     // page:  cling.proc.run({ program: "git.log", args: { count: 20, repo: ".", file: "src/a.txt" } })
//
// An argument is literal text, or literal text around ONE slot  {name:kind[:a[:b]]}  with kind
//   int:min:max   a whole number from min to max        token   letters, digits and . _ - / @ ~ ^ + = (max 200)
//   text:maxLen   any text of at most maxLen bytes      file / folder / path   an existing file, folder or either that
//                                                       the file commands could reach (passed as its absolute path)
// The element "@cwd={name:folder}" (at most one) names the working folder; without it the program runs in the first
// folder the application allowed.

class ProgramSpec {
public:
    string name;
    string exe;
    std::vector<string> elements;
    std::vector<string> slotNames;
    int timeoutMs;
    int maxBytes;
    ProgramSpec(string n, string e, int t, int m) {
        name = n;
        exe = e;
        timeoutMs = t;
        maxBytes = m;
    }
};

// The environment a program gets: ONLY these variables of this process, if they are set (a program started from an application that
// holds a token in its environment must not inherit the token). passEnvironment adds names.
class ProgramRegistry {
public:
    std::vector<ProgramSpec> specs;
    std::vector<string> envNames;
    ProgramRegistry() {
        std::vector<string> base = splitOn("PATH,SystemRoot,SYSTEMDRIVE,windir,TEMP,TMP,TMPDIR,LANG,LC_ALL,HOME,USERPROFILE", ',');
        envNames = base;
    }

    // NAME=value for each of the names that is set
    std::vector<string> environment() {
        std::vector<string> env;
        int i = 0;
        while (i < envNames.size()) {
            string value = "";
            if (app_os_env(envNames[i], value) == 1 && plainText(value, 30000)) {
                env.push_back(envNames[i] + "=" + value);
            }
            i = i + 1;
        }
        return env;
    }

    int indexOf(string name) {
        int i = 0;
        while (i < specs.size()) {
            ProgramSpec spec = specs[i];
            if (spec.name == name) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }
};

// "count:int:1:500", "ref:token", "msg:text:80", "f:file" -- is the slot text well formed?
bool slotSpecOk(string text) {
    std::vector<string> p = splitOn(text, ':');
    if (p.size() < 2) {
        return false;
    }
    string slotName = p[0];
    if (slotName.length() == 0 || slotName.length() > 40) {
        return false;
    }
    int i = 0;
    while (i < slotName.length()) {
        char c = slotName[i];
        bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
        if (!ok) {
            return false;
        }
        i = i + 1;
    }
    if (p[1] == "int") {
        return p.size() == 4 && isDigits(p[2]) && isDigits(p[3]) && decimalValue(p[2]) <= decimalValue(p[3]);
    }
    if (p[1] == "text") {
        return p.size() == 3 && isDigits(p[2]) && decimalValue(p[2]) >= 1.0 && decimalValue(p[2]) <= 100000.0;
    }
    if (p[1] == "token" || p[1] == "file" || p[1] == "folder" || p[1] == "path") {
        return p.size() == 2;
    }
    return false;
}

// where the slot sits in an element: the index of '{' (or -1) -- an element has at most one, and it must close
int slotOpen(string element) {
    return indexOfChar(element, '{');
}

int slotClose(string element) {
    return indexOfChar(element, '}');
}

void argError(string name, string what) {
    string message = "invalid_argument: `" + name + "` " + what;
    throw message;
}

bool tokenChar(char c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '.' || c == '_' || c == '-' ||
           c == '/' || c == '@' || c == '~' || c == '^' || c == '+' || c == '=';
}

// The checked text for one slot. `whole` = the slot is the entire argument, so a leading '-' could be read as an option.
string slotValue(FileGate gate, string slotText, Item args, bool whole) {
    std::vector<string> p = splitOn(slotText, ':');
    string name = p[0];
    string kind = p[1];
    Item v = getObjectItem(args, name);
    if (v == nullptr) {
        argError(name, "is missing");
        return "";
    }
    if (kind == "int") {
        if (!isNumber(v)) {
            argError(name, "must be a number");
            return "";
        }
        double x = v.valuedouble;
        double lo = decimalValue(p[2]);
        double hi = decimalValue(p[3]);
        if (x != double(int(x)) || x < lo || x > hi) {
            argError(name, "must be a whole number from " + p[2] + " to " + p[3]);
            return "";
        }
        return intToString(int(x));
    }
    if (!isString(v)) {
        argError(name, "must be a string");
        return "";
    }
    string text = v.valuestring;
    if (kind == "token") {
        if (text.length() == 0 || text.length() > 200) {
            argError(name, "must be 1 to 200 characters");
            return "";
        }
        int i = 0;
        while (i < text.length()) {
            if (!tokenChar(text[i])) {
                argError(name, "may only contain letters, digits and . _ - / @ ~ ^ + =");
                return "";
            }
            i = i + 1;
        }
    } else if (kind == "text") {
        if (text.length() > int(decimalValue(p[2]))) {
            argError(name, "is too long");
            return "";
        }
        if (!plainText(text, 100000)) {
            argError(name, "must be plain text");
            return "";
        }
    } else {
        int want = 0;
        if (kind == "file") {
            want = 1;
        } else if (kind == "folder") {
            want = 2;
        }
        FsResult found = gate.resolve(text, want);
        if (found.status != 0) {
            string message = fsCodeFor(found.status) + ": cannot use " + text;
            throw message;
        }
        return found.text;
    }
    if (whole && text.length() > 0 && text[0] == '-') {
        argError(name, "must not start with '-'");
        return "";
    }
    return text;
}

// The element with its slot replaced by the checked value.
string renderElement(FileGate gate, string element, Item args) {
    int open = slotOpen(element);
    if (open < 0) {
        return element;
    }
    int close = slotClose(element);
    string slotText = element.substr(open + 1, close - open - 1);
    bool whole = open == 0 && close == element.length() - 1;
    string value = slotValue(gate, slotText, args, whole);
    return element.substr(0, open) + value + element.substr(close + 1, element.length() - close - 1);
}

// Replies for a finished program: {exitCode, stdout, stderr, timedOut, truncated: {stdout, stderr}, lossy}.
// Runs on the worker that ran it.
void finishRun(int handle, string id, int status, string out, string err, int exitCode, int flags) {
    if (status == 0 && ((flags / 8) % 2) == 1) {
        replyError(handle, id, "cancelled", "the call was abandoned or the window is closing");
    } else if (status == 0) {
        Item result = createObject();
        string cleanOut = cleanUtf8(out);
        string cleanErr = cleanUtf8(err);
        addNumberToObject(result, "exitCode", double(exitCode));
        addStringToObject(result, "stdout", cleanOut);
        addStringToObject(result, "stderr", cleanErr);
        addBoolToObject(result, "timedOut", (flags % 2) == 1);
        Item cut = addObjectToObject(result, "truncated");
        addBoolToObject(cut, "stdout", ((flags / 2) % 2) == 1);
        addBoolToObject(cut, "stderr", ((flags / 4) % 2) == 1);
        addBoolToObject(result, "lossy", cleanOut != out || cleanErr != err);
        replyOk(handle, id, printUnformatted(result));
    } else if (status == 2) {
        replyError(handle, id, "program_not_found", "the program or its working folder does not exist");
    } else if (status == 5) {
        replyError(handle, id, "invalid_argument", "the arguments could not be passed to the program");
    } else {
        replyError(handle, id, "spawn_failed", "the program could not be started");
    }
}

bool programNameOk(string name) {
    if (name.length() == 0 || name.length() > 60) {
        return false;
    }
    int i = 0;
    while (i < name.length()) {
        char c = name[i];
        bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '.' || c == '_' || c == '-';
        if (!ok) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// The slot text inside an element's braces, or "" if it has none (-1: malformed braces).
int elementSlotCheck(string element) {
    int open = slotOpen(element);
    int close = slotClose(element);
    if (open < 0 && close < 0) {
        return 0;
    }
    if (open < 0 || close < open) {
        return -1;
    }
    string slotText = element.substr(open + 1, close - open - 1);
    string rest = element.substr(0, open) + element.substr(close + 1, element.length() - close - 1);
    if (indexOfChar(rest, '{') >= 0 || indexOfChar(rest, '}') >= 0) {
        return -1;
    }
    if (!slotSpecOk(slotText)) {
        return -1;
    }
    return 1;
}

// ---- finding a program ----------------------------------------------------------------------------
// `name` is an absolute path to a program (a plain .exe on Windows), or a bare name ("git") that is searched for on PATH ONLY: never
// the current folder, never the folder of the running program, and ("" and relative entries of PATH mean the current folder) never
// a PATH entry that is not absolute. Anything else is refused. Windows note: the arguments are joined into one command line with the
// C runtime's quoting rules, and a program that parses its command line differently (cmd.exe, and so every .bat / .cmd, msiexec,
// ...) could read them differently, so only .exe is accepted. Status: 0 found (text = absolute path), 2 not found, 5 refused.

bool windowsAbsolute(string w) {
    if (isDriveAbsolute(w)) {
        return true;
    }
    return w.length() >= 3 && isSeparator(w[0]) && isSeparator(w[1]) && w[2] != '?' && w[2] != '.';
}

bool endsWithExe(string w) {
    return w.length() >= 4 && lowerAscii(w.substr(w.length() - 4, 4)) == ".exe";
}

// no "." or ".." component in an absolute path
bool plainComponents(string path) {
    std::vector<string> parts = splitOn(path, '/');
    std::vector<string> more = splitOn(path, '\\');
    int i = 0;
    while (i < parts.size()) {
        if (parts[i] == "." || parts[i] == "..") {
            return false;
        }
        i = i + 1;
    }
    int k = 0;
    while (k < more.size()) {
        if (more[k] == "." || more[k] == "..") {
            return false;
        }
        k = k + 1;
    }
    return true;
}

bool runnable(string path, bool windows) {
    int kind = app_os_path_kind(path);
    if (windows) {
        return (kind & 3) == 1;
    }
    return (kind & 5) == 5;
}

FsResult resolveProgram(string name) {
    bool windows = app_os_windows() == 1;
    if (name.length() == 0 || !plainText(name, 4000)) {
        return new FsResult(5, "");
    }
    bool hasSeparator = indexOfChar(name, '/') >= 0 || (windows && (indexOfChar(name, '\\') >= 0 || indexOfChar(name, ':') >= 0));
    if (hasSeparator) {
        if (windows) {
            if (!windowsAbsolute(name) || !endsWithExe(name) || indexOfChar(name.substr(2, name.length() - 2), ':') >= 0) {
                return new FsResult(5, "");
            }
        } else if (name[0] != '/') {
            return new FsResult(5, "");
        }
        if (!plainComponents(name)) {
            return new FsResult(5, "");
        }
        if (!runnable(name, windows)) {
            return new FsResult(2, "");
        }
        return new FsResult(0, name);
    }
    int i = 0;
    while (i < name.length()) {
        char c = name[i];
        bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '.' || c == '_' || c == '-';
        if (!ok) {
            return new FsResult(5, "");
        }
        i = i + 1;
    }
    if (name == "." || name == "..") {
        return new FsResult(5, "");
    }
    string file = name;
    char listSeparator = ':';
    string slash = "/";
    if (windows) {
        listSeparator = ';';
        slash = "\\";
        if (!endsWithExe(name)) {
            file = name + ".exe";
        }
    }
    string path = "";
    if (app_os_env("PATH", path) != 1) {
        return new FsResult(2, "");
    }
    std::vector<string> dirs = splitOn(path, listSeparator);
    int d = 0;
    while (d < dirs.size()) {
        string dir = dirs[d];
        d = d + 1;
        if (windows && dir.length() >= 2 && dir[0] == '"' && dir[dir.length() - 1] == '"') {
            dir = dir.substr(1, dir.length() - 2);
        }
        bool absolute = dir.length() > 0 && dir[0] == '/';
        if (windows) {
            absolute = windowsAbsolute(dir);
        }
        if (!absolute) {
            continue;
        }
        while (dir.length() > 3 && (dir[dir.length() - 1] == '/' || dir[dir.length() - 1] == '\\')) {
            dir = dir.substr(0, dir.length() - 1);
        }
        string candidate = dir + slash + file;
        if (dir[dir.length() - 1] == '/' || dir[dir.length() - 1] == '\\') {
            candidate = dir + file;
        }
        if (runnable(candidate, windows)) {
            return new FsResult(0, candidate);
        }
    }
    return new FsResult(2, "");
}

// "replace" (default), "append" or "create" as the numbers FileGate.write takes
int writeMode(Item args) {
    string mode = optionalString(args, "mode", "replace");
    if (mode == "append") {
        return 1;
    }
    if (mode == "create") {
        return 2;
    }
    if (mode != "replace") {
        throw "invalid_argument: `mode` must be \"replace\", \"append\" or \"create\"";
    }
    return 0;
}

// the folders above `path` that do not exist yet (inside an allowed place, like everything else)
void makeParents(FileGate files, string path) {
    FsResult n = files.normalize(path, true, true);
    fsCheck(n.status, "cannot write " + path);
    int st = files.mkdir(files.parentOf(n.text), true);
    if (st != 6) {
        fsCheck(st, "cannot create the folder for " + path);
    }
}

// ---- programs the application runs itself -------------------------------------------------------------------------------
// A command that is the application's own (not a page's choice from the allowProgram table) runs a program like this: the main thread
// builds a ToolRun from values it has vetted, a worker calls runTool, and the worker answers the page (or sends the main loop a
// `Later` record when the answer needs the main thread, which alone may touch the file policy). Both structs hold plain values only,
// so they can be copied into a worker.
struct ToolRun {
public:
    int handle;              // the window and page call this run belongs to: cancelling the call (or closing the window) kills the program
    string call;
    string exe;
    std::vector<string> args;
    string cwd;
    std::vector<string> env;
    int timeoutMs;
    int maxBytes;
    ToolRun(string e, string c, int t, int m) {
        handle = 0;
        call = "";
        exe = e;
        cwd = c;
        timeoutMs = t;
        maxBytes = m;
    }
};

struct ToolResult {
public:
    int status;              // 0 it ran; else the native status (2 program or folder missing, 4 could not start, 5 refused)
    string out;
    string err;
    int exitCode;
    int flags;               // 1 timed out, 2 stdout cut, 4 stderr cut
    ToolResult() {
        status = 0;
        exitCode = 0;
        flags = 0;
    }
    // ran, did not time out, exited 0
    bool succeeded() {
        return status == 0 && (flags % 2) == 0 && exitCode == 0;
    }
    // what to tell the page when it did not succeed: the program's own complaint, else the reason
    string complaint() {
        if (status == 2) {
            return "program_not_found: the program or its working folder does not exist";
        }
        if (status != 0) {
            return "spawn_failed: the program could not be started";
        }
        if ((flags % 2) == 1) {
            return "timed_out: the program took too long";
        }
        if (((flags / 8) % 2) == 1) {
            return "cancelled: the call was abandoned or the window is closing";
        }
        string text = trimText(cleanUtf8(err));
        if (text.length() == 0) {
            text = trimText(cleanUtf8(out));
        }
        if (text.length() == 0) {
            text = "the program exited with code " + intToString(exitCode);
        }
        return "command_failed: " + text;
    }
};

ToolResult runTool(ToolRun run) {
    ToolResult r = new ToolResult();
    r.status = app_proc_run(run.handle, run.call, run.exe, run.args, run.cwd, run.env, run.timeoutMs, run.maxBytes, r.out, r.err, r.exitCode, r.flags);
    return r;
}

// runTool, or throws the complaint ("code: message") when the program could not run, timed out or exited non-zero. For use in a worker's job:
// a throw there rejects the page's promise with that code and message.
ToolResult runToolOrThrow(ToolRun run) {
    ToolResult r = runTool(run);
    if (!r.succeeded()) {
        string complaint = r.complaint();
        throw complaint;
    }
    return r;
}

// ---- background work whose last step needs the main thread -----------------------------------------------------------
// The file policy (FileGate) and every other piece of state belongs to the main thread, so a worker that has to read or write a file
// after its program has finished cannot do it itself. It sends the main loop a record instead: finishLater(handle, id, status, text).
// The command registered a `Later` for that page call (App.later); the main loop runs its `done` with the worker's result.
class Later {
public:
    Later() { }
    virtual void done(int handle, string id, int status, string payload) { }
};

class LaterBook {
public:
    std::vector<string> ids;
    std::vector<Later> items;
    LaterBook() { }
    int indexOf(string id) {
        int i = 0;
        while (i < ids.size()) {
            if (ids[i] == id) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }
    void drop(int index) {
        int last = ids.size() - 1;
        if (index != last) {
            ids[index] = ids[last];
            items[index] = items[last];
        }
        ids.pop_back();
        items.pop_back();
    }
};

// Runs on the worker: status 0 means `payload` is the JSON for the page, anything else means it is "code: message".
void finishLater(int handle, string id, int status, string payload) {
    string record = "later";
    record.push_back(char(0));
    record = record + id;
    record.push_back(char(0));
    record = record + intToString(status);
    record.push_back(char(0));
    record = record + payload;
    record.push_back(char(0));
    if (app_push(handle, "", record, 100000) != 1) {
        replyError(handle, id, "busy", "the application is not keeping up");
    }
}

// ---- watching folders -----------------------------------------------------------------------------
// fs.watch {path, recursive?} starts a watch and answers {id}; changes then arrive on the page as "fs.change" events
//     {watch: id, kind: "created" | "modified" | "removed", path}              path is relative to the watched folder
//     {watch: id, kind: "renamed", path: newName, from: oldName}
//     {watch: id, kind: "overflow"}                                              events were lost: read the folder again
//     {watch: id, kind: "stopped", reason: "closed" | "access_revoked" | "folder_gone" | "failed"}   no more will come
// The native watcher thread queues one record per change (id empty: a page's own call always has one); this side merges bursts
// (a program saving a file touches it many times in a few milliseconds), re-checks the permission before every delivery, and
// ends a watch whose folder can no longer be reached. At most 32 watches at a time.

class WatchEvent {
public:
    string kind;
    string path;
    string from;
    WatchEvent(string k, string p, string f) {
        kind = k;
        path = p;
        from = f;
    }
};

class WatchState {
public:
    int id;
    string root;                       // canonical, as FileGate.resolve spelled it
    std::vector<WatchEvent> pending;   // merged, not yet delivered
    bool overflowed;
    double firstAt;                    // when the oldest pending event arrived
    double lastAt;                     // when the newest did
    WatchState(int watchId, string folder) {
        id = watchId;
        root = folder;
        overflowed = false;
        firstAt = 0.0;
        lastAt = 0.0;
    }

    void clearPending() {
        while (pending.size() > 0) {
            pending.pop_back();
        }
        overflowed = false;
    }

    // The same change again straight away, or one more "modified" for a file that already has one, adds nothing.
    void merge(string kind, string path, string from, double now) {
        if (pending.size() == 0) {
            firstAt = now;
        }
        lastAt = now;
        if (kind == "overflow") {
            overflowed = true;
            return;
        }
        int i = 0;
        while (i < pending.size()) {
            WatchEvent e = pending[i];
            bool same = e.kind == kind && e.path == path && e.from == from;
            if (same && (kind == "modified" || i == pending.size() - 1)) {
                return;
            }
            i = i + 1;
        }
        if (pending.size() >= 500) {
            overflowed = true;
            return;
        }
        pending.push_back(new WatchEvent(kind, path, from));
    }
};

void emitWatchEvent(int handle, int watch, string kind, string path, string from) {
    if (!isUtf8(path) || !isUtf8(from)) {
        return;
    }
    Item e = createObject();
    addNumberToObject(e, "watch", double(watch));
    addStringToObject(e, "kind", kind);
    if (kind == "stopped") {
        addStringToObject(e, "reason", path);
    } else if (kind != "overflow") {
        addStringToObject(e, "path", path);
        if (kind == "renamed") {
            addStringToObject(e, "from", from);
        }
    }
    emitEvent(handle, "fs.change", printUnformatted(e));
}

// All the watches of a window, with the logic that delivers them.
class Watches {
public:
    std::vector<WatchState> states;
    Watches() { }

    int indexOf(int id) {
        int i = 0;
        while (i < states.size()) {
            WatchState s = states[i];
            if (s.id == id) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    // (order does not matter: the last one takes the place of the dropped one)
    void drop(int index) {
        int last = states.size() - 1;
        if (index != last) {
            states[index] = states[last];
        }
        states.pop_back();
    }

    bool anyPending() {
        int i = 0;
        while (i < states.size()) {
            WatchState s = states[i];
            if (s.pending.size() > 0 || s.overflowed) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    // Delivers what a watch has merged so far, after checking that the folder can still be reached. If it cannot (the
    // permission was withdrawn, or the folder is gone) the watch ends: the thread is stopped and "stopped" is the last event.
    void flush(FileGate gate, int handle, int index) {
        WatchState s = states[index];
        FsResult now = gate.resolve(s.root, 2);
        if (now.status != 0 || now.text != s.root) {
            string reason = "access_revoked";
            if (now.status == 2) {
                reason = "folder_gone";
            }
            app_watch_stop(handle, s.id);
            emitWatchEvent(handle, s.id, "stopped", reason, "");
            drop(index);
            return;
        }
        int i = 0;
        while (i < s.pending.size()) {
            WatchEvent e = s.pending[i];
            emitWatchEvent(handle, s.id, e.kind, e.path, e.from);
            i = i + 1;
        }
        if (s.overflowed) {
            emitWatchEvent(handle, s.id, "overflow", "", "");
        }
        s.clearPending();
    }

    // Delivers every watch that has been quiet for 40 ms, or has been collecting for 400 ms.
    void flushQuiet(FileGate gate, int handle) {
        double now = app_now_ms();
        int i = states.size() - 1;
        while (i >= 0) {
            WatchState s = states[i];
            bool some = s.pending.size() > 0 || s.overflowed;
            if (some && (now - s.lastAt >= 40.0 || now - s.firstAt >= 400.0)) {
                flush(gate, handle, i);
            }
            i = i - 1;
        }
    }

    // A record from the native watcher: "watch" id kind path from.
    void onRecord(FileGate gate, int handle, std::vector<string> f) {
        if (f.size() < 5) {
            return;
        }
        int index = indexOf(int(decimalValue(f[1])));
        if (index < 0) {
            return;
        }
        WatchState s = states[index];
        string kind = f[2];
        if (kind == "stopped") {
            if (s.pending.size() > 0 || s.overflowed) {
                flush(gate, handle, index);
                index = indexOf(s.id);
            }
            if (index >= 0) {
                app_watch_stop(handle, s.id);
                emitWatchEvent(handle, s.id, "stopped", f[3], "");
                drop(index);
            }
            return;
        }
        s.merge(kind, f[3], f[4], app_now_ms());
    }
};

// ---- the window -----------------------------------------------------------------------------------
class WindowState {
public:
    int handle;
    bool dirty;                // the page says it has unsaved work (window.setDirty)
    bool confirming;           // a "close anyway?" box is open
    bool confirm;              // confirmClose was called: the close button asks (applied when the window exists)
    string closeTitle;
    string closeMessage;
    WindowState() {
        handle = 0;
        dirty = false;
        confirming = false;
        confirm = false;
        closeTitle = "";
        closeMessage = "";
    }
};

// A running application: a window plus a command table.
class App {
public:
    int handle;
    Dispatcher dispatcher;
    ProgramRegistry programs;
    LaterBook laters;
    FileGate gate;
    Watches watches;
    WindowState window;
    std::vector<string> navigation;    // addresses the window may load after the application's own page (allowNavigation)
    int maxRequestBytes;
    int maxQueuedCalls;
    string siteStart;          // the address the window opens on, when the program serves its own web files

    App() {
        handle = 0;
        dispatcher = new Dispatcher();
        programs = new ProgramRegistry();
        laters = new LaterBook();
        gate = new FileGate();
        cling::setExitGraceMs(5000);
        watches = new Watches();
        window = new WindowState();
        maxRequestBytes = 4194304;
        maxQueuedCalls = 256;
        siteStart = "";
    }

    void command(string name, Command handler) {
        dispatcher.add(name, handler);
    }

    void asyncCommand(string name, AsyncCommand handler) {
        dispatcher.addAsync(name, handler);
    }

    // Pushes an event to the page (see emitEvent). Safe to call from the main thread only through this method;
    // worker jobs use emitEvent with a captured handle.
    bool emit(string name, string payloadJson) {
        return emitEvent(handle, name, payloadJson);
    }

    // Adds a folder the page may reach through the file commands. Nothing is reachable until at least one is added;
    // a relative path from the page means "inside the first folder added". false if the folder does not exist.
    bool allowFolder(string dir) {
        return gate.allow(dir) == 0;
    }

    // Withdraws everything the user granted through dialogs (the folders added with allowFolder stay).
    void revokeGrants() {
        gate.revokeGrants();
    }

    // Registers fs.read, fs.write, fs.list, fs.stat, fs.exists, fs.mkdir and fs.remove. Every path is checked by the
    // FileGate against the folders added with allowFolder. fs.read refuses files larger than maxReadBytes and files that
    // are not valid UTF-8 (text only; binary needs its own command).
    void enableFileCommands(int maxReadBytes) {
        FileGate files = gate;
        command("fs.read", closure Command [files, maxReadBytes] (Item args) {
            string path = requiredString(args, "path");
            FsResult r = files.read(path, maxReadBytes);
            fsCheck(r.status, "cannot read " + path);
            if (!isUtf8(r.text)) {
                throw "not_text: the file is not valid UTF-8";
            }
            Item result = createObject();
            addStringToObject(result, "text", r.text);
            return result;
        });
        command("fs.write", closure Command [files] (Item args) {
            string path = requiredString(args, "path");
            string text = requiredString(args, "text");
            int code = writeMode(args);
            if (optionalBool(args, "parents", false)) {
                makeParents(files, path);
            }
            fsCheck(files.write(path, text, code), "cannot write " + path);
            return createNull();
        });
        // the same for bytes: {base64} instead of {text}; a binary file travels through JSON as base64 text
        command("fs.writeBytes", closure Command [files] (Item args) {
            string path = requiredString(args, "path");
            string encoded = requiredString(args, "base64");
            int code = writeMode(args);
            if (!isBase64(encoded)) {
                throw "invalid_argument: `base64` is not well-formed base64";
            }
            if (optionalBool(args, "parents", false)) {
                makeParents(files, path);
            }
            fsCheck(files.write(path, base64Decode(encoded), code), "cannot write " + path);
            return createNull();
        });
        command("fs.readBytes", closure Command [files, maxReadBytes] (Item args) {
            string path = requiredString(args, "path");
            FsResult r = files.read(path, maxReadBytes);
            fsCheck(r.status, "cannot read " + path);
            Item result = createObject();
            addStringToObject(result, "base64", base64Encode(r.text));
            return result;
        });
        command("fs.list", closure Command [files] (Item args) {
            string path = requiredString(args, "path");
            FsResult r = files.list(path);
            fsCheck(r.status, "cannot list " + path);
            std::vector<string> parts = splitFields(r.text);
            Item listing = createArray();
            int i = 0;
            while (i + 3 < parts.size()) {
                string name = parts[i + 3];
                if (isUtf8(name)) {
                    addItemToArray(listing, entryItem(parts[i], parts[i + 1], parts[i + 2], name));
                }
                i = i + 4;
            }
            return listing;
        });
        command("fs.stat", closure Command [files] (Item args) {
            string path = requiredString(args, "path");
            FsResult r = files.stat(path);
            fsCheck(r.status, "cannot stat " + path);
            std::vector<string> parts = splitFields(r.text);
            if (parts.size() < 4 || !isUtf8(parts[3])) {
                throw "io_error: unreadable file entry";
            }
            return entryItem(parts[0], parts[1], parts[2], parts[3]);
        });
        command("fs.exists", closure Command [files] (Item args) {
            string path = requiredString(args, "path");
            FsResult r = files.stat(path);
            if (r.status == 2) {
                return createBool(false);
            }
            fsCheck(r.status, "cannot stat " + path);
            return createBool(true);
        });
        command("fs.mkdir", closure Command [files] (Item args) {
            string path = requiredString(args, "path");
            bool parents = optionalBool(args, "parents", false);
            int status = files.mkdir(path, parents);
            if (!(parents && status == 6)) {
                fsCheck(status, "cannot create " + path);
            }
            return createNull();
        });
        command("fs.remove", closure Command [files] (Item args) {
            string path = requiredString(args, "path");
            if (optionalBool(args, "recursive", false)) {
                fsCheck(files.removeTree(path, 0), "cannot remove " + path);
            } else {
                fsCheck(files.remove(path), "cannot remove " + path);
            }
            return createNull();
        });
    }

    // Declares a program the page may run, by name, with an argument template (see the comment above ProgramSpec).
    // `exe` is an absolute path to a .exe, or a bare name searched for on PATH only. Returns false, and registers
    // nothing, if the name or the template is malformed, the program cannot be found, or the name is taken.
    bool allowProgram(string name, string exe, std::vector<string> elements, int timeoutMs, int maxOutputBytes) {
        if (!programNameOk(name) || programs.indexOf(name) >= 0 || elements.size() > 64) {
            return false;
        }
        if (timeoutMs < 100 || timeoutMs > 600000 || maxOutputBytes < 0 || maxOutputBytes > 67108864) {
            return false;
        }
        FsResult found = resolveProgram(exe);
        if (found.status != 0) {
            return false;
        }
        ProgramSpec spec = new ProgramSpec(name, found.text, timeoutMs, maxOutputBytes);
        std::vector<string> names;
        int cwdCount = 0;
        int i = 0;
        while (i < elements.size()) {
            string element = elements[i];
            if (element.length() > 1000 || !plainText(element, 1000)) {
                return false;
            }
            if (startsWithText(element, "@cwd=")) {
                string inner = element.substr(5, element.length() - 5);
                if (elementSlotCheck(inner) != 1 || slotOpen(inner) != 0 || slotClose(inner) != inner.length() - 1) {
                    return false;
                }
                std::vector<string> parts = splitOn(inner.substr(1, inner.length() - 2), ':');
                if (parts.size() != 2 || parts[1] != "folder") {
                    return false;
                }
                cwdCount = cwdCount + 1;
                string cwdName = parts[0];
                names.push_back(cwdName);
            } else {
                int has = elementSlotCheck(element);
                if (has < 0) {
                    return false;
                }
                if (has == 1) {
                    int open = slotOpen(element);
                    int close = slotClose(element);
                    std::vector<string> parts = splitOn(element.substr(open + 1, close - open - 1), ':');
                    string slotName = parts[0];
                    names.push_back(slotName);
                }
            }
            spec.elements.push_back(element);
            i = i + 1;
        }
        if (cwdCount > 1) {
            return false;
        }
        int a = 0;
        while (a < names.size()) {
            int b = a + 1;
            while (b < names.size()) {
                if (names[a] == names[b]) {
                    return false;
                }
                b = b + 1;
            }
            a = a + 1;
        }
        spec.slotNames = names;
        programs.specs.push_back(spec);
        return true;
    }

    // Adds variables of this process that programs may see (see ProgramRegistry); everything else is withheld.
    bool passEnvironment(string name) {
        if (name.length() == 0 || !plainText(name, 200) || indexOfChar(name, '=') >= 0) {
            return false;
        }
        programs.envNames.push_back(name);
        return true;
    }

    // Registers proc.run: {program: "git.log", args: {count: 20, ...}} -> {exitCode, stdout, stderr, timedOut,
    // truncated: {stdout, stderr}, lossy}. A non-zero exit code is a result, not an error. Asynchronous: the program
    // runs on a worker, so the command loop keeps serving.
    void enableProcessCommands() {
        ProgramRegistry registry = programs;
        FileGate files = gate;
        asyncCommand("proc.run", closure AsyncCommand [registry, files] (Item args, string id, int handle) {
            string program = requiredString(args, "program");
            Item given = getObjectItem(args, "args");
            if (given == nullptr) {
                given = createObject();
            }
            if (!isObject(given)) {
                throw "invalid_argument: `args` must be an object";
            }
            int index = registry.indexOf(program);
            if (index < 0) {
                throw "unknown_program: no program is allowed under that name";
            }
            ProgramSpec spec = registry.specs[index];
            // every value in `args` must belong to a slot: nothing extra is passed along
            Item child = given.child;
            while (child != nullptr) {
                bool known = false;
                int k = 0;
                while (k < spec.slotNames.size()) {
                    if (spec.slotNames[k] == child.key) {
                        known = true;
                    }
                    k = k + 1;
                }
                if (!known) {
                    string message = "invalid_argument: `" + child.key + "` is not a parameter of " + program;
                    throw message;
                }
                child = child.next;
            }
            std::vector<string> argv;
            string cwd = "";
            int total = 0;
            int e = 0;
            while (e < spec.elements.size()) {
                string element = spec.elements[e];
                if (startsWithText(element, "@cwd=")) {
                    string inner = element.substr(5, element.length() - 5);
                    cwd = slotValue(files, inner.substr(1, inner.length() - 2), given, false);
                } else {
                    string rendered = renderElement(files, element, given);
                    if (!plainText(rendered, 32000)) {
                        throw "invalid_argument: an argument is not plain text";
                    }
                    total = total + rendered.length() + 3;
                    argv.push_back(rendered);
                }
                e = e + 1;
            }
            if (argv.size() > 256 || total > 30000) {
                throw "invalid_argument: too many or too long arguments";
            }
            if (cwd.length() == 0) {
                FsResult where = files.resolve(".", 2);
                if (where.status != 0) {
                    string message = fsCodeFor(where.status) + ": no folder is allowed to run programs in";
                    throw message;
                }
                cwd = where.text;
            }
            std::vector<string> env = registry.environment();
            string exe = spec.exe;
            int timeoutMs = spec.timeoutMs;
            int maxBytes = spec.maxBytes;
            spawn(closure Job [exe, argv, cwd, env, timeoutMs, maxBytes, id, handle] () {
                string out = "";
                string err = "";
                int exitCode = 0;
                int flags = 0;
                int status = app_proc_run(handle, id, exe, argv, cwd, env, timeoutMs, maxBytes, out, err, exitCode, flags);
                finishRun(handle, id, status, out, err, exitCode, flags);
            });
        });
    }

    // ---- watches ----

    // Registers fs.watch and fs.unwatch (see "watching folders" above). A page may watch only folders the file commands
    // can reach, at most 32 at a time.
    void enableWatchCommands() {
        FileGate files = gate;
        Watches book = watches;
        asyncCommand("fs.watch", closure AsyncCommand [files, book] (Item args, string id, int handle) {
            string path = requiredString(args, "path");
            bool recursive = optionalBool(args, "recursive", false);
            int flag = 0;
            if (recursive) {
                flag = 1;
            }
            FsResult r = files.resolve(path, 2);
            fsCheck(r.status, "cannot watch " + path);
            if (book.states.size() >= 32) {
                throw "too_many: at most 32 folders can be watched at a time";
            }
            int watchId = 0;
            fsCheck(app_watch_start(handle, r.text, flag, watchId), "cannot watch " + path);
            book.states.push_back(new WatchState(watchId, r.text));
            Item result = createObject();
            addNumberToObject(result, "id", double(watchId));
            replyOk(handle, id, printUnformatted(result));
        });
        asyncCommand("fs.unwatch", closure AsyncCommand [book] (Item args, string id, int handle) {
            Item given = getObjectItem(objectArg(args), "id");
            if (given == nullptr || !isNumber(given)) {
                throw "invalid_argument: `id` must be a number";
            }
            int watchId = int(given.valuedouble);
            int index = book.indexOf(watchId);
            if (index < 0) {
                throw "not_found: no such watch";
            }
            app_watch_stop(handle, watchId);
            book.drop(index);
            replyOk(handle, id, "null");
        });
    }

    // ---- dialogs ----

    // Registers dialog.open, dialog.save, dialog.folder and dialog.message. They are asynchronous commands, so the
    // command loop keeps serving while a dialog is open. A pick answers null on cancel, else {path} and grants that
    // one file (or folder) to the file commands.
    void enableDialogCommands() {
        asyncCommand("dialog.open", closure AsyncCommand [] (Item args, string id, int handle) {
            string title = dialogTitle(args);
            std::vector<string> filters = filterList(args);
            spawn(closure Job [title, filters, id, handle] () {
                string chosen = "";
                int status = app_dialog_pick(handle, 0, title, "", "", filters, chosen);
                finishPick(handle, id, status, chosen, false);
            });
        });
        asyncCommand("dialog.save", closure AsyncCommand [] (Item args, string id, int handle) {
            string title = dialogTitle(args);
            string suggested = optionalString(args, "defaultName", "");
            if (suggested.length() > 0 && !plainFileName(suggested)) {
                throw "invalid_argument: `defaultName` must be a file name without a folder";
            }
            std::vector<string> filters = filterList(args);
            string extension = defaultExtension(args);
            spawn(closure Job [title, suggested, extension, filters, id, handle] () {
                string chosen = "";
                int status = app_dialog_pick(handle, 1, title, suggested, extension, filters, chosen);
                finishPick(handle, id, status, chosen, false);
            });
        });
        asyncCommand("dialog.folder", closure AsyncCommand [] (Item args, string id, int handle) {
            string title = dialogTitle(args);
            std::vector<string> none;
            spawn(closure Job [title, none, id, handle] () {
                string chosen = "";
                int status = app_dialog_pick(handle, 2, title, "", "", none, chosen);
                finishPick(handle, id, status, chosen, true);
            });
        });
        asyncCommand("dialog.message", closure AsyncCommand [] (Item args, string id, int handle) {
            string title = dialogTitle(args);
            string message = requiredString(args, "message");
            if (!plainText(message, 4000)) {
                throw "invalid_argument: `message` must be plain text of at most 4000 bytes";
            }
            int kind = dialogKind(optionalString(args, "kind", "info"));
            int buttons = dialogButtons(optionalString(args, "buttons", "ok"));
            if (kind < 0 || buttons < 0) {
                throw "invalid_argument: unknown `kind` or `buttons`";
            }
            spawn(closure Job [title, message, kind, buttons, id, handle] () {
                int button = app_dialog_message(handle, title, message, kind, buttons);
                if (button > 0) {
                    Item result = createObject();
                    addStringToObject(result, "button", buttonName(button));
                    replyOk(handle, id, printUnformatted(result));
                } else {
                    replyError(handle, id, "unsupported", "the dialog could not be shown");
                }
            });
        });
    }

    // Applies what a dialog worker sent: grants the user's choice, then answers the page.
    void onPickRecord(std::vector<string> f) {
        if (f.size() < 4) {
            return;
        }
        string id = f[1];
        FsResult g = new FsResult(0, "");
        if (f[2] == "1") {
            g = gate.grantFolder(f[3]);
        } else {
            g = gate.grantFile(f[3]);
        }
        if (g.status != 0) {
            replyError(handle, id, fsCodeFor(g.status), "the chosen path cannot be used");
            return;
        }
        Item result = createObject();
        addStringToObject(result, "path", g.text);
        replyOk(handle, id, printUnformatted(result));
    }

    // ---- the window ----

    // Registers window.setTitle {title}, window.setSize {width, height}, window.minimize / maximize / restore / focus,
    // window.close, and window.setDirty {dirty}: the page says it has unsaved work, which matters to confirmClose.
    void enableWindowCommands() {
        WindowState state = window;
        command("window.setTitle", closure Command [state] (Item args) {
            string title = requiredString(args, "title");
            if (title.length() == 0 || !plainText(title, 200)) {
                throw "invalid_argument: `title` must be plain text of 1 to 200 bytes";
            }
            app_window_title(state.handle, title);
            return createNull();
        });
        command("window.setSize", closure Command [state] (Item args) {
            Item w = getObjectItem(objectArg(args), "width");
            Item h = getObjectItem(objectArg(args), "height");
            if (w == nullptr || h == nullptr || !isNumber(w) || !isNumber(h)) {
                throw "invalid_argument: `width` and `height` must be numbers";
            }
            if (w.valuedouble < 200.0 || w.valuedouble > 10000.0 || h.valuedouble < 150.0 || h.valuedouble > 10000.0) {
                throw "invalid_argument: width must be 200 to 10000 and height 150 to 10000";
            }
            app_window_size(state.handle, int(w.valuedouble), int(h.valuedouble));
            return createNull();
        });
        command("window.minimize", closure Command [state] (Item args) {
            app_window_state(state.handle, 1);
            return createNull();
        });
        command("window.maximize", closure Command [state] (Item args) {
            app_window_state(state.handle, 2);
            return createNull();
        });
        command("window.restore", closure Command [state] (Item args) {
            app_window_state(state.handle, 0);
            return createNull();
        });
        command("window.focus", closure Command [state] (Item args) {
            app_window_state(state.handle, 3);
            return createNull();
        });
        command("window.close", closure Command [state] (Item args) {
            app_terminate(state.handle);
            return createNull();
        });
        command("window.setDirty", closure Command [state] (Item args) {
            state.dirty = optionalBool(args, "dirty", true);
            return createNull();
        });
    }

    // When the user closes the window (the X, Alt+F4) while the page has said it has unsaved work, ask first with a native
    // box whose text is the application's, not the page's. Without this the window just closes.
    bool confirmClose(string title, string message) {
        if (!plainText(title, 200) || !plainText(message, 4000)) {
            return false;
        }
        window.closeTitle = title;
        window.closeMessage = message;
        window.confirm = true;
        if (handle == 0) {
            return true;
        }
        return app_window_guard(handle, 1) >= 0;
    }

    void onWindowRecord(std::vector<string> f) {
        if (f.size() < 2) {
            return;
        }
        if (f[1] == "navigation_blocked" && f.size() >= 3) {
            if (isUtf8(f[2])) {
                Item e = createObject();
                addStringToObject(e, "url", f[2]);
                emitEvent(handle, "window.navigationBlocked", printUnformatted(e));
            }
            return;
        }
        if (f[1] == "close_declined") {
            window.confirming = false;
            emitEvent(handle, "window.closeDeclined", "null");
            return;
        }
        if (f[1] != "close_requested") {
            return;
        }
        if (!window.dirty) {
            app_terminate(handle);
            return;
        }
        if (window.confirming) {
            return;
        }
        window.confirming = true;
        int h = handle;
        string title = window.closeTitle;
        string message = window.closeMessage;
        string declined = packRecord("window", "close_declined");
        spawn(closure Job [h, title, message, declined] () {
            if (app_dialog_message(h, title, message, 3, 2) == 3) {
                app_terminate(h);
            } else {
                app_push(h, "", declined, 100);
            }
        });
    }

    // The page may not send a call larger than maxRequestBytes or while maxQueuedCalls are waiting: such a call is answered at
    // once with {code: "too_large"} / {code: "busy"} and never reaches a command (defaults 4 MiB and 256). Applies to the next open.
    bool setRequestLimits(int maxRequest, int maxQueued) {
        if (maxRequest < 1024 || maxRequest > 268435456 || maxQueued < 1 || maxQueued > 100000) {
            return false;
        }
        maxRequestBytes = maxRequest;
        maxQueuedCalls = maxQueued;
        return true;
    }

    // After the application's own page, the window may load only addresses that start with `prefix` (for example a dev server,
    // "http://localhost:5173/"); everything else, every new window and every frame pointing elsewhere is refused and reported as
    // the event window.navigationBlocked {url}. Call before open.
    bool allowNavigation(string prefix) {
        if (prefix.length() < 5 || !plainText(prefix, 1000)) {
            return false;
        }
        navigation.push_back(prefix);
        return true;
    }

    // From now on the page may call only the commands named here (every name must be one that is registered by now, so a typo cannot
    // silently leave a command open or closed). Others are answered {code: "forbidden"}, registered or not. Cancelling a call
    // ($cancel) is always allowed. Calling it again replaces the list. One App serves one window, so this is that window's list.
    // false (and nothing changes) if a name is not registered.
    bool allowOnlyCommands(std::vector<string> names) {
        int i = 0;
        while (i < names.size()) {
            if (dispatcher.indexOf(names[i]) < 0 && dispatcher.indexOfAsync(names[i]) < 0) {
                return false;
            }
            i = i + 1;
        }
        dispatcher.allowed = names;
        dispatcher.restricted = true;
        return true;
    }

    // How long a page waits for the async command `name` ("" = every async command that has no setting of its own): after ms it is answered
    // {code: "timed_out"}, the call counts as cancelled (callCancelled; a program it started is killed) and a late answer is dropped.
    // 0 means as long as it takes, which is the default. Do not set it for the dialog commands, which wait for a person.
    bool setAsyncTimeout(string name, int ms) {
        if (ms < 0 || (ms > 0 && ms < 50) || ms > 86400000) {
            return false;
        }
        if (name.length() == 0) {
            dispatcher.defaultTimeoutMs = ms;
        } else {
            dispatcher.setTimeout(name, ms);
        }
        return true;
    }

    // After the program ends (main returns) the jobs still running get this long, then the process ends without them (a message on stderr
    // says how many). Default 5000. 0 waits for every job however long it takes.
    bool setShutdownGrace(int ms) {
        if (ms < 0 || ms > 3600000) {
            return false;
        }
        cling::setExitGraceMs(ms);
        return true;
    }

    // At most n async jobs run at the same time (the rest wait in a queue, oldest first); 0 = the default,
    // max(4, number of cores). A job is never dropped: on exit every queued job still runs.
    void setWorkerLimit(int n) {
        cling::setWorkerLimit(n);
    }

    // Opens the window. false if it could not be created (the shim has printed why on stderr).
    bool open(string title, int width, int height, string html, string bridgeJs, bool debug) {
        int d = 0;
        if (debug) {
            d = 1;
        }
        handle = app_open(title, width, height, html, siteStart, bridgeJs, d);
        window.handle = handle;
        if (handle != 0) {
            app_limits(handle, maxRequestBytes, maxQueuedCalls);
            app_navigation_allow(handle, navigation);
            if (window.confirm) {
                app_window_guard(handle, 1);
            }
        }
        return handle != 0;
    }

    // Opens the window on the page embedded at build time, with the standard bridge script.
    bool openPage(string title, int width, int height, bool debug) {
        return open(title, width, height, app_page_html(), app_bridge_js() + app_extra_js(), debug);
    }

    // Opens the window on the program's own web files (build with ASSETS=<folder>), served from memory under `origin`, which must be
    // http:// or https:// with no path ("http://app.localhost"). `csp`, if not empty, is sent with every HTML file as its
    // Content-Security-Policy. The window may navigate to that origin and nowhere else (allowNavigation adds more). false if there
    // are no files, no page among them, or the window could not be created.
    bool openSite(string title, int width, int height, bool debug, string origin, string csp) {
        SiteInfo info = publishSite(origin, csp);
        if (info.files == 0 || info.start.length() == 0) {
            return false;
        }
        siteStart = info.start;
        navigation.push_back(origin + "/");
        return open(title, width, height, "", app_bridge_js() + app_extra_js(), debug);
    }

    // Expects a record from a worker for the page call `id`: when finishLater arrives, `l.done` runs on the main thread.
    void later(string id, Later l) {
        laters.ids.push_back(id);
        laters.items.push_back(l);
    }

    // The run of a program the application chooses itself: `exe` as resolveProgram found it, `args` vetted by the caller, `cwd` a
    // folder the file policy has resolved. The environment is the one programs get (see passEnvironment).
    ToolRun toolRun(string exe, std::vector<string> args, string cwd, int timeoutMs, int maxBytes) {
        ToolRun run = new ToolRun(exe, cwd, timeoutMs, maxBytes);
        run.args = args;
        run.env = programs.environment();
        return run;
    }

    // A record the native layer queued itself (empty id): "watch", "pick", "window" or "later".
    void onInternalRecord(string request) {
        std::vector<string> f = splitFields(request);
        if (f.size() == 0) {
            return;
        }
        if (f[0] == "watch") {
            watches.onRecord(gate, handle, f);
        } else if (f[0] == "pick") {
            onPickRecord(f);
        } else if (f[0] == "window") {
            onWindowRecord(f);
        } else if (f[0] == "later" && f.size() >= 4) {
            int index = laters.indexOf(f[1]);
            if (index < 0) {
                return;
            }
            Later l = laters.items[index];
            laters.drop(index);
            try {
                l.done(handle, f[1], int(decimalValue(f[2])), f[3]);
            } catch (string message) {
                replyError(handle, f[1], errorCodeOf(message), errorTextOf(message));
            }
        }
    }

    // Serves the next thing in the queue: a call from the page (dispatched and answered) or a record from the native layer
    // (a file watcher's change, a dialog's choice, the window's close button). Waits up to timeoutMs (-1 = for as long as it
    // takes), and delivers merged file-watch events when they have been quiet for a moment.
    // Returns 1 if something was served, 2 if the wait timed out, 0 if the window has closed.
    int serveOne(int timeoutMs) {
        double started = app_now_ms();
        while (true) {
            int wait = timeoutMs;
            if (timeoutMs >= 0) {
                wait = timeoutMs - int(app_now_ms() - started);
                if (wait < 0) {
                    wait = 0;
                }
            }
            bool pending = watches.anyPending();
            if (pending && (wait < 0 || wait > 40)) {
                wait = 40;
            }
            dispatcher.sweep(handle);
            int due = dispatcher.nextDueMs();
            if (due >= 0 && (wait < 0 || wait > due + 1)) {
                wait = due + 1;
            }
            string id = "";
            string request = "";
            int r = app_next_call(handle, wait, id, request);
            if (r == 1) {
                if (id.length() == 0) {
                    onInternalRecord(request);
                } else {
                    Reply reply = dispatcher.handle(handle, id, request);
                    if (reply.status != 2) {
                        app_return(handle, id, reply.status, reply.json);
                    }
                }
                watches.flushQuiet(gate, handle);
                return 1;
            }
            if (r == 0) {
                app_cancel_all(handle);      // the window is gone: running work is told to stop, programs it started are killed
                return 0;
            }
            watches.flushQuiet(gate, handle);
            if (timeoutMs >= 0 && app_now_ms() - started >= double(timeoutMs)) {
                return 2;
            }
        }
        return 2;
    }

    // Serves calls and records until the window closes. Returns how many calls and records were served.
    int run() {
        int served = 0;
        while (true) {
            int r = serveOne(-1);
            if (r == 0) {
                break;
            }
            if (r == 1) {
                served = served + 1;
            }
        }
        return served;
    }

    void quit() {
        app_terminate(handle);
    }

    // Ends the application in order: every call still running is told to stop (callCancelled, programs killed), the watchers are stopped,
    // the window closes. Jobs that are still running afterwards get setShutdownGrace milliseconds when main returns, then the process ends.
    void close() {
        app_cancel_all(handle);
        app_close(handle);
        handle = 0;
        window.handle = 0;
    }
};
