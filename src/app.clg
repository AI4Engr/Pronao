// Which window is calling right now: set by the Dispatcher around a synchronous command (0 outside one). A command that acts on "its" window
// holds this object and reads `handle`.
class CallContext {
public:
    int handle;
    CallContext() {
        handle = 0;
    }
};

// The commands each window's page may call. The default list (once restrictAll has been used; before that: every registered command) applies
// to every window without a list of its own; restrictWindow gives one window its own. Anything else is answered {code: "forbidden"}, whether or not
// such a command exists, so the page cannot probe for names. `known` is every registered command name.
class CommandRules {
public:
    std::vector<string> known;
    bool defaultRestricted;
    std::vector<string> defaultNames;
    std::vector<int> restrictedHandles;
    std::vector<int> ruleHandles;
    std::vector<string> ruleNames;

    CommandRules() {
        defaultRestricted = false;
    }

    bool hasCommand(string name) {
        int i = 0;
        while (i < known.size()) {
            if (known[i] == name) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    bool mayCall(int handle, string name) {
        bool own = false;
        int i = 0;
        while (i < restrictedHandles.size()) {
            if (restrictedHandles[i] == handle) {
                own = true;
            }
            i = i + 1;
        }
        if (own) {
            int r = 0;
            while (r < ruleNames.size()) {
                if (ruleHandles[r] == handle && ruleNames[r] == name) {
                    return true;
                }
                r = r + 1;
            }
            return false;
        }
        if (!defaultRestricted) {
            return true;
        }
        int d = 0;
        while (d < defaultNames.size()) {
            if (defaultNames[d] == name) {
                return true;
            }
            d = d + 1;
        }
        return false;
    }

    // A window opened by another one starts with the opener's own list, if it has one (the default list applies to it anyway).
    void inheritRules(int from, int to) {
        bool own = false;
        int i = 0;
        while (i < restrictedHandles.size()) {
            if (restrictedHandles[i] == from) {
                own = true;
            }
            i = i + 1;
        }
        if (!own) {
            return;
        }
        std::vector<string> names;
        int r = 0;
        while (r < ruleNames.size()) {
            if (ruleHandles[r] == from) {
                names.push_back(ruleNames[r]);
            }
            r = r + 1;
        }
        restrictWindow(to, names);
    }

    void restrictAll(std::vector<string> names) {
        defaultNames = names;
        defaultRestricted = true;
    }

    void restrictWindow(int handle, std::vector<string> names) {
        forgetRules(handle);
        restrictedHandles.push_back(handle);
        int i = 0;
        while (i < names.size()) {
            ruleHandles.push_back(handle);
            ruleNames.push_back(names[i]);
            i = i + 1;
        }
    }

    void forgetRules(int handle) {
        int i = restrictedHandles.size() - 1;
        while (i >= 0) {
            if (restrictedHandles[i] == handle) {
                restrictedHandles[i] = restrictedHandles[restrictedHandles.size() - 1];
                restrictedHandles.pop_back();
            }
            i = i - 1;
        }
        int r = ruleNames.size() - 1;
        while (r >= 0) {
            if (ruleHandles[r] == handle) {
                int last = ruleNames.size() - 1;
                ruleHandles[r] = ruleHandles[last];
                ruleNames[r] = ruleNames[last];
                ruleHandles.pop_back();
                ruleNames.pop_back();
            }
            r = r - 1;
        }
    }

};

class Dispatcher {
public:
    std::vector<string> names;
    std::vector<Command> handlers;
    std::vector<string> asyncNames;
    std::vector<AsyncCommand> asyncHandlers;
    // How long the page waits for an async command before it is answered {code: "timed_out"} (0 = as long as it takes), per command name
    // with a default for the rest, and the calls that are waiting against their deadline.
    std::vector<string> timeoutNames;
    std::vector<int> timeoutValues;
    int defaultTimeoutMs;
    std::vector<string> dueIds;
    std::vector<int> dueHandles;       // (a page's call ids are only unique within its window: every table of calls is keyed by window AND id)
    std::vector<double> dueAt;
    // The tag a page gave an async call (cling.invoke(..., {signal})) and the call it names, newest last, at most 256 of them.
    std::vector<string> tags;
    std::vector<int> tagHandles;
    std::vector<string> tagCalls;

    // Which commands each window's page may call (see CommandRules), and which window's synchronous command is running right now (see
    // CallContext). Both are separate objects so that the commands, which are owned by this Dispatcher, can hold them without pointing back at it.
    CommandRules rules;
    CallContext caller;

    Dispatcher() {
        defaultTimeoutMs = 0;
        rules = new CommandRules();
        caller = new CallContext();
    }

    // A window is gone: its list, its tags and its deadlines go with it.
    void forgetWindow(int handle) {
        rules.forgetRules(handle);
        int t = tags.size() - 1;
        while (t >= 0) {
            if (tagHandles[t] == handle) {
                int k = t;
                while (k + 1 < tags.size()) {
                    tags[k] = tags[k + 1];
                    tagHandles[k] = tagHandles[k + 1];
                    tagCalls[k] = tagCalls[k + 1];
                    k = k + 1;
                }
                tags.pop_back();
                tagHandles.pop_back();
                tagCalls.pop_back();
            }
            t = t - 1;
        }
        int d = dueIds.size() - 1;
        while (d >= 0) {
            if (dueHandles[d] == handle) {
                dropDue(d);
            }
            d = d - 1;
        }
    }

    int timeoutFor(string name) {
        int i = 0;
        while (i < timeoutNames.size()) {
            if (timeoutNames[i] == name) {
                return timeoutValues[i];
            }
            i = i + 1;
        }
        return defaultTimeoutMs;
    }

    void setTimeout(string name, int ms) {
        int i = 0;
        while (i < timeoutNames.size()) {
            if (timeoutNames[i] == name) {
                timeoutValues[i] = ms;
                return;
            }
            i = i + 1;
        }
        timeoutNames.push_back(name);
        timeoutValues.push_back(ms);
    }

    void rememberTag(int handle, string tag, string call) {
        if (tags.size() >= 256) {
            int i = 0;
            while (i + 1 < tags.size()) {
                tags[i] = tags[i + 1];
                tagHandles[i] = tagHandles[i + 1];
                tagCalls[i] = tagCalls[i + 1];
                i = i + 1;
            }
            tags.pop_back();
            tagHandles.pop_back();
            tagCalls.pop_back();
        }
        tags.push_back(tag);
        tagHandles.push_back(handle);
        tagCalls.push_back(call);
    }

    // The page abandons the call it tagged: the work is told to stop. Unknown or finished tags are ignored, and a tag only names a call of the
    // window that sent it.
    void cancelTag(int handle, string tag) {
        int i = 0;
        while (i < tags.size()) {
            if (tags[i] == tag && tagHandles[i] == handle) {
                app_cancel(handle, tagCalls[i]);
                return;
            }
            i = i + 1;
        }
    }

    void dropDue(int index) {
        int last = dueIds.size() - 1;
        if (index != last) {
            dueIds[index] = dueIds[last];
            dueHandles[index] = dueHandles[last];
            dueAt[index] = dueAt[last];
        }
        dueIds.pop_back();
        dueHandles.pop_back();
        dueAt.pop_back();
    }

    // Answers every call whose time is up {code: "timed_out"} and tells the work to stop (callCancelled, and a program it started is
    // killed). A call that was answered meanwhile is just forgotten; the late answer of a job that kept going is dropped by the shim
    // (a page call is answered once).
    void sweep() {
        double now = app_now_ms();
        int i = dueIds.size() - 1;
        while (i >= 0) {
            string id = dueIds[i];
            int handle = dueHandles[i];
            if (app_pending(handle, id) == 0) {
                dropDue(i);
            } else if (now >= dueAt[i]) {
                replyError(handle, id, "timed_out", "the command took longer than the application allows");
                app_cancel(handle, id);      // (after the reply: replying forgets a cancel; the job's own late reply forgets this one)
                dropDue(i);
            }
            i = i - 1;
        }
    }

    // Milliseconds until the first deadline, or -1 if no call is waiting against one.
    int nextDueMs() {
        if (dueAt.size() == 0) {
            return -1;
        }
        double now = app_now_ms();
        double first = dueAt[0];
        int i = 1;
        while (i < dueAt.size()) {
            if (dueAt[i] < first) {
                first = dueAt[i];
            }
            i = i + 1;
        }
        if (first <= now) {
            return 0;
        }
        return int(first - now);
    }

    void add(string name, Command handler) {
        names.push_back(name);
        handlers.push_back(handler);
        rules.known.push_back(name);
    }

    void addAsync(string name, AsyncCommand handler) {
        asyncNames.push_back(name);
        asyncHandlers.push_back(handler);
        rules.known.push_back(name);
    }

    // The index of the async command called `name`, or -1.
    int indexOfAsync(string name) {
        int i = 0;
        while (i < asyncNames.size()) {
            if (asyncNames[i] == name) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    // The index of the command called `name`, or -1.
    int indexOf(string name) {
        int i = 0;
        while (i < names.size()) {
            if (names[i] == name) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    // One request in, one reply out. Never throws and never aborts on a malformed request: a bad
    // request is a rejected promise, not a dead application. For an async command the reply has status 2
    // ("deferred"): nothing is sent now, the worker answers later.
    Reply handle(int appHandle, string id, string request) {
        Item parsed = parse(request);
        if (parsed == nullptr) {
            return new Reply(1, errorJson("bad_request", "the request is not valid JSON"));
        }
        if (!isArray(parsed) || getArraySize(parsed) < 1) {
            return new Reply(1, errorJson("bad_request", "the request must be a JSON array [command, args]"));
        }
        Item nameItem = getArrayItem(parsed, 0);
        if (!isString(nameItem)) {
            return new Reply(1, errorJson("bad_request", "the command name must be a string"));
        }
        if (nameItem.valuestring == "$cancel") {
            Item which = getArrayItem(parsed, 1);
            if (which != nullptr && isString(which) && which.valuestring.length() <= 64) {
                cancelTag(appHandle, which.valuestring);
            }
            return new Reply(0, "null");
        }
        string tag = "";
        Item tagItem = getArrayItem(parsed, 2);
        if (tagItem != nullptr && isString(tagItem) && tagItem.valuestring.length() <= 64) {
            tag = tagItem.valuestring;
        }
        if (!rules.mayCall(appHandle, nameItem.valuestring)) {
            return new Reply(1, errorJson("forbidden", "this window may not call that command"));
        }
        int index = indexOf(nameItem.valuestring);
        int asyncIndex = indexOfAsync(nameItem.valuestring);
        if (index < 0 && asyncIndex < 0) {
            return new Reply(1, errorJson("unknown_command", "no command named " + nameItem.valuestring));
        }
        Item args = getArrayItem(parsed, 1);
        if (args == nullptr) {
            args = createNull();
        }
        if (index < 0) {
            try {
                AsyncCommand starter = asyncHandlers[asyncIndex];
                // every job this start() spawns inherits this: a throw inside it rejects the page's promise
                onJobFailure(closure Failure [id, appHandle] (string message) {
                    replyError(appHandle, id, errorCodeOf(message), errorTextOf(message));
                });
                starter.start(args, id, appHandle);
                cling::clearJobFailure();
                if (tag.length() > 0) {
                    rememberTag(appHandle, tag, id);
                }
                int limitMs = timeoutFor(nameItem.valuestring);
                if (limitMs > 0) {
                    dueIds.push_back(id);
                    dueHandles.push_back(appHandle);
                    dueAt.push_back(app_now_ms() + double(limitMs));
                }
                return new Reply(2, "");
            } catch (string message) {
                cling::clearJobFailure();
                return new Reply(1, errorJson(errorCodeOf(message), errorTextOf(message)));
            }
        }
        try {
            // (a local first: the checker cannot resolve a method call made directly on `handlers[index]`)
            Command handler = handlers[index];
            caller.handle = appHandle;
            Item result = handler.call(args);
            caller.handle = 0;
            if (result == nullptr) {
                return new Reply(0, "null");
            }
            string text = printUnformatted(result);
            if (text.length() == 0) {
                return new Reply(1, errorJson("command_failed", "the command returned a value that cannot be printed"));
            }
            return new Reply(0, text);
        } catch (string message) {
            caller.handle = 0;
            return new Reply(1, errorJson(errorCodeOf(message), errorTextOf(message)));
        }
        return new Reply(1, errorJson("internal", "unreachable"));
    }
};

// ---- file commands --------------------------------------------------------------------------------
// The allowed folders and every check on a path live in FileGate (files.clg), which decides on what the operating system
// actually opened. These helpers only map its status codes to error codes and shape the JSON.

string fsCodeFor(int status) {
    if (status == 1) { return "forbidden"; }
    if (status == 2) { return "not_found"; }
    if (status == 3) { return "too_large"; }
    if (status == 5) { return "invalid_path"; }
    if (status == 6) { return "already_exists"; }
    if (status == 7) { return "not_empty"; }
    if (status == 8) { return "is_directory"; }
    if (status == 9) { return "not_directory"; }
    if (status == 10) { return "permission_denied"; }
    if (status == 11) { return "too_many"; }
    return "io_error";
}

void fsCheck(int status, string what) {
    if (status != 0) {
        string message = fsCodeFor(status) + ": " + what;
        throw message;
    }
}

string kindName(string code) {
    if (code == "d") { return "dir"; }
    if (code == "l") { return "link"; }
    return "file";
}

// {name, kind: "file" | "dir" | "link", size, modified (seconds since 1970)}
Item entryItem(string kind, string size, string modified, string name) {
    Item e = createObject();
    addStringToObject(e, "name", name);
    addStringToObject(e, "kind", kindName(kind));
    addNumberToObject(e, "size", decimalValue(size));
    addNumberToObject(e, "modified", decimalValue(modified));
    return e;
}

// ---- dialog commands ------------------------------------------------------------------------------
// The user's choice in a native dialog is a grant: exactly the file (or folder) they picked becomes reachable through
// the file commands, and nothing around it. A page cannot reach a file it has not been given, by the app or by the
// user; and a dialog is the only way the user can give one. What a dialog may say is decided here: the native layer shows
// whatever it is handed.

bool extensionOk(string e) {
    if (e.length() == 0 || e.length() > 16) {
        return false;
    }
    int i = 0;
    while (i < e.length()) {
        char c = e[i];
        bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '-';
        if (!ok) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// a file name with no folder in it and none of the characters Windows refuses
bool plainFileName(string name) {
    if (name.length() == 0 || !plainText(name, 200) || name == "." || name == "..") {
        return false;
    }
    int i = 0;
    while (i < name.length()) {
        char c = name[i];
        if (int(c) >= 0 && int(c) < 32) {
            return false;
        }
        if (c == '/' || c == '\\' || c == ':' || c == '*' || c == '?' || c == '"' || c == '<' || c == '>' || c == '|') {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// ---- what a page sends: the shapes are structs, CeeLing writes the decoders (decodeDialogArgs, ...: see CeeLing's CLAUDE.md "generated JSON decoders") ----
// A struct with a constructor that takes no parameters has OPTIONAL fields: a missing (or null) field keeps the value the constructor gave it, a field that is
// present must have the right type or the call is refused with the field's name. What a value MEANS (lengths, characters, ranges) is checked below.
struct FilterArgs {
public:
    string name;
    std::vector<string> extensions;
    FilterArgs() {
        name = "";
    }
};

struct DialogArgs {
public:
    string title;
    string defaultName;
    std::vector<FilterArgs> filters;
    DialogArgs() {
        title = "";
        defaultName = "";
    }
};

struct MessageArgs {
public:
    string title;
    string message;
    string kind;
    string buttons;
    MessageArgs() {
        title = "";
        message = "";
        kind = "info";
        buttons = "ok";
    }
};

struct NotifyArgs {
public:
    string title;
    string text;
    string kind;
    string id;
    NotifyArgs() {
        title = "";
        text = "";
        kind = "info";
        id = "";
    }
};

// Notifications (toasts). One object, shared by the application and by the page command, so the command does not have to hold the whole App.
class Notifier {
public:
    int handle;                // the tray icon the notifications come from (0 = none yet)
    double lastMs;
    double gapMs;              // the least time between two notifications
    int asker;                 // the window whose page asked for the last notification (0 = the application did): its page hears of the click
    Notifier() {
        handle = 0;
        lastMs = -1.0e9;
        gapMs = 2000.0;
        asker = 0;
    }

    // text with no control character in it (a line break is allowed when `lines`)
    bool cleanText(string s, int maxBytes, bool lines) {
        if (!plainText(s, maxBytes)) {
            return false;
        }
        int i = 0;
        while (i < s.length()) {
            int c = int(s[i]);
            if ((c >= 0 && c < 32 && !(lines && c == 10)) || c == 127) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    // Shows a notification. "" on success, else the error as "code: message". kind: info, warning, error. id: "" or a name (1 to 64 letters, digits, . _ -) that comes
    // back when the user clicks THIS notification. At most one every gapMs (2 seconds unless the application changed it), so a program (or a page) cannot flood the screen.
    string show(string title, string text, string kind, string id) {
        if (title.length() == 0 || !cleanText(title, 63, false)) {
            return "invalid_argument: `title` must be 1 to 63 bytes of text on one line";
        }
        if (text.length() == 0 || !cleanText(text, 255, true)) {
            return "invalid_argument: `text` must be 1 to 255 bytes of text";
        }
        int level = 0;
        if (kind == "warning") {
            level = 1;
        } else if (kind == "error") {
            level = 2;
        } else if (kind != "info") {
            return "invalid_argument: `kind` must be info, warning or error";
        }
        if (id.length() > 0 && !menuId(id)) {
            return "invalid_argument: `id` must be 1 to 64 letters, digits, `.`, `_` or `-`";
        }
        if (handle == 0) {
            return "not_ready: notifications were not enabled";
        }
        double now = app_now_ms();
        if (now - lastMs < gapMs) {
            return "too_many: notifications are shown too often";
        }
        lastMs = now;
        int st = app_tray_notify(handle, title, text, level, id);
        if (st == -1) {
            return "unsupported: notifications cannot be shown on this system";
        }
        if (st != 0) {
            return "io_error: the system did not take the notification";
        }
        return "";
    }
};

struct OpenWindowArgs {
public:
    string start;
    string title;
    int width;
    int height;
    OpenWindowArgs() {
        start = "";
        title = "";
        width = 800;
        height = 600;
    }
};

string checkedTitle(string title) {
    if (!plainText(title, 200)) {
        throw "invalid_argument: `title` must be plain text of at most 200 bytes";
    }
    return title;
}

// [{name: "Text", extensions: ["txt", "md"]}, {name: "Everything"}] -> label, pattern, label, pattern ... ("*.txt;*.md", "*.*")
std::vector<string> filterList(DialogArgs a) {
    std::vector<string> out;
    if (a.filters.size() > 20) {
        throw "invalid_argument: at most 20 filters";
    }
    int i = 0;
    while (i < a.filters.size()) {
        FilterArgs f = a.filters[i];
        if (f.name.length() == 0 || !plainText(f.name, 80)) {
            throw "invalid_argument: a filter `name` must be plain text of 1 to 80 bytes";
        }
        string pattern = "*.*";
        if (f.extensions.size() > 0) {
            pattern = "";
            int j = 0;
            while (j < f.extensions.size()) {
                if (!extensionOk(f.extensions[j])) {
                    throw "invalid_argument: an extension is 1 to 16 letters, digits, _ or -";
                }
                if (j > 0) {
                    pattern = pattern + ";";
                }
                pattern = pattern + "*." + f.extensions[j];
                j = j + 1;
            }
        }
        out.push_back(f.name);
        out.push_back(pattern);
        i = i + 1;
    }
    return out;
}

// the first extension of the first filter, which a "save as" dialog appends to a name typed without one
string defaultExtension(DialogArgs a) {
    if (a.filters.size() == 0) {
        return "";
    }
    FilterArgs first = a.filters[0];
    if (first.extensions.size() == 0) {
        return "";
    }
    return first.extensions[0];
}

// What the worker that showed a dialog sends the main loop when the user chose something: the main loop applies the grant
// (the allow-list is touched by one thread only) and answers the page.
string pickRecord(string id, bool folder, string chosen) {
    string record = "pick";
    record.push_back(char(0));
    record = record + id;
    record.push_back(char(0));
    if (folder) {
        record.push_back('1');
    } else {
        record.push_back('0');
    }
    record.push_back(char(0));
    record = record + chosen;
    record.push_back(char(0));
    return record;
}

// Runs on the worker that showed the dialog.
void finishPick(int handle, string id, int status, string chosen, bool folder) {
    if (status == 0) {
        replyOk(handle, id, "null");
    } else if (status < 0) {
        replyError(handle, id, "unsupported", "the dialog could not be shown");
    } else if (app_push(handle, "", pickRecord(id, folder, chosen), 100000) != 1) {
        replyError(handle, id, "busy", "the application is not keeping up");
    }
}

string buttonName(int button) {
    if (button == 1) { return "ok"; }
    if (button == 3) { return "yes"; }
    if (button == 4) { return "no"; }
    return "cancel";
}

int dialogKind(string kind) {
    if (kind == "info") { return 0; }
    if (kind == "warning") { return 1; }
    if (kind == "error") { return 2; }
    if (kind == "question") { return 3; }
    return -1;
}

int dialogButtons(string buttons) {
    if (buttons == "ok") { return 0; }
    if (buttons == "okcancel") { return 1; }
    if (buttons == "yesno") { return 2; }
    return -1;
}

// ---- program commands -----------------------------------------------------------------------------
// The application declares WHICH programs may run and with what arguments (allowProgram); a page can only ask for one
// of them by name and fill in the named slots of its argument template. It never supplies a program name, a command
// line or an option: there is no shell, every argument is a separate string, and a slot value that could be read as an
// option (a leading '-') is refused when the slot is a whole argument. The shim (app_proc.cpp) runs the program with no
// stdin, a time limit, an output cap, and kills everything it started.
//
//     app.allowProgram("git.log", "git",
//         ["log", "-n", "{count:int:1:500}", "--format=%H%x09%s", "--", "{file:file}", "@cwd={repo:folder}"], 10000, 1000000);
//     // page:  cling.proc.run({ program: "git.log", args: { count: 20, repo: ".", file: "src/a.txt" } })
//
// An argument is literal text, or literal text around ONE slot  {name:kind[:a[:b]]}  with kind
//   int:min:max   a whole number from min to max        token   letters, digits and . _ - / @ ~ ^ + = (max 200)
//   text:maxLen   any text of at most maxLen bytes      file / folder / path   an existing file, folder or either that
//                                                       the file commands could reach (passed as its absolute path)
// The element "@cwd={name:folder}" (at most one) names the working folder; without it the program runs in the first
// folder the application allowed.

class ProgramSpec {
public:
    string name;
    string exe;
    std::vector<string> elements;
    std::vector<string> slotNames;
    int timeoutMs;
    int maxBytes;
    ProgramSpec(string n, string e, int t, int m) {
        name = n;
        exe = e;
        timeoutMs = t;
        maxBytes = m;
    }
};

// The environment a program gets: ONLY these variables of this process, if they are set (a program started from an application that
// holds a token in its environment must not inherit the token). passEnvironment adds names.
class ProgramRegistry {
public:
    std::vector<ProgramSpec> specs;
    std::vector<string> envNames;
    ProgramRegistry() {
        std::vector<string> base = splitOn("PATH,SystemRoot,SYSTEMDRIVE,windir,TEMP,TMP,TMPDIR,LANG,LC_ALL,HOME,USERPROFILE", ',');
        envNames = base;
    }

    // NAME=value for each of the names that is set
    std::vector<string> environment() {
        std::vector<string> env;
        int i = 0;
        while (i < envNames.size()) {
            string value = "";
            if (app_os_env(envNames[i], value) == 1 && plainText(value, 30000)) {
                env.push_back(envNames[i] + "=" + value);
            }
            i = i + 1;
        }
        return env;
    }

    int indexOf(string name) {
        int i = 0;
        while (i < specs.size()) {
            ProgramSpec spec = specs[i];
            if (spec.name == name) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }
};

// "count:int:1:500", "ref:token", "msg:text:80", "f:file" -- is the slot text well formed?
bool slotSpecOk(string text) {
    std::vector<string> p = splitOn(text, ':');
    if (p.size() < 2) {
        return false;
    }
    string slotName = p[0];
    if (slotName.length() == 0 || slotName.length() > 40) {
        return false;
    }
    int i = 0;
    while (i < slotName.length()) {
        char c = slotName[i];
        bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
        if (!ok) {
            return false;
        }
        i = i + 1;
    }
    if (p[1] == "int") {
        return p.size() == 4 && isDigits(p[2]) && isDigits(p[3]) && decimalValue(p[2]) <= decimalValue(p[3]);
    }
    if (p[1] == "text") {
        return p.size() == 3 && isDigits(p[2]) && decimalValue(p[2]) >= 1.0 && decimalValue(p[2]) <= 100000.0;
    }
    if (p[1] == "token" || p[1] == "file" || p[1] == "folder" || p[1] == "path") {
        return p.size() == 2;
    }
    return false;
}

// where the slot sits in an element: the index of '{' (or -1) -- an element has at most one, and it must close
int slotOpen(string element) {
    return indexOfChar(element, '{');
}

int slotClose(string element) {
    return indexOfChar(element, '}');
}

void argError(string name, string what) {
    string message = "invalid_argument: `" + name + "` " + what;
    throw message;
}

bool tokenChar(char c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '.' || c == '_' || c == '-' ||
           c == '/' || c == '@' || c == '~' || c == '^' || c == '+' || c == '=';
}

// The checked text for one slot. `whole` = the slot is the entire argument, so a leading '-' could be read as an option.
string slotValue(FileGate gate, string slotText, Item args, bool whole) {
    std::vector<string> p = splitOn(slotText, ':');
    string name = p[0];
    string kind = p[1];
    Item v = getObjectItem(args, name);
    if (v == nullptr) {
        argError(name, "is missing");
        return "";
    }
    if (kind == "int") {
        if (!isNumber(v)) {
            argError(name, "must be a number");
            return "";
        }
        double x = v.valuedouble;
        double lo = decimalValue(p[2]);
        double hi = decimalValue(p[3]);
        if (x != double(int(x)) || x < lo || x > hi) {
            argError(name, "must be a whole number from " + p[2] + " to " + p[3]);
            return "";
        }
        return intToString(int(x));
    }
    if (!isString(v)) {
        argError(name, "must be a string");
        return "";
    }
    string text = v.valuestring;
    if (kind == "token") {
        if (text.length() == 0 || text.length() > 200) {
            argError(name, "must be 1 to 200 characters");
            return "";
        }
        int i = 0;
        while (i < text.length()) {
            if (!tokenChar(text[i])) {
                argError(name, "may only contain letters, digits and . _ - / @ ~ ^ + =");
                return "";
            }
            i = i + 1;
        }
    } else if (kind == "text") {
        if (text.length() > int(decimalValue(p[2]))) {
            argError(name, "is too long");
            return "";
        }
        if (!plainText(text, 100000)) {
            argError(name, "must be plain text");
            return "";
        }
    } else {
        int want = 0;
        if (kind == "file") {
            want = 1;
        } else if (kind == "folder") {
            want = 2;
        }
        FsResult found = gate.resolve(text, want);
        if (found.status != 0) {
            string message = fsCodeFor(found.status) + ": cannot use " + text;
            throw message;
        }
        return found.text;
    }
    if (whole && text.length() > 0 && text[0] == '-') {
        argError(name, "must not start with '-'");
        return "";
    }
    return text;
}

// The element with its slot replaced by the checked value.
string renderElement(FileGate gate, string element, Item args) {
    int open = slotOpen(element);
    if (open < 0) {
        return element;
    }
    int close = slotClose(element);
    string slotText = element.substr(open + 1, close - open - 1);
    bool whole = open == 0 && close == element.length() - 1;
    string value = slotValue(gate, slotText, args, whole);
    return element.substr(0, open) + value + element.substr(close + 1, element.length() - close - 1);
}

// Replies for a finished program: {exitCode, stdout, stderr, timedOut, truncated: {stdout, stderr}, lossy}.
// Runs on the worker that ran it.
void finishRun(int handle, string id, int status, string out, string err, int exitCode, int flags) {
    if (status == 0 && ((flags / 8) % 2) == 1) {
        replyError(handle, id, "cancelled", "the call was abandoned or the window is closing");
    } else if (status == 0) {
        Item result = createObject();
        string cleanOut = cleanUtf8(out);
        string cleanErr = cleanUtf8(err);
        addNumberToObject(result, "exitCode", double(exitCode));
        addStringToObject(result, "stdout", cleanOut);
        addStringToObject(result, "stderr", cleanErr);
        addBoolToObject(result, "timedOut", (flags % 2) == 1);
        Item cut = addObjectToObject(result, "truncated");
        addBoolToObject(cut, "stdout", ((flags / 2) % 2) == 1);
        addBoolToObject(cut, "stderr", ((flags / 4) % 2) == 1);
        addBoolToObject(result, "lossy", cleanOut != out || cleanErr != err);
        replyOk(handle, id, printUnformatted(result));
    } else if (status == 2) {
        replyError(handle, id, "program_not_found", "the program or its working folder does not exist");
    } else if (status == 5) {
        replyError(handle, id, "invalid_argument", "the arguments could not be passed to the program");
    } else {
        replyError(handle, id, "spawn_failed", "the program could not be started");
    }
}

bool programNameOk(string name) {
    if (name.length() == 0 || name.length() > 60) {
        return false;
    }
    int i = 0;
    while (i < name.length()) {
        char c = name[i];
        bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '.' || c == '_' || c == '-';
        if (!ok) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// The slot text inside an element's braces, or "" if it has none (-1: malformed braces).
int elementSlotCheck(string element) {
    int open = slotOpen(element);
    int close = slotClose(element);
    if (open < 0 && close < 0) {
        return 0;
    }
    if (open < 0 || close < open) {
        return -1;
    }
    string slotText = element.substr(open + 1, close - open - 1);
    string rest = element.substr(0, open) + element.substr(close + 1, element.length() - close - 1);
    if (indexOfChar(rest, '{') >= 0 || indexOfChar(rest, '}') >= 0) {
        return -1;
    }
    if (!slotSpecOk(slotText)) {
        return -1;
    }
    return 1;
}

// ---- finding a program ----------------------------------------------------------------------------
// `name` is an absolute path to a program (a plain .exe on Windows), or a bare name ("git") that is searched for on PATH ONLY: never
// the current folder, never the folder of the running program, and ("" and relative entries of PATH mean the current folder) never
// a PATH entry that is not absolute. Anything else is refused. Windows note: the arguments are joined into one command line with the
// C runtime's quoting rules, and a program that parses its command line differently (cmd.exe, and so every .bat / .cmd, msiexec,
// ...) could read them differently, so only .exe is accepted. Status: 0 found (text = absolute path), 2 not found, 5 refused.

bool windowsAbsolute(string w) {
    if (isDriveAbsolute(w)) {
        return true;
    }
    return w.length() >= 3 && isSeparator(w[0]) && isSeparator(w[1]) && w[2] != '?' && w[2] != '.';
}

bool endsWithExe(string w) {
    return w.length() >= 4 && lowerAscii(w.substr(w.length() - 4, 4)) == ".exe";
}

// no "." or ".." component in an absolute path
bool plainComponents(string path) {
    std::vector<string> parts = splitOn(path, '/');
    std::vector<string> more = splitOn(path, '\\');
    int i = 0;
    while (i < parts.size()) {
        if (parts[i] == "." || parts[i] == "..") {
            return false;
        }
        i = i + 1;
    }
    int k = 0;
    while (k < more.size()) {
        if (more[k] == "." || more[k] == "..") {
            return false;
        }
        k = k + 1;
    }
    return true;
}

bool runnable(string path, bool windows) {
    int kind = app_os_path_kind(path);
    if (windows) {
        return (kind & 3) == 1;
    }
    return (kind & 5) == 5;
}

FsResult resolveProgram(string name) {
    bool windows = app_os_windows() == 1;
    if (name.length() == 0 || !plainText(name, 4000)) {
        return new FsResult(5, "");
    }
    bool hasSeparator = indexOfChar(name, '/') >= 0 || (windows && (indexOfChar(name, '\\') >= 0 || indexOfChar(name, ':') >= 0));
    if (hasSeparator) {
        if (windows) {
            if (!windowsAbsolute(name) || !endsWithExe(name) || indexOfChar(name.substr(2, name.length() - 2), ':') >= 0) {
                return new FsResult(5, "");
            }
        } else if (name[0] != '/') {
            return new FsResult(5, "");
        }
        if (!plainComponents(name)) {
            return new FsResult(5, "");
        }
        if (!runnable(name, windows)) {
            return new FsResult(2, "");
        }
        return new FsResult(0, name);
    }
    int i = 0;
    while (i < name.length()) {
        char c = name[i];
        bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '.' || c == '_' || c == '-';
        if (!ok) {
            return new FsResult(5, "");
        }
        i = i + 1;
    }
    if (name == "." || name == "..") {
        return new FsResult(5, "");
    }
    string file = name;
    char listSeparator = ':';
    string slash = "/";
    if (windows) {
        listSeparator = ';';
        slash = "\\";
        if (!endsWithExe(name)) {
            file = name + ".exe";
        }
    }
    string path = "";
    if (app_os_env("PATH", path) != 1) {
        return new FsResult(2, "");
    }
    std::vector<string> dirs = splitOn(path, listSeparator);
    int d = 0;
    while (d < dirs.size()) {
        string dir = dirs[d];
        d = d + 1;
        if (windows && dir.length() >= 2 && dir[0] == '"' && dir[dir.length() - 1] == '"') {
            dir = dir.substr(1, dir.length() - 2);
        }
        bool absolute = dir.length() > 0 && dir[0] == '/';
        if (windows) {
            absolute = windowsAbsolute(dir);
        }
        if (!absolute) {
            continue;
        }
        while (dir.length() > 3 && (dir[dir.length() - 1] == '/' || dir[dir.length() - 1] == '\\')) {
            dir = dir.substr(0, dir.length() - 1);
        }
        string candidate = dir + slash + file;
        if (dir[dir.length() - 1] == '/' || dir[dir.length() - 1] == '\\') {
            candidate = dir + file;
        }
        if (runnable(candidate, windows)) {
            return new FsResult(0, candidate);
        }
    }
    return new FsResult(2, "");
}

// "replace" (default), "append" or "create" as the numbers FileGate.write takes
int writeMode(Item args) {
    string mode = optionalString(args, "mode", "replace");
    if (mode == "append") {
        return 1;
    }
    if (mode == "create") {
        return 2;
    }
    if (mode != "replace") {
        throw "invalid_argument: `mode` must be \"replace\", \"append\" or \"create\"";
    }
    return 0;
}

// the folders above `path` that do not exist yet (inside an allowed place, like everything else)
void makeParents(FileGate files, string path) {
    FsResult n = files.normalize(path, true, true);
    fsCheck(n.status, "cannot write " + path);
    int st = files.mkdir(files.parentOf(n.text), true);
    if (st != 6) {
        fsCheck(st, "cannot create the folder for " + path);
    }
}

// ---- programs the application runs itself -------------------------------------------------------------------------------
// A command that is the application's own (not a page's choice from the allowProgram table) runs a program like this: the main thread
// builds a ToolRun from values it has vetted, a worker calls runTool, and the worker answers the page (or sends the main loop a
// `Later` record when the answer needs the main thread, which alone may touch the file policy). Both structs hold plain values only,
// so they can be copied into a worker.
struct ToolRun {
public:
    int handle;              // the window and page call this run belongs to: cancelling the call (or closing the window) kills the program
    string call;
    string exe;
    std::vector<string> args;
    string cwd;
    std::vector<string> env;
    int timeoutMs;
    int maxBytes;
    ToolRun(string e, string c, int t, int m) {
        handle = 0;
        call = "";
        exe = e;
        cwd = c;
        timeoutMs = t;
        maxBytes = m;
    }
};

struct ToolResult {
public:
    int status;              // 0 it ran; else the native status (2 program or folder missing, 4 could not start, 5 refused)
    string out;
    string err;
    int exitCode;
    int flags;               // 1 timed out, 2 stdout cut, 4 stderr cut
    ToolResult() {
        status = 0;
        exitCode = 0;
        flags = 0;
    }
    // ran, did not time out, exited 0
    bool succeeded() {
        return status == 0 && (flags % 2) == 0 && exitCode == 0;
    }
    // what to tell the page when it did not succeed: the program's own complaint, else the reason
    string complaint() {
        if (status == 2) {
            return "program_not_found: the program or its working folder does not exist";
        }
        if (status != 0) {
            return "spawn_failed: the program could not be started";
        }
        if ((flags % 2) == 1) {
            return "timed_out: the program took too long";
        }
        if (((flags / 8) % 2) == 1) {
            return "cancelled: the call was abandoned or the window is closing";
        }
        string text = trimText(cleanUtf8(err));
        if (text.length() == 0) {
            text = trimText(cleanUtf8(out));
        }
        if (text.length() == 0) {
            text = "the program exited with code " + intToString(exitCode);
        }
        return "command_failed: " + text;
    }
};

// What the native runner is given must already be fit for the operating system: absolute paths, text that is valid UTF-8 without a NUL, environment
// entries of the form NAME=value, limits in range. The native layer checks none of it (it only runs what it is handed), so this is the one place.
bool runFitsOs(string exe, std::vector<string> args, string cwd, std::vector<string> env, int timeoutMs, int maxBytes) {
    bool windows = app_os_windows() == 1;
    bool exeAbsolute = exe.length() > 0 && exe[0] == '/';
    bool cwdAbsolute = cwd.length() > 0 && cwd[0] == '/';
    if (windows) {
        exeAbsolute = windowsAbsolute(exe);
        cwdAbsolute = windowsAbsolute(cwd);
    }
    if (!exeAbsolute || !cwdAbsolute || !plainText(exe, 32000) || !plainText(cwd, 32000)) {
        return false;
    }
    if (timeoutMs < 1 || timeoutMs > 600000 || maxBytes < 0 || maxBytes > 67108864) {
        return false;
    }
    int i = 0;
    while (i < args.size()) {
        if (!plainText(args[i], 32000)) {
            return false;
        }
        i = i + 1;
    }
    int e = 0;
    while (e < env.size()) {
        string entry = env[e];
        if (!plainText(entry, 32000) || indexOfChar(entry, '=') < 1) {
            return false;
        }
        e = e + 1;
    }
    return true;
}

bool toolRunOk(ToolRun run) {
    return runFitsOs(run.exe, run.args, run.cwd, run.env, run.timeoutMs, run.maxBytes);
}

ToolResult runTool(ToolRun run) {
    ToolResult r = new ToolResult();
    if (!toolRunOk(run)) {
        r.status = 5;
        return r;
    }
    r.status = app_proc_run(run.handle, run.call, run.exe, run.args, run.cwd, run.env, run.timeoutMs, run.maxBytes, r.out, r.err, r.exitCode, r.flags);
    return r;
}

// runTool, or throws the complaint ("code: message") when the program could not run, timed out or exited non-zero. For use in a worker's job:
// a throw there rejects the page's promise with that code and message.
ToolResult runToolOrThrow(ToolRun run) {
    ToolResult r = runTool(run);
    if (!r.succeeded()) {
        string complaint = r.complaint();
        throw complaint;
    }
    return r;
}

// ---- background work whose last step needs the main thread -----------------------------------------------------------
// The file policy (FileGate) and every other piece of state belongs to the main thread, so a worker that has to read or write a file
// after its program has finished cannot do it itself. It sends the main loop a record instead: finishLater(handle, id, status, text).
// The command registered a `Later` for that page call (App.later); the main loop runs its `done` with the worker's result.
class Later {
public:
    Later() { }
    virtual void done(int handle, string id, int status, string payload) { }
};

class LaterBook {
public:
    std::vector<int> handles;      // the window each call came from: a call id is only unique within its window
    std::vector<string> ids;
    std::vector<Later> items;
    LaterBook() { }
    int indexOf(int handle, string id) {
        int i = 0;
        while (i < ids.size()) {
            if (ids[i] == id && handles[i] == handle) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }
    void drop(int index) {
        int last = ids.size() - 1;
        if (index != last) {
            handles[index] = handles[last];
            ids[index] = ids[last];
            items[index] = items[last];
        }
        handles.pop_back();
        ids.pop_back();
        items.pop_back();
    }
    // A window is gone: the calls it was still waiting for are forgotten.
    void forgetWindow(int handle) {
        int i = ids.size() - 1;
        while (i >= 0) {
            if (handles[i] == handle) {
                drop(i);
            }
            i = i - 1;
        }
    }
};

// Runs on the worker: status 0 means `payload` is the JSON for the page, anything else means it is "code: message".
void finishLater(int handle, string id, int status, string payload) {
    string record = "later";
    record.push_back(char(0));
    record = record + id;
    record.push_back(char(0));
    record = record + intToString(status);
    record.push_back(char(0));
    record = record + payload;
    record.push_back(char(0));
    if (app_push(handle, "", record, 100000) != 1) {
        replyError(handle, id, "busy", "the application is not keeping up");
    }
}

// ---- work that goes through a Channel and needs the main thread ----------------------------------------------------------
// A worker that needs something only the main thread may do (read a file through the file policy, say) sends a request on a Channel<T>
// and waits for the answer on another; the main thread answers from a pump. The main loop sleeps in its own queue, so a send on a
// Channel does not wake it: the worker calls wakeMain(handle, name) after sending, and the loop runs the pump registered under that name
// (App.onPump), which drains the channel:
//
//     Channel<Job> toMain;                                    // struct Job { string path; Channel<string> reply; ... }
//     app.onPump("files", closure Pump [toMain] (FileGate gate) {
//         while (toMain.wait(0)) {                           // poll: never wait on the main thread
//             Job j = toMain.take();
//             j.reply.send(gate.read(j.path, 1048576).text);
//         }
//     });
//     // in a worker (spawn): toMain.send(new Job(path, reply)); wakeMain(handle, "files"); reply.wait(5000) ...
//
// A pump must not throw (there is no page call to reject; the error is dropped) and must not wait: it runs on the thread that serves the window.
class Pump {
public:
    Pump() { }
    virtual void pump(FileGate gate) { }
};

class PumpBook {
public:
    std::vector<string> names;
    std::vector<Pump> items;
    PumpBook() { }
    int indexOf(string name) {
        int i = 0;
        while (i < names.size()) {
            if (names[i] == name) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }
};

// Runs on a worker: asks the main loop to run the pump called `name`. false if the main loop's queue is full (the pump will run on the next
// wake, so a worker that must not stall should wake again later).
bool wakeMain(int handle, string name) {
    string record = "pump";
    record.push_back(char(0));
    record = record + name;
    record.push_back(char(0));
    return app_push(handle, "", record, 100000) == 1;
}

// ---- watching folders -----------------------------------------------------------------------------
// fs.watch {path, recursive?} starts a watch and answers {id}; changes then arrive on the page as "fs.change" events
//     {watch: id, kind: "created" | "modified" | "removed", path}              path is relative to the watched folder
//     {watch: id, kind: "renamed", path: newName, from: oldName}
//     {watch: id, kind: "overflow"}                                              events were lost: read the folder again
//     {watch: id, kind: "stopped", reason: "closed" | "access_revoked" | "folder_gone" | "failed"}   no more will come
// The native watcher thread queues one record per change (id empty: a page's own call always has one); this side merges bursts
// (a program saving a file touches it many times in a few milliseconds), re-checks the permission before every delivery, and
// ends a watch whose folder can no longer be reached. At most 32 watches at a time.

class WatchEvent {
public:
    string kind;
    string path;
    string from;
    WatchEvent(string k, string p, string f) {
        kind = k;
        path = p;
        from = f;
    }
};

class WatchState {
public:
    int id;
    string root;                       // canonical, as FileGate.resolve spelled it
    std::vector<WatchEvent> pending;   // merged, not yet delivered
    bool overflowed;
    double firstAt;                    // when the oldest pending event arrived
    double lastAt;                     // when the newest did
    WatchState(int watchId, string folder) {
        id = watchId;
        root = folder;
        overflowed = false;
        firstAt = 0.0;
        lastAt = 0.0;
    }

    void clearPending() {
        while (pending.size() > 0) {
            pending.pop_back();
        }
        overflowed = false;
    }

    // The same change again straight away, or one more "modified" for a file that already has one, adds nothing.
    void merge(string kind, string path, string from, double now) {
        if (pending.size() == 0) {
            firstAt = now;
        }
        lastAt = now;
        if (kind == "overflow") {
            overflowed = true;
            return;
        }
        int i = 0;
        while (i < pending.size()) {
            WatchEvent e = pending[i];
            bool same = e.kind == kind && e.path == path && e.from == from;
            if (same && (kind == "modified" || i == pending.size() - 1)) {
                return;
            }
            i = i + 1;
        }
        if (pending.size() >= 500) {
            overflowed = true;
            return;
        }
        pending.push_back(new WatchEvent(kind, path, from));
    }
};

void emitWatchEvent(int handle, int watch, string kind, string path, string from) {
    if (!isUtf8(path) || !isUtf8(from)) {
        return;
    }
    Item e = createObject();
    addNumberToObject(e, "watch", double(watch));
    addStringToObject(e, "kind", kind);
    if (kind == "stopped") {
        addStringToObject(e, "reason", path);
    } else if (kind != "overflow") {
        addStringToObject(e, "path", path);
        if (kind == "renamed") {
            addStringToObject(e, "from", from);
        }
    }
    emitEvent(handle, "fs.change", printUnformatted(e));
}

// All the watches of a window, with the logic that delivers them.
class Watches {
public:
    std::vector<WatchState> states;
    Watches() { }

    int indexOf(int id) {
        int i = 0;
        while (i < states.size()) {
            WatchState s = states[i];
            if (s.id == id) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    // (order does not matter: the last one takes the place of the dropped one)
    void drop(int index) {
        int last = states.size() - 1;
        if (index != last) {
            states[index] = states[last];
        }
        states.pop_back();
    }

    bool anyPending() {
        int i = 0;
        while (i < states.size()) {
            WatchState s = states[i];
            if (s.pending.size() > 0 || s.overflowed) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    // Delivers what a watch has merged so far, after checking that the folder can still be reached. If it cannot (the
    // permission was withdrawn, or the folder is gone) the watch ends: the thread is stopped and "stopped" is the last event.
    void flush(FileGate gate, int handle, int index) {
        WatchState s = states[index];
        FsResult now = gate.resolve(s.root, 2);
        if (now.status != 0 || now.text != s.root) {
            string reason = "access_revoked";
            if (now.status == 2) {
                reason = "folder_gone";
            }
            app_watch_stop(handle, s.id);
            emitWatchEvent(handle, s.id, "stopped", reason, "");
            drop(index);
            return;
        }
        int i = 0;
        while (i < s.pending.size()) {
            WatchEvent e = s.pending[i];
            emitWatchEvent(handle, s.id, e.kind, e.path, e.from);
            i = i + 1;
        }
        if (s.overflowed) {
            emitWatchEvent(handle, s.id, "overflow", "", "");
        }
        s.clearPending();
    }

    // Delivers every watch that has been quiet for 40 ms, or has been collecting for 400 ms.
    void flushQuiet(FileGate gate, int handle) {
        double now = app_now_ms();
        int i = states.size() - 1;
        while (i >= 0) {
            WatchState s = states[i];
            bool some = s.pending.size() > 0 || s.overflowed;
            if (some && (now - s.lastAt >= 40.0 || now - s.firstAt >= 400.0)) {
                flush(gate, handle, i);
            }
            i = i - 1;
        }
    }

    // A record from the native watcher: "watch" id kind path from.
    void onRecord(FileGate gate, int handle, std::vector<string> f) {
        if (f.size() < 5) {
            return;
        }
        int index = indexOf(int(decimalValue(f[1])));
        if (index < 0) {
            return;
        }
        WatchState s = states[index];
        string kind = f[2];
        if (kind == "stopped") {
            if (s.pending.size() > 0 || s.overflowed) {
                flush(gate, handle, index);
                index = indexOf(s.id);
            }
            if (index >= 0) {
                app_watch_stop(handle, s.id);
                emitWatchEvent(handle, s.id, "stopped", f[3], "");
                drop(index);
            }
            return;
        }
        s.merge(kind, f[3], f[4], app_now_ms());
    }
};

// ---- the window -----------------------------------------------------------------------------------
class WindowState {
public:
    int handle;
    bool dirty;                // the page says it has unsaved work (window.setDirty)
    bool confirming;           // a "close anyway?" box is open
    bool confirm;              // confirmClose was called: the close button asks (applied when the window exists)
    bool hides;                // hideOnClose: the close button hides the window instead
    string closeTitle;
    string closeMessage;
    WindowState() {
        handle = 0;
        dirty = false;
        confirming = false;
        confirm = false;
        hides = false;
        closeTitle = "";
        closeMessage = "";
    }
};

// One open window: what belongs to it and not to the application. The application (App) owns the commands, the file policy, the programs;
// a Window owns its handle, its close-button state, its watches, the addresses it may load and (through the Dispatcher) its command list.
// The pop-up menus a page may ask for, by name. Only the application adds to it (App.allowPopup).
class PopupBook {
public:
    std::vector<string> names;
    std::vector<Menu> menus;
    PopupBook() { }

    int indexOf(string name) {
        int i = 0;
        while (i < names.size()) {
            if (names[i] == name) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    // true if some pop-up menu has an enabled item with this id
    bool hasItem(string id) {
        int i = 0;
        while (i < menus.size()) {
            Menu m = menus[i];
            int k = m.indexOfId(id);
            if (k >= 0 && (m.kinds[k] == "i" || m.kinds[k] == "c") && (m.flags[k] / 2) % 2 == 0) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
};

class Window {
public:
    int handle;
    WindowState state;
    Watches watches;
    std::vector<string> navigation;
    CommandRules rules;
    string memoryKey;                  // the name under which WindowMemory keeps this window's place ("" = not remembered)
    Menu menu;                         // the menu bar now on the window (empty = none)
    Window(int h, CommandRules r) {
        menu = new Menu();
        memoryKey = "";
        handle = h;
        state = new WindowState();
        state.handle = h;
        watches = new Watches();
        rules = r;
    }

    // Pushes an event to this window's page (see emitEvent).
    bool emit(string name, string payloadJson) {
        return emitEvent(handle, name, payloadJson);
    }

    // The close button (X, Alt+F4) hides the window instead of closing it; the program, and the page in the hidden window, keep running. Bring the window back
    // with show() (a tray icon's menu is the usual way), end the program with App.quit(). Hiding loses nothing, so it does not ask about unsaved work. Windows only.
    bool hideOnClose(bool on) {
        state.hides = on;
        int guard = 0;
        if (on || state.confirm) {
            guard = 1;
        }
        return app_window_guard(handle, guard) >= 0;
    }

    // Hides the window now (it has no taskbar button either) and shows it again with show().
    bool hide() {
        return app_window_state(handle, 5) >= 0;
    }

    // Shows the window again if it was hidden, restores it if it was minimized, and brings it to the front.
    bool show() {
        return app_window_state(handle, 6) >= 0;
    }

    // Puts a menu bar on this window (src/menu.clg): every id, label and shortcut was checked when the menu was built, and the top level must be only submenus.
    // The menu is taken over by the window; to change it later use setEnabled / setChecked or set a new one. false if the menu is not a complete bar, or the system
    // cannot show one (not Windows).
    bool setMenu(Menu bar) {
        if (!bar.complete() || !bar.isBar()) {
            return false;
        }
        if (app_menu_set(handle, bar.spec()) != 0) {
            return false;
        }
        menu = bar;
        return true;
    }

    bool removeMenu() {
        menu = new Menu();
        return app_menu_set(handle, "") == 0;
    }

    // Greys out or enables an item of the menu bar (and its shortcut stops working while it is grey).
    bool setEnabled(string id, bool enabled) {
        int i = menu.indexOfId(id);
        if (i < 0) {
            return false;
        }
        int on = 0;
        if (enabled) {
            on = 1;
        }
        menu.flags[i] = menu.flags[i] % 2 + 2 - 2 * on;
        return app_menu_item(handle, id, on, -1) == 0;
    }

    // Ticks or unticks an item that was made with check().
    bool setChecked(string id, bool checked) {
        int i = menu.indexOfId(id);
        if (i < 0 || menu.kinds[i] != "c") {
            return false;
        }
        int on = 0;
        if (checked) {
            on = 1;
        }
        menu.flags[i] = (menu.flags[i] / 2) * 2 + on;
        return app_menu_item(handle, id, -1, on) == 0;
    }

    // true if the item was made with check() and is ticked now
    bool isChecked(string id) {
        int i = menu.indexOfId(id);
        return i >= 0 && menu.kinds[i] == "c" && menu.flags[i] % 2 == 1;
    }

    // true if the item exists, can be clicked (not a submenu) and is not greyed out
    bool menuItemEnabled(string id) {
        int i = menu.indexOfId(id);
        if (i < 0) {
            return false;
        }
        string kind = menu.kinds[i];
        return (kind == "i" || kind == "c") && (menu.flags[i] / 2) % 2 == 0;
    }

    // Closes the window at once, without asking (see requestClose).
    void close() {
        app_terminate(handle);
    }

    // Asks the window to close as if the user had pressed the X: a window with confirmClose and unsaved work asks first.
    void requestClose() {
        app_window_state(handle, 4);
    }

    bool setTitle(string title) {
        if (title.length() == 0 || !plainText(title, 200)) {
            return false;
        }
        return app_window_title(handle, title) == 1;
    }

    // When the user closes this window (the X, Alt+F4) while its page has said it has unsaved work, ask first with a native box whose text
    // is the application's, not the page's.
    bool confirmClose(string title, string message) {
        if (!plainText(title, 200) || !plainText(message, 4000)) {
            return false;
        }
        state.closeTitle = title;
        state.closeMessage = message;
        state.confirm = true;
        return app_window_guard(handle, 1) >= 0;
    }

    // From now on this window may also load addresses that start with `prefix` (the event window.navigationBlocked reports the rest).
    bool allowNavigation(string prefix) {
        if (prefix.length() < 5 || !plainText(prefix, 1000)) {
            return false;
        }
        navigation.push_back(prefix);
        app_navigation_allow(handle, navigation);
        return true;
    }

    // This window's page may call only the commands named here (every name must be registered); a list of its own replaces the application's.
    // false, and nothing changes, if a name is not registered.
    bool allowOnlyCommands(std::vector<string> names) {
        int i = 0;
        while (i < names.size()) {
            if (!rules.hasCommand(names[i])) {
                return false;
            }
            i = i + 1;
        }
        rules.restrictWindow(handle, names);
        return true;
    }
};

// The open windows, by handle.
class WindowBook {
public:
    std::vector<int> handles;
    std::vector<Window> items;
    WindowBook() { }

    // Pushes an event to the page of every open window.
    void emitAll(string name, string payloadJson) {
        int i = 0;
        while (i < items.size()) {
            Window w = items[i];
            emitEvent(w.handle, name, payloadJson);
            i = i + 1;
        }
    }

    int indexOf(int handle) {
        int i = 0;
        while (i < handles.size()) {
            if (handles[i] == handle) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    // The window with this handle, or nullptr.
    Window get(int handle) {
        int i = indexOf(handle);
        if (i < 0) {
            return nullptr;
        }
        Window w = items[i];
        return w;
    }

    int count() {
        return handles.size();
    }

    void add(Window w) {
        handles.push_back(w.handle);
        items.push_back(w);
    }

    void drop(int index) {
        int last = handles.size() - 1;
        if (index != last) {
            handles[index] = handles[last];
            items[index] = items[last];
        }
        handles.pop_back();
        items.pop_back();
    }

    bool anyPending() {
        int i = 0;
        while (i < items.size()) {
            Window w = items[i];
            if (w.watches.anyPending()) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    void flushQuiet(FileGate gate) {
        int i = 0;
        while (i < items.size()) {
            Window w = items[i];
            w.watches.flushQuiet(gate, w.handle);
            i = i + 1;
        }
    }
};

// A page path for a window the page asks to open: inside the program's own site, plain, no parent folders, no scheme.
bool pagePathOk(string path) {
    if (path.length() < 1 || path.length() > 300 || path[0] != '/' || !plainText(path, 300)) {
        return false;
    }
    if (containsText(path, "..") || containsText(path, "//") || containsText(path, "\\") || containsText(path, ":")) {
        return false;
    }
    return true;
}

// A running application: commands, the file policy, programs, and any number of windows.
// The origin ("http://localhost:5173") of a development server address, or "" if the address is not one we load. Only the machine's own
// loopback names are accepted, over plain http, with an optional port and no user name: a development server is a program on this machine
// that serves the page while it is being written, and nothing else may be given the application's commands.
string devServerOrigin(string url) {
    if (url.length() > 300 || !plainText(url, 300) || !startsWithText(url, "http://")) {
        return "";
    }
    string rest = url.substr(7, url.length() - 7);
    int slash = indexOfChar(rest, '/');
    string hostPort = rest;
    if (slash >= 0) {
        hostPort = rest.substr(0, slash);
    }
    string host = hostPort;
    string port = "";
    int colon = indexOfChar(hostPort, ':');
    if (startsWithText(hostPort, "[")) {
        int close = indexOfChar(hostPort, ']');
        if (close < 0) {
            return "";
        }
        host = hostPort.substr(0, close + 1);
        if (close + 1 < hostPort.length()) {
            if (hostPort[close + 1] != ':') {
                return "";
            }
            port = hostPort.substr(close + 2, hostPort.length() - close - 2);
        }
    } else if (colon >= 0) {
        host = hostPort.substr(0, colon);
        port = hostPort.substr(colon + 1, hostPort.length() - colon - 1);
    }
    if (host != "localhost" && host != "127.0.0.1" && host != "[::1]") {
        return "";
    }
    if (hostPort.length() > host.length()) {
        if (port.length() == 0 || port.length() > 5 || !isDigits(port) || decimalValue(port) < 1.0 || decimalValue(port) > 65535.0) {
            return "";
        }
    }
    return "http://" + hostPort;
}

class App {
public:
    int handle;
    Dispatcher dispatcher;
    ProgramRegistry programs;
    LaterBook laters;
    PumpBook pumps;
    FileGate gate;
    SettingsStore settings;            // the application's own settings file (empty until open() is called on it)
    bool instanceClaimed;              // claimInstance made this process the one instance: the first window listens for later launches
    WindowMemory memory;               // where windows were last (rememberWindows)
    bool stayWithoutWindows;           // keepRunning: the program goes on with no window open (only a tray icon) until quit() is called
    bool quitCalled;
    Notifier notifier;                 // notifications (enableNotifications)
    NotificationAction notifyHandler;  // what runs when one is clicked (onNotificationClick)
    PopupBook popups;                  // the pop-up menus a page may ask for (allowPopup)
    std::vector<int> trays;            // the handles of the tray icons that are open
    std::vector<Menu> trayMenus;
    TrayAction trayHandler;            // what runs when the tray icon is clicked (onTray)
    MenuAction menuHandler;            // what runs when a menu item is clicked (onMenu)
    bool menuToPage;                   // a click is also an event for the page of the window (menuEventsToPage)
    LinkRules links;                   // what a page may ask the system to open (allowLinkSchemes, allowOpenExtensions, enableShellCommands)
    WindowBook windows;                // the open windows
    std::vector<int> opened;           // every window this application ever opened (close() closes them all, even those already closed by the user)
    Watches watches;                   // the first window's (see `handle`); each Window has its own
    WindowState window;                // the first window's
    std::vector<string> navigation;    // addresses every window opened from now on may load after the application's own page (allowNavigation)
    int maxRequestBytes;
    int maxQueuedCalls;
    string siteStart;          // the address windows open on, when the program serves its own web files
    string siteOrigin;         // the origin the program's own web files are served under ("" until openSite)
    int maxWindows;            // how many windows a page may ask for (enableWindowOpenCommand); 0 = a page may not open windows
    bool confirmDefault;       // confirmClose was called: every window asks before it closes with unsaved work
    string confirmTitle;
    string confirmMessage;

    App() {
        handle = 0;
        dispatcher = new Dispatcher();
        programs = new ProgramRegistry();
        laters = new LaterBook();
        pumps = new PumpBook();
        gate = new FileGate();
        settings = new SettingsStore();
        links = new LinkRules();
        memory = new WindowMemory();
        menuHandler = new MenuAction();
        trayHandler = new TrayAction();
        popups = new PopupBook();
        notifier = new Notifier();
        notifyHandler = new NotificationAction();
        stayWithoutWindows = false;
        quitCalled = false;
        menuToPage = false;
        instanceClaimed = false;
        cling::setExitGraceMs(5000);
        windows = new WindowBook();
        watches = new Watches();
        window = new WindowState();
        maxRequestBytes = 4194304;
        maxQueuedCalls = 256;
        siteStart = "";
        siteOrigin = "";
        maxWindows = 0;
        confirmDefault = false;
        confirmTitle = "";
        confirmMessage = "";
    }

    void command(string name, Command handler) {
        dispatcher.add(name, handler);
    }

    void asyncCommand(string name, AsyncCommand handler) {
        dispatcher.addAsync(name, handler);
    }

    // Pushes an event to the page of EVERY open window (see emitEvent; Window.emit addresses one). Safe to call from the main thread only
    // through this method; worker jobs use emitEvent with a captured handle. true if some window took it.
    bool emit(string name, string payloadJson) {
        bool any = false;
        int i = 0;
        while (i < windows.items.size()) {
            Window w = windows.items[i];
            if (emitEvent(w.handle, name, payloadJson)) {
                any = true;
            }
            i = i + 1;
        }
        return any;
    }

    // Adds a folder the page may reach through the file commands. Nothing is reachable until at least one is added;
    // a relative path from the page means "inside the first folder added". false if the folder does not exist.
    bool allowFolder(string dir) {
        return gate.allow(dir) == 0;
    }

    // Makes the application's own folder for `kind` ("data" or "cache", see appFolderPath in settings.clg) and adds it to the folders the page may
    // reach through the file commands. false if the name or the kind is not acceptable, the environment does not say where the folder is, or it
    // cannot be made. "config" is refused on purpose: it holds settings.json, which a page may change only through the settings commands (and only
    // the keys the application declared).
    bool allowAppFolder(string appName, string kind) {
        if (kind == "config") {
            return false;
        }
        string path = appFolderPath(kind, appName);
        if (path.length() == 0) {
            return false;
        }
        makeAppFolder(kind, appName);
        return gate.allow(path) == 0;
    }

    // Registers settings.get {key} -> the value, settings.getAll {} -> {key: value, ...} and settings.set {key, value} -> null for the settings the
    // application declared in `app.settings` (open it, declare the keys, load it: see SettingsStore in settings.clg). Nothing else is reachable: a key that is not declared is "unknown_setting", a value that does not
    // fit its declaration is "invalid_argument", and a write that could not be saved is "io_error" (the page's promise is rejected; the value in
    // memory is changed). Every window may call them unless its command list says otherwise. After a successful set the page of EVERY window gets
    // the event "settings.changed" {key, value}.
    void enableSettingsCommands() {
        SettingsStore settings = this.settings;
        command("settings.get", closure Command [settings] (Item args) {
            string key = requiredString(args, "key");
            Item value = settings.valueItem(key);
            if (value == nullptr) {
                string message = "unknown_setting: `" + key + "` is not a declared setting";
                throw message;
            }
            return value;
        });
        command("settings.getAll", closure Command [settings] (Item args) {
            return settings.allItem();
        });
        WindowBook book = windows;
        command("settings.set", closure Command [settings, book] (Item args) {
            string key = requiredString(args, "key");
            Item given = getObjectItem(objectArg(args), "value");
            if (given == nullptr) {
                throw "invalid_argument: `value` is missing";
            }
            string why = settings.set(key, given);
            if (why.length() > 0) {
                throw why;
            }
            Item changed = createObject();
            addStringToObject(changed, "key", key);
            addItemToObject(changed, "value", settings.valueItem(key));
            book.emitAll("settings.changed", printUnformatted(changed));
            return createNull();
        });
    }

    // ---- starting up on someone else's computer ----

    // Is what the window needs installed? On Windows the window is the Microsoft WebView2 Runtime, which every current Windows has but an older Windows 10 may not.
    // If it is missing, a message box (it needs no window) says so and offers the download page; the answer here is false and the program should end:
    //     if (!app.checkRuntime("My app")) { return 1; }
    // true if the runtime is there or nothing is needed on this system. Call it before the first window is opened; `appName` is plain text of at most 80 bytes.
    bool checkRuntime(string appName) {
        string version = "";
        if (app_runtime_version(version) != 1) {
            return true;
        }
        string name = appName;
        if (name.length() == 0 || !plainText(name, 80)) {
            name = "This program";
        }
        string text = name + " needs the Microsoft WebView2 Runtime to show its window, and this computer does not have it.\n\nOpen the page where Microsoft offers it?";
        if (app_message_box(name, text, 1) == 1) {
            app_shell_open("https://developer.microsoft.com/microsoft-edge/webview2/", 0);
        }
        return false;
    }

    // A message box with an OK button and no window of ours, for what a program has to say when it cannot open its window (a program without a console has nowhere to
    // print to). Title up to 80 and text up to 1000 bytes of plain text. false if it could not be shown.
    bool showMessage(string title, string text) {
        if (title.length() == 0 || !plainText(title, 80) || text.length() == 0 || !plainText(text, 1000)) {
            return false;
        }
        return app_message_box(title, text, 0) >= 0;
    }

    // ---- opening things in the system (src/links.clg) ----

    // The address schemes a page may open in the default browser, from http, https and mailto. Until this is called no address is opened.
    bool allowLinkSchemes(std::vector<string> schemes) {
        return links.allowSchemes(schemes);
    }

    // The extensions ("pdf", "txt") of the files a page may open in their default program. Extensions that start a program or a script are refused.
    bool allowOpenExtensions(std::vector<string> extensions) {
        return links.allowExtensions(extensions);
    }

    // A click (not a script) on a link that leaves the application, or on one with target=_blank, opens the address in the default browser when its
    // scheme is allowed (allowLinkSchemes). Off by default; the event window.navigationBlocked is sent either way.
    void openLinksInBrowser(bool on) {
        links.browserLinks = on;
    }

    // Registers shell.openUrl {url}, shell.openFile {path} and shell.reveal {path}, all answering null:
    //   openUrl   an address of an allowed scheme, in the default browser;
    //   openFile  a regular file the file policy lets the page reach, with an extension from allowOpenExtensions, in its default program;
    //   reveal    a file or folder the file policy lets the page reach, shown in the file manager (starts nothing).
    // At most about three opens a second. A refused address or file is "invalid_argument" / "forbidden" / "not_found" ..., a limit is "too_many".
    void enableShellCommands() {
        LinkRules rules = links;
        FileGate files = gate;
        command("shell.openUrl", closure Command [rules] (Item args) {
            string url = requiredString(args, "url");
            string why = rules.openAddress(url);
            if (why.length() > 0) {
                throw why;
            }
            return createNull();
        });
        command("shell.openFile", closure Command [rules, files] (Item args) {
            string path = requiredString(args, "path");
            FsResult r = files.resolve(path, 1);
            fsCheck(r.status, "cannot open " + path);
            if (!rules.extensionAllowed(r.text)) {
                throw "forbidden: this application does not open files of that type";
            }
            if (!rules.mayOpenNow()) {
                throw "too_many: files are opened at most about three times a second";
            }
            if (app_shell_open(r.text, 0) != 0) {
                throw "io_error: the file could not be handed to the system";
            }
            return createNull();
        });
        command("shell.reveal", closure Command [rules, files] (Item args) {
            string path = requiredString(args, "path");
            FsResult r = files.resolve(path, 0);
            fsCheck(r.status, "cannot show " + path);
            if (!rules.mayOpenNow()) {
                throw "too_many: files are shown at most about three times a second";
            }
            if (app_shell_open(r.text, 1) != 0) {
                throw "io_error: the file could not be shown";
            }
            return createNull();
        });
    }

    // Withdraws everything the user granted through dialogs (the folders added with allowFolder stay).
    void revokeGrants() {
        gate.revokeGrants();
    }

    // Registers fs.read, fs.write, fs.list, fs.stat, fs.exists, fs.mkdir and fs.remove. Every path is checked by the
    // FileGate against the folders added with allowFolder. fs.read refuses files larger than maxReadBytes and files that
    // are not valid UTF-8 (text only; binary needs its own command).
    void enableFileCommands(int maxReadBytes) {
        FileGate files = gate;
        command("fs.read", closure Command [files, maxReadBytes] (Item args) {
            string path = requiredString(args, "path");
            FsResult r = files.read(path, maxReadBytes);
            fsCheck(r.status, "cannot read " + path);
            if (!isUtf8(r.text)) {
                throw "not_text: the file is not valid UTF-8";
            }
            Item result = createObject();
            addStringToObject(result, "text", r.text);
            return result;
        });
        command("fs.write", closure Command [files] (Item args) {
            string path = requiredString(args, "path");
            string text = requiredString(args, "text");
            int code = writeMode(args);
            if (optionalBool(args, "parents", false)) {
                makeParents(files, path);
            }
            fsCheck(files.write(path, text, code), "cannot write " + path);
            return createNull();
        });
        // the same for bytes: {base64} instead of {text}; a binary file travels through JSON as base64 text
        command("fs.writeBytes", closure Command [files] (Item args) {
            string path = requiredString(args, "path");
            string encoded = requiredString(args, "base64");
            int code = writeMode(args);
            if (!isBase64(encoded)) {
                throw "invalid_argument: `base64` is not well-formed base64";
            }
            if (optionalBool(args, "parents", false)) {
                makeParents(files, path);
            }
            fsCheck(files.write(path, base64Decode(encoded), code), "cannot write " + path);
            return createNull();
        });
        command("fs.readBytes", closure Command [files, maxReadBytes] (Item args) {
            string path = requiredString(args, "path");
            FsResult r = files.read(path, maxReadBytes);
            fsCheck(r.status, "cannot read " + path);
            Item result = createObject();
            addStringToObject(result, "base64", base64Encode(r.text));
            return result;
        });
        command("fs.list", closure Command [files] (Item args) {
            string path = requiredString(args, "path");
            FsResult r = files.list(path);
            fsCheck(r.status, "cannot list " + path);
            std::vector<string> parts = splitFields(r.text);
            Item listing = createArray();
            int i = 0;
            while (i + 3 < parts.size()) {
                string name = parts[i + 3];
                if (isUtf8(name)) {
                    addItemToArray(listing, entryItem(parts[i], parts[i + 1], parts[i + 2], name));
                }
                i = i + 4;
            }
            return listing;
        });
        command("fs.stat", closure Command [files] (Item args) {
            string path = requiredString(args, "path");
            FsResult r = files.stat(path);
            fsCheck(r.status, "cannot stat " + path);
            std::vector<string> parts = splitFields(r.text);
            if (parts.size() < 4 || !isUtf8(parts[3])) {
                throw "io_error: unreadable file entry";
            }
            return entryItem(parts[0], parts[1], parts[2], parts[3]);
        });
        command("fs.exists", closure Command [files] (Item args) {
            string path = requiredString(args, "path");
            FsResult r = files.stat(path);
            if (r.status == 2) {
                return createBool(false);
            }
            fsCheck(r.status, "cannot stat " + path);
            return createBool(true);
        });
        command("fs.mkdir", closure Command [files] (Item args) {
            string path = requiredString(args, "path");
            bool parents = optionalBool(args, "parents", false);
            int status = files.mkdir(path, parents);
            if (!(parents && status == 6)) {
                fsCheck(status, "cannot create " + path);
            }
            return createNull();
        });
        command("fs.remove", closure Command [files] (Item args) {
            string path = requiredString(args, "path");
            if (optionalBool(args, "recursive", false)) {
                fsCheck(files.removeTree(path, 0), "cannot remove " + path);
            } else {
                fsCheck(files.remove(path), "cannot remove " + path);
            }
            return createNull();
        });
    }

    // Declares a program the page may run, by name, with an argument template (see the comment above ProgramSpec).
    // `exe` is an absolute path to a .exe, or a bare name searched for on PATH only. Returns false, and registers
    // nothing, if the name or the template is malformed, the program cannot be found, or the name is taken.
    bool allowProgram(string name, string exe, std::vector<string> elements, int timeoutMs, int maxOutputBytes) {
        if (!programNameOk(name) || programs.indexOf(name) >= 0 || elements.size() > 64) {
            return false;
        }
        if (timeoutMs < 100 || timeoutMs > 600000 || maxOutputBytes < 0 || maxOutputBytes > 67108864) {
            return false;
        }
        FsResult found = resolveProgram(exe);
        if (found.status != 0) {
            return false;
        }
        ProgramSpec spec = new ProgramSpec(name, found.text, timeoutMs, maxOutputBytes);
        std::vector<string> names;
        int cwdCount = 0;
        int i = 0;
        while (i < elements.size()) {
            string element = elements[i];
            if (element.length() > 1000 || !plainText(element, 1000)) {
                return false;
            }
            if (startsWithText(element, "@cwd=")) {
                string inner = element.substr(5, element.length() - 5);
                if (elementSlotCheck(inner) != 1 || slotOpen(inner) != 0 || slotClose(inner) != inner.length() - 1) {
                    return false;
                }
                std::vector<string> parts = splitOn(inner.substr(1, inner.length() - 2), ':');
                if (parts.size() != 2 || parts[1] != "folder") {
                    return false;
                }
                cwdCount = cwdCount + 1;
                string cwdName = parts[0];
                names.push_back(cwdName);
            } else {
                int has = elementSlotCheck(element);
                if (has < 0) {
                    return false;
                }
                if (has == 1) {
                    int open = slotOpen(element);
                    int close = slotClose(element);
                    std::vector<string> parts = splitOn(element.substr(open + 1, close - open - 1), ':');
                    string slotName = parts[0];
                    names.push_back(slotName);
                }
            }
            spec.elements.push_back(element);
            i = i + 1;
        }
        if (cwdCount > 1) {
            return false;
        }
        int a = 0;
        while (a < names.size()) {
            int b = a + 1;
            while (b < names.size()) {
                if (names[a] == names[b]) {
                    return false;
                }
                b = b + 1;
            }
            a = a + 1;
        }
        spec.slotNames = names;
        programs.specs.push_back(spec);
        return true;
    }

    // Adds variables of this process that programs may see (see ProgramRegistry); everything else is withheld.
    bool passEnvironment(string name) {
        if (name.length() == 0 || !plainText(name, 200) || indexOfChar(name, '=') >= 0) {
            return false;
        }
        programs.envNames.push_back(name);
        return true;
    }

    // Registers proc.run: {program: "git.log", args: {count: 20, ...}} -> {exitCode, stdout, stderr, timedOut,
    // truncated: {stdout, stderr}, lossy}. A non-zero exit code is a result, not an error. Asynchronous: the program
    // runs on a worker, so the command loop keeps serving.
    void enableProcessCommands() {
        ProgramRegistry registry = programs;
        FileGate files = gate;
        asyncCommand("proc.run", closure AsyncCommand [registry, files] (Item args, string id, int handle) {
            string program = requiredString(args, "program");
            Item given = getObjectItem(args, "args");
            if (given == nullptr) {
                given = createObject();
            }
            if (!isObject(given)) {
                throw "invalid_argument: `args` must be an object";
            }
            int index = registry.indexOf(program);
            if (index < 0) {
                throw "unknown_program: no program is allowed under that name";
            }
            ProgramSpec spec = registry.specs[index];
            // every value in `args` must belong to a slot: nothing extra is passed along
            Item child = given.child;
            while (child != nullptr) {
                bool known = false;
                int k = 0;
                while (k < spec.slotNames.size()) {
                    if (spec.slotNames[k] == child.key) {
                        known = true;
                    }
                    k = k + 1;
                }
                if (!known) {
                    string message = "invalid_argument: `" + child.key + "` is not a parameter of " + program;
                    throw message;
                }
                child = child.next;
            }
            std::vector<string> argv;
            string cwd = "";
            int total = 0;
            int e = 0;
            while (e < spec.elements.size()) {
                string element = spec.elements[e];
                if (startsWithText(element, "@cwd=")) {
                    string inner = element.substr(5, element.length() - 5);
                    cwd = slotValue(files, inner.substr(1, inner.length() - 2), given, false);
                } else {
                    string rendered = renderElement(files, element, given);
                    if (!plainText(rendered, 32000)) {
                        throw "invalid_argument: an argument is not plain text";
                    }
                    total = total + rendered.length() + 3;
                    argv.push_back(rendered);
                }
                e = e + 1;
            }
            if (argv.size() > 256 || total > 30000) {
                throw "invalid_argument: too many or too long arguments";
            }
            if (cwd.length() == 0) {
                FsResult where = files.resolve(".", 2);
                if (where.status != 0) {
                    string message = fsCodeFor(where.status) + ": no folder is allowed to run programs in";
                    throw message;
                }
                cwd = where.text;
            }
            std::vector<string> env = registry.environment();
            string exe = spec.exe;
            int timeoutMs = spec.timeoutMs;
            int maxBytes = spec.maxBytes;
            if (!runFitsOs(exe, argv, cwd, env, timeoutMs, maxBytes)) {
                throw "invalid_argument: the program cannot be started with these arguments";
            }
            spawn(closure Job [exe, argv, cwd, env, timeoutMs, maxBytes, id, handle] () {
                string out = "";
                string err = "";
                int exitCode = 0;
                int flags = 0;
                int status = app_proc_run(handle, id, exe, argv, cwd, env, timeoutMs, maxBytes, out, err, exitCode, flags);
                finishRun(handle, id, status, out, err, exitCode, flags);
            });
        });
    }

    // ---- watches ----

    // Registers fs.watch and fs.unwatch (see "watching folders" above). A page may watch only folders the file commands
    // can reach, at most 32 at a time.
    void enableWatchCommands() {
        FileGate files = gate;
        WindowBook book = windows;
        asyncCommand("fs.watch", closure AsyncCommand [files, book] (Item args, string id, int handle) {
            Window owner = book.get(handle);
            if (owner == nullptr) {
                throw "forbidden: the window is gone";
            }
            string path = requiredString(args, "path");
            bool recursive = optionalBool(args, "recursive", false);
            int flag = 0;
            if (recursive) {
                flag = 1;
            }
            FsResult r = files.resolve(path, 2);
            fsCheck(r.status, "cannot watch " + path);
            if (owner.watches.states.size() >= 32) {
                throw "too_many: at most 32 folders can be watched at a time";
            }
            int watchId = 0;
            fsCheck(app_watch_start(handle, r.text, flag, watchId), "cannot watch " + path);
            owner.watches.states.push_back(new WatchState(watchId, r.text));
            Item result = createObject();
            addNumberToObject(result, "id", double(watchId));
            replyOk(handle, id, printUnformatted(result));
        });
        asyncCommand("fs.unwatch", closure AsyncCommand [book] (Item args, string id, int handle) {
            Window owner = book.get(handle);
            if (owner == nullptr) {
                throw "forbidden: the window is gone";
            }
            Item given = getObjectItem(objectArg(args), "id");
            if (given == nullptr || !isNumber(given)) {
                throw "invalid_argument: `id` must be a number";
            }
            int watchId = int(given.valuedouble);
            int index = owner.watches.indexOf(watchId);
            if (index < 0) {
                throw "not_found: no such watch";
            }
            app_watch_stop(handle, watchId);
            owner.watches.drop(index);
            replyOk(handle, id, "null");
        });
    }

    // ---- dialogs ----

    // Registers dialog.open, dialog.save, dialog.folder and dialog.message. They are asynchronous commands, so the
    // command loop keeps serving while a dialog is open. A pick answers null on cancel, else {path} and grants that
    // one file (or folder) to the file commands.
    void enableDialogCommands() {
        asyncCommand("dialog.open", closure AsyncCommand [] (Item args, string id, int handle) {
            DialogArgs given = decodeDialogArgs(args);
            string title = checkedTitle(given.title);
            std::vector<string> filters = filterList(given);
            spawn(closure Job [title, filters, id, handle] () {
                string chosen = "";
                int status = app_dialog_pick(handle, 0, title, "", "", filters, chosen);
                finishPick(handle, id, status, chosen, false);
            });
        });
        asyncCommand("dialog.save", closure AsyncCommand [] (Item args, string id, int handle) {
            DialogArgs given = decodeDialogArgs(args);
            string title = checkedTitle(given.title);
            string suggested = given.defaultName;
            if (suggested.length() > 0 && !plainFileName(suggested)) {
                throw "invalid_argument: `defaultName` must be a file name without a folder";
            }
            std::vector<string> filters = filterList(given);
            string extension = defaultExtension(given);
            spawn(closure Job [title, suggested, extension, filters, id, handle] () {
                string chosen = "";
                int status = app_dialog_pick(handle, 1, title, suggested, extension, filters, chosen);
                finishPick(handle, id, status, chosen, false);
            });
        });
        asyncCommand("dialog.folder", closure AsyncCommand [] (Item args, string id, int handle) {
            DialogArgs given = decodeDialogArgs(args);
            string title = checkedTitle(given.title);
            std::vector<string> none;
            spawn(closure Job [title, none, id, handle] () {
                string chosen = "";
                int status = app_dialog_pick(handle, 2, title, "", "", none, chosen);
                finishPick(handle, id, status, chosen, true);
            });
        });
        asyncCommand("dialog.message", closure AsyncCommand [] (Item args, string id, int handle) {
            MessageArgs given = decodeMessageArgs(args);
            string title = checkedTitle(given.title);
            string message = given.message;
            if (message.length() == 0 || !plainText(message, 4000)) {
                throw "invalid_argument: `message` must be plain text of 1 to 4000 bytes";
            }
            int kind = dialogKind(given.kind);
            int buttons = dialogButtons(given.buttons);
            if (kind < 0 || buttons < 0) {
                throw "invalid_argument: unknown `kind` or `buttons`";
            }
            spawn(closure Job [title, message, kind, buttons, id, handle] () {
                int button = app_dialog_message(handle, title, message, kind, buttons);
                if (button > 0) {
                    Item result = createObject();
                    addStringToObject(result, "button", buttonName(button));
                    replyOk(handle, id, printUnformatted(result));
                } else {
                    replyError(handle, id, "unsupported", "the dialog could not be shown");
                }
            });
        });
    }

    // Applies what a dialog worker sent: grants the user's choice, then answers the page.
    void onPickRecord(int from, std::vector<string> f) {
        if (f.size() < 4) {
            return;
        }
        string id = f[1];
        FsResult g = new FsResult(0, "");
        if (f[2] == "1") {
            g = gate.grantFolder(f[3]);
        } else {
            g = gate.grantFile(f[3]);
        }
        if (g.status != 0) {
            replyError(from, id, fsCodeFor(g.status), "the chosen path cannot be used");
            return;
        }
        Item result = createObject();
        addStringToObject(result, "path", g.text);
        replyOk(from, id, printUnformatted(result));
    }

    // ---- the window ----

    // Registers window.setTitle {title}, window.setSize {width, height}, window.minimize / maximize / restore / focus,
    // window.close, and window.setDirty {dirty}: the page says it has unsaved work, which matters to confirmClose.
    void enableWindowCommands() {
        CallContext who = dispatcher.caller;
        WindowBook book = windows;
        command("window.setTitle", closure Command [who] (Item args) {
            string title = requiredString(args, "title");
            if (title.length() == 0 || !plainText(title, 200)) {
                throw "invalid_argument: `title` must be plain text of 1 to 200 bytes";
            }
            app_window_title(who.handle, title);
            return createNull();
        });
        command("window.setSize", closure Command [who] (Item args) {
            Item w = getObjectItem(objectArg(args), "width");
            Item h = getObjectItem(objectArg(args), "height");
            if (w == nullptr || h == nullptr || !isNumber(w) || !isNumber(h)) {
                throw "invalid_argument: `width` and `height` must be numbers";
            }
            if (w.valuedouble < 200.0 || w.valuedouble > 10000.0 || h.valuedouble < 150.0 || h.valuedouble > 10000.0) {
                throw "invalid_argument: width must be 200 to 10000 and height 150 to 10000";
            }
            app_window_size(who.handle, int(w.valuedouble), int(h.valuedouble));
            return createNull();
        });
        command("window.minimize", closure Command [who] (Item args) {
            app_window_state(who.handle, 1);
            return createNull();
        });
        command("window.maximize", closure Command [who] (Item args) {
            app_window_state(who.handle, 2);
            return createNull();
        });
        command("window.restore", closure Command [who] (Item args) {
            app_window_state(who.handle, 0);
            return createNull();
        });
        command("window.focus", closure Command [who] (Item args) {
            app_window_state(who.handle, 3);
            return createNull();
        });
        command("window.close", closure Command [who] (Item args) {
            app_terminate(who.handle);
            return createNull();
        });
        command("window.setDirty", closure Command [who, book] (Item args) {
            Window w = book.get(who.handle);
            if (w == nullptr) {
                throw "forbidden: the window is gone";
            }
            w.state.dirty = optionalBool(args, "dirty", true);
            return createNull();
        });
    }

    // Registers window.open {start, title?, width?, height?}: a page may ask for another window of the program's own site. Off unless this is called
    // (a page that can open windows can show the application's commands to more places); `max` windows at most (1 to 32, counting the open ones).
    // `start` must be a path inside the site ("/settings.html"): plain text, no "..", no scheme. The window opens after the call has been answered
    // (null), on the thread that serves the windows; it gets the opener's own command list if it has one, and if it cannot open the opener receives
    // the event window.openFailed {start}. Needs openSite to have been used.
    bool enableWindowOpenCommand(int max) {
        if (max < 1 || max > 32) {
            return false;
        }
        maxWindows = max;
        CallContext who = dispatcher.caller;
        WindowBook book = windows;
        command("window.open", closure Command [who, book, max] (Item args) {
            OpenWindowArgs given = decodeOpenWindowArgs(args);
            string start = given.start;
            if (!pagePathOk(start)) {
                throw "invalid_argument: `start` must be a path inside the site, such as /settings.html";
            }
            string title = given.title;
            if (title.length() > 0 && !plainText(title, 200)) {
                throw "invalid_argument: `title` must be plain text of at most 200 bytes";
            }
            if (given.width < 200 || given.width > 10000) {
                throw "invalid_argument: `width` must be 200 to 10000";
            }
            if (given.height < 150 || given.height > 10000) {
                throw "invalid_argument: `height` must be 150 to 10000";
            }
            if (book.count() >= max) {
                string message = "too_many: at most " + intToString(max) + " windows can be open";
                throw message;
            }
            string record = "openwin";
            record.push_back(char(0));
            record = record + start;
            record.push_back(char(0));
            record = record + title;
            record.push_back(char(0));
            record = record + intToString(given.width);
            record.push_back(char(0));
            record = record + intToString(given.height);
            record.push_back(char(0));
            if (app_push(who.handle, "", record, 100) != 1) {
                throw "busy: the application is not keeping up";
            }
            return createNull();
        });
        return true;
    }

    // The window.open record: opens the window if the cap still allows it, and tells the opener when it could not.
    void openFromRecord(int opener, std::vector<string> f) {
        if (f.size() < 5) {
            return;
        }
        string start = f[1];
        string title = f[2];
        if (title.length() == 0) {
            title = "window";
        }
        int h = 0;
        if (maxWindows > 0 && windows.count() < maxWindows && pagePathOk(start)) {
            h = openWindow(title, int(decimalValue(f[3])), int(decimalValue(f[4])), false, start);
        }
        if (h == 0) {
            Item e = createObject();
            addStringToObject(e, "start", start);
            emitEvent(opener, "window.openFailed", printUnformatted(e));
            return;
        }
        dispatcher.rules.inheritRules(opener, h);
    }

    // When the user closes a window (the X, Alt+F4) while its page has said it has unsaved work, ask first with a native box whose text is
    // the application's, not the page's. Applies to every window, open now or opened later. Without this a window just closes.
    bool confirmClose(string title, string message) {
        if (!plainText(title, 200) || !plainText(message, 4000)) {
            return false;
        }
        confirmDefault = true;
        confirmTitle = title;
        confirmMessage = message;
        window.closeTitle = title;
        window.closeMessage = message;
        window.confirm = true;
        bool ok = true;
        int i = 0;
        while (i < windows.items.size()) {
            Window w = windows.items[i];
            if (!w.confirmClose(title, message)) {
                ok = false;
            }
            i = i + 1;
        }
        return ok;
    }

    void onWindowRecord(int from, std::vector<string> f) {
        if (f.size() < 2) {
            return;
        }
        if (f[1] == "placement" && f.size() >= 7) {
            Window moved = windows.get(from);
            bool numbers = isSignedNumber(f[2]) && isSignedNumber(f[3]) && isSignedNumber(f[4]) && isSignedNumber(f[5]) && isSignedNumber(f[6]);
            if (numbers && moved != nullptr && moved.memoryKey.length() > 0) {
                WindowMemory mem = memory;
                mem.remember(moved.memoryKey, signedInt(f[2]), signedInt(f[3]), signedInt(f[4]), signedInt(f[5]), signedInt(f[6]));
            }
            return;
        }
        if (f[1] == "navigation_blocked" && f.size() >= 3) {
            if (isUtf8(f[2])) {
                Item e = createObject();
                addStringToObject(e, "url", f[2]);
                emitEvent(from, "window.navigationBlocked", printUnformatted(e));
                // a click (not a script) on a link that leaves the application: the browser opens it if the application said so
                if (links.browserLinks && f.size() >= 4 && f[3] == "1") {
                    links.openAddress(f[2]);
                }
            }
            return;
        }
        Window w = windows.get(from);
        if (w == nullptr) {
            return;
        }
        WindowState st = w.state;
        if (f[1] == "close_declined") {
            st.confirming = false;
            emitEvent(from, "window.closeDeclined", "null");
            return;
        }
        if (f[1] != "close_requested") {
            return;
        }
        if (st.hides) {
            app_window_state(from, 5);
            return;
        }
        if (!st.dirty) {
            app_terminate(from);
            return;
        }
        if (st.confirming) {
            return;
        }
        st.confirming = true;
        int h = from;
        string title = st.closeTitle;
        string message = st.closeMessage;
        string declined = packRecord("window", "close_declined");
        spawn(closure Job [h, title, message, declined] () {
            if (app_dialog_message(h, title, message, 3, 2) == 3) {
                app_terminate(h);
            } else {
                app_push(h, "", declined, 100);
            }
        });
    }

    // The page may not send a call larger than maxRequestBytes or while maxQueuedCalls are waiting: such a call is answered at
    // once with {code: "too_large"} / {code: "busy"} and never reaches a command (defaults 4 MiB and 256). Applies to the next open.
    bool setRequestLimits(int maxRequest, int maxQueued) {
        if (maxRequest < 1024 || maxRequest > 268435456 || maxQueued < 1 || maxQueued > 100000) {
            return false;
        }
        maxRequestBytes = maxRequest;
        maxQueuedCalls = maxQueued;
        return true;
    }

    // After the application's own page, the window may load only addresses that start with `prefix` (for example a dev server,
    // "http://localhost:5173/"); everything else, every new window and every frame pointing elsewhere is refused and reported as
    // the event window.navigationBlocked {url}. Call before open.
    bool allowNavigation(string prefix) {
        if (prefix.length() < 5 || !plainText(prefix, 1000)) {
            return false;
        }
        addNavigation(prefix);
        return true;
    }

    void addNavigation(string prefix) {
        int i = 0;
        while (i < navigation.size()) {
            if (navigation[i] == prefix) {
                return;
            }
            i = i + 1;
        }
        navigation.push_back(prefix);
    }

    // From now on the page may call only the commands named here (every name must be one that is registered by now, so a typo cannot
    // silently leave a command open or closed). Others are answered {code: "forbidden"}, registered or not. Cancelling a call
    // ($cancel) is always allowed. Calling it again replaces the list. This is the list of every window that has no list of its own
    // (Window.allowOnlyCommands gives one window its own). false (and nothing changes) if a name is not registered.
    bool allowOnlyCommands(std::vector<string> names) {
        int i = 0;
        while (i < names.size()) {
            if (!dispatcher.rules.hasCommand(names[i])) {
                return false;
            }
            i = i + 1;
        }
        dispatcher.rules.restrictAll(names);
        return true;
    }

    // How long a page waits for the async command `name` ("" = every async command that has no setting of its own): after ms it is answered
    // {code: "timed_out"}, the call counts as cancelled (callCancelled; a program it started is killed) and a late answer is dropped.
    // 0 means as long as it takes, which is the default. Do not set it for the dialog commands, which wait for a person.
    bool setAsyncTimeout(string name, int ms) {
        if (ms < 0 || (ms > 0 && ms < 50) || ms > 86400000) {
            return false;
        }
        if (name.length() == 0) {
            dispatcher.defaultTimeoutMs = ms;
        } else {
            dispatcher.setTimeout(name, ms);
        }
        return true;
    }

    // After the program ends (main returns) the jobs still running get this long, then the process ends without them (a message on stderr
    // says how many). Default 5000. 0 waits for every job however long it takes.
    bool setShutdownGrace(int ms) {
        if (ms < 0 || ms > 3600000) {
            return false;
        }
        cling::setExitGraceMs(ms);
        return true;
    }

    // At most n async jobs run at the same time (the rest wait in a queue, oldest first); 0 = the default,
    // max(4, number of cores). A job is never dropped: on exit every queued job still runs.
    void setWorkerLimit(int n) {
        cling::setWorkerLimit(n);
    }

    // Opens a window on `start` (an address, or "" for `html`). Returns its handle, 0 if it could not be created (the shim has printed why on
    // stderr). The first window opened is the primary one: `handle`, `window` and `watches` name it.
    int openAt(string title, int width, int height, string html, string start, string bridgeJs, bool debug) {
        int d = 0;
        if (debug) {
            d = 1;
        }
        int h = app_open(title, width, height, html, start, bridgeJs, d);
        if (h == 0) {
            return 0;
        }
        app_limits(h, maxRequestBytes, maxQueuedCalls);
        app_navigation_allow(h, navigation);
        Window w = new Window(h, dispatcher.rules);
        w.navigation = navigation;
        windows.add(w);
        opened.push_back(h);
        if (windows.count() == 1) {
            handle = h;
            window = w.state;
            watches = w.watches;
        }
        if (confirmDefault) {
            w.confirmClose(confirmTitle, confirmMessage);
        }
        if (instanceClaimed && windows.count() == 1) {
            app_instance_listen(h);
        }
        if (memory.isOpen()) {
            string key = memoryKeyFor(start, windows.count() == 1);
            w.memoryKey = key;
            placeRemembered(h, key);
            app_window_track(h, 1);
        }
        return h;
    }

    // ---- menus (src/menu.clg) ----

    // What runs when an item of a menu bar is clicked or its shortcut is pressed: `clicked(id)`, with an id the application gave. One handler for the
    // application; it runs on the main thread. A throw in it is dropped (nobody is waiting for an answer).
    void onMenu(MenuAction handler) {
        menuHandler = handler;
    }

    // From now on a click is also sent to the page of the window it came from, as the event menu.click {id}. Off by default: a page that is not told
    // has nothing to react to.
    void menuEventsToPage(bool on) {
        menuToPage = on;
    }

    // The menu bar of the first window.
    bool setMenu(Menu bar) {
        Window w = windows.get(handle);
        if (w == nullptr) {
            return false;
        }
        return w.setMenu(bar);
    }

    int trayIndex(int h) {
        int i = 0;
        while (i < trays.size()) {
            if (trays[i] == h) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    void onMenuClick(int from, string id) {
        int ti = trayIndex(from);
        if (ti >= 0) {
            Menu tm = trayMenus[ti];
            int mi = tm.indexOfId(id);
            if (mi < 0 || (tm.flags[mi] / 2) % 2 == 1) {
                return;                   // not an item of the tray menu, or a greyed one
            }
            try {
                MenuAction trayItem = menuHandler;
                trayItem.clicked(id);
            } catch (string message) {
                // nobody is waiting for an answer
            }
            return;
        }
        Window w = windows.get(from);
        if (w == nullptr || !(w.menuItemEnabled(id) || popups.hasItem(id))) {
            return;                       // an id this window's menu (or a pop-up menu) does not have, or an item that is greyed out: nothing happens
        }
        try {
            MenuAction handler = menuHandler;
            handler.clicked(id);
        } catch (string message) {
            // nobody is waiting for an answer
        }
        if (menuToPage) {
            Item e = createObject();
            addStringToObject(e, "id", id);
            emitEvent(from, "menu.click", printUnformatted(e));
        }
    }

    // ---- pop-up menus a page may ask for ----

    // Registers a menu under a name (1 to 64 letters, digits, `.`, `_`, `-`; at most 16 menus): the page may ask for it by that name and for nothing else.
    // The menu may have items at its top level. false if the name is taken or not a name, the menu is not complete, or there are 16 already.
    bool allowPopup(string name, Menu popup) {
        if (!menuId(name) || popups.indexOf(name) >= 0 || !popup.complete() || popups.names.size() >= 16) {
            return false;
        }
        popups.names.push_back(name);
        popups.menus.push_back(popup);
        return true;
    }

    // Registers menu.popup {name}: shows the menu with that name at the mouse and answers the id of the item chosen, or null if it was dismissed. A name that was not
    // registered with allowPopup is "unknown_menu". The chosen item also runs the handler of onMenu. Off until this is called.
    void enablePopupCommand() {
        PopupBook book = popups;
        asyncCommand("menu.popup", closure AsyncCommand [book] (Item args, string id, int handle) {
            string name = requiredString(args, "name");
            int index = book.indexOf(name);
            if (index < 0) {
                throw "unknown_menu: no menu is registered under that name";
            }
            Menu chosenFrom = book.menus[index];
            string spec = chosenFrom.spec();
            spawn(closure Job [spec, id, handle] () {
                string chosen = "";
                int st = app_menu_popup(handle, spec, chosen);
                if (st == -1) {
                    replyError(handle, id, "unsupported", "menus cannot be shown on this system");
                } else if (st != 0) {
                    replyError(handle, id, "command_failed", "the menu could not be shown");
                } else if (chosen.length() == 0) {
                    replyOk(handle, id, "null");
                } else {
                    Item answer = createString(chosen);
                    replyOk(handle, id, printUnformatted(answer));
                }
            });
        });
    }

    // ---- notifications (Windows) ----

    // Makes notifications possible in a program that has no tray icon: a notification-only icon (tooltip: `appName`, at most 127 bytes of text) that is in the
    // notification area only while a notification is up. A program that has a tray icon (openTray) needs nothing: its notifications come from that icon. false if it could not be made.
    bool enableNotifications(string appName) {
        if (notifier.handle != 0) {
            return true;
        }
        if (!plainText(appName, 127) || appName.length() == 0) {
            return false;
        }
        int th = 0;
        if (app_notifier_open(appName, th) != 0 || th == 0) {
            return false;
        }
        trays.push_back(th);
        trayMenus.push_back(new Menu());
        notifier.handle = th;
        return true;
    }

    // Shows a notification (a toast on current Windows): a title of 1 to 63 bytes, text of up to 255, kind "info", "warning" or "error", and an id ("" or a name) that
    // onNotificationClick gets when the user clicks it. "" if the system took it, else the reason as "code: message". At most one every 2 seconds (setNotificationGap). Whether it is SHOWN is up to the
    // system: Focus Assist / Do Not Disturb, the user's settings for notifications and a full-screen program in front can all hide it.
    string notify(string title, string text, string kind, string id) {
        notifier.asker = 0;
        return notifier.show(title, text, kind, id);
    }

    // The least time between two notifications, from 200 ms to 10 minutes (default 2 seconds). The page cannot change it. false if it is out of that range.
    bool setNotificationGap(int ms) {
        if (ms < 200 || ms > 600000) {
            return false;
        }
        notifier.gapMs = double(ms);
        return true;
    }

    // What runs when the user clicks a notification: `clicked(id)`.
    void onNotificationClick(NotificationAction handler) {
        notifyHandler = handler;
    }

    // Registers notification.show {title, text, kind?, id?} for the page: the same limits and the same gap. A click on that notification reaches the page that
    // asked as the event notification.click {id}, and the handler of onNotificationClick too. Off until this is called; notifications must be enabled (enableNotifications or a tray).
    void enableNotificationCommand() {
        Notifier shared = notifier;
        CallContext caller = dispatcher.caller;
        command("notification.show", closure Command [shared, caller] (Item args) {
            NotifyArgs given = decodeNotifyArgs(args);
            shared.asker = caller.handle;
            string why = shared.show(given.title, given.text, given.kind, given.id);
            if (why.length() > 0) {
                throw why;
            }
            return createNull();
        });
    }

    void onNotificationRecord(int from, string id) {
        if (trayIndex(from) < 0 || (id.length() > 0 && !menuId(id))) {
            return;
        }
        try {
            NotificationAction handler = notifyHandler;
            handler.clicked(id);
        } catch (string message) {
            // nobody is waiting for an answer
        }
        if (notifier.asker != 0) {
            Item e = createObject();
            addStringToObject(e, "id", id);
            emitEvent(notifier.asker, "notification.click", printUnformatted(e));
        }
    }

    // ---- the tray icon (Windows) ----

    // Puts an icon in the notification area: the program's own icon (ICON= in build.sh, else the system's), a tooltip of at most 127 bytes of plain text, and a
    // right-click menu `popup` (src/menu.clg; its items may be at the top level). Returns the tray's handle, 0 if it could not be made (not Windows, no
    // shell, a menu that is not complete, a bad tooltip). Choosing an item runs the handler of onMenu with the item's id; clicking the icon runs onTray.
    // Close it with closeTray; App.close() closes all of them. Not closed, the icon stays in the notification area until the mouse passes over it.
    int openTray(string tooltip, Menu popup) {
        if (!plainText(tooltip, 127) || tooltip.length() == 0 || !popup.complete() || trays.size() >= 4) {
            return 0;
        }
        int th = 0;
        if (app_tray_open(tooltip, popup.spec(), th) != 0 || th == 0) {
            return 0;
        }
        trays.push_back(th);
        trayMenus.push_back(popup);
        if (notifier.handle == 0) {
            notifier.handle = th;            // a program with a tray icon says its notifications from it
        }
        return th;
    }

    // What runs when the tray icon is clicked: `happened("click")` for a left click, `happened("double")` for a double click. The right click shows the menu.
    void onTray(TrayAction handler) {
        trayHandler = handler;
    }

    bool trayTooltip(int th, string tooltip) {
        if (trayIndex(th) < 0 || !plainText(tooltip, 127) || tooltip.length() == 0) {
            return false;
        }
        return app_tray_update(th, tooltip, "") == 0;
    }

    bool trayEnabled(int th, string id, bool enabled) {
        int ti = trayIndex(th);
        if (ti < 0) {
            return false;
        }
        Menu tm = trayMenus[ti];
        int mi = tm.indexOfId(id);
        if (mi < 0) {
            return false;
        }
        int on = 0;
        if (enabled) {
            on = 1;
        }
        tm.flags[mi] = tm.flags[mi] % 2 + 2 - 2 * on;
        return app_tray_item(th, id, on, -1) == 0;
    }

    bool trayChecked(int th, string id, bool checked) {
        int ti = trayIndex(th);
        if (ti < 0) {
            return false;
        }
        Menu tm = trayMenus[ti];
        int mi = tm.indexOfId(id);
        if (mi < 0 || tm.kinds[mi] != "c") {
            return false;
        }
        int on = 0;
        if (checked) {
            on = 1;
        }
        tm.flags[mi] = (tm.flags[mi] / 2) * 2 + on;
        return app_tray_item(th, id, -1, on) == 0;
    }

    // Removes the icon.
    bool closeTray(int th) {
        int ti = trayIndex(th);
        if (ti < 0) {
            return false;
        }
        app_close(th);
        trayGone(th);
        return true;
    }

    void trayGone(int th) {
        int ti = trayIndex(th);
        if (ti < 0) {
            return;
        }
        int last = trays.size() - 1;
        if (ti != last) {
            trays[ti] = trays[last];
            trayMenus[ti] = trayMenus[last];
        }
        trays.pop_back();
        trayMenus.pop_back();
        if (notifier.handle == th) {
            notifier.handle = 0;
        }
    }

    // The window with this handle comes back (see Window.hide, hideOnClose): shown, restored if minimized, in front.
    bool showWindow(int h) {
        Window w = windows.get(h);
        if (w == nullptr) {
            return false;
        }
        return w.show();
    }

    // ---- remembering where windows were (src/placement.clg) ----

    // From now on windows open where they were the last time (the restored rectangle and whether they were maximized, kept per window in windows.json in the
    // application's config folder), fitted to the monitors that exist now, and the place is saved when the user moves, resizes, maximizes or restores one.
    // The first window is "main", another window is named by the page it starts on; at most 16 names. Call before the first window is opened. false if the
    // application name is not a plain name or the config folder cannot be used (windows then open as they always did). The window is created where the
    // program asked and moved at once, so it can be seen to jump; a program that cares passes its own default size.
    bool rememberWindows(string appName) {
        return memory.open(appName) == "";
    }

    string memoryKeyFor(string start, bool first) {
        if (first) {
            return "main";
        }
        if (startsWithText(start, "/") && start.length() <= 80 && plainText(start, 80)) {
            return "page" + start;
        }
        return "other";
    }

    void placeRemembered(int h, string key) {
        WindowMemory mem = memory;
        int i = mem.indexOf(key);
        if (i < 0) {
            return;
        }
        std::vector<int> monitors = monitorList();
        std::vector<int> r = fitToMonitors(mem.xs[i], mem.ys[i], mem.ws[i], mem.hs[i], monitors);
        app_window_placement(h, r[0], r[1], r[2], r[3], mem.maxed[i]);
    }

    // Opens a window on the page embedded at build time or on `siteStart`. false if it could not be created.
    bool open(string title, int width, int height, string html, string bridgeJs, bool debug) {
        return openAt(title, width, height, html, siteStart, bridgeJs, debug) != 0;
    }

    // Opens another window and returns its handle (0 if it could not be created); `windows.get(handle)` is the Window object. `start` is ""
    // for the embedded page, a path inside the program's own site ("/settings.html", after openSite), or the address of a development server
    // (see openDevServer). It gets the application's command list and the addresses allowNavigation added.
    int openWindow(string title, int width, int height, bool debug, string start) {
        string address = "";
        string html = "";
        if (start.length() == 0) {
            html = app_page_html();
        } else if (startsWithText(start, "/")) {
            if (siteOrigin.length() == 0 || !pagePathOk(start)) {
                return 0;
            }
            address = siteOrigin + start;
        } else {
            if (app_release_build() == 1) {
                return 0;
            }
            string origin = devServerOrigin(start);
            if (origin.length() == 0) {
                return 0;
            }
            addNavigation(origin + "/");
            address = start;
        }
        return openAt(title, width, height, html, address, app_bridge_js() + app_extra_js(), debug);
    }

    // The development server address the program was asked to load (environment variable APP_DEV_URL), or "" if there is none, it is not a
    // loopback address (see devServerOrigin) or this is a release build.
    string devServerFromEnvironment() {
        if (app_release_build() == 1) {
            return "";
        }
        string url = "";
        if (app_os_env("APP_DEV_URL", url) != 1) {
            return "";
        }
        string origin = devServerOrigin(url);
        if (origin.length() == 0) {
            return "";
        }
        return url;
    }

    // Opens the window on a development server (Vite, webpack, `python -m http.server`...) running on this machine, with the bridge
    // injected and the developer tools on. The page reloads itself the way the dev server arranges (hot module replacement); this
    // program's commands stay the compiled ones. Refused (false) for an address that is not http on localhost / 127.0.0.1 / [::1], and in
    // a release build, where nothing may load a server. The window may navigate within that origin and nowhere else.
    bool openDevServer(string title, int width, int height, string url) {
        if (app_release_build() == 1) {
            return false;
        }
        string origin = devServerOrigin(url);
        if (origin.length() == 0) {
            return false;
        }
        siteStart = url;
        addNavigation(origin + "/");
        return open(title, width, height, "", app_bridge_js() + app_extra_js(), true);
    }

    // Opens the window on the page embedded at build time, with the standard bridge script.
    bool openPage(string title, int width, int height, bool debug) {
        return open(title, width, height, app_page_html(), app_bridge_js() + app_extra_js(), debug);
    }

    // Opens the window on the program's own web files (build with ASSETS=<folder>), served from memory under `origin`, which must be
    // http:// or https:// with no path ("http://app.localhost"). `csp`, if not empty, is sent with every HTML file as its
    // Content-Security-Policy. The window may navigate to that origin and nowhere else (allowNavigation adds more). false if there
    // are no files, no page among them, or the window could not be created.
    bool openSite(string title, int width, int height, bool debug, string origin, string csp) {
        if (siteOrigin.length() > 0 && siteOrigin != origin) {
            return false;           // one site per program: every window shares the origin
        }
        if (siteOrigin.length() == 0) {
            SiteInfo info = publishSite(origin, csp);
            if (info.files == 0 || info.start.length() == 0) {
                return false;
            }
            siteStart = info.start;
            siteOrigin = origin;
        }
        addNavigation(origin + "/");
        return open(title, width, height, "", app_bridge_js() + app_extra_js(), debug);
    }

    // Registers the pump that wakeMain(handle, name) runs on the main thread (see Pump). The same name replaces the earlier pump.
    // false for a name that is empty, over 64 bytes or not plain text.
    bool onPump(string name, Pump p) {
        if (name.length() == 0 || !plainText(name, 64)) {
            return false;
        }
        int index = pumps.indexOf(name);
        if (index >= 0) {
            pumps.items[index] = p;
        } else {
            pumps.names.push_back(name);
            pumps.items.push_back(p);
        }
        return true;
    }

    // Expects a record from a worker for the page call `id` of window `handle` (the one the command was called from; call ids repeat across
    // windows): when finishLater arrives, `l.done` runs on the main thread.
    void later(int handle, string id, Later l) {
        laters.handles.push_back(handle);
        laters.ids.push_back(id);
        laters.items.push_back(l);
    }

    // The run of a program the application chooses itself: `exe` as resolveProgram found it, `args` vetted by the caller, `cwd` a
    // folder the file policy has resolved. The environment is the one programs get (see passEnvironment).
    ToolRun toolRun(string exe, std::vector<string> args, string cwd, int timeoutMs, int maxBytes) {
        ToolRun run = new ToolRun(exe, cwd, timeoutMs, maxBytes);
        run.args = args;
        run.env = programs.environment();
        return run;
    }

    // A record the native layer queued itself (empty id) for window `from`: "watch", "pick", "window", "later" or "pump".
    // A later launch of this program handed over its working folder and arguments (record "instance", folder, arguments...). They are text from
    // another process and reach the page as the event app.secondInstance {cwd, args}; at most 64 arguments of plain text up to 4096 bytes each. The window
    // comes to the front. Nothing in them is allowed or opened by this: if an argument names a file, whether the page may reach it is the application's call.
    void onSecondInstance(int from, std::vector<string> f) {
        if (f.size() < 2) {
            return;
        }
        string cwd = f[1];
        if (!plainText(cwd, 32000)) {
            cwd = "";
        }
        Item e = createObject();
        addStringToObject(e, "cwd", cwd);
        Item list = createArray();
        int i = 2;
        int kept = 0;
        while (i < f.size() && kept < 64) {
            if (plainText(f[i], 4096)) {
                addItemToArray(list, createString(f[i]));
                kept = kept + 1;
            }
            i = i + 1;
        }
        addItemToObject(e, "args", list);
        emitEvent(from, "app.secondInstance", printUnformatted(e));
        app_window_state(from, 3);
    }

    // ---- one running copy (Windows; elsewhere nothing is enforced) ----

    // Makes this process THE instance named `appName` (a plain name), or finds that another one is running and hands it this process's folder and
    // arguments. 0 this is the instance (the first window listens for later launches); 1 another one runs and was told: exit now; 2 another one holds
    // the name but could not be told (it may be starting or stuck): exit now, or tell the user; 3 not supported on this system, nothing is enforced;
    // 4 the name is not a plain name. Call before the first window is opened.
    int claimInstance(string appName) {
        if (!plainName(appName)) {
            return 4;
        }
        int first = 1;
        int st = app_instance_claim(appName, first);
        if (st == 0 && first == 1) {
            instanceClaimed = true;
            return 0;
        }
        if (st == 0) {
            return 1;
        }
        if (st == 4 && first == 0) {
            return 2;
        }
        return 3;
    }

    // true if this process may go on: it is the instance, or nothing can be enforced here. false: another copy is running (and, if it could be reached,
    // was told); the program should end. `if (!app.singleInstance("my-app")) { return 0; }`
    bool singleInstance(string appName) {
        int code = claimInstance(appName);
        return code == 0 || code == 3;
    }

    // The arguments this process was started with, without the program name.
    std::vector<string> arguments() {
        string raw = "";
        app_command_line(raw);
        return splitFields(raw);
    }

    void onInternalRecord(int from, string request) {
        std::vector<string> f = splitFields(request);
        if (f.size() == 0) {
            return;
        }
        if (f[0] == "watch") {
            Window w = windows.get(from);
            if (w != nullptr) {
                w.watches.onRecord(gate, from, f);
            }
        } else if (f[0] == "openwin") {
            openFromRecord(from, f);
        } else if (f[0] == "pick") {
            onPickRecord(from, f);
        } else if (f[0] == "window") {
            onWindowRecord(from, f);
        } else if (f[0] == "instance") {
            onSecondInstance(from, f);
        } else if (f[0] == "menu" && f.size() >= 2) {
            onMenuClick(from, f[1]);
        } else if (f[0] == "notify" && f.size() >= 2) {
            onNotificationRecord(from, f[1]);
        } else if (f[0] == "tray" && f.size() >= 2) {
            if (trayIndex(from) >= 0 && (f[1] == "click" || f[1] == "double")) {
                try {
                    TrayAction clicked = trayHandler;
                    clicked.happened(f[1]);
                } catch (string message) {
                    // nobody is waiting for an answer
                }
            }
        } else if (f[0] == "pump" && f.size() >= 2) {
            int index = pumps.indexOf(f[1]);
            if (index >= 0) {
                Pump p = pumps.items[index];
                try {
                    p.pump(gate);
                } catch (string message) {
                    // nothing to answer: a pump has no page call (see Pump)
                }
            }
        } else if (f[0] == "later" && f.size() >= 4) {
            int index = laters.indexOf(from, f[1]);
            if (index < 0) {
                return;
            }
            Later l = laters.items[index];
            laters.drop(index);
            try {
                l.done(from, f[1], int(decimalValue(f[2])), f[3]);
            } catch (string message) {
                replyError(from, f[1], errorCodeOf(message), errorTextOf(message));
            }
        }
    }

    // A window's queue reported that it is closed: the work it started is told to stop (callCancelled; programs it started are killed), its
    // book entries go, and the next window becomes the primary one if it was the primary.
    void windowGone(int gone) {
        app_cancel_all(gone);
        dispatcher.forgetWindow(gone);
        laters.forgetWindow(gone);
        int index = windows.indexOf(gone);
        if (index >= 0) {
            windows.drop(index);
        }
        if (gone == handle && windows.count() > 0) {
            Window next = windows.items[0];
            handle = next.handle;
            window = next.state;
            watches = next.watches;
        }
    }

    // Serves the next thing in any window's queue: a call from a page (dispatched and answered) or a record from the native layer (a file
    // watcher's change, a dialog's choice, a window's close button). Waits up to timeoutMs (-1 = for as long as it takes), and delivers merged
    // file-watch events when they have been quiet for a moment.
    // Returns 1 if something was served, 2 if the wait timed out, 0 when no window is open any more (the last one has closed).
    int serveOne(int timeoutMs) {
        double started = app_now_ms();
        if (quitCalled && windows.count() == 0) {
            return 0;
        }
        while (true) {
            int wait = timeoutMs;
            if (timeoutMs >= 0) {
                wait = timeoutMs - int(app_now_ms() - started);
                if (wait < 0) {
                    wait = 0;
                }
            }
            bool pending = windows.anyPending();
            if (pending && (wait < 0 || wait > 40)) {
                wait = 40;
            }
            dispatcher.sweep();
            int due = dispatcher.nextDueMs();
            if (due >= 0 && (wait < 0 || wait > due + 1)) {
                wait = due + 1;
            }
            int from = 0;
            std::vector<int> waitOn = windows.handles;
            int t = 0;
            while (t < trays.size()) {
                waitOn.push_back(trays[t]);
                t = t + 1;
            }
            int ready = app_wait_any(waitOn, wait, from);
            if (ready == 0) {
                return 0;
            }
            if (ready == 1) {
                string id = "";
                string request = "";
                int r = app_next_call(from, 0, id, request);
                if (r == 1) {
                    if (id.length() == 0) {
                        onInternalRecord(from, request);
                    } else {
                        Reply reply = dispatcher.handle(from, id, request);
                        if (reply.status != 2) {
                            app_return(from, id, reply.status, reply.json);
                        }
                    }
                    windows.flushQuiet(gate);
                    return 1;
                }
                if (r == 0 && trayIndex(from) >= 0) {
                    trayGone(from);
                } else if (r == 0) {
                    windowGone(from);
                    if (windows.count() == 0 && (!stayWithoutWindows || quitCalled)) {
                        return 0;
                    }
                }
            } else {
                windows.flushQuiet(gate);
                if (timeoutMs >= 0 && app_now_ms() - started >= double(timeoutMs)) {
                    return 2;
                }
            }
        }
        return 2;
    }

    // Serves calls and records until the last window closes. Returns how many calls and records were served.
    int run() {
        int served = 0;
        while (true) {
            int r = serveOne(-1);
            if (r == 0) {
                break;
            }
            if (r == 1) {
                served = served + 1;
            }
        }
        return served;
    }

    // By default the program ends when its last window has closed. With keepRunning(true) it goes on with no window open (a program that lives in the tray) until
    // quit() is called; the loop (run / serveOne) then returns 0.
    void keepRunning(bool on) {
        stayWithoutWindows = on;
    }

    // Closes every window the way the close button does when nothing asks first, and ends the loop even for a program that keeps running without windows.
    void quit() {
        quitCalled = true;
        int i = 0;
        while (i < windows.items.size()) {
            Window w = windows.items[i];
            app_terminate(w.handle);
            i = i + 1;
        }
    }

    // Ends the application in order: every call still running is told to stop (callCancelled, programs killed), the watchers are stopped,
    // the window closes. Jobs that are still running afterwards get setShutdownGrace milliseconds when main returns, then the process ends.
    void close() {
        while (trays.size() > 0) {
            closeTray(trays[0]);
        }
        int i = 0;
        while (i < opened.size()) {
            app_cancel_all(opened[i]);
            app_close(opened[i]);
            i = i + 1;
        }
        while (opened.size() > 0) {
            opened.pop_back();
        }
        while (windows.count() > 0) {
            windows.drop(windows.count() - 1);
        }
        handle = 0;
        window.handle = 0;
    }
};
