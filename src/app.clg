

#include "cjson_item.clh"
#include "cjson_api.clh"
#include "cjson_parse.clh"
#include "cjson_print.clh"
#include "text.clh"
#include "core.clh"
#include "files.clh"
#include "dispatch.clh"
#include "fscommands.clh"
#include "dialogs.clh"
#include "notify.clh"
#include "programs.clh"
#include "later.clh"
#include "watches.clh"
#include "windows.clh"
#include "settings.clh"
#include "links.clh"
#include "placement.clh"
#include "menu.clh"
#include "theme.clh"
#include "drops.clh"
#include "assets.clh"

ext_fn int app_open(string title, int width, int height, string html, string url, string initJs, int debug);
ext_fn int app_wait_any(std::vector<int> handles, int timeoutMs, ref int handle);
ext_fn int app_next_call(int handle, int timeoutMs, ref string id, ref string request);
ext_fn int app_push(int handle, string id, string request, int maxQueued);
ext_fn int app_terminate(int handle);
ext_fn int app_close(int handle);
ext_fn int app_window_title(int handle, string title);
ext_fn int app_window_size(int handle, int width, int height);
ext_fn int app_window_state(int handle, int state);
ext_fn int app_cancel_all(int handle);
ext_fn int app_limits(int handle, int maxRequest, int maxQueued);
ext_fn int app_navigation_allow(int handle, std::vector<string> prefixes);
ext_fn int app_watch_start(int handle, string root, int recursive, ref int watchId);
ext_fn int app_watch_stop(int handle, int watchId);
ext_fn int app_shell_open(string target, int mode);
ext_fn int app_runtime_version(ref string version);
ext_fn int app_message_box(string title, string text, int ask);
ext_fn int app_window_placement(int handle, int x, int y, int width, int height, int maximized);
ext_fn int app_window_track(int handle, int on);
ext_fn int app_drop_accept(int handle, int on);
ext_fn int app_theme_system();
ext_fn int app_menu_popup(int handle, string spec, ref string chosen);
ext_fn int app_tray_open(string tooltip, string menu, ref int handle);
ext_fn int app_tray_update(int handle, string tooltip, string menu);
ext_fn int app_tray_item(int handle, string id, int enabled, int checked);
ext_fn int app_notifier_open(string tooltip, ref int handle);
ext_fn int app_instance_claim(string name, ref int first);
ext_fn int app_instance_listen(int handle);
ext_fn int app_command_line(ref string out);
ext_fn int app_os_env(string name, ref string out);
ext_fn int app_release_build();
ext_fn double app_now_ms();
ext_fn int app_proc_run(int handle, string call, string exe, std::vector<string> args, string cwd, std::vector<string> env, int timeoutMs, int maxBytes, ref string out, ref string err, ref int exitCode, ref int flags);
ext_fn int app_dialog_pick(int handle, int mode, string title, string defaultName, string defaultExt, std::vector<string> filters, ref string path);
ext_fn int app_dialog_message(int handle, string title, string message, int kind, int buttons);
ext_fn string app_page_html();
ext_fn string app_bridge_js();
ext_fn string app_extra_js();

class App {
public:
    int handle;
    Dispatcher dispatcher;
    ProgramRegistry programs;
    LaterBook laters;
    PumpBook pumps;
    FileGate gate;
    SettingsStore settings;            // the application's own settings file (empty until open() is called on it)
    bool instanceClaimed;              // claimInstance made this process the one instance: the first window listens for later launches
    WindowMemory memory;               // where windows were last (rememberWindows)
    bool stayWithoutWindows;           // keepRunning: the program goes on with no window open (only a tray icon) until quit() is called
    bool quitCalled;
    Notifier notifier;                 // notifications (enableNotifications)
    NotificationAction notifyHandler;  // what runs when one is clicked (onNotificationClick)
    PopupBook popups;                  // the pop-up menus a page may ask for (allowPopup)
    std::vector<int> trays;            // the handles of the tray icons that are open
    std::vector<Menu> trayMenus;
    TrayAction trayHandler;            // what runs when the tray icon is clicked (onTray)
    MenuAction menuHandler;            // what runs when a menu item is clicked (onMenu)
    bool menuToPage;                   // a click is also an event for the page of the window (menuEventsToPage)
    LinkRules links;                   // what a page may ask the system to open (allowLinkSchemes, allowOpenExtensions, enableShellCommands)
    ThemeState theme;                  // how the windows look: follow the system's light or dark scheme, or stay light or dark (setTheme)
    DropRules drops;                   // files dragged onto a window (enableFileDrop)
    WindowBook windows;                // the open windows
    std::vector<int> opened;           // every window this application ever opened (close() closes them all, even those already closed by the user)
    Watches watches;                   // the first window's (see `handle`); each Window has its own
    WindowState window;                // the first window's
    std::vector<string> navigation;    // addresses every window opened from now on may load after the application's own page (allowNavigation)
    int maxRequestBytes;
    int maxQueuedCalls;
    string siteStart;          // the address windows open on, when the program serves its own web files
    string siteOrigin;         // the origin the program's own web files are served under ("" until openSite)
    int maxWindows;            // how many windows a page may ask for (enableWindowOpenCommand); 0 = a page may not open windows
    bool confirmDefault;       // confirmClose was called: every window asks before it closes with unsaved work
    string confirmTitle;
    string confirmMessage;

    App() {
        handle = 0;
        dispatcher = new Dispatcher();
        programs = new ProgramRegistry();
        laters = new LaterBook();
        pumps = new PumpBook();
        gate = new FileGate();
        settings = new SettingsStore();
        links = new LinkRules();
        drops = new DropRules(gate);
        memory = new WindowMemory();
        menuHandler = new MenuAction();
        trayHandler = new TrayAction();
        popups = new PopupBook();
        notifier = new Notifier();
        notifyHandler = new NotificationAction();
        stayWithoutWindows = false;
        quitCalled = false;
        menuToPage = false;
        instanceClaimed = false;
        cling::setExitGraceMs(5000);
        windows = new WindowBook();
        theme = new ThemeState(windows);
        watches = new Watches();
        window = new WindowState();
        maxRequestBytes = 4194304;
        maxQueuedCalls = 256;
        siteStart = "";
        siteOrigin = "";
        maxWindows = 0;
        confirmDefault = false;
        confirmTitle = "";
        confirmMessage = "";
    }

    void command(string name, Command handler) {
        dispatcher.add(name, handler);
    }

    void asyncCommand(string name, AsyncCommand handler) {
        dispatcher.addAsync(name, handler);
    }

    // Pushes an event to the page of EVERY open window (see emitEvent; Window.emit addresses one). Safe to call from the main thread only
    // through this method; worker jobs use emitEvent with a captured handle. true if some window took it.
    bool emit(string name, string payloadJson) {
        bool any = false;
        int i = 0;
        while (i < windows.items.size()) {
            Window w = windows.items[i];
            if (emitEvent(w.handle, name, payloadJson)) {
                any = true;
            }
            i = i + 1;
        }
        return any;
    }

    // Adds a folder the page may reach through the file commands. Nothing is reachable until at least one is added;
    // a relative path from the page means "inside the first folder added". false if the folder does not exist.
    bool allowFolder(string dir) {
        return gate.allow(dir) == 0;
    }

    // Makes the application's own folder for `kind` ("data" or "cache", see appFolderPath in settings.clg) and adds it to the folders the page may
    // reach through the file commands. false if the name or the kind is not acceptable, the environment does not say where the folder is, or it
    // cannot be made. "config" is refused on purpose: it holds settings.json, which a page may change only through the settings commands (and only
    // the keys the application declared).
    bool allowAppFolder(string appName, string kind) {
        if (kind == "config") {
            return false;
        }
        string path = appFolderPath(kind, appName);
        if (path.length() == 0) {
            return false;
        }
        makeAppFolder(kind, appName);
        return gate.allow(path) == 0;
    }

    // Registers settings.get {key} -> the value, settings.getAll {} -> {key: value, ...} and settings.set {key, value} -> null for the settings the
    // application declared in `app.settings` (open it, declare the keys, load it: see SettingsStore in settings.clg). Nothing else is reachable: a key that is not declared is "unknown_setting", a value that does not
    // fit its declaration is "invalid_argument", and a write that could not be saved is "io_error" (the page's promise is rejected; the value in
    // memory is changed). Every window may call them unless its command list says otherwise. After a successful set the page of EVERY window gets
    // the event "settings.changed" {key, value}.
    void enableSettingsCommands() {
        SettingsStore settings = this.settings;
        command("settings.get", closure Command [settings] (Item args) {
            string key = requiredString(args, "key");
            Item value = settings.valueItem(key);
            if (value == nullptr) {
                string message = "unknown_setting: `" + key + "` is not a declared setting";
                throw message;
            }
            return value;
        });
        command("settings.getAll", closure Command [settings] (Item args) {
            return settings.allItem();
        });
        WindowBook book = windows;
        command("settings.set", closure Command [settings, book] (Item args) {
            string key = requiredString(args, "key");
            Item given = getObjectItem(objectArg(args), "value");
            if (given == nullptr) {
                throw "invalid_argument: `value` is missing";
            }
            string why = settings.set(key, given);
            if (why.length() > 0) {
                throw why;
            }
            Item changed = createObject();
            addStringToObject(changed, "key", key);
            addItemToObject(changed, "value", settings.valueItem(key));
            book.emitAll("settings.changed", printUnformatted(changed));
            return createNull();
        });
    }

    // ---- starting up on someone else's computer ----

    // Is what the window needs installed? On Windows the window is the Microsoft WebView2 Runtime, which every current Windows has but an older Windows 10 may not.
    // If it is missing, a message box (it needs no window) says so and offers the download page; the answer here is false and the program should end:
    //     if (!app.checkRuntime("My app")) { return 1; }
    // true if the runtime is there or nothing is needed on this system. Call it before the first window is opened; `appName` is plain text of at most 80 bytes.
    bool checkRuntime(string appName) {
        string version = "";
        if (app_runtime_version(version) != 1) {
            return true;
        }
        string name = appName;
        if (name.length() == 0 || !plainText(name, 80)) {
            name = "This program";
        }
        string text = name + " needs the Microsoft WebView2 Runtime to show its window, and this computer does not have it.\n\nOpen the page where Microsoft offers it?";
        if (app_message_box(name, text, 1) == 1) {
            app_shell_open("https://developer.microsoft.com/microsoft-edge/webview2/", 0);
        }
        return false;
    }

    // A message box with an OK button and no window of ours, for what a program has to say when it cannot open its window (a program without a console has nowhere to
    // print to). Title up to 80 and text up to 1000 bytes of plain text. false if it could not be shown.
    bool showMessage(string title, string text) {
        if (title.length() == 0 || !plainText(title, 80) || text.length() == 0 || !plainText(text, 1000)) {
            return false;
        }
        return app_message_box(title, text, 0) >= 0;
    }

    // ---- opening things in the system (src/links.clg) ----

    // The address schemes a page may open in the default browser, from http, https and mailto. Until this is called no address is opened.
    bool allowLinkSchemes(std::vector<string> schemes) {
        return links.allowSchemes(schemes);
    }

    // The extensions ("pdf", "txt") of the files a page may open in their default program. Extensions that start a program or a script are refused.
    bool allowOpenExtensions(std::vector<string> extensions) {
        return links.allowExtensions(extensions);
    }

    // A click (not a script) on a link that leaves the application, or on one with target=_blank, opens the address in the default browser when its
    // scheme is allowed (allowLinkSchemes). Off by default; the event window.navigationBlocked is sent either way.
    void openLinksInBrowser(bool on) {
        links.browserLinks = on;
    }

    // Registers shell.openUrl {url}, shell.openFile {path} and shell.reveal {path}, all answering null:
    //   openUrl   an address of an allowed scheme, in the default browser;
    //   openFile  a regular file the file policy lets the page reach, with an extension from allowOpenExtensions, in its default program;
    //   reveal    a file or folder the file policy lets the page reach, shown in the file manager (starts nothing).
    // At most about three opens a second. A refused address or file is "invalid_argument" / "forbidden" / "not_found" ..., a limit is "too_many".
    void enableShellCommands() {
        LinkRules rules = links;
        FileGate files = gate;
        command("shell.openUrl", closure Command [rules] (Item args) {
            string url = requiredString(args, "url");
            string why = rules.openAddress(url);
            if (why.length() > 0) {
                throw why;
            }
            return createNull();
        });
        command("shell.openFile", closure Command [rules, files] (Item args) {
            string path = requiredString(args, "path");
            FsResult r = files.resolve(path, 1);
            fsCheck(r.status, "cannot open " + path);
            if (!rules.extensionAllowed(r.text)) {
                throw "forbidden: this application does not open files of that type";
            }
            if (!rules.mayOpenNow()) {
                throw "too_many: files are opened at most about three times a second";
            }
            if (app_shell_open(r.text, 0) != 0) {
                throw "io_error: the file could not be handed to the system";
            }
            return createNull();
        });
        command("shell.reveal", closure Command [rules, files] (Item args) {
            string path = requiredString(args, "path");
            FsResult r = files.resolve(path, 0);
            fsCheck(r.status, "cannot show " + path);
            if (!rules.mayOpenNow()) {
                throw "too_many: files are shown at most about three times a second";
            }
            if (app_shell_open(r.text, 1) != 0) {
                throw "io_error: the file could not be shown";
            }
            return createNull();
        });
    }

    // ---- the colour scheme (src/theme.clg) ----

    // How every window looks, now and for windows opened later: "system" follows the user's choice of light or dark applications (the title bar, and what the page's
    // `prefers-color-scheme` says), "light" and "dark" stay as they are. The page of every window gets the event theme.changed {mode, system}. From the first call on the
    // title bar also follows the system when it changes and the event is sent then too. false for any other word (nothing changes). Windows only; elsewhere the call is
    // harmless and changes nothing. The page part is the browser engine's per-program setting, so with several windows the page of all of them follows the last choice.
    bool setTheme(string mode) {
        return theme.apply(mode);
    }

    // The system's scheme right now: "light", "dark", or "unknown" (a system with no such setting, or not Windows).
    string systemTheme() {
        return themeSchemeName(app_theme_system());
    }

    // Registers theme.get {} -> {mode, system} ("system" | "light" | "dark", and "light" | "dark" | "unknown") and, if `pageMaySet`, theme.set {mode} -> null (a word that is
    // not system, light or dark is "invalid_argument"). The event theme.changed {mode, system} reaches every window when the choice or the system's scheme changes (once
    // setTheme was called).
    void enableThemeCommands(bool pageMaySet) {
        ThemeState state = theme;
        command("theme.get", closure Command [state] (Item args) {
            return state.stateItem();
        });
        if (pageMaySet) {
            command("theme.set", closure Command [state] (Item args) {
                string mode = requiredString(args, "mode");
                if (!state.apply(mode)) {
                    throw "invalid_argument: `mode` must be system, light or dark";
                }
                return createNull();
            });
        }
    }

    // ---- files dragged onto a window (src/drops.clg) ----

    // From now on files dropped on a window from the file manager reach its page as the event drop.files {x, y, files: [{path, kind}], skipped} (and drop.enter / over / leave
    // while the drag is over the page); every file in it has been granted to the file commands like a dialog pick (that file only). At most `maxFiles` (1 to 64) paths are taken from one drop. With `folders` a dropped folder is accepted too and granted as a folder.
    // false if the number is out of range, or if some open window could not accept drops (not Windows).
    bool enableFileDrop(int maxFiles, bool folders) {
        if (maxFiles < 1 || maxFiles > 64) {
            return false;
        }
        drops.on = true;
        drops.maxFiles = maxFiles;
        drops.folders = folders;
        bool all = true;
        int i = 0;
        while (i < windows.items.size()) {
            Window w = windows.items[i];
            if (app_drop_accept(w.handle, 1) != 0) {
                all = false;
            }
            i = i + 1;
        }
        return all;
    }

    // Stops accepting files (every window, and windows opened later).
    void disableFileDrop() {
        drops.on = false;
        int i = 0;
        while (i < windows.items.size()) {
            Window w = windows.items[i];
            app_drop_accept(w.handle, 0);
            i = i + 1;
        }
    }

    // A record "drop" "files" x y path... from the window `from`: the event it comes to (see DropRules.eventFor).
    void onDropRecord(int from, std::vector<string> f) {
        string made = drops.eventFor(f);
        if (made.length() > 0) {
            emitEvent(from, "drop.files", made);
        }
    }

    // Withdraws everything the user granted through dialogs (the folders added with allowFolder stay).
    void revokeGrants() {
        gate.revokeGrants();
    }

    // Registers fs.read, fs.write, fs.list, fs.stat, fs.exists, fs.mkdir and fs.remove. Every path is checked by the
    // FileGate against the folders added with allowFolder. fs.read refuses files larger than maxReadBytes and files that
    // are not valid UTF-8 (text only; binary needs its own command).
    void enableFileCommands(int maxReadBytes) {
        FileGate files = gate;
        command("fs.read", closure Command [files, maxReadBytes] (Item args) {
            string path = requiredString(args, "path");
            FsResult r = files.read(path, maxReadBytes);
            fsCheck(r.status, "cannot read " + path);
            if (!isUtf8(r.text)) {
                throw "not_text: the file is not valid UTF-8";
            }
            Item result = createObject();
            addStringToObject(result, "text", r.text);
            return result;
        });
        command("fs.write", closure Command [files] (Item args) {
            string path = requiredString(args, "path");
            string text = requiredString(args, "text");
            int code = writeMode(args);
            if (optionalBool(args, "parents", false)) {
                makeParents(files, path);
            }
            fsCheck(files.write(path, text, code), "cannot write " + path);
            return createNull();
        });
        // the same for bytes: {base64} instead of {text}; a binary file travels through JSON as base64 text
        command("fs.writeBytes", closure Command [files] (Item args) {
            string path = requiredString(args, "path");
            string encoded = requiredString(args, "base64");
            int code = writeMode(args);
            if (!isBase64(encoded)) {
                throw "invalid_argument: `base64` is not well-formed base64";
            }
            if (optionalBool(args, "parents", false)) {
                makeParents(files, path);
            }
            fsCheck(files.write(path, base64Decode(encoded), code), "cannot write " + path);
            return createNull();
        });
        command("fs.readBytes", closure Command [files, maxReadBytes] (Item args) {
            string path = requiredString(args, "path");
            FsResult r = files.read(path, maxReadBytes);
            fsCheck(r.status, "cannot read " + path);
            Item result = createObject();
            addStringToObject(result, "base64", base64Encode(r.text));
            return result;
        });
        command("fs.list", closure Command [files] (Item args) {
            string path = requiredString(args, "path");
            FsResult r = files.list(path);
            fsCheck(r.status, "cannot list " + path);
            std::vector<string> parts = splitFields(r.text);
            Item listing = createArray();
            int i = 0;
            while (i + 3 < parts.size()) {
                string name = parts[i + 3];
                if (isUtf8(name)) {
                    addItemToArray(listing, entryItem(parts[i], parts[i + 1], parts[i + 2], name));
                }
                i = i + 4;
            }
            return listing;
        });
        command("fs.stat", closure Command [files] (Item args) {
            string path = requiredString(args, "path");
            FsResult r = files.stat(path);
            fsCheck(r.status, "cannot stat " + path);
            std::vector<string> parts = splitFields(r.text);
            if (parts.size() < 4 || !isUtf8(parts[3])) {
                throw "io_error: unreadable file entry";
            }
            return entryItem(parts[0], parts[1], parts[2], parts[3]);
        });
        command("fs.exists", closure Command [files] (Item args) {
            string path = requiredString(args, "path");
            FsResult r = files.stat(path);
            if (r.status == 2) {
                return createBool(false);
            }
            fsCheck(r.status, "cannot stat " + path);
            return createBool(true);
        });
        command("fs.mkdir", closure Command [files] (Item args) {
            string path = requiredString(args, "path");
            bool parents = optionalBool(args, "parents", false);
            int status = files.mkdir(path, parents);
            if (!(parents && status == 6)) {
                fsCheck(status, "cannot create " + path);
            }
            return createNull();
        });
        command("fs.remove", closure Command [files] (Item args) {
            string path = requiredString(args, "path");
            if (optionalBool(args, "recursive", false)) {
                fsCheck(files.removeTree(path, 0), "cannot remove " + path);
            } else {
                fsCheck(files.remove(path), "cannot remove " + path);
            }
            return createNull();
        });
    }

    // Declares a program the page may run, by name, with an argument template (see the comment above ProgramSpec).
    // `exe` is an absolute path to a .exe, or a bare name searched for on PATH only. Returns false, and registers
    // nothing, if the name or the template is malformed, the program cannot be found, or the name is taken.
    bool allowProgram(string name, string exe, std::vector<string> elements, int timeoutMs, int maxOutputBytes) {
        if (!programNameOk(name) || programs.indexOf(name) >= 0 || elements.size() > 64) {
            return false;
        }
        if (timeoutMs < 100 || timeoutMs > 600000 || maxOutputBytes < 0 || maxOutputBytes > 67108864) {
            return false;
        }
        FsResult found = resolveProgram(exe);
        if (found.status != 0) {
            return false;
        }
        ProgramSpec spec = new ProgramSpec(name, found.text, timeoutMs, maxOutputBytes);
        std::vector<string> names;
        int cwdCount = 0;
        int i = 0;
        while (i < elements.size()) {
            string element = elements[i];
            if (element.length() > 1000 || !plainText(element, 1000)) {
                return false;
            }
            if (startsWithText(element, "@cwd=")) {
                string inner = element.substr(5, element.length() - 5);
                if (elementSlotCheck(inner) != 1 || slotOpen(inner) != 0 || slotClose(inner) != inner.length() - 1) {
                    return false;
                }
                std::vector<string> parts = splitOn(inner.substr(1, inner.length() - 2), ':');
                if (parts.size() != 2 || parts[1] != "folder") {
                    return false;
                }
                cwdCount = cwdCount + 1;
                string cwdName = parts[0];
                names.push_back(cwdName);
            } else {
                int has = elementSlotCheck(element);
                if (has < 0) {
                    return false;
                }
                if (has == 1) {
                    int open = slotOpen(element);
                    int close = slotClose(element);
                    std::vector<string> parts = splitOn(element.substr(open + 1, close - open - 1), ':');
                    string slotName = parts[0];
                    names.push_back(slotName);
                }
            }
            spec.elements.push_back(element);
            i = i + 1;
        }
        if (cwdCount > 1) {
            return false;
        }
        int a = 0;
        while (a < names.size()) {
            int b = a + 1;
            while (b < names.size()) {
                if (names[a] == names[b]) {
                    return false;
                }
                b = b + 1;
            }
            a = a + 1;
        }
        spec.slotNames = names;
        programs.specs.push_back(spec);
        return true;
    }

    // Adds variables of this process that programs may see (see ProgramRegistry); everything else is withheld.
    bool passEnvironment(string name) {
        if (name.length() == 0 || !plainText(name, 200) || indexOfChar(name, '=') >= 0) {
            return false;
        }
        programs.envNames.push_back(name);
        return true;
    }

    // Registers proc.run: {program: "git.log", args: {count: 20, ...}} -> {exitCode, stdout, stderr, timedOut,
    // truncated: {stdout, stderr}, lossy}. A non-zero exit code is a result, not an error. Asynchronous: the program
    // runs on a worker, so the command loop keeps serving.
    void enableProcessCommands() {
        ProgramRegistry registry = programs;
        FileGate files = gate;
        asyncCommand("proc.run", closure AsyncCommand [registry, files] (Item args, string id, int handle) {
            string program = requiredString(args, "program");
            Item given = getObjectItem(args, "args");
            if (given == nullptr) {
                given = createObject();
            }
            if (!isObject(given)) {
                throw "invalid_argument: `args` must be an object";
            }
            int index = registry.indexOf(program);
            if (index < 0) {
                throw "unknown_program: no program is allowed under that name";
            }
            ProgramSpec spec = registry.specs[index];
            // every value in `args` must belong to a slot: nothing extra is passed along
            Item child = given.child;
            while (child != nullptr) {
                bool known = false;
                int k = 0;
                while (k < spec.slotNames.size()) {
                    if (spec.slotNames[k] == child.key) {
                        known = true;
                    }
                    k = k + 1;
                }
                if (!known) {
                    string message = "invalid_argument: `" + child.key + "` is not a parameter of " + program;
                    throw message;
                }
                child = child.next;
            }
            std::vector<string> argv;
            string cwd = "";
            int total = 0;
            int e = 0;
            while (e < spec.elements.size()) {
                string element = spec.elements[e];
                if (startsWithText(element, "@cwd=")) {
                    string inner = element.substr(5, element.length() - 5);
                    cwd = slotValue(files, inner.substr(1, inner.length() - 2), given, false);
                } else {
                    string rendered = renderElement(files, element, given);
                    if (!plainText(rendered, 32000)) {
                        throw "invalid_argument: an argument is not plain text";
                    }
                    total = total + rendered.length() + 3;
                    argv.push_back(rendered);
                }
                e = e + 1;
            }
            if (argv.size() > 256 || total > 30000) {
                throw "invalid_argument: too many or too long arguments";
            }
            if (cwd.length() == 0) {
                FsResult where = files.resolve(".", 2);
                if (where.status != 0) {
                    string message = fsCodeFor(where.status) + ": no folder is allowed to run programs in";
                    throw message;
                }
                cwd = where.text;
            }
            std::vector<string> env = registry.environment();
            string exe = spec.exe;
            int timeoutMs = spec.timeoutMs;
            int maxBytes = spec.maxBytes;
            if (!runFitsOs(exe, argv, cwd, env, timeoutMs, maxBytes)) {
                throw "invalid_argument: the program cannot be started with these arguments";
            }
            spawn(closure Job [exe, argv, cwd, env, timeoutMs, maxBytes, id, handle] () {
                string out = "";
                string err = "";
                int exitCode = 0;
                int flags = 0;
                int status = app_proc_run(handle, id, exe, argv, cwd, env, timeoutMs, maxBytes, out, err, exitCode, flags);
                finishRun(handle, id, status, out, err, exitCode, flags);
            });
        });
    }

    // ---- watches ----

    // Registers fs.watch and fs.unwatch (see "watching folders" above). A page may watch only folders the file commands
    // can reach, at most 32 at a time.
    void enableWatchCommands() {
        FileGate files = gate;
        WindowBook book = windows;
        asyncCommand("fs.watch", closure AsyncCommand [files, book] (Item args, string id, int handle) {
            Window owner = book.get(handle);
            if (owner == nullptr) {
                throw "forbidden: the window is gone";
            }
            string path = requiredString(args, "path");
            bool recursive = optionalBool(args, "recursive", false);
            int flag = 0;
            if (recursive) {
                flag = 1;
            }
            FsResult r = files.resolve(path, 2);
            fsCheck(r.status, "cannot watch " + path);
            if (owner.watches.states.size() >= 32) {
                throw "too_many: at most 32 folders can be watched at a time";
            }
            int watchId = 0;
            fsCheck(app_watch_start(handle, r.text, flag, watchId), "cannot watch " + path);
            owner.watches.states.push_back(new WatchState(watchId, r.text));
            Item result = createObject();
            addNumberToObject(result, "id", double(watchId));
            replyOk(handle, id, printUnformatted(result));
        });
        asyncCommand("fs.unwatch", closure AsyncCommand [book] (Item args, string id, int handle) {
            Window owner = book.get(handle);
            if (owner == nullptr) {
                throw "forbidden: the window is gone";
            }
            Item given = getObjectItem(objectArg(args), "id");
            if (given == nullptr || !isNumber(given)) {
                throw "invalid_argument: `id` must be a number";
            }
            int watchId = int(given.valuedouble);
            int index = owner.watches.indexOf(watchId);
            if (index < 0) {
                throw "not_found: no such watch";
            }
            app_watch_stop(handle, watchId);
            owner.watches.drop(index);
            replyOk(handle, id, "null");
        });
    }

    // ---- dialogs ----

    // Registers dialog.open, dialog.save, dialog.folder and dialog.message. They are asynchronous commands, so the
    // command loop keeps serving while a dialog is open. A pick answers null on cancel, else {path} and grants that
    // one file (or folder) to the file commands.
    void enableDialogCommands() {
        asyncCommand("dialog.open", closure AsyncCommand [] (Item args, string id, int handle) {
            DialogArgs given = readDialogArgs(args);
            string title = checkedTitle(given.title);
            std::vector<string> filters = filterList(given);
            spawn(closure Job [title, filters, id, handle] () {
                string chosen = "";
                int status = app_dialog_pick(handle, 0, title, "", "", filters, chosen);
                finishPick(handle, id, status, chosen, false);
            });
        });
        asyncCommand("dialog.save", closure AsyncCommand [] (Item args, string id, int handle) {
            DialogArgs given = readDialogArgs(args);
            string title = checkedTitle(given.title);
            string suggested = given.defaultName;
            if (suggested.length() > 0 && !plainFileName(suggested)) {
                throw "invalid_argument: `defaultName` must be a file name without a folder";
            }
            std::vector<string> filters = filterList(given);
            string extension = defaultExtension(given);
            spawn(closure Job [title, suggested, extension, filters, id, handle] () {
                string chosen = "";
                int status = app_dialog_pick(handle, 1, title, suggested, extension, filters, chosen);
                finishPick(handle, id, status, chosen, false);
            });
        });
        asyncCommand("dialog.folder", closure AsyncCommand [] (Item args, string id, int handle) {
            DialogArgs given = readDialogArgs(args);
            string title = checkedTitle(given.title);
            std::vector<string> none;
            spawn(closure Job [title, none, id, handle] () {
                string chosen = "";
                int status = app_dialog_pick(handle, 2, title, "", "", none, chosen);
                finishPick(handle, id, status, chosen, true);
            });
        });
        asyncCommand("dialog.message", closure AsyncCommand [] (Item args, string id, int handle) {
            MessageArgs given = readMessageArgs(args);
            string title = checkedTitle(given.title);
            string message = given.message;
            if (message.length() == 0 || !plainText(message, 4000)) {
                throw "invalid_argument: `message` must be plain text of 1 to 4000 bytes";
            }
            int kind = dialogKind(given.kind);
            int buttons = dialogButtons(given.buttons);
            if (kind < 0 || buttons < 0) {
                throw "invalid_argument: unknown `kind` or `buttons`";
            }
            spawn(closure Job [title, message, kind, buttons, id, handle] () {
                int button = app_dialog_message(handle, title, message, kind, buttons);
                if (button > 0) {
                    Item result = createObject();
                    addStringToObject(result, "button", buttonName(button));
                    replyOk(handle, id, printUnformatted(result));
                } else {
                    replyError(handle, id, "unsupported", "the dialog could not be shown");
                }
            });
        });
    }

    // Applies what a dialog worker sent: grants the user's choice, then answers the page.
    void onPickRecord(int from, std::vector<string> f) {
        if (f.size() < 4) {
            return;
        }
        string id = f[1];
        FsResult g = new FsResult(0, "");
        if (f[2] == "1") {
            g = gate.grantFolder(f[3]);
        } else {
            g = gate.grantFile(f[3]);
        }
        if (g.status != 0) {
            replyError(from, id, fsCodeFor(g.status), "the chosen path cannot be used");
            return;
        }
        Item result = createObject();
        addStringToObject(result, "path", g.text);
        replyOk(from, id, printUnformatted(result));
    }

    // ---- the window ----

    // Registers window.setTitle {title}, window.setSize {width, height}, window.minimize / maximize / restore / focus,
    // window.close, and window.setDirty {dirty}: the page says it has unsaved work, which matters to confirmClose.
    void enableWindowCommands() {
        CallContext who = dispatcher.caller;
        WindowBook book = windows;
        command("window.setTitle", closure Command [who] (Item args) {
            string title = requiredString(args, "title");
            if (title.length() == 0 || !plainText(title, 200)) {
                throw "invalid_argument: `title` must be plain text of 1 to 200 bytes";
            }
            app_window_title(who.handle, title);
            return createNull();
        });
        command("window.setSize", closure Command [who] (Item args) {
            Item w = getObjectItem(objectArg(args), "width");
            Item h = getObjectItem(objectArg(args), "height");
            if (w == nullptr || h == nullptr || !isNumber(w) || !isNumber(h)) {
                throw "invalid_argument: `width` and `height` must be numbers";
            }
            if (w.valuedouble < 200.0 || w.valuedouble > 10000.0 || h.valuedouble < 150.0 || h.valuedouble > 10000.0) {
                throw "invalid_argument: width must be 200 to 10000 and height 150 to 10000";
            }
            app_window_size(who.handle, int(w.valuedouble), int(h.valuedouble));
            return createNull();
        });
        command("window.minimize", closure Command [who] (Item args) {
            app_window_state(who.handle, 1);
            return createNull();
        });
        command("window.maximize", closure Command [who] (Item args) {
            app_window_state(who.handle, 2);
            return createNull();
        });
        command("window.restore", closure Command [who] (Item args) {
            app_window_state(who.handle, 0);
            return createNull();
        });
        command("window.focus", closure Command [who] (Item args) {
            app_window_state(who.handle, 3);
            return createNull();
        });
        command("window.close", closure Command [who] (Item args) {
            app_terminate(who.handle);
            return createNull();
        });
        command("window.setDirty", closure Command [who, book] (Item args) {
            Window w = book.get(who.handle);
            if (w == nullptr) {
                throw "forbidden: the window is gone";
            }
            w.state.dirty = optionalBool(args, "dirty", true);
            return createNull();
        });
    }

    // Registers the commands a page needs to lay out ITS OWN window: window.getBounds {} -> {x, y, width, height, maximized, minimized, fullscreen, alwaysOnTop, frameless,
    // resizable}, window.setBounds {x, y, width, height} (fitted to the monitors, see Window.setBounds), window.startDrag {} and window.startResize {edge} (for a window with no title bar;
    // they do something only while the left mouse button is held down). `fullscreen` and `alwaysOnTop` also register window.setFullscreen {on} and window.setAlwaysOnTop {on}: off unless asked
    // for, because a page that can cover the screen and stay in front can imitate the system's own windows. Whether the window HAS a title bar or can be resized, and which windows
    // are modal, is for the application (Window.setFrameless / setResizable / setModalFor), not the page.
    void enableWindowLayoutCommands(bool fullscreen, bool alwaysOnTop) {
        CallContext who = dispatcher.caller;
        WindowBook book = windows;
        command("window.getBounds", closure Command [who, book] (Item args) {
            Window self = book.needed(who.handle);
            std::vector<int> b = self.bounds();
            if (b.size() != 5) {
                throw "unsupported: the position of the window cannot be told on this system";
            }
            Item r = createObject();
            addNumberToObject(r, "x", double(b[0]));
            addNumberToObject(r, "y", double(b[1]));
            addNumberToObject(r, "width", double(b[2]));
            addNumberToObject(r, "height", double(b[3]));
            addBoolToObject(r, "maximized", (b[4] / 1) % 2 == 1);
            addBoolToObject(r, "minimized", (b[4] / 2) % 2 == 1);
            addBoolToObject(r, "fullscreen", (b[4] / 4) % 2 == 1);
            addBoolToObject(r, "alwaysOnTop", (b[4] / 8) % 2 == 1);
            addBoolToObject(r, "frameless", (b[4] / 16) % 2 == 1);
            addBoolToObject(r, "resizable", (b[4] / 32) % 2 == 0);
            return r;
        });
        command("window.setBounds", closure Command [who, book] (Item args) {
            Window self = book.needed(who.handle);
            Item x = getObjectItem(objectArg(args), "x");
            Item y = getObjectItem(objectArg(args), "y");
            Item w = getObjectItem(objectArg(args), "width");
            Item h = getObjectItem(objectArg(args), "height");
            if (x == nullptr || y == nullptr || w == nullptr || h == nullptr || !isNumber(x) || !isNumber(y) || !isNumber(w) || !isNumber(h)) {
                throw "invalid_argument: `x`, `y`, `width` and `height` must be numbers";
            }
            if (x.valuedouble < -32000.0 || x.valuedouble > 32000.0 || y.valuedouble < -32000.0 || y.valuedouble > 32000.0) {
                throw "invalid_argument: `x` and `y` must be from -32000 to 32000";
            }
            if (w.valuedouble < 200.0 || w.valuedouble > 10000.0 || h.valuedouble < 150.0 || h.valuedouble > 10000.0) {
                throw "invalid_argument: width must be 200 to 10000 and height 150 to 10000";
            }
            if (!self.setBounds(int(x.valuedouble), int(y.valuedouble), int(w.valuedouble), int(h.valuedouble))) {
                throw "command_failed: the window could not be moved (it may be in full screen)";
            }
            return createNull();
        });
        command("window.startDrag", closure Command [who, book] (Item args) {
            Window self = book.needed(who.handle);
            self.startDrag();
            return createNull();
        });
        command("window.startResize", closure Command [who, book] (Item args) {
            Window self = book.needed(who.handle);
            string edge = requiredString(args, "edge");
            if (!self.startResize(edge)) {
                throw "invalid_argument: `edge` must be left, right, top, bottom, topleft, topright, bottomleft or bottomright";
            }
            return createNull();
        });
        if (fullscreen) {
            command("window.setFullscreen", closure Command [who, book] (Item args) {
                Window self = book.needed(who.handle);
                self.setFullscreen(optionalBool(args, "on", true));
                return createNull();
            });
        }
        if (alwaysOnTop) {
            command("window.setAlwaysOnTop", closure Command [who, book] (Item args) {
                Window self = book.needed(who.handle);
                self.setAlwaysOnTop(optionalBool(args, "on", true));
                return createNull();
            });
        }
    }

    // Registers window.open {start, title?, width?, height?}: a page may ask for another window of the program's own site. Off unless this is called
    // (a page that can open windows can show the application's commands to more places); `max` windows at most (1 to 32, counting the open ones).
    // `start` must be a path inside the site ("/settings.html"): plain text, no "..", no scheme. The window opens after the call has been answered
    // (null), on the thread that serves the windows; it gets the opener's own command list if it has one, and if it cannot open the opener receives
    // the event window.openFailed {start}. Needs openSite to have been used.
    bool enableWindowOpenCommand(int max) {
        if (max < 1 || max > 32) {
            return false;
        }
        maxWindows = max;
        CallContext who = dispatcher.caller;
        WindowBook book = windows;
        command("window.open", closure Command [who, book, max] (Item args) {
            OpenWindowArgs given = readOpenWindowArgs(args);
            string start = given.start;
            if (!pagePathOk(start)) {
                throw "invalid_argument: `start` must be a path inside the site, such as /settings.html";
            }
            string title = given.title;
            if (title.length() > 0 && !plainText(title, 200)) {
                throw "invalid_argument: `title` must be plain text of at most 200 bytes";
            }
            if (given.width < 200 || given.width > 10000) {
                throw "invalid_argument: `width` must be 200 to 10000";
            }
            if (given.height < 150 || given.height > 10000) {
                throw "invalid_argument: `height` must be 150 to 10000";
            }
            if (book.count() >= max) {
                string message = "too_many: at most " + intToString(max) + " windows can be open";
                throw message;
            }
            string record = "openwin";
            record.push_back(char(0));
            record = record + start;
            record.push_back(char(0));
            record = record + title;
            record.push_back(char(0));
            record = record + intToString(given.width);
            record.push_back(char(0));
            record = record + intToString(given.height);
            record.push_back(char(0));
            if (given.modal) {
                record = record + "1";
            } else {
                record = record + "0";
            }
            record.push_back(char(0));
            if (app_push(who.handle, "", record, 100) != 1) {
                throw "busy: the application is not keeping up";
            }
            return createNull();
        });
        return true;
    }

    // The window.open record: opens the window if the cap still allows it, and tells the opener when it could not.
    void openFromRecord(int opener, std::vector<string> f) {
        if (f.size() < 5) {
            return;
        }
        string start = f[1];
        string title = f[2];
        if (title.length() == 0) {
            title = "window";
        }
        int h = 0;
        if (maxWindows > 0 && windows.count() < maxWindows && pagePathOk(start)) {
            h = openWindow(title, int(decimalValue(f[3])), int(decimalValue(f[4])), false, start);
        }
        if (h == 0) {
            Item e = createObject();
            addStringToObject(e, "start", start);
            emitEvent(opener, "window.openFailed", printUnformatted(e));
            return;
        }
        dispatcher.rules.inheritRules(opener, h);
        if (f.size() >= 6 && f[5] == "1") {
            Window child = windows.get(h);
            if (child != nullptr) {
                child.setModalFor(opener);
            }
        }
    }

    // When the user closes a window (the X, Alt+F4) while its page has said it has unsaved work, ask first with a native box whose text is
    // the application's, not the page's. Applies to every window, open now or opened later. Without this a window just closes.
    bool confirmClose(string title, string message) {
        if (!plainText(title, 200) || !plainText(message, 4000)) {
            return false;
        }
        confirmDefault = true;
        confirmTitle = title;
        confirmMessage = message;
        window.closeTitle = title;
        window.closeMessage = message;
        window.confirm = true;
        bool ok = true;
        int i = 0;
        while (i < windows.items.size()) {
            Window w = windows.items[i];
            if (!w.confirmClose(title, message)) {
                ok = false;
            }
            i = i + 1;
        }
        return ok;
    }

    void onWindowRecord(int from, std::vector<string> f) {
        if (f.size() < 2) {
            return;
        }
        if (f[1] == "placement" && f.size() >= 7) {
            Window moved = windows.get(from);
            bool numbers = isSignedNumber(f[2]) && isSignedNumber(f[3]) && isSignedNumber(f[4]) && isSignedNumber(f[5]) && isSignedNumber(f[6]);
            if (numbers && moved != nullptr && moved.memoryKey.length() > 0) {
                WindowMemory mem = memory;
                mem.remember(moved.memoryKey, signedInt(f[2]), signedInt(f[3]), signedInt(f[4]), signedInt(f[5]), signedInt(f[6]));
            }
            return;
        }
        if (f[1] == "theme" && f.size() >= 3) {
            theme.systemChanged(f[2]);
            return;
        }
        if (f[1] == "navigation_blocked" && f.size() >= 3) {
            if (isUtf8(f[2])) {
                Item e = createObject();
                addStringToObject(e, "url", f[2]);
                emitEvent(from, "window.navigationBlocked", printUnformatted(e));
                // a click (not a script) on a link that leaves the application: the browser opens it if the application said so
                if (links.browserLinks && f.size() >= 4 && f[3] == "1") {
                    links.openAddress(f[2]);
                }
            }
            return;
        }
        Window w = windows.get(from);
        if (w == nullptr) {
            return;
        }
        WindowState st = w.state;
        if (f[1] == "close_declined") {
            st.confirming = false;
            emitEvent(from, "window.closeDeclined", "null");
            return;
        }
        if (f[1] != "close_requested") {
            return;
        }
        if (st.hides) {
            app_window_state(from, 5);
            return;
        }
        if (!st.dirty) {
            app_terminate(from);
            return;
        }
        if (st.confirming) {
            return;
        }
        st.confirming = true;
        int h = from;
        string title = st.closeTitle;
        string message = st.closeMessage;
        string declined = packRecord("window", "close_declined");
        spawn(closure Job [h, title, message, declined] () {
            if (app_dialog_message(h, title, message, 3, 2) == 3) {
                app_terminate(h);
            } else {
                app_push(h, "", declined, 100);
            }
        });
    }

    // The page may not send a call larger than maxRequestBytes or while maxQueuedCalls are waiting: such a call is answered at
    // once with {code: "too_large"} / {code: "busy"} and never reaches a command (defaults 4 MiB and 256). Applies to the next open.
    bool setRequestLimits(int maxRequest, int maxQueued) {
        if (maxRequest < 1024 || maxRequest > 268435456 || maxQueued < 1 || maxQueued > 100000) {
            return false;
        }
        maxRequestBytes = maxRequest;
        maxQueuedCalls = maxQueued;
        return true;
    }

    // After the application's own page, the window may load only addresses that start with `prefix` (for example a dev server,
    // "http://localhost:5173/"); everything else, every new window and every frame pointing elsewhere is refused and reported as
    // the event window.navigationBlocked {url}. Call before open.
    bool allowNavigation(string prefix) {
        if (prefix.length() < 5 || !plainText(prefix, 1000)) {
            return false;
        }
        addNavigation(prefix);
        return true;
    }

    void addNavigation(string prefix) {
        int i = 0;
        while (i < navigation.size()) {
            if (navigation[i] == prefix) {
                return;
            }
            i = i + 1;
        }
        navigation.push_back(prefix);
    }

    // From now on the page may call only the commands named here (every name must be one that is registered by now, so a typo cannot
    // silently leave a command open or closed). Others are answered {code: "forbidden"}, registered or not. Cancelling a call
    // ($cancel) is always allowed. Calling it again replaces the list. This is the list of every window that has no list of its own
    // (Window.allowOnlyCommands gives one window its own). false (and nothing changes) if a name is not registered.
    bool allowOnlyCommands(std::vector<string> names) {
        int i = 0;
        while (i < names.size()) {
            if (!dispatcher.rules.hasCommand(names[i])) {
                return false;
            }
            i = i + 1;
        }
        dispatcher.rules.restrictAll(names);
        return true;
    }

    // How long a page waits for the async command `name` ("" = every async command that has no setting of its own): after ms it is answered
    // {code: "timed_out"}, the call counts as cancelled (callCancelled; a program it started is killed) and a late answer is dropped.
    // 0 means as long as it takes, which is the default. Do not set it for the dialog commands, which wait for a person.
    bool setAsyncTimeout(string name, int ms) {
        if (ms < 0 || (ms > 0 && ms < 50) || ms > 86400000) {
            return false;
        }
        if (name.length() == 0) {
            dispatcher.defaultTimeoutMs = ms;
        } else {
            dispatcher.setTimeout(name, ms);
        }
        return true;
    }

    // After the program ends (main returns) the jobs still running get this long, then the process ends without them (a message on stderr
    // says how many). Default 5000. 0 waits for every job however long it takes.
    bool setShutdownGrace(int ms) {
        if (ms < 0 || ms > 3600000) {
            return false;
        }
        cling::setExitGraceMs(ms);
        return true;
    }

    // At most n async jobs run at the same time (the rest wait in a queue, oldest first); 0 = the default,
    // max(4, number of cores). A job is never dropped: on exit every queued job still runs.
    void setWorkerLimit(int n) {
        cling::setWorkerLimit(n);
    }

    // Opens a window on `start` (an address, or "" for `html`). Returns its handle, 0 if it could not be created (the shim has printed why on
    // stderr). The first window opened is the primary one: `handle`, `window` and `watches` name it.
    int openAt(string title, int width, int height, string html, string start, string bridgeJs, bool debug) {
        int d = 0;
        if (debug) {
            d = 1;
        }
        int h = app_open(title, width, height, html, start, bridgeJs, d);
        if (h == 0) {
            return 0;
        }
        app_limits(h, maxRequestBytes, maxQueuedCalls);
        app_navigation_allow(h, navigation);
        Window w = new Window(h, dispatcher.rules);
        w.navigation = navigation;
        windows.add(w);
        opened.push_back(h);
        if (windows.count() == 1) {
            handle = h;
            window = w.state;
            watches = w.watches;
        }
        if (confirmDefault) {
            w.confirmClose(confirmTitle, confirmMessage);
        }
        if (instanceClaimed && windows.count() == 1) {
            app_instance_listen(h);
        }
        theme.windowOpened(h);
        if (drops.on) {
            app_drop_accept(h, 1);
        }
        if (memory.isOpen()) {
            string key = memoryKeyFor(start, windows.count() == 1);
            w.memoryKey = key;
            placeRemembered(h, key);
            app_window_track(h, 1);
        }
        return h;
    }

    // ---- menus (src/menu.clg) ----

    // What runs when an item of a menu bar is clicked or its shortcut is pressed: `clicked(id)`, with an id the application gave. One handler for the
    // application; it runs on the main thread. A throw in it is dropped (nobody is waiting for an answer).
    void onMenu(MenuAction handler) {
        menuHandler = handler;
    }

    // From now on a click is also sent to the page of the window it came from, as the event menu.click {id}. Off by default: a page that is not told
    // has nothing to react to.
    void menuEventsToPage(bool on) {
        menuToPage = on;
    }

    // The menu bar of the first window.
    bool setMenu(Menu bar) {
        Window w = windows.get(handle);
        if (w == nullptr) {
            return false;
        }
        return w.setMenu(bar);
    }

    int trayIndex(int h) {
        int i = 0;
        while (i < trays.size()) {
            if (trays[i] == h) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    void onMenuClick(int from, string id) {
        int ti = trayIndex(from);
        if (ti >= 0) {
            Menu tm = trayMenus[ti];
            int mi = tm.indexOfId(id);
            if (mi < 0 || (tm.flags[mi] / 2) % 2 == 1) {
                return;                   // not an item of the tray menu, or a greyed one
            }
            try {
                MenuAction trayItem = menuHandler;
                trayItem.clicked(id);
            } catch (string message) {
                // nobody is waiting for an answer
            }
            return;
        }
        Window w = windows.get(from);
        if (w == nullptr || !(w.menuItemEnabled(id) || popups.hasItem(id))) {
            return;                       // an id this window's menu (or a pop-up menu) does not have, or an item that is greyed out: nothing happens
        }
        try {
            MenuAction handler = menuHandler;
            handler.clicked(id);
        } catch (string message) {
            // nobody is waiting for an answer
        }
        if (menuToPage) {
            Item e = createObject();
            addStringToObject(e, "id", id);
            emitEvent(from, "menu.click", printUnformatted(e));
        }
    }

    // ---- pop-up menus a page may ask for ----

    // Registers a menu under a name (1 to 64 letters, digits, `.`, `_`, `-`; at most 16 menus): the page may ask for it by that name and for nothing else.
    // The menu may have items at its top level. false if the name is taken or not a name, the menu is not complete, or there are 16 already.
    bool allowPopup(string name, Menu popup) {
        if (!menuId(name) || popups.indexOf(name) >= 0 || !popup.complete() || popups.names.size() >= 16) {
            return false;
        }
        popups.names.push_back(name);
        popups.menus.push_back(popup);
        return true;
    }

    // Registers menu.popup {name}: shows the menu with that name at the mouse and answers the id of the item chosen, or null if it was dismissed. A name that was not
    // registered with allowPopup is "unknown_menu". The chosen item also runs the handler of onMenu. Off until this is called.
    void enablePopupCommand() {
        PopupBook book = popups;
        asyncCommand("menu.popup", closure AsyncCommand [book] (Item args, string id, int handle) {
            string name = requiredString(args, "name");
            int index = book.indexOf(name);
            if (index < 0) {
                throw "unknown_menu: no menu is registered under that name";
            }
            Menu chosenFrom = book.menus[index];
            string spec = chosenFrom.spec();
            spawn(closure Job [spec, id, handle] () {
                string chosen = "";
                int st = app_menu_popup(handle, spec, chosen);
                if (st == -1) {
                    replyError(handle, id, "unsupported", "menus cannot be shown on this system");
                } else if (st != 0) {
                    replyError(handle, id, "command_failed", "the menu could not be shown");
                } else if (chosen.length() == 0) {
                    replyOk(handle, id, "null");
                } else {
                    Item answer = createString(chosen);
                    replyOk(handle, id, printUnformatted(answer));
                }
            });
        });
    }

    // ---- notifications (Windows) ----

    // Makes notifications possible in a program that has no tray icon: a notification-only icon (tooltip: `appName`, at most 127 bytes of text) that is in the
    // notification area only while a notification is up. A program that has a tray icon (openTray) needs nothing: its notifications come from that icon. false if it could not be made.
    bool enableNotifications(string appName) {
        if (notifier.handle != 0) {
            return true;
        }
        if (!plainText(appName, 127) || appName.length() == 0) {
            return false;
        }
        int th = 0;
        if (app_notifier_open(appName, th) != 0 || th == 0) {
            return false;
        }
        trays.push_back(th);
        trayMenus.push_back(new Menu());
        notifier.handle = th;
        return true;
    }

    // Shows a notification (a toast on current Windows): a title of 1 to 63 bytes, text of up to 255, kind "info", "warning" or "error", and an id ("" or a name) that
    // onNotificationClick gets when the user clicks it. "" if the system took it, else the reason as "code: message". At most one every 2 seconds (setNotificationGap). Whether it is SHOWN is up to the
    // system: Focus Assist / Do Not Disturb, the user's settings for notifications and a full-screen program in front can all hide it.
    string notify(string title, string text, string kind, string id) {
        notifier.asker = 0;
        return notifier.show(title, text, kind, id);
    }

    // The least time between two notifications, from 200 ms to 10 minutes (default 2 seconds). The page cannot change it. false if it is out of that range.
    bool setNotificationGap(int ms) {
        if (ms < 200 || ms > 600000) {
            return false;
        }
        notifier.gapMs = double(ms);
        return true;
    }

    // What runs when the user clicks a notification: `clicked(id)`.
    void onNotificationClick(NotificationAction handler) {
        notifyHandler = handler;
    }

    // Registers notification.show {title, text, kind?, id?} for the page: the same limits and the same gap. A click on that notification reaches the page that
    // asked as the event notification.click {id}, and the handler of onNotificationClick too. Off until this is called; notifications must be enabled (enableNotifications or a tray).
    void enableNotificationCommand() {
        Notifier shared = notifier;
        CallContext caller = dispatcher.caller;
        command("notification.show", closure Command [shared, caller] (Item args) {
            NotifyArgs given = readNotifyArgs(args);
            shared.asker = caller.handle;
            string why = shared.show(given.title, given.text, given.kind, given.id);
            if (why.length() > 0) {
                throw why;
            }
            return createNull();
        });
    }

    void onNotificationRecord(int from, string id) {
        if (trayIndex(from) < 0 || (id.length() > 0 && !menuId(id))) {
            return;
        }
        try {
            NotificationAction handler = notifyHandler;
            handler.clicked(id);
        } catch (string message) {
            // nobody is waiting for an answer
        }
        if (notifier.asker != 0) {
            Item e = createObject();
            addStringToObject(e, "id", id);
            emitEvent(notifier.asker, "notification.click", printUnformatted(e));
        }
    }

    // ---- the tray icon (Windows) ----

    // Puts an icon in the notification area: the program's own icon (ICON= in build.sh, else the system's), a tooltip of at most 127 bytes of plain text, and a
    // right-click menu `popup` (src/menu.clg; its items may be at the top level). Returns the tray's handle, 0 if it could not be made (not Windows, no
    // shell, a menu that is not complete, a bad tooltip). Choosing an item runs the handler of onMenu with the item's id; clicking the icon runs onTray.
    // Close it with closeTray; App.close() closes all of them. Not closed, the icon stays in the notification area until the mouse passes over it.
    int openTray(string tooltip, Menu popup) {
        if (!plainText(tooltip, 127) || tooltip.length() == 0 || !popup.complete() || trays.size() >= 4) {
            return 0;
        }
        int th = 0;
        if (app_tray_open(tooltip, popup.spec(), th) != 0 || th == 0) {
            return 0;
        }
        trays.push_back(th);
        trayMenus.push_back(popup);
        if (notifier.handle == 0) {
            notifier.handle = th;            // a program with a tray icon says its notifications from it
        }
        return th;
    }

    // What runs when the tray icon is clicked: `happened("click")` for a left click, `happened("double")` for a double click. The right click shows the menu.
    void onTray(TrayAction handler) {
        trayHandler = handler;
    }

    bool trayTooltip(int th, string tooltip) {
        if (trayIndex(th) < 0 || !plainText(tooltip, 127) || tooltip.length() == 0) {
            return false;
        }
        return app_tray_update(th, tooltip, "") == 0;
    }

    bool trayEnabled(int th, string id, bool enabled) {
        int ti = trayIndex(th);
        if (ti < 0) {
            return false;
        }
        Menu tm = trayMenus[ti];
        int mi = tm.indexOfId(id);
        if (mi < 0) {
            return false;
        }
        int on = 0;
        if (enabled) {
            on = 1;
        }
        tm.flags[mi] = tm.flags[mi] % 2 + 2 - 2 * on;
        return app_tray_item(th, id, on, -1) == 0;
    }

    bool trayChecked(int th, string id, bool checked) {
        int ti = trayIndex(th);
        if (ti < 0) {
            return false;
        }
        Menu tm = trayMenus[ti];
        int mi = tm.indexOfId(id);
        if (mi < 0 || tm.kinds[mi] != "c") {
            return false;
        }
        int on = 0;
        if (checked) {
            on = 1;
        }
        tm.flags[mi] = (tm.flags[mi] / 2) * 2 + on;
        return app_tray_item(th, id, -1, on) == 0;
    }

    // Removes the icon.
    bool closeTray(int th) {
        int ti = trayIndex(th);
        if (ti < 0) {
            return false;
        }
        app_close(th);
        trayGone(th);
        return true;
    }

    void trayGone(int th) {
        int ti = trayIndex(th);
        if (ti < 0) {
            return;
        }
        int last = trays.size() - 1;
        if (ti != last) {
            trays[ti] = trays[last];
            trayMenus[ti] = trayMenus[last];
        }
        trays.pop_back();
        trayMenus.pop_back();
        if (notifier.handle == th) {
            notifier.handle = 0;
        }
    }

    // The window with this handle comes back (see Window.hide, hideOnClose): shown, restored if minimized, in front.
    bool showWindow(int h) {
        Window w = windows.get(h);
        if (w == nullptr) {
            return false;
        }
        return w.show();
    }

    // ---- remembering where windows were (src/placement.clg) ----

    // From now on windows open where they were the last time (the restored rectangle and whether they were maximized, kept per window in windows.json in the
    // application's config folder), fitted to the monitors that exist now, and the place is saved when the user moves, resizes, maximizes or restores one.
    // The first window is "main", another window is named by the page it starts on; at most 16 names. Call before the first window is opened. false if the
    // application name is not a plain name or the config folder cannot be used (windows then open as they always did). The window is created where the
    // program asked and moved at once, so it can be seen to jump; a program that cares passes its own default size.
    bool rememberWindows(string appName) {
        return memory.open(appName) == "";
    }

    string memoryKeyFor(string start, bool first) {
        if (first) {
            return "main";
        }
        if (startsWithText(start, "/") && start.length() <= 80 && plainText(start, 80)) {
            return "page" + start;
        }
        return "other";
    }

    void placeRemembered(int h, string key) {
        WindowMemory mem = memory;
        int i = mem.indexOf(key);
        if (i < 0) {
            return;
        }
        std::vector<int> monitors = monitorList();
        std::vector<int> r = fitToMonitors(mem.xs[i], mem.ys[i], mem.ws[i], mem.hs[i], monitors);
        app_window_placement(h, r[0], r[1], r[2], r[3], mem.maxed[i]);
    }

    // Opens a window on the page embedded at build time or on `siteStart`. false if it could not be created.
    bool open(string title, int width, int height, string html, string bridgeJs, bool debug) {
        return openAt(title, width, height, html, siteStart, bridgeJs, debug) != 0;
    }

    // Opens another window and returns its handle (0 if it could not be created); `windows.get(handle)` is the Window object. `start` is ""
    // for the embedded page, a path inside the program's own site ("/settings.html", after openSite), or the address of a development server
    // (see openDevServer). It gets the application's command list and the addresses allowNavigation added.
    int openWindow(string title, int width, int height, bool debug, string start) {
        string address = "";
        string html = "";
        if (start.length() == 0) {
            html = app_page_html();
        } else if (startsWithText(start, "/")) {
            if (siteOrigin.length() == 0 || !pagePathOk(start)) {
                return 0;
            }
            address = siteOrigin + start;
        } else {
            if (app_release_build() == 1) {
                return 0;
            }
            string origin = devServerOrigin(start);
            if (origin.length() == 0) {
                return 0;
            }
            addNavigation(origin + "/");
            address = start;
        }
        return openAt(title, width, height, html, address, app_bridge_js() + app_extra_js(), debug);
    }

    // The development server address the program was asked to load (environment variable APP_DEV_URL), or "" if there is none, it is not a
    // loopback address (see devServerOrigin) or this is a release build.
    string devServerFromEnvironment() {
        if (app_release_build() == 1) {
            return "";
        }
        string url = "";
        if (app_os_env("APP_DEV_URL", url) != 1) {
            return "";
        }
        string origin = devServerOrigin(url);
        if (origin.length() == 0) {
            return "";
        }
        return url;
    }

    // Opens the window on a development server (Vite, webpack, `python -m http.server`...) running on this machine, with the bridge
    // injected and the developer tools on. The page reloads itself the way the dev server arranges (hot module replacement); this
    // program's commands stay the compiled ones. Refused (false) for an address that is not http on localhost / 127.0.0.1 / [::1], and in
    // a release build, where nothing may load a server. The window may navigate within that origin and nowhere else.
    bool openDevServer(string title, int width, int height, string url) {
        if (app_release_build() == 1) {
            return false;
        }
        string origin = devServerOrigin(url);
        if (origin.length() == 0) {
            return false;
        }
        siteStart = url;
        addNavigation(origin + "/");
        return open(title, width, height, "", app_bridge_js() + app_extra_js(), true);
    }

    // Opens the window on the page embedded at build time, with the standard bridge script.
    bool openPage(string title, int width, int height, bool debug) {
        return open(title, width, height, app_page_html(), app_bridge_js() + app_extra_js(), debug);
    }

    // Opens the window on the program's own web files (build with ASSETS=<folder>), served from memory under `origin`, which must be
    // http:// or https:// with no path ("http://app.localhost"). `csp`, if not empty, is sent with every HTML file as its
    // Content-Security-Policy. The window may navigate to that origin and nowhere else (allowNavigation adds more). false if there
    // are no files, no page among them, or the window could not be created.
    bool openSite(string title, int width, int height, bool debug, string origin, string csp) {
        if (siteOrigin.length() > 0 && siteOrigin != origin) {
            return false;           // one site per program: every window shares the origin
        }
        if (siteOrigin.length() == 0) {
            SiteInfo info = publishSite(origin, csp);
            if (info.files == 0 || info.start.length() == 0) {
                return false;
            }
            siteStart = info.start;
            siteOrigin = origin;
        }
        addNavigation(origin + "/");
        return open(title, width, height, "", app_bridge_js() + app_extra_js(), debug);
    }

    // Registers the pump that wakeMain(handle, name) runs on the main thread (see Pump). The same name replaces the earlier pump.
    // false for a name that is empty, over 64 bytes or not plain text.
    bool onPump(string name, Pump p) {
        if (name.length() == 0 || !plainText(name, 64)) {
            return false;
        }
        int index = pumps.indexOf(name);
        if (index >= 0) {
            pumps.items[index] = p;
        } else {
            pumps.names.push_back(name);
            pumps.items.push_back(p);
        }
        return true;
    }

    // Expects a record from a worker for the page call `id` of window `handle` (the one the command was called from; call ids repeat across
    // windows): when finishLater arrives, `l.done` runs on the main thread.
    void later(int handle, string id, Later l) {
        laters.handles.push_back(handle);
        laters.ids.push_back(id);
        laters.items.push_back(l);
    }

    // The run of a program the application chooses itself: `exe` as resolveProgram found it, `args` vetted by the caller, `cwd` a
    // folder the file policy has resolved. The environment is the one programs get (see passEnvironment).
    ToolRun toolRun(string exe, std::vector<string> args, string cwd, int timeoutMs, int maxBytes) {
        ToolRun run = new ToolRun(exe, cwd, timeoutMs, maxBytes);
        run.args = args;
        run.env = programs.environment();
        return run;
    }

    // A record the native layer queued itself (empty id) for window `from`: "watch", "pick", "window", "later" or "pump".
    // A later launch of this program handed over its working folder and arguments (record "instance", folder, arguments...). They are text from
    // another process and reach the page as the event app.secondInstance {cwd, args}; at most 64 arguments of plain text up to 4096 bytes each. The window
    // comes to the front. Nothing in them is allowed or opened by this: if an argument names a file, whether the page may reach it is the application's call.
    void onSecondInstance(int from, std::vector<string> f) {
        if (f.size() < 2) {
            return;
        }
        string cwd = f[1];
        if (!plainText(cwd, 32000)) {
            cwd = "";
        }
        Item e = createObject();
        addStringToObject(e, "cwd", cwd);
        Item list = createArray();
        int i = 2;
        int kept = 0;
        while (i < f.size() && kept < 64) {
            if (plainText(f[i], 4096)) {
                addItemToArray(list, createString(f[i]));
                kept = kept + 1;
            }
            i = i + 1;
        }
        addItemToObject(e, "args", list);
        emitEvent(from, "app.secondInstance", printUnformatted(e));
        app_window_state(from, 3);
    }

    // ---- one running copy (Windows; elsewhere nothing is enforced) ----

    // Makes this process THE instance named `appName` (a plain name), or finds that another one is running and hands it this process's folder and
    // arguments. 0 this is the instance (the first window listens for later launches); 1 another one runs and was told: exit now; 2 another one holds
    // the name but could not be told (it may be starting or stuck): exit now, or tell the user; 3 not supported on this system, nothing is enforced;
    // 4 the name is not a plain name. Call before the first window is opened.
    int claimInstance(string appName) {
        if (!plainName(appName)) {
            return 4;
        }
        int first = 1;
        int st = app_instance_claim(appName, first);
        if (st == 0 && first == 1) {
            instanceClaimed = true;
            return 0;
        }
        if (st == 0) {
            return 1;
        }
        if (st == 4 && first == 0) {
            return 2;
        }
        return 3;
    }

    // true if this process may go on: it is the instance, or nothing can be enforced here. false: another copy is running (and, if it could be reached,
    // was told); the program should end. `if (!app.singleInstance("my-app")) { return 0; }`
    bool singleInstance(string appName) {
        int code = claimInstance(appName);
        return code == 0 || code == 3;
    }

    // The arguments this process was started with, without the program name.
    std::vector<string> arguments() {
        string raw = "";
        app_command_line(raw);
        return splitFields(raw);
    }

    void onInternalRecord(int from, string request) {
        std::vector<string> f = splitFields(request);
        if (f.size() == 0) {
            return;
        }
        if (f[0] == "watch") {
            Window w = windows.get(from);
            if (w != nullptr) {
                w.watches.onRecord(gate, from, f);
            }
        } else if (f[0] == "openwin") {
            openFromRecord(from, f);
        } else if (f[0] == "pick") {
            onPickRecord(from, f);
        } else if (f[0] == "window") {
            onWindowRecord(from, f);
        } else if (f[0] == "instance") {
            onSecondInstance(from, f);
        } else if (f[0] == "drop" && f.size() >= 4) {
            onDropRecord(from, f);
        } else if (f[0] == "menu" && f.size() >= 2) {
            onMenuClick(from, f[1]);
        } else if (f[0] == "notify" && f.size() >= 2) {
            onNotificationRecord(from, f[1]);
        } else if (f[0] == "tray" && f.size() >= 2) {
            if (trayIndex(from) >= 0 && (f[1] == "click" || f[1] == "double")) {
                try {
                    TrayAction clicked = trayHandler;
                    clicked.happened(f[1]);
                } catch (string message) {
                    // nobody is waiting for an answer
                }
            }
        } else if (f[0] == "pump" && f.size() >= 2) {
            int index = pumps.indexOf(f[1]);
            if (index >= 0) {
                Pump p = pumps.items[index];
                try {
                    p.pump(gate);
                } catch (string message) {
                    // nothing to answer: a pump has no page call (see Pump)
                }
            }
        } else if (f[0] == "later" && f.size() >= 4) {
            int index = laters.indexOf(from, f[1]);
            if (index < 0) {
                return;
            }
            Later l = laters.items[index];
            laters.drop(index);
            try {
                l.done(from, f[1], int(decimalValue(f[2])), f[3]);
            } catch (string message) {
                replyError(from, f[1], errorCodeOf(message), errorTextOf(message));
            }
        }
    }

    // A window's queue reported that it is closed: the work it started is told to stop (callCancelled; programs it started are killed), its
    // book entries go, and the next window becomes the primary one if it was the primary.
    void windowGone(int gone) {
        app_cancel_all(gone);
        dispatcher.forgetWindow(gone);
        laters.forgetWindow(gone);
        int index = windows.indexOf(gone);
        if (index >= 0) {
            windows.drop(index);
        }
        if (gone == handle && windows.count() > 0) {
            Window next = windows.items[0];
            handle = next.handle;
            window = next.state;
            watches = next.watches;
        }
    }

    // Serves the next thing in any window's queue: a call from a page (dispatched and answered) or a record from the native layer (a file
    // watcher's change, a dialog's choice, a window's close button). Waits up to timeoutMs (-1 = for as long as it takes), and delivers merged
    // file-watch events when they have been quiet for a moment.
    // Returns 1 if something was served, 2 if the wait timed out, 0 when no window is open any more (the last one has closed).
    int serveOne(int timeoutMs) {
        double started = app_now_ms();
        if (quitCalled && windows.count() == 0) {
            return 0;
        }
        while (true) {
            int wait = timeoutMs;
            if (timeoutMs >= 0) {
                wait = timeoutMs - int(app_now_ms() - started);
                if (wait < 0) {
                    wait = 0;
                }
            }
            bool pending = windows.anyPending();
            if (pending && (wait < 0 || wait > 40)) {
                wait = 40;
            }
            dispatcher.sweep();
            int due = dispatcher.nextDueMs();
            if (due >= 0 && (wait < 0 || wait > due + 1)) {
                wait = due + 1;
            }
            int from = 0;
            std::vector<int> waitOn = windows.handles;
            int t = 0;
            while (t < trays.size()) {
                waitOn.push_back(trays[t]);
                t = t + 1;
            }
            int ready = app_wait_any(waitOn, wait, from);
            if (ready == 0) {
                return 0;
            }
            if (ready == 1) {
                string id = "";
                string request = "";
                int r = app_next_call(from, 0, id, request);
                if (r == 1) {
                    if (id.length() == 0) {
                        onInternalRecord(from, request);
                    } else {
                        Reply reply = dispatcher.handle(from, id, request);
                        if (reply.status != 2) {
                            app_return(from, id, reply.status, reply.json);
                        }
                    }
                    windows.flushQuiet(gate);
                    return 1;
                }
                if (r == 0 && trayIndex(from) >= 0) {
                    trayGone(from);
                } else if (r == 0) {
                    windowGone(from);
                    if (windows.count() == 0 && (!stayWithoutWindows || quitCalled)) {
                        return 0;
                    }
                }
            } else {
                windows.flushQuiet(gate);
                if (timeoutMs >= 0 && app_now_ms() - started >= double(timeoutMs)) {
                    return 2;
                }
            }
        }
        return 2;
    }

    // Serves calls and records until the last window closes. Returns how many calls and records were served.
    int run() {
        int served = 0;
        while (true) {
            int r = serveOne(-1);
            if (r == 0) {
                break;
            }
            if (r == 1) {
                served = served + 1;
            }
        }
        return served;
    }

    // By default the program ends when its last window has closed. With keepRunning(true) it goes on with no window open (a program that lives in the tray) until
    // quit() is called; the loop (run / serveOne) then returns 0.
    void keepRunning(bool on) {
        stayWithoutWindows = on;
    }

    // Closes every window the way the close button does when nothing asks first, and ends the loop even for a program that keeps running without windows.
    void quit() {
        quitCalled = true;
        int i = 0;
        while (i < windows.items.size()) {
            Window w = windows.items[i];
            app_terminate(w.handle);
            i = i + 1;
        }
    }

    // Ends the application in order: every call still running is told to stop (callCancelled, programs killed), the watchers are stopped,
    // the window closes. Jobs that are still running afterwards get setShutdownGrace milliseconds when main returns, then the process ends.
    void close() {
        while (trays.size() > 0) {
            closeTray(trays[0]);
        }
        int i = 0;
        while (i < opened.size()) {
            app_cancel_all(opened[i]);
            app_close(opened[i]);
            i = i + 1;
        }
        while (opened.size() > 0) {
            opened.pop_back();
        }
        while (windows.count() > 0) {
            windows.drop(windows.count() - 1);
        }
        handle = 0;
        window.handle = 0;
    }
};
