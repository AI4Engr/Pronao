// pronao -- what a page may ask the operating system to open: an address in the default browser, a file in its default program, a file shown in
// the file manager. The native layer (app_shell_open) only hands the target to the shell; WHAT may be handed over is decided here.
//
//  * An ADDRESS must be an http, https or mailto address that the application allowed (`allowSchemes`), written the way the network wants it: printable
//    ASCII only (so an address with spaces, quotes, angle brackets or a backslash is refused, and non-ASCII must be percent-encoded), at most 2048
//    bytes, and for http / https a host with no `user@` in front of it. Nothing else is ever opened: not `file:`, not `javascript:`, not a program.
//  * A FILE must be one the file policy lets the page reach, a regular file, and its extension must be one the application listed (`allowExtensions`).
//    A fixed list of extensions that start programs or scripts, or change settings, is refused even if the application lists one by mistake: opening
//    a program is "run this", and the page may not ask for that here (proc.run is the only door to programs, and it has its own table).
//  * SHOWING a file or folder in the file manager needs only the file policy: it starts nothing.
//  * Every kind is rate limited (one per 300 ms), so a page cannot open a thousand browser tabs.
//
// What this does not do: it cannot tell what the browser or the default program of a file type will do with what it receives. A document viewer that
// runs scripts in a file is the application's choice to list.
#include "text.clh"

ext_fn int app_shell_open(string target, int mode);
ext_fn double app_now_ms();

// Extensions that start a program, run a script, install something or change a setting when the shell opens them. Never opened from a page.
bool dangerousExtension(string ext) {
    std::vector<string> names = splitOn("exe,com,bat,cmd,scr,pif,msi,msp,msix,appx,appxbundle,ps1,psm1,psd1,ps1xml,vbs,vbe,js,jse,wsf,wsh,hta,cpl,lnk,url,reg,jar,dll,sys,drv,ocx,inf,chm,gadget,application,sh,bash,zsh,command,app,run,bin,desktop,workflow,action,scpt,py,pl,rb,php,ade,adp,mde,mdb,msc,msh,job,theme,themepack,settingcontent-ms,library-ms,search-ms,diagcab,iso,img,vhd,vhdx,dmg,pkg,deb,rpm,apk", ',');
    int i = 0;
    while (i < names.size()) {
        if (names[i] == ext) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

bool extensionName(string ext) {
    if (ext.length() < 1 || ext.length() > 8) {
        return false;
    }
    int i = 0;
    while (i < ext.length()) {
        char c = ext[i];
        if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9'))) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// the lower-case extension of the last component of a path ("" if it has none)
string extensionOf(string path) {
    int cut = path.length() - 1;
    while (cut >= 0 && path[cut] != '/' && path[cut] != '\\') {
        cut = cut - 1;
    }
    string leaf = path.substr(cut + 1, path.length() - cut - 1);
    int dot = leaf.length() - 1;
    while (dot >= 0 && leaf[dot] != '.') {
        dot = dot - 1;
    }
    if (dot <= 0) {
        return "";
    }
    return lowerAscii(leaf.substr(dot + 1, leaf.length() - dot - 1));
}

bool addressChar(char c) {
    int v = int(c);
    if (v < 33 || v > 126) {
        return false;
    }
    return c != '"' && c != '<' && c != '>' && c != '\\' && c != '^' && c != '`' && c != '{' && c != '|' && c != '}';
}

bool hostChar(char c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '.' || c == '-' || c == ':' || c == '[' || c == ']' || c == '_';
}

// the lower-case scheme of an address ("" if it does not start with one)
string schemeOf(string url) {
    int colon = indexOfChar(url, ':');
    if (colon < 1) {
        return "";
    }
    int i = 0;
    while (i < colon) {
        char c = url[i];
        bool letter = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
        bool more = (c >= '0' && c <= '9') || c == '+' || c == '-' || c == '.';
        if (!(letter || (i > 0 && more))) {
            return "";
        }
        i = i + 1;
    }
    return lowerAscii(url.substr(0, colon));
}

class LinkRules {
public:
    std::vector<string> schemes;       // empty until the application allows some
    std::vector<string> extensions;
    bool browserLinks;                 // a click on a link that leaves the application opens it in the browser (App.openLinksInBrowser)
    double lastMs;

    LinkRules() {
        browserLinks = false;
        lastMs = -1.0e9;
    }

    // Names from http, https, mailto. false (and nothing changes) for anything else or an empty list.
    bool allowSchemes(std::vector<string> names) {
        if (names.size() == 0 || names.size() > 3) {
            return false;
        }
        int i = 0;
        while (i < names.size()) {
            if (names[i] != "http" && names[i] != "https" && names[i] != "mailto") {
                return false;
            }
            i = i + 1;
        }
        schemes = names;
        return true;
    }

    // Lower-case extensions without the dot ("pdf", "txt"), at most 32, none of them one that starts a program or a script.
    bool allowExtensions(std::vector<string> names) {
        if (names.size() == 0 || names.size() > 32) {
            return false;
        }
        int i = 0;
        while (i < names.size()) {
            if (!extensionName(names[i]) || dangerousExtension(names[i])) {
                return false;
            }
            i = i + 1;
        }
        extensions = names;
        return true;
    }

    bool schemeAllowed(string scheme) {
        int i = 0;
        while (i < schemes.size()) {
            if (schemes[i] == scheme) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    bool addressAllowed(string url) {
        if (url.length() < 1 || url.length() > 2048) {
            return false;
        }
        int i = 0;
        while (i < url.length()) {
            if (!addressChar(url[i])) {
                return false;
            }
            i = i + 1;
        }
        string scheme = schemeOf(url);
        if (scheme.length() == 0 || !schemeAllowed(scheme)) {
            return false;
        }
        string rest = url.substr(scheme.length() + 1, url.length() - scheme.length() - 1);
        if (scheme == "mailto") {
            return rest.length() > 0 && rest[0] != '/';
        }
        if (rest.length() < 3 || rest.substr(0, 2) != "//") {
            return false;
        }
        int end = 2;
        while (end < rest.length() && rest[end] != '/' && rest[end] != '?' && rest[end] != '#') {
            if (!hostChar(rest[end])) {
                return false;
            }
            end = end + 1;
        }
        return end > 2;
    }

    // true if the extension of this path (the resolved name of a file) is one the application listed
    bool extensionAllowed(string path) {
        string ext = extensionOf(path);
        if (ext.length() == 0 || dangerousExtension(ext)) {
            return false;
        }
        int i = 0;
        while (i < extensions.size()) {
            if (extensions[i] == ext) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    // One open per 300 ms. true (and the clock is set) if this one may go ahead.
    bool mayOpenNow() {
        double now = app_now_ms();
        if (now - lastMs < 300.0) {
            return false;
        }
        lastMs = now;
        return true;
    }

    // Opens an address that addressAllowed accepted. "" on success, else the error for the page.
    string openAddress(string url) {
        if (!addressAllowed(url)) {
            return "invalid_argument: `url` must be an http, https or mailto address that this application allows";
        }
        if (!mayOpenNow()) {
            return "too_many: addresses are opened at most about three times a second";
        }
        if (app_shell_open(url, 0) != 0) {
            return "io_error: the address could not be handed to the system";
        }
        return "";
    }
};
