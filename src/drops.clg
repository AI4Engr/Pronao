//ceeling 0.1
// Files dragged from the file manager onto a window. The native layer (app_drop_accept) queues the paths the engine names; what
// becomes of them is decided here:
//
//  * Nothing happens until the application calls `App.enableFileDrop`.
//  * Every path is granted to the file policy exactly as a dialog pick would be: that file (or, if folders are allowed, that folder and
//    what is in it), nothing next to it. The paths belong to File objects the user put into the page; a page cannot make a File that
//    has a path. At most 256 grants exist at a time (`revokeGrants` clears them).
//  * At most `maxFiles` paths are taken from one drop; the rest, and any path that is not plain text, not a file or folder, or that the
//    policy would not grant, are counted in `skipped`.
//
// The page gets `drop.files {x, y, files: [{path, kind: "file" | "folder"}], skipped}` (x, y in CSS pixels). drop.enter / drop.over /
// drop.leave come from src/bridge.js with no round trip. See docs/manual/03-files-and-data.md.
#include "cjson_item.clh"
#include "cjson_api.clh"
#include "cjson_parse.clh"
#include "cjson_print.clh"
#include "text.clh"
#include "core.clh"
#include "files.clh"
#include "placement.clh"

ext_fn int app_os_path_kind(string path);

class DropRules {
public:
    bool on;           // enableFileDrop was called
    bool folders;      // a dropped folder is accepted (granted as a folder)
    int maxFiles;
    FileGate gate;

    DropRules(FileGate files) {
        gate = files;
        on = false;
        folders = false;
        maxFiles = 32;
    }

    // The drop.files payload for the record "drop" "files" x y path... of one window; "" if there is nothing to tell. The paths are
    // granted here, so the event never names a path the page cannot read.
    string eventFor(std::vector<string> f) {
        if (!on || f.size() < 5 || f[1] != "files" || !isSignedNumber(f[2]) || !isSignedNumber(f[3])) {
            return "";
        }
        Item list = createArray();
        int taken = 0;
        int skipped = 0;
        int i = 4;
        while (i < f.size()) {
            string path = f[i];
            i = i + 1;
            if (taken >= maxFiles || !plainText(path, 32000)) {
                skipped = skipped + 1;
                continue;
            }
            // what the path is now (grantFile alone also accepts a name that does not exist yet, which is for "save as")
            int found = app_os_path_kind(path);
            string kind = "file";
            FsResult g = new FsResult(1, "");
            if (found == 2) {
                kind = "folder";
                if (folders) {
                    g = gate.grantFolder(path);
                }
            } else if (found == 1 || found == 5) {
                g = gate.grantFile(path);
            }
            if (g.status != 0) {
                skipped = skipped + 1;
                continue;
            }
            Item one = createObject();
            addStringToObject(one, "path", g.text);
            addStringToObject(one, "kind", kind);
            addItemToArray(list, one);
            taken = taken + 1;
        }
        Item e = createObject();
        addNumberToObject(e, "x", double(signedInt(f[2])));
        addNumberToObject(e, "y", double(signedInt(f[3])));
        addItemToObject(e, "files", list);
        addNumberToObject(e, "skipped", double(skipped));
        return printUnformatted(e);
    }
};
