// app-cling -- Files dragged from the file manager onto a window. The page (src/bridge.js) sees the drag, hands the engine the files that were dropped, and the native layer
// (app_drop_accept) queues the paths the engine names for them. WHAT becomes of the paths is decided here:
//
//  * Nothing happens until the application asks (`App.enableFileDrop`). Until then the engine's default stays: a drop on the page does not reach the application, and the
//    engine's attempt to open the file in the window is refused by the navigation guard.
//  * Every path is granted to the file policy EXACTLY as a dialog pick would be: that file (or, if the application allows folders, that folder and what is in it), nothing
//    next to it. The paths belong to File objects that the user put into the page by dropping them (or by choosing them in a file input of its own): a page cannot make a File
//    that has a path. A page that holds one can ask for the same grant a drop gives, and nothing more. At most 256 grants exist at a time (`revokeGrants` clears them).
//  * At most `maxFiles` paths are taken from one drop; the rest are counted in `skipped`, with those that are not plain text, are not files or folders, or that the policy
//    would not grant.
//
// What the page gets, sent to the window that was dropped on: `drop.files {x, y, files: [{path, kind: "file" | "folder"}], skipped}` (x and y in CSS pixels from the top left of
// the page); the path is then reachable with the file commands under that name (fs.read {path} ...). The page itself raises drop.enter / drop.over / drop.leave while a drag of
// files is over it (bridge.js; no round trip). A drag of text or a picture is not a drop of files and is left to the page.
#include "cjson_item.clh"
#include "cjson_api.clh"
#include "cjson_parse.clh"
#include "cjson_print.clh"
#include "text.clh"
#include "core.clh"
#include "files.clh"
#include "placement.clh"

ext_fn int app_os_path_kind(string path);

class DropRules {
public:
    bool on;           // enableFileDrop was called
    bool folders;      // a dropped folder is accepted (granted as a folder)
    int maxFiles;      // how many paths of one drop are taken
    FileGate gate;     // the file policy the dropped paths are granted to

    DropRules(FileGate files) {
        gate = files;
        on = false;
        folders = false;
        maxFiles = 32;
    }

    // The payload of drop.files for the record "drop" "files" x y path... of one window; "" if there is nothing to tell. The paths are granted here, so the event never names
    // a path the page cannot read.
    string eventFor(std::vector<string> f) {
        if (!on || f.size() < 5 || f[1] != "files" || !isSignedNumber(f[2]) || !isSignedNumber(f[3])) {
            return "";
        }
        Item list = createArray();
        int taken = 0;
        int skipped = 0;
        int i = 4;
        while (i < f.size()) {
            string path = f[i];
            i = i + 1;
            if (taken >= maxFiles || !plainText(path, 32000)) {
                skipped = skipped + 1;
                continue;
            }
            // what the path is NOW (grantFile alone would also accept a name that does not exist yet, which is for "save as", not for a drop)
            int found = app_os_path_kind(path);
            string kind = "file";
            FsResult g = new FsResult(1, "");
            if (found == 2) {
                kind = "folder";
                if (folders) {
                    g = gate.grantFolder(path);
                }
            } else if (found == 1 || found == 5) {
                g = gate.grantFile(path);
            }
            if (g.status != 0) {
                skipped = skipped + 1;
                continue;
            }
            Item one = createObject();
            addStringToObject(one, "path", g.text);
            addStringToObject(one, "kind", kind);
            addItemToArray(list, one);
            taken = taken + 1;
        }
        Item e = createObject();
        addNumberToObject(e, "x", double(signedInt(f[2])));
        addNumberToObject(e, "y", double(signedInt(f[3])));
        addItemToObject(e, "files", list);
        addNumberToObject(e, "skipped", double(skipped));
        return printUnformatted(e);
    }
};
