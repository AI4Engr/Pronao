//ceeling 0.1
// A worker hands a result to the main thread (Later, LaterBook, finishLater) or asks it to do something only it may (Pump, PumpBook,
// wakeMain). See docs/manual/07-background-work.md.

#include "cjson_item.clh"
#include "cjson_api.clh"
#include "cjson_parse.clh"
#include "cjson_print.clh"
#include "text.clh"
#include "core.clh"
#include "files.clh"

ext_fn int app_push(int handle, string id, string request, int maxQueued);

// ---- background work whose last step needs the main thread -----------------------------------------------------------
// All state, the file policy (FileGate) included, belongs to the main thread, so a worker that must touch a file after its program
// finished sends the main loop a record: finishLater(handle, id, status, text). The loop runs the `done` of the `Later` registered
// for that call (App.later).
class Later {
public:
    Later() { }
    virtual void done(int handle, string id, int status, string payload) { }
};

class LaterBook {
public:
    std::vector<int> handles;      // the window each call came from: a call id is only unique within its window
    std::vector<string> ids;
    std::vector<Later> items;
    LaterBook() { }
    int indexOf(int handle, string id) {
        int i = 0;
        while (i < ids.size()) {
            if (ids[i] == id && handles[i] == handle) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }
    void drop(int index) {
        int last = ids.size() - 1;
        if (index != last) {
            handles[index] = handles[last];
            ids[index] = ids[last];
            items[index] = items[last];
        }
        handles.pop_back();
        ids.pop_back();
        items.pop_back();
    }
    void forgetWindow(int handle) {
        int i = ids.size() - 1;
        while (i >= 0) {
            if (handles[i] == handle) {
                drop(i);
            }
            i = i - 1;
        }
    }
};

// Runs on the worker: status 0 means `payload` is the JSON for the page, anything else means it is "code: message".
void finishLater(int handle, string id, int status, string payload) {
    string record = "later";
    record.push_back(char(0));
    record = record + id;
    record.push_back(char(0));
    record = record + intToString(status);
    record.push_back(char(0));
    record = record + payload;
    record.push_back(char(0));
    if (app_push(handle, "", record, 100000) != 1) {
        replyError(handle, id, "busy", "the application is not keeping up");
    }
}

// ---- work that goes through a Channel and needs the main thread ----------------------------------------------------------
// A worker sends a request on a Channel<T> and waits for the answer on another; the main thread answers from a pump. The main loop
// sleeps in its own queue, so a send does not wake it: the worker calls wakeMain(handle, name), and the loop runs the pump registered
// under that name (App.onPump), which drains the channel with toMain.wait(0) (poll, never block the main thread). Example in
// docs/manual/07-background-work.md.
//
// A pump must not throw (there is no page call to reject; the error is dropped) and must not wait: it runs on the window's thread.
class Pump {
public:
    Pump() { }
    virtual void pump(FileGate gate) { }
};

class PumpBook {
public:
    std::vector<string> names;
    std::vector<Pump> items;
    PumpBook() { }
    int indexOf(string name) {
        int i = 0;
        while (i < names.size()) {
            if (names[i] == name) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }
};

// Runs on a worker: asks the main loop to run the pump called `name`. false if the main loop's queue is full (nothing was queued).
bool wakeMain(int handle, string name) {
    string record = "pump";
    record.push_back(char(0));
    record = record + name;
    record.push_back(char(0));
    return app_push(handle, "", record, 100000) == 1;
}
