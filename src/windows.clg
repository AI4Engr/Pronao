// app-cling -- One open window and the book of them: its state, its menu bar, its layout, the pop-up menus a page may ask for, and the checks on the pages a window may be opened on.

#include "cjson_item.clh"
#include "cjson_api.clh"
#include "cjson_parse.clh"
#include "cjson_print.clh"
#include "text.clh"
#include "core.clh"
#include "files.clh"
#include "dispatch.clh"
#include "watches.clh"
#include "placement.clh"
#include "menu.clh"

ext_fn int app_terminate(int handle);
ext_fn int app_window_title(int handle, string title);
ext_fn int app_window_state(int handle, int state);
ext_fn int app_window_guard(int handle, int on);
ext_fn int app_navigation_allow(int handle, std::vector<string> prefixes);
ext_fn int app_window_placement(int handle, int x, int y, int width, int height, int maximized);
ext_fn int app_menu_set(int handle, string spec);
ext_fn int app_window_rect(int handle, ref string out);
ext_fn int app_window_style(int handle, int what, int on);
ext_fn int app_window_drag(int handle, int edge);
ext_fn int app_window_modal(int child, int owner, int on);
ext_fn int app_menu_item(int handle, string id, int enabled, int checked);

struct OpenWindowArgs {
public:
    string start;
    string title;
    int width;
    int height;
    bool modal;
    OpenWindowArgs() {
        start = "";
        title = "";
        width = 800;
        height = 600;
        modal = false;
    }
};

// ---- the window -----------------------------------------------------------------------------------
class WindowState {
public:
    int handle;
    bool dirty;                // the page says it has unsaved work (window.setDirty)
    bool confirming;           // a "close anyway?" box is open
    bool confirm;              // confirmClose was called: the close button asks (applied when the window exists)
    bool hides;                // hideOnClose: the close button hides the window instead
    string closeTitle;
    string closeMessage;
    WindowState() {
        handle = 0;
        dirty = false;
        confirming = false;
        confirm = false;
        hides = false;
        closeTitle = "";
        closeMessage = "";
    }
};

// One open window: what belongs to it and not to the application. The application (App) owns the commands, the file policy, the programs;
// a Window owns its handle, its close-button state, its watches, the addresses it may load and (through the Dispatcher) its command list.
// The pop-up menus a page may ask for, by name. Only the application adds to it (App.allowPopup).
class PopupBook {
public:
    std::vector<string> names;
    std::vector<Menu> menus;
    PopupBook() { }

    int indexOf(string name) {
        int i = 0;
        while (i < names.size()) {
            if (names[i] == name) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    // true if some pop-up menu has an enabled item with this id
    bool hasItem(string id) {
        int i = 0;
        while (i < menus.size()) {
            Menu m = menus[i];
            int k = m.indexOfId(id);
            if (k >= 0 && (m.kinds[k] == "i" || m.kinds[k] == "c") && (m.flags[k] / 2) % 2 == 0) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
};

class Window {
public:
    int handle;
    WindowState state;
    Watches watches;
    std::vector<string> navigation;
    CommandRules rules;
    string memoryKey;                  // the name under which WindowMemory keeps this window's place ("" = not remembered)
    Menu menu;                         // the menu bar now on the window (empty = none)
    Window(int h, CommandRules r) {
        menu = new Menu();
        memoryKey = "";
        handle = h;
        state = new WindowState();
        state.handle = h;
        watches = new Watches();
        rules = r;
    }

    // Pushes an event to this window's page (see emitEvent).
    bool emit(string name, string payloadJson) {
        return emitEvent(handle, name, payloadJson);
    }

    // The close button (X, Alt+F4) hides the window instead of closing it; the program, and the page in the hidden window, keep running. Bring the window back
    // with show() (a tray icon's menu is the usual way), end the program with App.quit(). Hiding loses nothing, so it does not ask about unsaved work. Windows only.
    bool hideOnClose(bool on) {
        state.hides = on;
        int guard = 0;
        if (on || state.confirm) {
            guard = 1;
        }
        return app_window_guard(handle, guard) >= 0;
    }

    // Hides the window now (it has no taskbar button either) and shows it again with show().
    bool hide() {
        return app_window_state(handle, 5) >= 0;
    }

    // Shows the window again if it was hidden, restores it if it was minimized, and brings it to the front.
    bool show() {
        return app_window_state(handle, 6) >= 0;
    }

    // ---- layout (Windows) ----

    // Where the window is: x, y, width, height (screen pixels, the frame included) and a sum of 1 maximized, 2 minimized, 4 full screen, 8 always on top,
    // 16 no title bar, 32 not resizable, 64 hidden. An empty list if it cannot be told.
    std::vector<int> bounds() {
        std::vector<int> out;
        string text = "";
        if (app_window_rect(handle, text) != 0) {
            return out;
        }
        std::vector<string> parts = splitOn(text, ' ');
        int i = 0;
        while (i < parts.size() && i < 5) {
            out.push_back(signedInt(parts[i]));
            i = i + 1;
        }
        if (out.size() != 5) {
            while (out.size() > 0) {
                out.pop_back();
            }
        }
        return out;
    }

    // Puts the window at x, y with this size, FITTED to the monitors there are (never off the screen, never bigger than the biggest monitor: the same rule as
    // remembered window places, src/placement.clg). false if the window is in full screen, or the system cannot do it.
    bool setBounds(int x, int y, int width, int height) {
        std::vector<int> now = bounds();
        if (now.size() != 5 || (now[4] / 4) % 2 == 1) {
            return false;
        }
        std::vector<int> fit = fitToMonitors(x, y, width, height, monitorList());
        return app_window_placement(handle, fit[0], fit[1], fit[2], fit[3], 0) >= 0;
    }

    // The window covers the whole monitor it is on, with no frame; false puts it back as it was. No other window of the program is touched.
    bool setFullscreen(bool on) {
        return app_window_style(handle, 1, flag(on)) >= 0;
    }

    // The window stays above the others, also when it is not the active one.
    bool setAlwaysOnTop(bool on) {
        return app_window_style(handle, 2, flag(on)) >= 0;
    }

    // No title bar and no border line: the page draws its own, and calls startDrag on a mouse down on it to let the user move the window (and startResize for the
    // edges). The thin resize border stays while the window may be resized. Minimize, maximize and close are then the page's buttons (window.minimize and so on).
    bool setFrameless(bool on) {
        return app_window_style(handle, 3, flag(on)) >= 0;
    }

    // May the user change the size, and maximize? false: a fixed-size window.
    bool setResizable(bool on) {
        return app_window_style(handle, 4, flag(on)) >= 0;
    }

    int flag(bool on) {
        if (on) {
            return 1;
        }
        return 0;
    }

    // Starts the system's move for this window; it only does anything while the user is holding the left mouse button (a page calls it from a mouse-down handler).
    bool startDrag() {
        return app_window_drag(handle, 0) >= 0;
    }

    // Starts the system's resize from an edge or corner: left, right, top, bottom, topleft, topright, bottomleft, bottomright. Same condition.
    bool startResize(string edge) {
        int code = 0;
        if (edge == "left") { code = 10; }
        if (edge == "right") { code = 11; }
        if (edge == "top") { code = 12; }
        if (edge == "topleft") { code = 13; }
        if (edge == "topright") { code = 14; }
        if (edge == "bottom") { code = 15; }
        if (edge == "bottomleft") { code = 16; }
        if (edge == "bottomright") { code = 17; }
        if (code == 0) {
            return false;
        }
        return app_window_drag(handle, code) >= 0;
    }

    // Makes this window modal for another: while it is open the owner cannot be used (it is greyed and ignores the mouse and the keyboard) and it is enabled again
    // when this window closes. false if either window is gone, or they are the same.
    bool setModalFor(int owner) {
        return app_window_modal(handle, owner, 1) == 0;
    }

    // Puts a menu bar on this window (src/menu.clg): every id, label and shortcut was checked when the menu was built, and the top level must be only submenus.
    // The menu is taken over by the window; to change it later use setEnabled / setChecked or set a new one. false if the menu is not a complete bar, or the system
    // cannot show one (not Windows).
    bool setMenu(Menu bar) {
        if (!bar.complete() || !bar.isBar()) {
            return false;
        }
        if (app_menu_set(handle, bar.spec()) != 0) {
            return false;
        }
        menu = bar;
        return true;
    }

    bool removeMenu() {
        menu = new Menu();
        return app_menu_set(handle, "") == 0;
    }

    // Greys out or enables an item of the menu bar (and its shortcut stops working while it is grey).
    bool setEnabled(string id, bool enabled) {
        int i = menu.indexOfId(id);
        if (i < 0) {
            return false;
        }
        int on = 0;
        if (enabled) {
            on = 1;
        }
        menu.flags[i] = menu.flags[i] % 2 + 2 - 2 * on;
        return app_menu_item(handle, id, on, -1) == 0;
    }

    // Ticks or unticks an item that was made with check().
    bool setChecked(string id, bool checked) {
        int i = menu.indexOfId(id);
        if (i < 0 || menu.kinds[i] != "c") {
            return false;
        }
        int on = 0;
        if (checked) {
            on = 1;
        }
        menu.flags[i] = (menu.flags[i] / 2) * 2 + on;
        return app_menu_item(handle, id, -1, on) == 0;
    }

    // true if the item was made with check() and is ticked now
    bool isChecked(string id) {
        int i = menu.indexOfId(id);
        return i >= 0 && menu.kinds[i] == "c" && menu.flags[i] % 2 == 1;
    }

    // true if the item exists, can be clicked (not a submenu) and is not greyed out
    bool menuItemEnabled(string id) {
        int i = menu.indexOfId(id);
        if (i < 0) {
            return false;
        }
        string kind = menu.kinds[i];
        return (kind == "i" || kind == "c") && (menu.flags[i] / 2) % 2 == 0;
    }

    // Closes the window at once, without asking (see requestClose).
    void close() {
        app_terminate(handle);
    }

    // Asks the window to close as if the user had pressed the X: a window with confirmClose and unsaved work asks first.
    void requestClose() {
        app_window_state(handle, 4);
    }

    bool setTitle(string title) {
        if (title.length() == 0 || !plainText(title, 200)) {
            return false;
        }
        return app_window_title(handle, title) == 1;
    }

    // When the user closes this window (the X, Alt+F4) while its page has said it has unsaved work, ask first with a native box whose text
    // is the application's, not the page's.
    bool confirmClose(string title, string message) {
        if (!plainText(title, 200) || !plainText(message, 4000)) {
            return false;
        }
        state.closeTitle = title;
        state.closeMessage = message;
        state.confirm = true;
        return app_window_guard(handle, 1) >= 0;
    }

    // From now on this window may also load addresses that start with `prefix` (the event window.navigationBlocked reports the rest).
    bool allowNavigation(string prefix) {
        if (prefix.length() < 5 || !plainText(prefix, 1000)) {
            return false;
        }
        navigation.push_back(prefix);
        app_navigation_allow(handle, navigation);
        return true;
    }

    // This window's page may call only the commands named here (every name must be registered); a list of its own replaces the application's.
    // false, and nothing changes, if a name is not registered.
    bool allowOnlyCommands(std::vector<string> names) {
        int i = 0;
        while (i < names.size()) {
            if (!rules.hasCommand(names[i])) {
                return false;
            }
            i = i + 1;
        }
        rules.restrictWindow(handle, names);
        return true;
    }
};

// The open windows, by handle.
class WindowBook {
public:
    std::vector<int> handles;
    std::vector<Window> items;
    WindowBook() { }

    // The window with this handle; a call from a window that is gone is refused.
    Window needed(int h) {
        Window w = get(h);
        if (w == nullptr) {
            throw "forbidden: the window is gone";
        }
        return w;
    }

    // Pushes an event to the page of every open window.
    void emitAll(string name, string payloadJson) {
        int i = 0;
        while (i < items.size()) {
            Window w = items[i];
            emitEvent(w.handle, name, payloadJson);
            i = i + 1;
        }
    }

    int indexOf(int handle) {
        int i = 0;
        while (i < handles.size()) {
            if (handles[i] == handle) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    // The window with this handle, or nullptr.
    Window get(int handle) {
        int i = indexOf(handle);
        if (i < 0) {
            return nullptr;
        }
        Window w = items[i];
        return w;
    }

    int count() {
        return handles.size();
    }

    void add(Window w) {
        handles.push_back(w.handle);
        items.push_back(w);
    }

    void drop(int index) {
        int last = handles.size() - 1;
        if (index != last) {
            handles[index] = handles[last];
            items[index] = items[last];
        }
        handles.pop_back();
        items.pop_back();
    }

    bool anyPending() {
        int i = 0;
        while (i < items.size()) {
            Window w = items[i];
            if (w.watches.anyPending()) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    void flushQuiet(FileGate gate) {
        int i = 0;
        while (i < items.size()) {
            Window w = items[i];
            w.watches.flushQuiet(gate, w.handle);
            i = i + 1;
        }
    }
};

// A page path for a window the page asks to open: inside the program's own site, plain, no parent folders, no scheme.
bool pagePathOk(string path) {
    if (path.length() < 1 || path.length() > 300 || path[0] != '/' || !plainText(path, 300)) {
        return false;
    }
    if (containsText(path, "..") || containsText(path, "//") || containsText(path, "\\") || containsText(path, ":")) {
        return false;
    }
    return true;
}

// A running application: commands, the file policy, programs, and any number of windows.
// The origin ("http://localhost:5173") of a development server address, or "" if the address is not one we load. Only the machine's own
// loopback names are accepted, over plain http, with an optional port and no user name: a development server is a program on this machine
// that serves the page while it is being written, and nothing else may be given the application's commands.
string devServerOrigin(string url) {
    if (url.length() > 300 || !plainText(url, 300) || !startsWithText(url, "http://")) {
        return "";
    }
    string rest = url.substr(7, url.length() - 7);
    int slash = indexOfChar(rest, '/');
    string hostPort = rest;
    if (slash >= 0) {
        hostPort = rest.substr(0, slash);
    }
    string host = hostPort;
    string port = "";
    int colon = indexOfChar(hostPort, ':');
    if (startsWithText(hostPort, "[")) {
        int close = indexOfChar(hostPort, ']');
        if (close < 0) {
            return "";
        }
        host = hostPort.substr(0, close + 1);
        if (close + 1 < hostPort.length()) {
            if (hostPort[close + 1] != ':') {
                return "";
            }
            port = hostPort.substr(close + 2, hostPort.length() - close - 2);
        }
    } else if (colon >= 0) {
        host = hostPort.substr(0, colon);
        port = hostPort.substr(colon + 1, hostPort.length() - colon - 1);
    }
    if (host != "localhost" && host != "127.0.0.1" && host != "[::1]") {
        return "";
    }
    if (hostPort.length() > host.length()) {
        if (port.length() == 0 || port.length() > 5 || !isDigits(port) || decimalValue(port) < 1.0 || decimalValue(port) > 65535.0) {
            return "";
        }
    }
    return "http://" + hostPort;
}

// (a struct is decoded in the file that declares it: other files call this)
OpenWindowArgs readOpenWindowArgs(Item args) {
    return decodeOpenWindowArgs(args);
}
