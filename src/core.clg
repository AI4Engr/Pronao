// What every other module uses: replies and structured errors, events to the page, argument helpers, and the classes a command is
// built from. The `ext_fn`s below are trusted C++, not checked.
//
// A request is the JSON array ["command", args]; the reply is a status (0 = resolve, 1 = reject) and a JSON text. Error texts and
// event scripts are built with the JSON printer, never by string concatenation, so they stay valid JSON whatever a message contains.
// See docs/manual/02-how-it-works.md and 07-background-work.md.
#include "cjson_item.clh"
#include "cjson_api.clh"
#include "cjson_parse.clh"
#include "cjson_print.clh"
#include "text.clh"

ext_fn int app_return(int handle, string id, int status, string json);
ext_fn int app_eval(int handle, string js);
ext_fn int app_cancel_forget(int handle, string call);
ext_fn int app_cancelled(int handle, string call);
ext_fn int app_sleep_ms(int ms);

class Reply {
public:
    int status;
    string json;
    Reply(int s, string j) {
        status = s;
        json = j;
    }
};

class Command {
public:
    Command() { }
    virtual Item call(Item args) {
        return createNull();
    }
};

string errorJson(string code, string message) {
    Item e = createObject();
    addStringToObject(e, "code", code);
    addStringToObject(e, "message", message);
    return printUnformatted(e);
}

// A thrown message may start with "<code>: " (lower-case letters, digits and underscores, at most 40): the code becomes the
// reply's error code and the rest its message. Anything else keeps the code "command_failed" and the whole message.
int errorPrefixLength(string thrown) {
    int i = 0;
    while (i < thrown.length() && i < 40) {
        char c = thrown[i];
        bool lower = c >= 'a' && c <= 'z';
        bool digit = c >= '0' && c <= '9';
        if (lower || (i > 0 && (digit || c == '_'))) {
            i = i + 1;
        } else {
            break;
        }
    }
    if (i > 0 && i + 1 < thrown.length() && thrown[i] == ':' && thrown[i + 1] == ' ') {
        return i + 2;
    }
    return 0;
}

string errorCodeOf(string thrown) {
    int n = errorPrefixLength(thrown);
    if (n == 0) {
        return "command_failed";
    }
    return thrown.substr(0, n - 2);
}

string errorTextOf(string thrown) {
    int n = errorPrefixLength(thrown);
    if (n == 0) {
        return thrown;
    }
    return thrown.substr(n, thrown.length() - n);
}

// ---- argument helpers --------------------------------------------------------------------------
// A page sends anything. Reading a missing or wrongly typed value straight off the JSON would hit the null check and abort the
// program, which a page must not be able to do. These helpers throw instead, so the page's promise is rejected with the message.

string argName(int index) {
    return "argument " + intToString(index);
}

double numberAt(Item args, int index) {
    Item v = getArrayItem(args, index);
    if (!isNumber(v)) {
        string message = argName(index) + " must be a number";
        throw message;
    }
    return v.valuedouble;
}

string stringAt(Item args, int index) {
    Item v = getArrayItem(args, index);
    if (!isString(v)) {
        string message = argName(index) + " must be a string";
        throw message;
    }
    return v.valuestring;
}

bool boolAt(Item args, int index) {
    Item v = getArrayItem(args, index);
    if (!isBool(v)) {
        string message = argName(index) + " must be a boolean";
        throw message;
    }
    return isTrue(v);
}

Item fieldOf(Item object, string name) {
    Item v = getObjectItem(object, name);
    if (v == nullptr) {
        string message = "missing field " + name;
        throw message;
    }
    return v;
}

// ---- background work ---------------------------------------------------------------------------
// An AsyncCommand does not block the window loop. `start` runs on the main thread, copies what it needs out of `args` into plain
// values (the compiler refuses an Item in a `spawn` capture list) and spawns a worker that answers through replyOk / replyError.
// `start` must either spawn and return, or throw BEFORE spawning: a promise is answered exactly once. Example in
// docs/manual/07-background-work.md.
class Job {
public:
    Job() { }
    virtual void run() { }
};

class AsyncCommand {
public:
    AsyncCommand() { }
    virtual void start(Item args, string id, int handle) { }
};

// What runs when a spawned job throws. The dispatcher installs one around every AsyncCommand.start, so a job that throws rejects
// the page's promise instead of leaving it pending.
class Failure {
public:
    Failure() { }
    virtual void fail(string message) { }
};

class MenuAction {
public:
    MenuAction() { }
    virtual void clicked(string id) { }
};

class TrayAction {
public:
    TrayAction() { }
    virtual void happened(string kind) { }
};

class NotificationAction {
public:
    NotificationAction() { }
    virtual void clicked(string id) { }
};

void replyOk(int handle, string id, string json) {
    app_return(handle, id, 0, json);
    app_cancel_forget(handle, id);
}

void replyError(int handle, string id, string code, string message) {
    app_return(handle, id, 1, errorJson(code, message));
    app_cancel_forget(handle, id);
}

// True once the page gave up on call `id` (its AbortSignal fired, or its timeout passed) or the window is closing. A long job
// checks this between steps and stops; a program it started is killed without the job doing anything.
bool callCancelled(int handle, string id) {
    return app_cancelled(handle, id) == 1;
}

// ---- events: CeeLing -> page -------------------------------------------------------------------
// emitEvent(handle, "progress", "{\"done\":3}") runs the page's `pronao.on("progress", fn)` listeners with {done: 3}. It takes
// only an int and strings, so a worker job can call it.
//
// The payload must be valid JSON text. The script handed to the page is built only with the JSON printer (name and payload are
// re-printed, never pasted), so script text in either stays a string literal and cannot run. Returns false, and sends nothing, if
// the payload is not valid JSON or the window is gone. An event sent before the page registered its listener is dropped.
bool emitEvent(int handle, string name, string payloadJson) {
    Item payload = parseWithOpts(payloadJson, true);   // strict: trailing text after the JSON value is an error
    if (payload == nullptr) {
        return false;
    }
    Item message = createArray();
    addItemToArray(message, createString(name));
    addItemToArray(message, payload);
    string text = printUnformatted(message);
    if (text.length() == 0) {
        return false;
    }
    return app_eval(handle, "window.__pronao_emit(" + text + ");") == 1;
}

Item objectArg(Item args) {
    if (args == nullptr || !isObject(args)) {
        throw "invalid_argument: expected an object such as {path: \"...\"}";
    }
    return args;
}

string requiredString(Item args, string name) {
    Item v = getObjectItem(objectArg(args), name);
    if (v == nullptr || !isString(v)) {
        string message = "invalid_argument: `" + name + "` must be a string";
        throw message;
    }
    return v.valuestring;
}

string optionalString(Item args, string name, string fallback) {
    Item v = getObjectItem(objectArg(args), name);
    if (v == nullptr) {
        return fallback;
    }
    if (!isString(v)) {
        string message = "invalid_argument: `" + name + "` must be a string";
        throw message;
    }
    return v.valuestring;
}

string optionalNullableString(Item args, string name) {
    Item v = getObjectItem(objectArg(args), name);
    if (v == nullptr || isNull(v)) {
        return "";
    }
    if (!isString(v)) {
        string message = "invalid_argument: `" + name + "` must be a string or null";
        throw message;
    }
    return v.valuestring;
}

bool optionalBool(Item args, string name, bool fallback) {
    Item v = getObjectItem(objectArg(args), name);
    if (v == nullptr) {
        return fallback;
    }
    if (!isBool(v)) {
        string message = "invalid_argument: `" + name + "` must be true or false";
        throw message;
    }
    return isTrue(v);
}
