// examples/background -- a slow command that runs on a worker, with progress, a deadline and cancelling.
//   PAGE=examples/background/index.html EXTRA=examples/background/commands.clg bash scripts/build.sh examples/background/main.clg out/background.exe
#include "app.clh"
#include "commands.clh"

int main() {
    App app = new App();
    installBackground(app);
    if (!app.openPage("Background", 640, 420, false)) {
        return 1;
    }
    app.run();
    app.close();
    return 0;
}
