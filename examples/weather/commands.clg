//ceeling 0.1
// examples/weather: a five-day forecast. The page asks a public weather service (Open-Meteo, which needs no key) through http.request; this program decides
// that only that one host may be reached, that nothing is ever sent in the body of a request, and how big an answer may be. The page has no network code of its own
// to trust: it could not call another address, and it could not read or send an API key (this service has none; see the README for how a key would be kept).
#include "app.clh"

Item cityItem(string name, double latitude, double longitude) {
    Item c = createObject();
    addStringToObject(c, "name", name);
    addNumberToObject(c, "latitude", latitude);
    addNumberToObject(c, "longitude", longitude);
    return c;
}

void installWeather(App app) {
    // the one host a page may reach, over https; GET only (the default), no request body, at most 64 KiB back, 10 seconds
    app.allowHost("api.open-meteo.com");
    app.httpLimits(0, 65536, 10000);
    app.enableHttpCommands();

    // the cities the page offers, with the coordinates the page sends in the request
    app.command("weather.cities", closure Command [] (Item args) {
        Item list = createArray();
        addItemToArray(list, cityItem("Shanghai", 31.23, 121.47));
        addItemToArray(list, cityItem("Oslo", 59.91, 10.75));
        addItemToArray(list, cityItem("Cairo", 30.04, 31.24));
        addItemToArray(list, cityItem("Lima", -12.05, -77.04));
        return list;
    });
}
