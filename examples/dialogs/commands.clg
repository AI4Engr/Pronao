//ceeling 0.1
// installDialogs -- the commands of the dialogs example (docs/manual/03-files-and-data.md, "Dialogs" and "Files dragged onto a window").
#include "app.clh"

void installDialogs(App app) {
    // No folder is allowed: the page reaches only what the user picks in a dialog or drops on the window.
    app.enableFileCommands(1024 * 1024);
    app.enableDialogCommands();
    app.enableFileDrop(8, false);
}
