// examples/menus -- menu bar, pop-up menu, notification and theme.
//   PAGE=examples/menus/index.html EXTRA=examples/menus/commands.clg bash scripts/build.sh examples/menus/main.clg out/menus.exe
#include "app.clh"
#include "commands.clh"

int main() {
    App app = new App();
    if (!app.openPage("Menus", 640, 420, false)) {
        return 1;
    }
    installMenus(app);          // after openPage: the menu bar belongs to the window
    app.run();
    app.close();
    return 0;
}
