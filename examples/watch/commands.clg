//ceeling 0.1
// installWatch -- the commands of the watch example (docs/manual/03-files-and-data.md, "Watching folders").
#include "app.clh"

void installWatch(App app) {
    // The page's whole world: one folder of the program's own, %LOCALAPPDATA%\pronao-watch (XDG: ~/.local/share/pronao-watch).
    if (!app.allowAppFolder("pronao-watch", "data")) {
        throw "io_error: the data folder could not be made";
    }
    app.enableFileCommands(1024 * 1024);
    app.enableWatchCommands();
}
