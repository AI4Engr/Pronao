// examples/limits -- request limits and a command list. See README.md.
#include "app.clh"
#include "commands.clh"

int main() {
    App app = new App();
    installLimits(app);
    if (!app.openPage("limits", 640, 420, false)) {
        return 1;
    }
    app.run();
    app.close();
    return 0;
}
