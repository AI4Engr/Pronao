//ceeling 0.1
// Drives examples/weather through the real dispatcher with a scripted network (headless window double and tests/doubles/http_double.cpp): what the program lets its page
// reach, what it refuses, and what goes out on the wire. The page's own code (the codes of the service turned into icons) is not run here.
#include "text.clh"
#include "core.clh"
#include "files.clh"
#include "app.clh"
#include "support.clh"
#include "commands.clh"

ext_fn int app_test_http_reset();
ext_fn int app_test_http_reply(string url, int code, int status, string headers, string body, int flags, int delayMs);
ext_fn int app_test_http_count();
ext_fn int app_test_http_request(int index, ref string method, ref string url, ref string headers, ref string body, ref int timeoutMs, ref int maxBytes);

string forecastUrl(string latitude, string longitude) {
    return "https://api.open-meteo.com/v1/forecast?latitude=" + latitude + "&longitude=" + longitude +
           "&current=temperature_2m,relative_humidity_2m,wind_speed_10m,weather_code&daily=weather_code,temperature_2m_max,temperature_2m_min&timezone=auto&forecast_days=5";
}

Item request(string url) {
    Item o = createObject();
    addStringToObject(o, "url", url);
    Item h = addObjectToObject(o, "headers");
    addStringToObject(h, "Accept", "application/json");
    return o;
}

string get(App app, string id, string url) {
    return roundTrip(app, id, requestText("http.request", request(url)));
}

string lastHeaders() {
    string m = "";
    string u = "";
    string h = "";
    string b = "";
    int t = 0;
    int c = 0;
    app_test_http_request(app_test_http_count() - 1, m, u, h, b, t, c);
    return h;
}

int lastMaxBytes() {
    string m = "";
    string u = "";
    string h = "";
    string b = "";
    int t = 0;
    int c = 0;
    app_test_http_request(app_test_http_count() - 1, m, u, h, b, t, c);
    return c;
}

int lastTimeout() {
    string m = "";
    string u = "";
    string h = "";
    string b = "";
    int t = 0;
    int c = 0;
    app_test_http_request(app_test_http_count() - 1, m, u, h, b, t, c);
    return t;
}

int main() {
    App app = new App();
    app.open("t", 100, 100, "<html></html>", "", false);
    installWeather(app);
    app_test_http_reset();

    string cities = roundTrip(app, "c1", requestText("weather.cities", createArray()));
    check("the cities come with their coordinates", cities == "0 [{\"name\":\"Shanghai\",\"latitude\":31.23,\"longitude\":121.47},{\"name\":\"Oslo\",\"latitude\":59.91,\"longitude\":10.75},{\"name\":\"Cairo\",\"latitude\":30.04,\"longitude\":31.24},{\"name\":\"Lima\",\"latitude\":-12.05,\"longitude\":-77.04}]");

    string oslo = "{\"current\":{\"temperature_2m\":-1.1,\"relative_humidity_2m\":74,\"wind_speed_10m\":6.1,\"weather_code\":0},\"daily\":{\"time\":[\"2026-11-14\"],\"weather_code\":[3],\"temperature_2m_max\":[5.1],\"temperature_2m_min\":[-1.1]}}";
    app_test_http_reply(forecastUrl("59.91", "10.75"), 0, 200, "Content-Type: application/json\n", oslo, 0, 0);
    string r = get(app, "f1", forecastUrl("59.91", "10.75"));
    check("the page's forecast request is answered with the service's status and text", startsWithText(r, "0 {\"status\":200,") && containsText(r, "\"body\":\"{\\\"current\\\":{\\\"temperature_2m\\\":-1.1"));
    check("it went to the one allowed host, by GET", app_test_http_count() == 1 && containsText(lastHeaders(), "Accept: application/json\n"));
    check("with the program's limits: nothing in a body, 64 KiB back, 10 seconds", lastMaxBytes() == 65536 && lastTimeout() > 9000 && lastTimeout() <= 10000);

    int before = app_test_http_count();
    check("another host is refused before anything is sent", failedWith(get(app, "o1", "https://evil.example.net/v1/forecast"), "host_not_allowed") && app_test_http_count() == before);
    check("so is plain http to the same host", failedWith(get(app, "o2", "http://api.open-meteo.com/v1/forecast"), "host_not_allowed"));
    check("and another port of it", failedWith(get(app, "o3", "https://api.open-meteo.com:8443/v1/forecast"), "host_not_allowed"));
    check("and a lookalike name", failedWith(get(app, "o4", "https://api.open-meteo.com.evil.net/"), "host_not_allowed"));

    Item post = request(forecastUrl("59.91", "10.75"));
    addStringToObject(post, "method", "POST");
    addStringToObject(post, "body", "x");
    check("the page cannot send data: POST is not allowed", failedWith(roundTrip(app, "p1", requestText("http.request", post)), "method_not_allowed"));

    Item withKey = request(forecastUrl("59.91", "10.75"));
    Item headers = getObjectItem(withKey, "headers");
    addStringToObject(headers, "Authorization", "Bearer stolen");
    check("the page cannot send an Authorization header", failedWith(roundTrip(app, "k1", requestText("http.request", withKey)), "invalid_argument") && app_test_http_count() == before);

    app_test_http_reply(forecastUrl("0", "0"), 0, 404, "", "not found", 0, 0);
    check("an error status is an answer the page can show", startsWithText(get(app, "e1", forecastUrl("0", "0")), "0 {\"status\":404,"));
    app_test_http_reply(forecastUrl("1", "1"), 0, 200, "", "{}", 0, 0);
    app_test_http_reply(forecastUrl("2", "2"), 3, 0, "", "", 0, 0);
    check("a failed secure connection is a code of its own", failedWith(get(app, "e2", forecastUrl("2", "2")), "tls_failed"));
    check("a host that cannot be reached too", failedWith(get(app, "e3", forecastUrl("3", "3")), "connect_failed"));
    app_test_http_reply(forecastUrl("4", "4"), 0, 200, "", "", 1, 0);
    check("a slow answer ends with a timeout", failedWith(get(app, "e4", forecastUrl("4", "4")), "timeout"));
    check("an unknown command is refused", failedWith(roundTrip(app, "u1", requestText("weather.forecast", createObject())), "unknown_command"));
    return 0;
}
