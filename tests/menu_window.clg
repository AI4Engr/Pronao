// A menu bar and its shortcuts in a real window (run by tests/run_menu_window.sh, which clicks and types from outside). Every click prints "click ID".
#include "text.clh"
#include "core.clh"
#include "files.clh"
#include "assets.clh"
#include "settings.clh"
#include "menu.clh"
#include "app.clh"

class Saw {
public:
    bool grid;
    Saw() {
        grid = false;
    }
};

int main() {
    App app = new App();
    Saw saw = new Saw();
    app.command("ready", closure Command [] (Item args) {
        std::cout << "ready " << int(fieldOf(args, "width").valuedouble) << " " << int(fieldOf(args, "height").valuedouble) << std::endl;
        return createNull();
    });
    app.command("sized", closure Command [] (Item args) {
        std::cout << "sized " << int(fieldOf(args, "width").valuedouble) << " " << int(fieldOf(args, "height").valuedouble) << std::endl;
        return createNull();
    });
    app.command("popupResult", closure Command [] (Item args) {
        Item v = getObjectItem(args, "id");
        if (v != nullptr && isString(v)) {
            std::cout << "popup chosen " << v.valuestring << std::endl;
        } else {
            std::cout << "popup dismissed" << std::endl;
        }
        return createNull();
    });
    app.command("pageSaw", closure Command [] (Item args) {
        std::cout << "page saw " << requiredString(args, "id") << std::endl;
        return createNull();
    });
    if (!app.openSite("menu test", 600, 400, false, "http://app.localhost", "")) {
        std::cout << "selftest FAILED: no window" << std::endl;
        return 2;
    }
    Menu bar = new Menu();
    bar.begin("&File");
    bar.item("file.open", "&Open", "Ctrl+O");
    bar.item("file.save", "&Save", "Ctrl+S");
    bar.separator();
    bar.item("file.nosave", "&Disable save", "");
    bar.item("file.quit", "&Quit", "Ctrl+Q");
    bar.end();
    bar.begin("&View");
    bar.check("view.grid", "&Grid", "F5", false);
    bar.end();
    if (!app.setMenu(bar)) {
        std::cout << "selftest FAILED: the menu was refused: " << bar.problem << std::endl;
        return 2;
    }
    Menu ctx = new Menu();
    ctx.item("ctx.copy", "&Copy", "");
    ctx.item("ctx.paste", "&Paste", "");
    app.allowPopup("ctx", ctx);
    app.enablePopupCommand();
    app.menuEventsToPage(true);
    app.onMenu(closure MenuAction [app, saw] (string id) {
        std::cout << "click " << id << std::endl;
        Window w = app.windows.get(app.handle);
        if (id == "view.grid") {
            saw.grid = !saw.grid;
            w.setChecked("view.grid", saw.grid);
        }
        if (id == "file.nosave") {
            w.setEnabled("file.save", false);
        }
        if (id == "file.quit") {
            app.quit();
        }
    });
    app.run();
    app.close();
    std::cout << "closed" << std::endl;
    return 0;
}
