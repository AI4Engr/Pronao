// A real window, a real page: the page calls every kind of command (ok, rejected by the handler, unknown),
// collects what it saw and reports it through `selftest`; CeeLing compares it with the expected JSON text and
// closes the window. Exit code 0 and "selftest ok" only if everything matched.
#include "app.clh"

class Verdict {
public:
    bool ok;
    Verdict() {
        ok = false;
    }
    void set(bool v) {
        ok = v;
    }
};

int main() {
    App app = new App();
    Verdict verdict = new Verdict();
    app.command("ping", closure Command [] (Item args) {
        return createString("pong");
    });
    app.command("add", closure Command [] (Item args) {
        return createNumber(numberAt(args, 0) + numberAt(args, 1));
    });
    app.command("echo", closure Command [] (Item args) {
        return duplicate(args, true);
    });
    app.command("fail", closure Command [] (Item args) {
        throw "this command always fails";
    });
    if (!app.allowFolder("files")) {
        std::cout << "selftest FAILED: no files folder" << std::endl;
        return 2;
    }
    app.enableFileCommands(1000);
    app.enableDialogCommands();
    if (!app.openPage("app-cling selftest", 480, 320, false)) {
        std::cout << "selftest FAILED: no window" << std::endl;
        return 2;
    }
    int handle = app.handle;
    app.asyncCommand("aecho", closure AsyncCommand [] (Item args, string id, int handle) {
        string payload = printUnformatted(args);
        spawn(closure Job [payload, id, handle] () {
            Item mine = parse(payload);
            replyOk(handle, id, printUnformatted(mine));
        });
    });
    app.command("emit_hello", closure Command [handle] (Item args) {
        emitEvent(handle, "hello", "{\"x\":[1,\"two\"]}");
        return createNull();
    });
    app.command("selftest", closure Command [verdict, handle] (Item args) {
        string expected = "{\"ping\":\"pong\",\"sum\":5,\"echo\":{\"a\":[1,\"x\",null]},\"async\":{\"n\":[1,2]},\"file\":{\"text\":\"hi é\"},\"escape\":\"forbidden\",\"missing\":\"not_found\",\"msg\":{\"button\":\"ok\"},\"open\":null,\"event\":{\"x\":[1,\"two\"]},\"rejected\":{\"code\":\"command_failed\",\"message\":\"this command always fails\"},\"unknown\":{\"code\":\"unknown_command\",\"message\":\"no command named nope\"}}";
        string got = printUnformatted(args);
        verdict.set(got == expected);
        if (got != expected) {
            std::cout << "got:      " << got << std::endl;
            std::cout << "expected: " << expected << std::endl;
        }
        app_terminate(handle);
        return createNull();
    });
    app.run();
    app.close();
    if (verdict.ok) {
        std::cout << "selftest ok" << std::endl;
        return 0;
    }
    std::cout << "selftest FAILED" << std::endl;
    return 1;
}
