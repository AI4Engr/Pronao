// One running copy of a program, with real processes and a real window (run by tests/run_instance_window.sh, which starts this program twice).
//   first launch   claims the name, opens a window, tells the script it is ready, and ends when the page reports the event app.secondInstance
//   second launch  (while the first runs) finds the name taken, hands over its folder and arguments, and ends at once WITHOUT opening a window
#include "text.clh"
#include "core.clh"
#include "files.clh"
#include "assets.clh"
#include "settings.clh"
#include "app.clh"

class Observed {
public:
    string cwd;
    std::vector<string> args;
    int events;
    string failure;
    Observed() {
        cwd = "";
        events = 0;
        failure = "";
    }
};

int main() {
    App app = new App();
    if (!app.singleInstance("app-cling-instance-window-test")) {
        std::cout << "second launch handed over" << std::endl;
        return 0;
    }
    Observed seen = new Observed();
    app.command("ready", closure Command [] (Item args) {
        std::cout << "first ready" << std::endl;
        return createNull();
    });
    app.command("second", closure Command [seen, app] (Item args) {
        seen.cwd = requiredString(args, "cwd");
        Item list = getObjectItem(args, "args");
        int i = 0;
        while (i < getArraySize(list)) {
            Item one = getArrayItem(list, i);
            seen.args.push_back(one.valuestring);
            i = i + 1;
        }
        seen.events = seen.events + 1;
        app.quit();
        return createNull();
    });
    app.command("failed", closure Command [seen] (Item args) {
        seen.failure = requiredString(args, "error");
        return createNull();
    });
    if (!app.openSite("instance test", 420, 300, false, "http://app.localhost", "")) {
        std::cout << "selftest FAILED: no window" << std::endl;
        return 2;
    }
    app.run();
    app.close();
    std::vector<string> got = seen.args;
    bool ok = seen.failure.length() == 0 && seen.events == 1 && seen.cwd.length() > 0 && got.size() == 2 && got[0] == "alpha" && got[1] == "b c";
    if (ok) {
        std::cout << "selftest ok" << std::endl;
        return 0;
    }
    std::cout << "selftest FAILED: events=" << seen.events << " args=" << got.size() << " cwd=" << seen.cwd << " failure=" << seen.failure << std::endl;
    return 1;
}
