#include "text.clh"
#include "files.clh"
#include "app.clh"

ext_fn int app_test_inject(int handle, string id, string request);
ext_fn int app_test_take_response(int handle, ref string id, ref int status, ref string json);
ext_fn int app_test_close_window(int handle);
ext_fn int app_test_take_eval(int handle, ref string js);
ext_fn int app_test_response_ready(int handle);
ext_fn double app_now_ms();
ext_fn int app_test_exists(string path);
ext_fn int app_limits(int handle, int maxRequest, int maxQueued);
ext_fn int app_test_setenv(string name, string value);
ext_fn int app_test_push_internal(int handle, string request);
ext_fn int app_test_take_window_log(int handle, ref string line);
ext_fn int app_test_make_temp_dir(ref string out);
ext_fn int app_test_remove_tree(string path);
ext_fn int app_test_write_raw(string path, string data);
ext_fn int app_test_mkdir_raw(string path);
ext_fn int app_test_make_dir_link(string link, string target);
ext_fn int app_test_dialog_push(string answer);
ext_fn int app_test_dialog_take_request(ref string request);
ext_fn int app_test_helper(ref string path);
ext_fn int app_test_sleep_ms(int ms);
ext_fn int app_test_gauge_enter();
ext_fn int app_test_gauge_leave();
ext_fn int app_test_gauge_peak();

void check(string name, bool ok) {
    if (ok) {
        std::cout << "PASS " << name << std::endl;
    } else {
        std::cout << "FAIL " << name << std::endl;
    }
}

string repeated(string unit, int times) {
    string out = "";
    int i = 0;
    while (i < times) {
        out = out + unit;
        i = i + 1;
    }
    return out;
}

// the most recent dialog request the shim saw (earlier ones are drained)
string latestRequest() {
    string last = "";
    string one = "";
    while (app_test_dialog_take_request(one) == 1) {
        last = one;
    }
    return last;
}

// {"id": n}
Item watchIdArgs(int n) {
    Item o = createObject();
    addNumberToObject(o, "id", double(n));
    return o;
}

// the record a watcher thread queues: "watch" id kind path from, each field followed by a NUL
string watchRecord(int id, string kind, string path, string from) {
    string r = "watch";
    r.push_back(char(0));
    r = r + intToString(id);
    r.push_back(char(0));
    r = r + kind;
    r.push_back(char(0));
    r = r + path;
    r.push_back(char(0));
    r = r + from;
    r.push_back(char(0));
    return r;
}

int countText(string text, string needle) {
    int n = 0;
    int i = 0;
    while (i + needle.length() <= text.length()) {
        if (text.substr(i, needle.length()) == needle) {
            n = n + 1;
            i = i + needle.length();
        } else {
            i = i + 1;
        }
    }
    return n;
}

// the window's calls are all cancelled once it has closed (what a job polls through callCancelled)
bool app_cancelled_after_close(int handle) {
    return callCancelled(handle, "any call at all");
}

bool startsWith(string text, string prefix) {
    return text.length() >= prefix.length() && text.substr(0, prefix.length()) == prefix;
}

// {"path": p}
Item pathArgs(string p) {
    Item o = createObject();
    addStringToObject(o, "path", p);
    return o;
}

// The request text ["command", args]
string requestText(string command, Item args) {
    Item arr = createArray();
    addItemToArray(arr, createString(command));
    addItemToArray(arr, args);
    return printUnformatted(arr);
}

// serves the loop until nothing has arrived for quietMs
void drain(App app, int quietMs) {
    int r = 1;
    while (r == 1) {
        r = app.serveOne(quietMs);
    }
}

// Sends one request through the whole pipeline and returns "<status> <json>". The loop keeps serving until the answer is
// there, because some answers need the main loop to run again after a worker has finished (a dialog's grant).
// like roundTrip, for a call injected into one particular window of a program with several
string roundTripOn(App app, int h, string id, string request) {
    app_test_inject(h, id, request);
    int turns = 0;
    while (app_test_response_ready(h) == 0 && turns < 500) {
        app.serveOne(20);
        turns = turns + 1;
    }
    string gotId = "";
    int status = 0;
    string json = "";
    int r = app_test_take_response(h, gotId, status, json);
    if (r != 1) {
        return "NO RESPONSE";
    }
    return intToString(status) + " " + json;
}

// serves until window h has an answer (or ~2 s have passed); "" if none
string answerOn(App app, int h) {
    int turns = 0;
    while (app_test_response_ready(h) == 0 && turns < 100) {
        app.serveOne(20);
        turns = turns + 1;
    }
    string gotId = "";
    int status = 0;
    string json = "";
    if (app_test_take_response(h, gotId, status, json) != 1) {
        return "";
    }
    return intToString(status) + " " + json;
}

// Serves the loop and gathers every script evaluated in the page until `needle` has appeared (or maxMs have passed): a wait for an event that
// is exactly as long as it takes, instead of a fixed sleep that is too short on a busy machine and too long on an idle one.
string awaitEvals(App app, string needle, int maxMs) {
    string all = "";
    string one = "";
    double began = app_now_ms();
    while (!containsText(all, needle) && app_now_ms() - began < double(maxMs)) {
        app.serveOne(25);
        while (app_test_take_eval(app.handle, one) == 1) {
            all = all + one;
        }
    }
    return all;
}

// a fresh empty argument list (a vector passed to a method is moved, so every call needs its own)
std::vector<string> emptyArgs() {
    std::vector<string> none;
    return none;
}

class Counted {
public:
    int count;
    string last;
    Counted() {
        count = 0;
        last = "";
    }
};

string roundTrip(App app, string id, string request) {
    app_test_inject(app.handle, id, request);
    int turns = 0;
    while (app_test_response_ready(app.handle) == 0 && turns < 500) {
        app.serveOne(20);
        turns = turns + 1;
    }
    string gotId = "";
    int status = 0;
    string json = "";
    int r = app_test_take_response(app.handle, gotId, status, json);
    if (r != 1) {
        return "NO RESPONSE";
    }
    if (gotId != id) {
        return "WRONG ID " + gotId;
    }
    return intToString(status) + " " + json;
}

// a plain-value struct: copied into the worker, the main thread changes its own copy afterwards
struct Work {
public:
    int times;
    string word;
    std::vector<int> extra;
    Work(int t, string w) {
        times = t;
        word = w;
    }
};

// a flat class object: MOVED into the worker, which then owns it alone
class Tally {
public:
    int count;
    int total;
    std::vector<int> seen;
    Tally() {
        count = 0;
        total = 0;
    }
    void add(int x) {
        seen.push_back(x);
        count = count + 1;
        total = total + x;
    }
};

string demoJson(string count, string tags, string spotY, string more) {
    return "{\"name\":\"n\",\"count\":" + count + ",\"flag\":true,\"ratio\":0.5,\"tags\":" + tags + ",\"spot\":{\"x\":1,\"y\":" + spotY + "},\"more\":" + more + ",\"extra\":[1]}";
}

// A worker asks the main thread for something and waits for the answer on the channel it brings along.
struct FileAsk {
public:
    string path;
    Channel<string> reply;
    FileAsk(string p, Channel<string> r) { path = p; reply = r; }
};

// decodeDemoArgs is not written anywhere: a call to decode<StructName> asks the compiler for it (CeeLing's struct_json)
struct DemoSpot {
public:
    int x;
    int y;
    DemoSpot(int a, int b) { x = a; y = b; }
};

struct DemoArgs {
public:
    string name;
    int count;
    bool flag;
    double ratio;
    std::vector<string> tags;
    DemoSpot spot;
    std::vector<DemoSpot> more;
    DemoArgs(string n, int c, bool f, double r, std::vector<string> t, DemoSpot s, std::vector<DemoSpot> m) {
        name = n; count = c; flag = f; ratio = r; tags = t; spot = s; more = m;
    }
};

int main() {
    App app = new App();
    app.command("add", closure Command [] (Item args) {
        return createNumber(numberAt(args, 0) + numberAt(args, 1));
    });
    app.command("echo", closure Command [] (Item args) {
        return duplicate(args, true);
    });
    app.command("fail", closure Command [] (Item args) {
        throw "refused";
    });
    app.command("greet", closure Command [] (Item args) {
        return createString("hello, " + stringAt(args, 0));
    });
    app.command("field", closure Command [] (Item args) {
        return duplicate(fieldOf(args, "x"), true);
    });
    app.command("decoded", closure Command [] (Item args) {
        DemoArgs a = decodeDemoArgs(args);
        string text = a.name + ":" + intToString(a.count) + ":" + intToString(a.tags.size()) + ":" + intToString(a.spot.y) + ":" + intToString(a.more.size());
        if (a.flag) {
            text = text + ":flag";
        }
        return createString(text);
    });
    // a worker reads a file THROUGH THE MAIN THREAD: request on a Channel, pump answers on the reply Channel it was given
    Channel<FileAsk> toMain;
    app.onPump("files", closure Pump [toMain] (FileGate gate) {
        while (toMain.wait(0)) {
            FileAsk ask = toMain.take();
            FsResult r = gate.read(ask.path, 100000);
            if (r.status == 0) {
                ask.reply.send(r.text);
            } else {
                ask.reply.send("ERR");
            }
        }
    });
    app.asyncCommand("viapump", closure AsyncCommand [toMain] (Item args, string id, int handle) {
        string path = stringAt(args, 0);
        Channel<FileAsk> asks = toMain;      // (a nested closure can capture a local, not the outer closure's own captures)
        spawn(closure Job [asks, path, id, handle] () {
            Channel<string> reply;
            asks.send(new FileAsk(path, reply));
            wakeMain(handle, "files");
            string answer = "timeout";
            if (reply.wait(5000)) {
                answer = reply.take();
            }
            replyOk(handle, id, "\"" + answer + "\"");
        });
    });
    // async commands: the worker rebuilds its own JSON tree from a string and answers the page itself
    app.asyncCommand("aecho", closure AsyncCommand [] (Item args, string id, int handle) {
        string payload = printUnformatted(args);
        spawn(closure Job [payload, id, handle] () {
            Item mine = parse(payload);
            replyOk(handle, id, printUnformatted(mine));
        });
    });
    // args [milliseconds, tag]: answers the tag after sleeping
    app.asyncCommand("aslow", closure AsyncCommand [] (Item args, string id, int handle) {
        int ms = int(numberAt(args, 0));
        string tag = stringAt(args, 1);
        spawn(closure Job [ms, tag, id, handle] () {
            app_test_sleep_ms(ms);
            replyOk(handle, id, "\"" + tag + "\"");
        });
    });
    app.asyncCommand("afail", closure AsyncCommand [] (Item args, string id, int handle) {
        spawn(closure Job [id, handle] () {
            replyError(handle, id, "worker_failed", "the job gave up");
        });
    });
    // args [times, word]: the worker repeats the word; the struct is built here and COPIED into the job
    app.asyncCommand("arepeat", closure AsyncCommand [] (Item args, string id, int handle) {
        Work w = new Work(int(numberAt(args, 0)), stringAt(args, 1));
        w.extra.push_back(1);
        spawn(closure Job [w, id, handle] () {
            string out = "";
            int i = 0;
            while (i < w.times) {
                out = out + w.word;
                i = i + 1;
            }
            replyOk(handle, id, "\"" + out + "\"");
        });
        w.times = 0;
        w.word = "changed after spawn";
    });
    // args [numbers...]: the Tally is built here and moved into the worker, which replies with count and total
    app.asyncCommand("atally", closure AsyncCommand [] (Item args, string id, int handle) {
        Tally t = new Tally();
        int i = 0;
        while (i < getArraySize(args)) {
            t.add(int(numberAt(args, i)));
            i = i + 1;
        }
        spawn(closure Job [t, id, handle] () {
            replyOk(handle, id, "[" + intToString(t.count) + "," + intToString(t.total) + "]");
        });
    });
    // a job that throws: the dispatcher's default failure handler must answer the page with a rejection
    app.asyncCommand("athrow", closure AsyncCommand [] (Item args, string id, int handle) {
        spawn(closure Job [id] () {
            throw "kaboom";
        });
    });
    // args [milliseconds]: holds a slot of the worker pool for that long, counted by the shim's gauge
    app.asyncCommand("agauge", closure AsyncCommand [] (Item args, string id, int handle) {
        int ms = int(numberAt(args, 0));
        spawn(closure Job [ms, id, handle] () {
            app_test_gauge_enter();
            app_test_sleep_ms(ms);
            app_test_gauge_leave();
            replyOk(handle, id, "1");
        });
    });
    // answers twice: the page's promise must settle once
    app.asyncCommand("adouble", closure AsyncCommand [] (Item args, string id, int handle) {
        spawn(closure Job [id, handle] () {
            replyOk(handle, id, "\"first\"");
            replyOk(handle, id, "\"second\"");
            replyError(handle, id, "late", "a third answer");
        });
    });
    // works in small steps until the call is abandoned, then leaves a mark (args: the mark's path)
    app.asyncCommand("acoop", closure AsyncCommand [] (Item args, string id, int handle) {
        string mark = stringAt(args, 0);
        spawn(closure Job [mark, id, handle] () {
            int steps = 0;
            while (!callCancelled(handle, id) && steps < 600) {
                app_test_sleep_ms(10);
                steps = steps + 1;
            }
            app_test_write_raw(mark, intToString(steps));
            replyOk(handle, id, "\"stopped\"");
        });
    });
    // emits from a worker thread through emitEvent, then replies
    app.asyncCommand("aemit", closure AsyncCommand [] (Item args, string id, int handle) {
        spawn(closure Job [id, handle] () {
            emitEvent(handle, "fromWorker", "{\"ok\":true}");
            replyOk(handle, id, "true");
        });
    });
    app.open("t", 100, 100, "<html></html>", "", false);

    check("add", roundTrip(app, "1", "[\"add\",[2,3]]") == "0 5");
    check("echo object", roundTrip(app, "2", "[\"echo\",{\"a\":[1,true,null]}]") == "0 {\"a\":[1,true,null]}");
    check("echo no args", roundTrip(app, "3", "[\"echo\"]") == "0 null");
    check("greet", roundTrip(app, "4", "[\"greet\",[\"web\"]]") == "0 \"hello, web\"");
    check("string with quote", roundTrip(app, "5", "[\"echo\",\"a\\\"b\"]") == "0 \"a\\\"b\"");

    check("unknown command", roundTrip(app, "6", "[\"nope\",1]") == "1 {\"code\":\"unknown_command\",\"message\":\"no command named nope\"}");
    check("bad json", roundTrip(app, "7", "[\"add\",") == "1 {\"code\":\"bad_request\",\"message\":\"the request is not valid JSON\"}");
    check("not an array", roundTrip(app, "8", "{\"add\":1}") == "1 {\"code\":\"bad_request\",\"message\":\"the request must be a JSON array [command, args]\"}");
    check("empty array", roundTrip(app, "9", "[]") == "1 {\"code\":\"bad_request\",\"message\":\"the request must be a JSON array [command, args]\"}");
    check("command not a string", roundTrip(app, "10", "[7,1]") == "1 {\"code\":\"bad_request\",\"message\":\"the command name must be a string\"}");

    check("handler throws", roundTrip(app, "11", "[\"fail\"]") == "1 {\"code\":\"command_failed\",\"message\":\"refused\"}");
    check("missing args", roundTrip(app, "12", "[\"add\"]") == "1 {\"code\":\"command_failed\",\"message\":\"argument 0 must be a number\"}");
    check("wrong arg type", roundTrip(app, "13", "[\"add\",[1,\"x\"]]") == "1 {\"code\":\"command_failed\",\"message\":\"argument 1 must be a number\"}");
    check("args not an array", roundTrip(app, "14", "[\"greet\",5]") == "1 {\"code\":\"command_failed\",\"message\":\"argument 0 must be a string\"}");
    check("missing field", roundTrip(app, "15", "[\"field\",{\"y\":1}]") == "1 {\"code\":\"command_failed\",\"message\":\"missing field x\"}");
    check("field present", roundTrip(app, "16", "[\"field\",{\"x\":[4]}]") == "0 [4]");

    // a large payload goes through unchanged
    string big = "";
    int i = 0;
    while (i < 20000) {
        big.push_back('a');
        i = i + 1;
    }
    check("large payload", roundTrip(app, "17", "[\"echo\",\"" + big + "\"]") == "0 \"" + big + "\"");

    // the server survives all of the above: one more good call at the end
    check("still serving", roundTrip(app, "18", "[\"add\",[40,2]]") == "0 42");

    // two requests queued together are answered in order
    app_test_inject(app.handle, "a", "[\"add\",[1,1]]");
    app_test_inject(app.handle, "b", "[\"add\",[2,2]]");
    drain(app, 100);
    string id1 = "";
    string id2 = "";
    int s1 = 0;
    int s2 = 0;
    string j1 = "";
    string j2 = "";
    app_test_take_response(app.handle, id1, s1, j1);
    app_test_take_response(app.handle, id2, s2, j2);
    check("ordering", id1 == "a" && j1 == "2" && id2 == "b" && j2 == "4");

    // ---- async commands -------------------------------------------------------------------------
    check("async echo", roundTrip(app, "x1", "[\"aecho\",{\"k\":[1,2]}]") == "0 {\"k\":[1,2]}");
    check("async worker error", roundTrip(app, "x2", "[\"afail\"]") == "1 {\"code\":\"worker_failed\",\"message\":\"the job gave up\"}");
    check("async start rejects bad args", roundTrip(app, "x3", "[\"aslow\",[\"no\",\"t\"]]") == "1 {\"code\":\"command_failed\",\"message\":\"argument 0 must be a number\"}");

    check("struct copied into worker", roundTrip(app, "x4", "[\"arepeat\",[3,\"ab\"]]") == "0 \"ababab\"");

    check("object moved into worker", roundTrip(app, "x5", "[\"atally\",[4,5,6]]") == "0 [3,15]");

    check("throwing job rejects the promise", roundTrip(app, "x6", "[\"athrow\"]") == "1 {\"code\":\"command_failed\",\"message\":\"kaboom\"}");

    // a slow job started first answers LAST; replies are matched by id, not by order
    app_test_inject(app.handle, "slow", "[\"aslow\",[400,\"slow\"]]");
    app_test_inject(app.handle, "fast", "[\"aslow\",[5,\"fast\"]]");
    drain(app, 100);
    string firstId = "";
    string secondId = "";
    int st1 = 0;
    int st2 = 0;
    string body1 = "";
    string body2 = "";
    app_test_take_response(app.handle, firstId, st1, body1);
    app_test_take_response(app.handle, secondId, st2, body2);
    check("out-of-order replies", firstId == "fast" && body1 == "\"fast\"" && secondId == "slow" && body2 == "\"slow\"");

    // a sync and an async call queued together are both answered, whichever comes first
    app_test_inject(app.handle, "m1", "[\"add\",[1,2]]");
    app_test_inject(app.handle, "m2", "[\"aecho\",[\"x\"]]");
    drain(app, 100);
    string mixA = "";
    string mixB = "";
    int ms1 = 0;
    int ms2 = 0;
    string mb1 = "";
    string mb2 = "";
    app_test_take_response(app.handle, mixA, ms1, mb1);
    app_test_take_response(app.handle, mixB, ms2, mb2);
    bool mixedOk = false;
    if (mixA == "m1") {
        mixedOk = mb1 == "3" && mixB == "m2" && mb2 == "[\"x\"]";
    } else {
        mixedOk = mixA == "m2" && mb1 == "[\"x\"]" && mixB == "m1" && mb2 == "3";
    }
    check("sync and async mixed", mixedOk);

    // many concurrent jobs: every call answered exactly once with its own payload
    int total = 50;
    int n = 0;
    while (n < total) {
        app_test_inject(app.handle, "c" + intToString(n), "[\"aecho\",[" + intToString(n) + "]]");
        n = n + 1;
    }
    drain(app, 100);
    std::vector<int> seen;
    int k = 0;
    while (k < total) {
        seen.push_back(0);
        k = k + 1;
    }
    bool allOk = true;
    k = 0;
    while (k < total) {
        string rid = "";
        int rst = 0;
        string rbody = "";
        int got = app_test_take_response(app.handle, rid, rst, rbody);
        if (got != 1 || rst != 0 || rid.length() < 2) {
            allOk = false;
        } else {
            int idx = 0;
            int pos = 1;
            while (pos < rid.length()) {
                idx = idx * 10 + (int(rid[pos]) - 48);
                pos = pos + 1;
            }
            if (idx < 0 || idx >= total || rbody != "[" + intToString(idx) + "]") {
                allOk = false;
            } else {
                if (seen[idx] != 0) {
                    allOk = false;
                }
                seen[idx] = 1;
            }
        }
        k = k + 1;
    }
    check("50 concurrent jobs", allOk);

    // ---- the worker limit -------------------------------------------------------------------------
    // 6 jobs of 80 ms with at most 2 running at once: all answered, and the gauge never saw more than 2 inside
    app.setWorkerLimit(2);
    int a = 0;
    while (a < 6) {
        app_test_inject(app.handle, "g" + intToString(a), "[\"agauge\",[80]]");
        a = a + 1;
    }
    drain(app, 100);
    int answered = 0;
    a = 0;
    while (a < 6) {
        string gid = "";
        int gst = 0;
        string gbody = "";
        if (app_test_take_response(app.handle, gid, gst, gbody) == 1 && gst == 0 && gbody == "1") {
            answered = answered + 1;
        }
        a = a + 1;
    }
    check("limit 2: all 6 jobs answered", answered == 6);
    check("limit 2: never more than 2 at once", app_test_gauge_peak() <= 2 && app_test_gauge_peak() >= 1);

    // control: without the cap the same jobs overlap more, so the check above could have failed
    app.setWorkerLimit(0);
    a = 0;
    while (a < 6) {
        app_test_inject(app.handle, "h" + intToString(a), "[\"agauge\",[80]]");
        a = a + 1;
    }
    drain(app, 100);
    a = 0;
    while (a < 6) {
        string hid = "";
        int hst = 0;
        string hbody = "";
        app_test_take_response(app.handle, hid, hst, hbody);
        a = a + 1;
    }
    check("control: default limit lets more than 2 overlap", app_test_gauge_peak() > 2);
    // ---- events: CeeLing -> page ---------------------------------------------------------------
    string js = "";
    check("emit builds the call", app.emit("tick", "{\"n\":1}") && app_test_take_eval(app.handle, js) == 1 && js == "window.__cling_emit([\"tick\",{\"n\":1}]);");
    check("emit re-prints the payload", app.emit("t", "{ \"a\" : [ 1 , 2 ] }") && app_test_take_eval(app.handle, js) == 1 && js == "window.__cling_emit([\"t\",{\"a\":[1,2]}]);");
    // a name and a payload that try to break out of the script stay string literals
    check("emit cannot inject script", app.emit("a\"b", "\"x\\\");alert(1);(\\\"\"") && app_test_take_eval(app.handle, js) == 1 && js == "window.__cling_emit([\"a\\\"b\",\"x\\\");alert(1);(\\\"\"]);");
    check("emit rejects invalid JSON", !app.emit("bad", "{oops") && app_test_take_eval(app.handle, js) == 0);
    check("emit rejects a payload with trailing script", !app.emit("bad", "1);alert(1") && app_test_take_eval(app.handle, js) == 0);
    app.emit("one", "1");
    app.emit("two", "2");
    string firstJs = "";
    string secondJs = "";
    app_test_take_eval(app.handle, firstJs);
    app_test_take_eval(app.handle, secondJs);
    check("events keep their order", firstJs == "window.__cling_emit([\"one\",1]);" && secondJs == "window.__cling_emit([\"two\",2]);");

    // a worker job can emit: the event arrives while the job runs, then it answers
    int waited = 0;
    string workerJs = "";
    check("worker emits then replies", roundTrip(app, "x7", "[\"aemit\"]") == "0 true");
    while (app_test_take_eval(app.handle, workerJs) == 0 && waited < 100) {
        app_test_sleep_ms(20);
        waited = waited + 1;
    }
    check("worker's event arrived", workerJs == "window.__cling_emit([\"fromWorker\",{\"ok\":true}]);");

    // ---- file commands ----------------------------------------------------------------------------
    app.enableFileCommands(16);
    string base = "";
    app_test_make_temp_dir(base);
    string allowed = base + "/allowed";
    string outside = base + "/outside";
    check("a folder that does not exist cannot be allowed", !app.allowFolder(base + "/nope"));
    app_test_mkdir_raw(allowed);
    app_test_mkdir_raw(outside);
    app_test_write_raw(outside + "/secret.txt", "TOP SECRET");
    string badBytes = "";
    badBytes.push_back(char(255));
    app_test_write_raw(allowed + "/binary.dat", badBytes);
    check("allowFolder accepts a real folder", app.allowFolder(allowed));

    Item writeArgs = pathArgs("note.txt");
    addStringToObject(writeArgs, "text", "hello");
    check("fs.write then fs.read", roundTrip(app, "f1", requestText("fs.write", writeArgs)) == "0 null" &&
          roundTrip(app, "f2", requestText("fs.read", pathArgs("note.txt"))) == "0 {\"text\":\"hello\"}");
    check("fs.stat describes the file", startsWith(roundTrip(app, "f3", requestText("fs.stat", pathArgs("note.txt"))),
          "0 {\"name\":\"note.txt\",\"kind\":\"file\",\"size\":5,\"modified\":"));
    string listed = roundTrip(app, "f4", requestText("fs.list", pathArgs(".")));
    check("fs.list shows it", startsWith(listed, "0 [{\"name\":") && listed.length() > 40);
    check("fs.exists true", roundTrip(app, "f6", requestText("fs.exists", pathArgs("note.txt"))) == "0 true");
    check("fs.exists false", roundTrip(app, "f7", requestText("fs.exists", pathArgs("absent.txt"))) == "0 false");
    check("missing file is not_found", startsWith(roundTrip(app, "f8", requestText("fs.read", pathArgs("absent.txt"))),
          "1 {\"code\":\"not_found\",\"message\":\"cannot read absent.txt\"}"));

    check("dot-dot escape is forbidden", startsWith(roundTrip(app, "f9", requestText("fs.read", pathArgs("../outside/secret.txt"))),
          "1 {\"code\":\"forbidden\""));
    check("absolute path outside is forbidden", startsWith(roundTrip(app, "f10", requestText("fs.read", pathArgs(outside + "/secret.txt"))),
          "1 {\"code\":\"forbidden\""));
    check("exists does not leak outside", startsWith(roundTrip(app, "f11", requestText("fs.exists", pathArgs(outside + "/secret.txt"))),
          "1 {\"code\":\"forbidden\"") &&
          startsWith(roundTrip(app, "f12", requestText("fs.exists", pathArgs(outside + "/no-such-file"))), "1 {\"code\":\"forbidden\""));
    check("write without text is invalid_argument", startsWith(roundTrip(app, "f13", requestText("fs.write", pathArgs(outside + "/planted.txt"))), "1 {\"code\":\"invalid_argument\""));
    Item plant = pathArgs(outside + "/planted.txt");
    addStringToObject(plant, "text", "x");
    check("write outside with all arguments is forbidden", startsWith(roundTrip(app, "f14", requestText("fs.write", plant)), "1 {\"code\":\"forbidden\""));

    string link = allowed + "/linkout";
    app_test_make_dir_link(link, outside);
    check("a link that leads out is forbidden", startsWith(roundTrip(app, "f15", requestText("fs.read", pathArgs("linkout/secret.txt"))), "1 {\"code\":\"forbidden\""));
    check("listing through that link is forbidden", startsWith(roundTrip(app, "f16", requestText("fs.list", pathArgs("linkout"))), "1 {\"code\":\"forbidden\""));
    check("removing the link leaves its target", startsWith(roundTrip(app, "f17", requestText("fs.remove", pathArgs("linkout"))), "0 null") &&
          startsWith(roundTrip(app, "f18", requestText("fs.exists", pathArgs(outside + "/secret.txt"))), "1 {\"code\":\"forbidden\""));

    check("a missing path argument is invalid_argument", roundTrip(app, "f19", requestText("fs.read", createObject())) ==
          "1 {\"code\":\"invalid_argument\",\"message\":\"`path` must be a string\"}");
    check("a non-object argument is invalid_argument", startsWith(roundTrip(app, "f20", "[\"fs.read\",5]"), "1 {\"code\":\"invalid_argument\""));
    Item badMode = pathArgs("m.txt");
    addStringToObject(badMode, "text", "x");
    addStringToObject(badMode, "mode", "overwrite");
    check("an unknown mode is invalid_argument", startsWith(roundTrip(app, "f21", requestText("fs.write", badMode)), "1 {\"code\":\"invalid_argument\""));

    Item createOnly = pathArgs("once.txt");
    addStringToObject(createOnly, "text", "1");
    addStringToObject(createOnly, "mode", "create");
    check("create mode creates", roundTrip(app, "f22", requestText("fs.write", createOnly)) == "0 null");
    check("create mode refuses an existing name", startsWith(roundTrip(app, "f23", requestText("fs.write", createOnly)), "1 {\"code\":\"already_exists\""));
    Item appendArgs = pathArgs("once.txt");
    addStringToObject(appendArgs, "text", "2");
    addStringToObject(appendArgs, "mode", "append");
    check("append mode", roundTrip(app, "f24", requestText("fs.write", appendArgs)) == "0 null" &&
          roundTrip(app, "f25", requestText("fs.read", pathArgs("once.txt"))) == "0 {\"text\":\"12\"}");

    Item bigArgs = pathArgs("big.txt");
    addStringToObject(bigArgs, "text", "this text is longer than sixteen bytes");
    roundTrip(app, "f26", requestText("fs.write", bigArgs));
    check("a file over the read limit is too_large", startsWith(roundTrip(app, "f27", requestText("fs.read", pathArgs("big.txt"))), "1 {\"code\":\"too_large\""));
    check("a file that is not UTF-8 is not_text", startsWith(roundTrip(app, "f28", requestText("fs.read", pathArgs("binary.dat"))), "1 {\"code\":\"not_text\""));

    Item dirArgs = pathArgs("a/b/c");
    addBoolToObject(dirArgs, "parents", true);
    check("mkdir with parents", roundTrip(app, "f29", requestText("fs.mkdir", dirArgs)) == "0 null" &&
          roundTrip(app, "f30", requestText("fs.mkdir", dirArgs)) == "0 null");
    check("mkdir without parents needs the parent", startsWith(roundTrip(app, "f31", requestText("fs.mkdir", pathArgs("x/y/z"))), "1 {\"code\":\"not_found\""));
    check("removing a folder with entries is not_empty", startsWith(roundTrip(app, "f32", requestText("fs.remove", pathArgs("a"))), "1 {\"code\":\"not_empty\""));
    check("removing an empty folder", roundTrip(app, "f33", requestText("fs.remove", pathArgs("a/b/c"))) == "0 null");
    check("the allowed folder itself cannot be removed", startsWith(roundTrip(app, "f34", requestText("fs.remove", pathArgs(allowed))), "1 {\"code\":\"forbidden\""));
    check("reading a folder is is_directory", startsWith(roundTrip(app, "f35", requestText("fs.read", pathArgs("a"))), "1 {\"code\":\"is_directory\""));
    app.gate.allow(outside);
    FsResult secret = app.gate.read(outside + "/secret.txt", 100);
    FsResult planted = app.gate.stat(outside + "/planted.txt");
    check("the secret outside was never touched", secret.status == 0 && secret.text == "TOP SECRET" && planted.status == 2);
    app.gate.clear();
    app_test_remove_tree(base);

    // ---- dialog commands: a pick is a grant of exactly what was picked ---------------------------------
    app.enableDialogCommands();
    string dbase = "";
    app_test_make_temp_dir(dbase);
    app_test_write_raw(dbase + "/picked.txt", "chosen");
    app_test_write_raw(dbase + "/neighbour.txt", "other");
    app_test_mkdir_raw(dbase + "/chosen_folder");
    app_test_write_raw(dbase + "/chosen_folder/inside.txt", "inside");
    app.gate.clear();

    check("nothing is reachable before the user picks", startsWith(roundTrip(app, "d1", requestText("fs.read", pathArgs(dbase + "/picked.txt"))), "1 {\"code\":\"forbidden\""));
    app_test_dialog_push("cancel");
    check("cancel answers null and grants nothing", roundTrip(app, "d2", requestText("dialog.open", createObject())) == "0 null" &&
          startsWith(roundTrip(app, "d3", requestText("fs.read", pathArgs(dbase + "/picked.txt"))), "1 {\"code\":\"forbidden\""));

    Item openArgs = createObject();
    addStringToObject(openArgs, "title", "Open a note");
    Item filterList = addArrayToObject(openArgs, "filters");
    Item textFilter = createObject();
    addStringToObject(textFilter, "name", "Text");
    Item textExts = addArrayToObject(textFilter, "extensions");
    addItemToArray(textExts, createString("txt"));
    addItemToArray(textExts, createString("md"));
    addItemToArray(filterList, textFilter);
    Item allFilter = createObject();
    addStringToObject(allFilter, "name", "Everything");
    addItemToArray(filterList, allFilter);
    app_test_dialog_push("path:" + dbase + "/picked.txt");
    string pickReply = roundTrip(app, "d4", requestText("dialog.open", openArgs));
    check("a pick answers the path", startsWith(pickReply, "0 {\"path\":\"") && containsText(pickReply, "picked.txt"));
    check("the dialog was asked with the title and two filters", latestRequest() == "pick|0|Open a note|||Text|*.txt;*.md|Everything|*.*");
    check("the picked file is now readable", roundTrip(app, "d5", requestText("fs.read", pathArgs(dbase + "/picked.txt"))) == "0 {\"text\":\"chosen\"}");
    check("its neighbour is not", startsWith(roundTrip(app, "d6", requestText("fs.read", pathArgs(dbase + "/neighbour.txt"))), "1 {\"code\":\"forbidden\""));
    check("neither is the folder listing", startsWith(roundTrip(app, "d7", requestText("fs.list", pathArgs(dbase))), "1 {\"code\":\"forbidden\""));

    Item saveArgs = createObject();
    addStringToObject(saveArgs, "defaultName", "export.txt");
    app_test_dialog_push("path:" + dbase + "/export.txt");
    check("save as grants a file that does not exist yet", startsWith(roundTrip(app, "d8", requestText("dialog.save", saveArgs)), "0 {\"path\":\"") &&
          latestRequest() == "pick|1||export.txt|");
    Item exportWrite = pathArgs(dbase + "/export.txt");
    addStringToObject(exportWrite, "text", "exported");
    addStringToObject(exportWrite, "mode", "create");
    check("which the page may then create", roundTrip(app, "d9", requestText("fs.write", exportWrite)) == "0 null");
    Item otherWrite = pathArgs(dbase + "/other.txt");
    addStringToObject(otherWrite, "text", "x");
    check("but not a second file beside it", startsWith(roundTrip(app, "d10", requestText("fs.write", otherWrite)), "1 {\"code\":\"forbidden\""));

    app_test_dialog_push("path:" + dbase + "/chosen_folder");
    check("a folder pick grants the folder", startsWith(roundTrip(app, "d11", requestText("dialog.folder", createObject())), "0 {\"path\":\"") &&
          roundTrip(app, "d12", requestText("fs.read", pathArgs(dbase + "/chosen_folder/inside.txt"))) == "0 {\"text\":\"inside\"}");

    app.revokeGrants();
    check("revoking withdraws every grant", startsWith(roundTrip(app, "d13", requestText("fs.read", pathArgs(dbase + "/picked.txt"))), "1 {\"code\":\"forbidden\"") &&
          startsWith(roundTrip(app, "d14", requestText("fs.read", pathArgs(dbase + "/chosen_folder/inside.txt"))), "1 {\"code\":\"forbidden\""));

    Item msgArgs = createObject();
    addStringToObject(msgArgs, "title", "Delete?");
    addStringToObject(msgArgs, "message", "Really delete the note?");
    addStringToObject(msgArgs, "kind", "question");
    addStringToObject(msgArgs, "buttons", "yesno");
    app_test_dialog_push("button:3");
    check("a message box answers the button", roundTrip(app, "d15", requestText("dialog.message", msgArgs)) == "0 {\"button\":\"yes\"}" &&
          latestRequest() == "message|Delete?|Really delete the note?|3|2");
    app_test_dialog_push("button:4");
    check("and the other button", roundTrip(app, "d16", requestText("dialog.message", msgArgs)) == "0 {\"button\":\"no\"}");

    Item badKind = createObject();
    addStringToObject(badKind, "message", "x");
    addStringToObject(badKind, "kind", "alarm");
    check("an unknown kind is invalid_argument", startsWith(roundTrip(app, "d17", requestText("dialog.message", badKind)), "1 {\"code\":\"invalid_argument\""));
    Item noMessage = createObject();
    check("a message box needs a message", startsWith(roundTrip(app, "d18", requestText("dialog.message", noMessage)), "1 {\"code\":\"invalid_argument\""));
    Item badFilters = createObject();
    addStringToObject(badFilters, "filters", "txt");
    check("filters must be an array", startsWith(roundTrip(app, "d19", requestText("dialog.open", badFilters)), "1 {\"code\":\"invalid_argument\""));
    check("a field of the wrong type is named (generated decoder)", roundTrip(app, "d19b", "[\"dialog.open\",{\"filters\":[{\"name\":5}]}]") == "1 {\"code\":\"invalid_argument\",\"message\":\"`filters[0].name` must be a string\"}");
    app_test_dialog_push("button:1");
    check("a null field counts as absent", startsWith(roundTrip(app, "d19c", "[\"dialog.message\",{\"message\":\"hi\",\"title\":null}]"), "0 {\"button\":") &&
          latestRequest() == "message||hi|0|0");
    Item badExtension = createObject();
    Item badList = addArrayToObject(badExtension, "filters");
    Item oddFilter = createObject();
    addStringToObject(oddFilter, "name", "Odd");
    Item oddExts = addArrayToObject(oddFilter, "extensions");
    addItemToArray(oddExts, createString("a;b"));
    addItemToArray(badList, oddFilter);
    check("an extension with odd characters is refused", startsWith(roundTrip(app, "d20", requestText("dialog.open", badExtension)), "1 {\"code\":\"invalid_argument\""));
    Item longTitle = createObject();
    addStringToObject(longTitle, "title", repeated("x", 201));
    check("an over-long title is refused", startsWith(roundTrip(app, "d21", requestText("dialog.open", longTitle)), "1 {\"code\":\"invalid_argument\""));
    Item badName = createObject();
    addStringToObject(badName, "defaultName", "../escape.txt");
    check("a default name with a folder in it is refused", startsWith(roundTrip(app, "d22", requestText("dialog.save", badName)), "1 {\"code\":\"invalid_argument\""));
    check("with nothing scripted the dialog is unsupported", startsWith(roundTrip(app, "d23", requestText("dialog.folder", createObject())), "1 {\"code\":\"unsupported\""));
    app.gate.clear();
    app_test_remove_tree(dbase);

    // ---- program commands: the page names an entry of a table, never a command line ---------------------
    string helper = "";
    app_test_helper(helper);
    string pbase = "";
    app_test_make_temp_dir(pbase);
    app.allowFolder(pbase);
    app_test_write_raw(pbase + "/f.txt", "file");
    app_test_mkdir_raw(pbase + "/sub");
    string pout = "";
    app_test_make_temp_dir(pout);

    std::vector<string> pEcho;
    pEcho.push_back("fixed");
    pEcho.push_back("{a:text:50}");
    pEcho.push_back("n={n:int:1:100}");
    pEcho.push_back("{t:token}");
    pEcho.push_back("--file={f:file}");
    pEcho.push_back("@cwd={dir:folder}");
    check("allowProgram accepts a good template", app.allowProgram("echo", helper, pEcho, 5000, 100000));

    std::vector<string> pExit;
    pExit.push_back("--exit");
    pExit.push_back("{code:int:0:255}");
    pExit.push_back("@cwd={dir:folder}");
    std::vector<string> pSleepy;
    pSleepy.push_back("--sleep");
    pSleepy.push_back("{ms:int:0:60000}");
    pSleepy.push_back("@cwd={dir:folder}");
    std::vector<string> pBig;
    pBig.push_back("--big");
    pBig.push_back("{n:int:0:5000000}");
    pBig.push_back("@cwd={dir:folder}");
    std::vector<string> pBytes;
    pBytes.push_back("--bytes");
    pBytes.push_back("{hex:token}");
    pBytes.push_back("@cwd={dir:folder}");
    std::vector<string> pSleeper;
    pSleeper.push_back("--leave-sleeper");
    pSleeper.push_back("@cwd={dir:folder}");
    std::vector<string> pCwd;
    pCwd.push_back("--cwd");
    pCwd.push_back("@cwd={dir:folder}");
    std::vector<string> pWhere;
    pWhere.push_back("--cwd");
    app.allowProgram("exit", helper, pExit, 5000, 1000);
    app.allowProgram("sleepy", helper, pSleepy, 300, 1000);
    app.allowProgram("big", helper, pBig, 20000, 1000);
    app.allowProgram("bytes", helper, pBytes, 5000, 1000);
    app.allowProgram("sleeper", helper, pSleeper, 20000, 1000);
    app.allowProgram("cwd", helper, pCwd, 5000, 1000);
    app.allowProgram("where", helper, pWhere, 5000, 1000);
    app.enableProcessCommands();

    // the template itself is checked when it is registered
    std::vector<string> bad1;
    bad1.push_back("{a:wrongkind}");
    std::vector<string> bad2;
    bad2.push_back("{a:int:5}");
    std::vector<string> bad3;
    bad3.push_back("x{a:text:5}{b:text:5}");
    std::vector<string> bad4;
    bad4.push_back("{a:text:5");
    std::vector<string> bad5;
    bad5.push_back("@cwd={a:folder}");
    bad5.push_back("@cwd={b:folder}");
    std::vector<string> bad6;
    bad6.push_back("{a:text:5}");
    bad6.push_back("{a:token}");
    std::vector<string> bad7;
    bad7.push_back("@cwd={a:file}");
    std::vector<string> bad8;
    bad8.push_back("{a:int:9:3}");
    std::vector<string> fine;
    check("a slot of an unknown kind is refused", !app.allowProgram("t1", helper, bad1, 1000, 1000));
    check("an int slot needs min and max", !app.allowProgram("t2", helper, bad2, 1000, 1000));
    check("two slots in one argument are refused", !app.allowProgram("t3", helper, bad3, 1000, 1000));
    check("an unclosed brace is refused", !app.allowProgram("t4", helper, bad4, 1000, 1000));
    check("two working folders are refused", !app.allowProgram("t5", helper, bad5, 1000, 1000));
    check("the same slot name twice is refused", !app.allowProgram("t6", helper, bad6, 1000, 1000));
    check("the working folder must be a folder slot", !app.allowProgram("t7", helper, bad7, 1000, 1000));
    check("an int range must be ordered", !app.allowProgram("t8", helper, bad8, 1000, 1000));
    check("a program that does not exist is refused", !app.allowProgram("t9", pbase + "/nothing.exe", fine, 1000, 1000));
    check("a bare name that is not on PATH is refused", !app.allowProgram("t10", "surely-not-installed-xyz", fine, 1000, 1000));
    check("a name with a space is refused", !app.allowProgram("has space", helper, fine, 1000, 1000));
    check("a taken name is refused", !app.allowProgram("echo", helper, fine, 1000, 1000));
    check("a timeout below 100 ms is refused", !app.allowProgram("t11", helper, fine, 50, 1000));
    check("a relative program path is refused", !app.allowProgram("t12", "./helper.exe", fine, 1000, 1000));

    Item eArgs = createObject();
    addStringToObject(eArgs, "a", "plain");
    addNumberToObject(eArgs, "n", 7.0);
    addStringToObject(eArgs, "t", "main");
    addStringToObject(eArgs, "f", "f.txt");
    addStringToObject(eArgs, "dir", pbase);
    Item eReq = createObject();
    addStringToObject(eReq, "program", "echo");
    addItemToObject(eReq, "args", eArgs);
    string eReply = roundTrip(app, "p1", requestText("proc.run", eReq));
    check("a program runs and its output comes back", startsWith(eReply, "0 {\"exitCode\":0,\"stdout\":\"[1]=fixed") && containsText(eReply, "[3]=n=7") &&
          containsText(eReply, "[4]=main") && containsText(eReply, "f.txt") && containsText(eReply, "\"timedOut\":false"));

    // shell characters in a value stay inside ONE argument
    Item i1 = createObject();
    addStringToObject(i1, "a", "x; calc & echo hi | find > out");
    addNumberToObject(i1, "n", 1.0);
    addStringToObject(i1, "t", "main");
    addStringToObject(i1, "f", "f.txt");
    addStringToObject(i1, "dir", pbase);
    Item iReq = createObject();
    addStringToObject(iReq, "program", "echo");
    addItemToObject(iReq, "args", i1);
    string iReply = roundTrip(app, "p2", requestText("proc.run", iReq));
    check("shell characters are not interpreted", containsText(iReply, "[2]=x; calc & echo hi | find > out") && containsText(iReply, "\"exitCode\":0"));

    Item optionLike = createObject();
    addStringToObject(optionLike, "a", "--help");
    addNumberToObject(optionLike, "n", 1.0);
    addStringToObject(optionLike, "t", "main");
    addStringToObject(optionLike, "f", "f.txt");
    addStringToObject(optionLike, "dir", pbase);
    Item oReq = createObject();
    addStringToObject(oReq, "program", "echo");
    addItemToObject(oReq, "args", optionLike);
    check("a whole argument cannot start with a dash", startsWith(roundTrip(app, "p3", requestText("proc.run", oReq)), "1 {\"code\":\"invalid_argument\""));

    Item tokenBad = createObject();
    addStringToObject(tokenBad, "a", "ok");
    addNumberToObject(tokenBad, "n", 1.0);
    addStringToObject(tokenBad, "t", "a;b");
    addStringToObject(tokenBad, "f", "f.txt");
    addStringToObject(tokenBad, "dir", pbase);
    Item tReq = createObject();
    addStringToObject(tReq, "program", "echo");
    addItemToObject(tReq, "args", tokenBad);
    check("a token with a semicolon is refused", startsWith(roundTrip(app, "p4", requestText("proc.run", tReq)), "1 {\"code\":\"invalid_argument\""));

    Item intBad = createObject();
    addStringToObject(intBad, "a", "ok");
    addNumberToObject(intBad, "n", 101.0);
    addStringToObject(intBad, "t", "main");
    addStringToObject(intBad, "f", "f.txt");
    addStringToObject(intBad, "dir", pbase);
    Item nReq = createObject();
    addStringToObject(nReq, "program", "echo");
    addItemToObject(nReq, "args", intBad);
    check("an int above its range is refused", startsWith(roundTrip(app, "p5", requestText("proc.run", nReq)), "1 {\"code\":\"invalid_argument\""));
    Item intFrac = createObject();
    addStringToObject(intFrac, "a", "ok");
    addNumberToObject(intFrac, "n", 1.5);
    addStringToObject(intFrac, "t", "main");
    addStringToObject(intFrac, "f", "f.txt");
    addStringToObject(intFrac, "dir", pbase);
    Item fReq = createObject();
    addStringToObject(fReq, "program", "echo");
    addItemToObject(fReq, "args", intFrac);
    check("a fraction is not an int", startsWith(roundTrip(app, "p6", requestText("proc.run", fReq)), "1 {\"code\":\"invalid_argument\""));
    Item intStr = createObject();
    addStringToObject(intStr, "a", "ok");
    addStringToObject(intStr, "n", "5");
    addStringToObject(intStr, "t", "main");
    addStringToObject(intStr, "f", "f.txt");
    addStringToObject(intStr, "dir", pbase);
    Item sReq = createObject();
    addStringToObject(sReq, "program", "echo");
    addItemToObject(sReq, "args", intStr);
    check("a string is not an int", startsWith(roundTrip(app, "p7", requestText("proc.run", sReq)), "1 {\"code\":\"invalid_argument\""));

    Item fileOutside = createObject();
    addStringToObject(fileOutside, "a", "ok");
    addNumberToObject(fileOutside, "n", 1.0);
    addStringToObject(fileOutside, "t", "main");
    addStringToObject(fileOutside, "f", pout + "/secret.txt");
    addStringToObject(fileOutside, "dir", pbase);
    Item oReq2 = createObject();
    addStringToObject(oReq2, "program", "echo");
    addItemToObject(oReq2, "args", fileOutside);
    check("a file slot outside the allowed folders is forbidden", startsWith(roundTrip(app, "p8", requestText("proc.run", oReq2)), "1 {\"code\":\"forbidden\""));
    Item fileEscape = createObject();
    addStringToObject(fileEscape, "a", "ok");
    addNumberToObject(fileEscape, "n", 1.0);
    addStringToObject(fileEscape, "t", "main");
    addStringToObject(fileEscape, "f", "../outside.txt");
    addStringToObject(fileEscape, "dir", pbase);
    Item eReq2 = createObject();
    addStringToObject(eReq2, "program", "echo");
    addItemToObject(eReq2, "args", fileEscape);
    check("a file slot with dot-dot is forbidden", startsWith(roundTrip(app, "p9", requestText("proc.run", eReq2)), "1 {\"code\":\"forbidden\""));
    Item fileMissing = createObject();
    addStringToObject(fileMissing, "a", "ok");
    addNumberToObject(fileMissing, "n", 1.0);
    addStringToObject(fileMissing, "t", "main");
    addStringToObject(fileMissing, "f", "missing.txt");
    addStringToObject(fileMissing, "dir", pbase);
    Item mReq = createObject();
    addStringToObject(mReq, "program", "echo");
    addItemToObject(mReq, "args", fileMissing);
    check("a missing file is not_found", startsWith(roundTrip(app, "p10", requestText("proc.run", mReq)), "1 {\"code\":\"not_found\""));
    Item fileIsDir = createObject();
    addStringToObject(fileIsDir, "a", "ok");
    addNumberToObject(fileIsDir, "n", 1.0);
    addStringToObject(fileIsDir, "t", "main");
    addStringToObject(fileIsDir, "f", "sub");
    addStringToObject(fileIsDir, "dir", pbase);
    Item dReq = createObject();
    addStringToObject(dReq, "program", "echo");
    addItemToObject(dReq, "args", fileIsDir);
    check("a folder where a file is wanted", startsWith(roundTrip(app, "p11", requestText("proc.run", dReq)), "1 {\"code\":\"is_directory\""));

    Item extra = createObject();
    addStringToObject(extra, "a", "ok");
    addNumberToObject(extra, "n", 1.0);
    addStringToObject(extra, "t", "main");
    addStringToObject(extra, "f", "f.txt");
    addStringToObject(extra, "dir", pbase);
    addStringToObject(extra, "extra", "--delete-everything");
    Item xReq = createObject();
    addStringToObject(xReq, "program", "echo");
    addItemToObject(xReq, "args", extra);
    check("a parameter the template does not have is refused", containsText(roundTrip(app, "p12", requestText("proc.run", xReq)), "`extra` is not a parameter of echo"));
    Item lacking = createObject();
    addStringToObject(lacking, "a", "ok");
    Item lReq = createObject();
    addStringToObject(lReq, "program", "echo");
    addItemToObject(lReq, "args", lacking);
    check("a missing parameter is refused", startsWith(roundTrip(app, "p13", requestText("proc.run", lReq)), "1 {\"code\":\"invalid_argument\""));

    Item unknown = createObject();
    addStringToObject(unknown, "program", "rm");
    check("an unregistered program name", startsWith(roundTrip(app, "p14", requestText("proc.run", unknown)), "1 {\"code\":\"unknown_program\""));
    Item pathProgram = createObject();
    addStringToObject(pathProgram, "program", helper);
    check("a program path from the page is just an unknown name", startsWith(roundTrip(app, "p15", requestText("proc.run", pathProgram)), "1 {\"code\":\"unknown_program\""));
    check("the program name must be given", startsWith(roundTrip(app, "p16", requestText("proc.run", createObject())), "1 {\"code\":\"invalid_argument\""));
    Item argsNotObject = createObject();
    addStringToObject(argsNotObject, "program", "echo");
    addStringToObject(argsNotObject, "args", "-rf /");
    check("args must be an object", startsWith(roundTrip(app, "p17", requestText("proc.run", argsNotObject)), "1 {\"code\":\"invalid_argument\""));

    Item exitArgs = createObject();
    addNumberToObject(exitArgs, "code", 7.0);
    addStringToObject(exitArgs, "dir", pbase);
    Item xitReq = createObject();
    addStringToObject(xitReq, "program", "exit");
    addItemToObject(xitReq, "args", exitArgs);
    string xitReply = roundTrip(app, "p18", requestText("proc.run", xitReq));
    check("a non-zero exit code is a result, not an error", startsWith(xitReply, "0 {\"exitCode\":7,") && containsText(xitReply, "\"timedOut\":false"));

    Item sleepArgs = createObject();
    addNumberToObject(sleepArgs, "ms", 20000.0);
    addStringToObject(sleepArgs, "dir", pbase);
    Item slReq = createObject();
    addStringToObject(slReq, "program", "sleepy");
    addItemToObject(slReq, "args", sleepArgs);
    string slReply = roundTrip(app, "p19", requestText("proc.run", slReq));
    check("a program over its time limit is killed", startsWith(slReply, "0 {\"exitCode\":-1,") && containsText(slReply, "\"timedOut\":true"));

    Item bigArgs2 = createObject();
    addNumberToObject(bigArgs2, "n", 1000000.0);
    addStringToObject(bigArgs2, "dir", pbase);
    Item bgReq = createObject();
    addStringToObject(bgReq, "program", "big");
    addItemToObject(bgReq, "args", bigArgs2);
    string bgReply = roundTrip(app, "p20", requestText("proc.run", bgReq));
    check("output beyond the cap is cut and says so", containsText(bgReply, "\"truncated\":{\"stdout\":true,\"stderr\":false}") && bgReply.length() < 2000);

    Item bytesArgs = createObject();
    addStringToObject(bytesArgs, "hex", "41ff42");
    addStringToObject(bytesArgs, "dir", pbase);
    Item byReq = createObject();
    addStringToObject(byReq, "program", "bytes");
    addItemToObject(byReq, "args", bytesArgs);
    string byReply = roundTrip(app, "p21", requestText("proc.run", byReq));
    check("output that is not UTF-8 is cleaned and flagged", containsText(byReply, "\"lossy\":true") && containsText(byReply, "A") && startsWith(byReply, "0 {"));

    Item sleeperArgs = createObject();
    addStringToObject(sleeperArgs, "dir", pbase);
    Item spReq = createObject();
    addStringToObject(spReq, "program", "sleeper");
    addItemToObject(spReq, "args", sleeperArgs);
    string spReply = roundTrip(app, "p22", requestText("proc.run", spReq));
    check("something left running behind the program is killed", containsText(spReply, "left a sleeper") && containsText(spReply, "\"exitCode\":0"));

    Item cwdIn = createObject();
    addStringToObject(cwdIn, "dir", pbase + "/sub");
    Item cwReq = createObject();
    addStringToObject(cwReq, "program", "cwd");
    addItemToObject(cwReq, "args", cwdIn);
    check("the working folder is the one named", containsText(roundTrip(app, "p23", requestText("proc.run", cwReq)), "sub"));
    Item cwdOut = createObject();
    addStringToObject(cwdOut, "dir", pout);
    Item cwReq2 = createObject();
    addStringToObject(cwReq2, "program", "cwd");
    addItemToObject(cwReq2, "args", cwdOut);
    check("a working folder outside the allowed folders is forbidden", startsWith(roundTrip(app, "p24", requestText("proc.run", cwReq2)), "1 {\"code\":\"forbidden\""));
    Item cwdFile = createObject();
    addStringToObject(cwdFile, "dir", "f.txt");
    Item cwReq3 = createObject();
    addStringToObject(cwReq3, "program", "cwd");
    addItemToObject(cwReq3, "args", cwdFile);
    check("a file is not a working folder", startsWith(roundTrip(app, "p25", requestText("proc.run", cwReq3)), "1 {\"code\":\"not_directory\""));
    Item whereReq = createObject();
    addStringToObject(whereReq, "program", "where");
    check("without a working folder it is the first allowed folder", containsText(roundTrip(app, "p26", requestText("proc.run", whereReq)), "app-cling-"));

    // many at once: the pool serves them, every one is answered with its own result
    int pn = 0;
    while (pn < 24) {
        Item eachArgs = createObject();
        addNumberToObject(eachArgs, "code", double(pn));
        addStringToObject(eachArgs, "dir", pbase);
        Item eachReq = createObject();
        addStringToObject(eachReq, "program", "exit");
        addItemToObject(eachReq, "args", eachArgs);
        app_test_inject(app.handle, "q" + intToString(pn), requestText("proc.run", eachReq));
        pn = pn + 1;
    }
    drain(app, 100);
    int pmatched = 0;
    pn = 0;
    while (pn < 24) {
        string qid = "";
        int qst = 0;
        string qbody = "";
        if (app_test_take_response(app.handle, qid, qst, qbody) == 1 && qst == 0 && qid.length() >= 2) {
            int idx = 0;
            int pos = 1;
            while (pos < qid.length()) {
                idx = idx * 10 + (int(qid[pos]) - 48);
                pos = pos + 1;
            }
            if (startsWith(qbody, "{\"exitCode\":" + intToString(idx) + ",")) {
                pmatched = pmatched + 1;
            }
        }
        pn = pn + 1;
    }
    check("24 programs at once, each answered with its own exit code", pmatched == 24);

    // the environment: a program sees only the variables it was given
    std::vector<string> pEnv;
    pEnv.push_back("--env");
    pEnv.push_back("{name:token}");
    pEnv.push_back("@cwd={dir:folder}");
    app.allowProgram("envp", helper, pEnv, 5000, 1000);
    app_test_setenv("APP_CLING_SECRET", "hunter2");
    Item envArgs = createObject();
    addStringToObject(envArgs, "name", "APP_CLING_SECRET");
    addStringToObject(envArgs, "dir", pbase);
    Item envReq = createObject();
    addStringToObject(envReq, "program", "envp");
    addItemToObject(envReq, "args", envArgs);
    string hidden = roundTrip(app, "e1", requestText("proc.run", envReq));
    check("a variable of this process is not passed to a program", containsText(hidden, "(unset)") && !containsText(hidden, "hunter2"));
    check("a name with = cannot be passed on", !app.passEnvironment("A=B") && !app.passEnvironment(""));
    check("passEnvironment names a variable to pass", app.passEnvironment("APP_CLING_SECRET"));
    string shown = roundTrip(app, "e2", requestText("proc.run", envReq));
    check("then it arrives", containsText(shown, "hunter2") && !containsText(shown, "(unset)"));
    Item pathArgs2 = createObject();
    addStringToObject(pathArgs2, "name", "PATH");
    addStringToObject(pathArgs2, "dir", pbase);
    Item pathReq = createObject();
    addStringToObject(pathReq, "program", "envp");
    addItemToObject(pathReq, "args", pathArgs2);
    check("PATH is passed by default", !containsText(roundTrip(app, "e3", requestText("proc.run", pathReq)), "(unset)"));
    app.gate.clear();
    app_test_remove_tree(pbase);
    app_test_remove_tree(pout);

    // ---- watching folders: a watcher thread -> the call queue -> the main loop -> an event on the page -----
    app.enableWatchCommands();
    string wbase = "";
    app_test_make_temp_dir(wbase);
    app_test_mkdir_raw(wbase + "/outside");
    app_test_mkdir_raw(wbase + "/outside/watched");
    app_test_mkdir_raw(wbase + "/outside/granted");
    app.gate.clear();
    app.allowFolder(wbase + "/outside/watched");
    string trash = "";
    while (app_test_take_eval(app.handle, trash) == 1) { }

    Item watchArgs = pathArgs(wbase + "/outside/watched");
    string watchReply = roundTrip(app, "w1", requestText("fs.watch", watchArgs));
    check("fs.watch answers the watch id", startsWith(watchReply, "0 {\"id\":") );
    check("a folder outside the allowed ones cannot be watched", startsWith(roundTrip(app, "w2", requestText("fs.watch", pathArgs(wbase + "/outside"))), "1 {\"code\":\"forbidden\""));
    check("a missing folder is not_found", startsWith(roundTrip(app, "w3", requestText("fs.watch", pathArgs(wbase + "/outside/watched/missing"))), "1 {\"code\":\"not_found\""));
    check("a dot-dot path is forbidden", startsWith(roundTrip(app, "w4", requestText("fs.watch", pathArgs("../"))), "1 {\"code\":\"forbidden\""));

    app_test_write_raw(wbase + "/outside/watched/made.txt", "hi");
    string allEvals = awaitEvals(app, "\"kind\":\"created\",\"path\":\"made.txt\"", 10000);
    string oneEval = "";
    check("a new file reaches the page as an event", containsText(allEvals, "window.__cling_emit([\"fs.change\",{\"watch\":") &&
          containsText(allEvals, "\"kind\":\"created\",\"path\":\"made.txt\""));
    check("the event carries a relative path only", !containsText(allEvals, wbase) && !containsText(allEvals, "app-cling-"));

    // a name that tries to break out of the script stays a string
    app_test_write_raw(wbase + "/outside/watched/a'b);alert(1);(.txt", "x");
    allEvals = awaitEvals(app, "alert(1)", 10000);
    check("a hostile file name stays inside a string literal", containsText(allEvals, "\"kind\":\"created\"") && containsText(allEvals, "alert(1)") && startsWith(allEvals, "window.__cling_emit([\"fs.change\",{"));

    check("unwatch with an unknown id is not_found", startsWith(roundTrip(app, "w5", requestText("fs.unwatch", watchIdArgs(999999))), "1 {\"code\":\"not_found\""));
    Item badUnwatch = createObject();
    addStringToObject(badUnwatch, "id", "1");
    check("unwatch needs a number", startsWith(roundTrip(app, "w6", requestText("fs.unwatch", badUnwatch)), "1 {\"code\":\"invalid_argument\""));
    string idText = watchReply.substr(6, watchReply.length() - 7);
    int watchNumber = int(decimalValue(idText));
    check("unwatch stops the watch", roundTrip(app, "w7", requestText("fs.unwatch", watchIdArgs(watchNumber))) == "0 null");
    app_test_write_raw(wbase + "/outside/watched/silent.txt", "x");
    app_test_sleep_ms(250);
    drain(app, 100);
    allEvals = "";
    while (app_test_take_eval(app.handle, oneEval) == 1) {
        allEvals = allEvals + oneEval;
    }
    check("after unwatch nothing arrives", !containsText(allEvals, "silent.txt"));

    // a pick is a grant, and a watch on it ends when the grant is withdrawn
    FsResult pickedFolder = app.gate.grantFolder(wbase + "/outside/granted");
    string revokedReply = roundTrip(app, "w8", requestText("fs.watch", pathArgs(pickedFolder.text)));
    check("the page can watch the folder the user granted", startsWith(revokedReply, "0 {\"id\":"));
    app.revokeGrants();
    app_test_write_raw(wbase + "/outside/granted/late.txt", "x");
    allEvals = awaitEvals(app, "access_revoked", 10000);
    check("withdrawing the permission ends the watch with a reason", containsText(allEvals, "\"kind\":\"stopped\",\"reason\":\"access_revoked\"") && !containsText(allEvals, "late.txt"));

    // the queue entry that signals a watch has an empty id: a page cannot produce one
    check("an injected call with an empty id is dropped", app_test_inject(app.handle, "", "[\"fs.list\",{\"path\":\".\"}]") == 3);

    app.gate.clear();
    app_test_remove_tree(wbase);

    // ---- watch records are merged and checked on the CeeLing side: records pushed by hand, no file system involved ----
    string mbase = "";
    app_test_make_temp_dir(mbase);
    app.allowFolder(mbase);
    FsResult mroot = app.gate.resolve(mbase, 2);
    app.watches.states.push_back(new WatchState(901, mroot.text));
    while (app_test_take_eval(app.handle, trash) == 1) { }
    int mk = 0;
    while (mk < 10) {
        app_test_push_internal(app.handle, watchRecord(901, "modified", "a.txt", ""));
        mk = mk + 1;
    }
    app_test_push_internal(app.handle, watchRecord(901, "created", "b.txt", ""));
    app_test_push_internal(app.handle, watchRecord(901, "modified", "a.txt", ""));
    app_test_push_internal(app.handle, watchRecord(901, "renamed", "c.txt", "d.txt"));
    app_test_push_internal(app.handle, watchRecord(901, "renamed", "c.txt", "d.txt"));
    app_test_push_internal(app.handle, watchRecord(902, "created", "nobody-watches-this.txt", ""));
    drain(app, 100);
    string merged = "";
    while (app_test_take_eval(app.handle, oneEval) == 1) {
        merged = merged + oneEval;
    }
    check("eleven modified records for one file are one event", countText(merged, "\"kind\":\"modified\",\"path\":\"a.txt\"") == 1);
    check("a created file is passed on", countText(merged, "\"kind\":\"created\",\"path\":\"b.txt\"") == 1);
    check("the same rename twice in a row is one event", countText(merged, "\"kind\":\"renamed\",\"path\":\"c.txt\",\"from\":\"d.txt\"") == 1);
    check("a record for a watch nobody started is dropped", !containsText(merged, "nobody-watches-this"));
    app_test_push_internal(app.handle, watchRecord(901, "overflow", "", ""));
    drain(app, 100);
    merged = "";
    while (app_test_take_eval(app.handle, oneEval) == 1) {
        merged = merged + oneEval;
    }
    check("an overflow record becomes an overflow event", containsText(merged, "\"watch\":901,\"kind\":\"overflow\"}"));
    app_test_push_internal(app.handle, watchRecord(901, "stopped", "folder_gone", ""));
    drain(app, 100);
    merged = "";
    while (app_test_take_eval(app.handle, oneEval) == 1) {
        merged = merged + oneEval;
    }
    check("a stopped record ends the watch with its reason", containsText(merged, "\"kind\":\"stopped\",\"reason\":\"folder_gone\"") && app.watches.indexOf(901) < 0);
    app_test_push_internal(app.handle, watchRecord(901, "created", "after.txt", ""));
    drain(app, 100);
    check("nothing arrives for a watch that has ended", app_test_take_eval(app.handle, oneEval) == 0);
    string hostile = "x";
    hostile.push_back(char(255));
    app.watches.states.push_back(new WatchState(903, mroot.text));
    app_test_push_internal(app.handle, watchRecord(903, "created", hostile, ""));
    drain(app, 100);
    check("a name that is not UTF-8 is not passed to the page", app_test_take_eval(app.handle, oneEval) == 0);
    app.watches.drop(app.watches.indexOf(903));

    // at most 32 folder watches at a time
    int wn = 0;
    int accepted = 0;
    string lastReply = "";
    while (wn < 34) {
        string reply = roundTrip(app, "lim" + intToString(wn), requestText("fs.watch", pathArgs(mbase)));
        if (startsWith(reply, "0 {\"id\":")) {
            accepted = accepted + 1;
        } else {
            lastReply = reply;
        }
        wn = wn + 1;
    }
    check("at most 32 folders can be watched", accepted >= 28 && accepted <= 32 && startsWith(lastReply, "1 {\"code\":\"too_many\""));
    app.gate.clear();
    app_test_remove_tree(mbase);

    // ---- what a page may send ---------------------------------------------------------------------------
    check("the limits must be sensible", !app.setRequestLimits(10, 10) && !app.setRequestLimits(4096, 0) && app.setRequestLimits(4194304, 256));
    app_limits(app.handle, 1024, 3);
    string bigRequest = "[\"echo\",\"" + repeated("x", 2000) + "\"]";
    check("a call over the size limit is refused", app_test_inject(app.handle, "big1", bigRequest) == 1);
    string refusedId = "";
    int refusedStatus = 0;
    string refusedJson = "";
    check("and answered at once, without reaching a command", app_test_take_response(app.handle, refusedId, refusedStatus, refusedJson) == 1 && refusedId == "big1" && refusedStatus == 1 &&
          startsWith(refusedJson, "{\"code\":\"too_large\"") && !containsText(refusedJson, "xxxx"));
    drain(app, 200);          // (the 32 watches above end now that their folder is gone; their records are served first)
    int qn = 0;
    int accepted2 = 0;
    int refusedBusy = 0;
    while (qn < 6) {
        int r2 = app_test_inject(app.handle, "fl" + intToString(qn), "[\"add\",[1,1]]");
        if (r2 == 0) {
            accepted2 = accepted2 + 1;
        }
        if (r2 == 2) {
            refusedBusy = refusedBusy + 1;
        }
        qn = qn + 1;
    }
    check("with 3 waiting, the rest of a flood is refused", accepted2 == 3 && refusedBusy == 3);
    int busyAnswers = 0;
    int plainAnswers = 0;
    qn = 0;
    while (qn < 6) {
        if (qn == 3) {
            drain(app, 100);
        }
        string fid = "";
        int fst = 0;
        string fbody = "";
        if (app_test_take_response(app.handle, fid, fst, fbody) == 1) {
            if (startsWith(fbody, "{\"code\":\"busy\"")) {
                busyAnswers = busyAnswers + 1;
            } else if (fbody == "2") {
                plainAnswers = plainAnswers + 1;
            }
        }
        qn = qn + 1;
    }
    check("three get the busy answer, the three that were queued get their results", busyAnswers == 3 && plainAnswers == 3);
    string longId = repeated("i", 65);
    check("an id the page could not have been given is refused", app_test_inject(app.handle, longId, "[\"add\",[1,1]]") == 3);
    app_limits(app.handle, 4194304, 256);
    string bigReply = roundTrip(app, "ok1", bigRequest);
    check("after raising the limit the same call goes through", startsWith(bigReply, "0 ") && bigReply.length() > 2000);

    // ---- navigation ---------------------------------------------------------------------------------------
    check("an allowed address needs a scheme", !app.allowNavigation("x") && !app.allowNavigation(""));
    check("allowNavigation takes a prefix", app.allowNavigation("http://localhost:5173/"));
    string blockedRecord = "window";
    blockedRecord.push_back(char(0));
    blockedRecord = blockedRecord + "navigation_blocked";
    blockedRecord.push_back(char(0));
    blockedRecord = blockedRecord + "https://evil.example/\"><script>";
    blockedRecord.push_back(char(0));
    while (app_test_take_eval(app.handle, oneEval) == 1) { }
    app_test_push_internal(app.handle, blockedRecord);
    drain(app, 100);
    string blockedEvent = "";
    app_test_take_eval(app.handle, blockedEvent);
    check("a refused navigation reaches the application as an event", startsWith(blockedEvent, "window.__cling_emit([\"window.navigationBlocked\",{\"url\":\"https://evil.example/") &&
          containsText(blockedEvent, "\\\"><script>"));

    // ---- one answer per call, cancelling, timeouts, shutdown ---------------------------------------------
    check("a page call is answered once: the second and third answers are dropped", roundTrip(app, "z1", "[\"adouble\"]") == "0 \"first\"");
    app_test_sleep_ms(200);
    check("and nothing else arrives", app_test_response_ready(app.handle) == 0);
    check("an answer for a call nobody made is dropped", app_return(app.handle, "never-asked", 0, "1") == 0);

    string cbase = "";
    app_test_make_temp_dir(cbase);
    app.allowFolder(cbase);
    std::vector<string> pNap;
    pNap.push_back("--sleep");
    pNap.push_back("{ms:int:0:60000}");
    pNap.push_back("@cwd={dir:folder}");
    check("a program that can run for a long time", app.allowProgram("napper", helper, pNap, 30000, 1000));
    Item napArgs = createObject();
    addNumberToObject(napArgs, "ms", 20000.0);
    addStringToObject(napArgs, "dir", cbase);
    Item napReq = createObject();
    addStringToObject(napReq, "program", "napper");
    addItemToObject(napReq, "args", napArgs);
    string napBody = requestText("proc.run", napReq);

    // the page abandons a call (its AbortSignal): the program is killed and the call ends {code: cancelled}
    string tagged = napBody.substr(0, napBody.length() - 1) + ",\"tag-1\"]";
    double cancelStarted = app_now_ms();
    app_test_inject(app.handle, "n1", tagged);
    app.serveOne(300);
    app_test_inject(app.handle, "n2", "[\"$cancel\",\"tag-1\"]");
    int waitedFor = 0;
    while (app_test_response_ready(app.handle) == 0 && waitedFor < 200) {
        app.serveOne(50);
        waitedFor = waitedFor + 1;
    }
    string cancelFirstId = "";
    int cancelFirstStatus = 0;
    string cancelFirstBody = "";
    app_test_take_response(app.handle, cancelFirstId, cancelFirstStatus, cancelFirstBody);
    drain(app, 200);
    string cancelSecondId = "";
    int cancelSecondStatus = 0;
    string cancelSecondBody = "";
    if (app_test_response_ready(app.handle) == 1) {
        app_test_take_response(app.handle, cancelSecondId, cancelSecondStatus, cancelSecondBody);
    }
    bool cancelAnswered = (cancelFirstId == "n1" && startsWith(cancelFirstBody, "{\"code\":\"cancelled\"")) || (cancelSecondId == "n1" && startsWith(cancelSecondBody, "{\"code\":\"cancelled\""));
    check("$cancel ends a running program's call with {code: cancelled}, long before the program would have", cancelAnswered && app_now_ms() - cancelStarted < 8000.0);
    check("an unknown tag is ignored", roundTrip(app, "n3", "[\"$cancel\",\"no-such-tag\"]") == "0 null");

    // a deadline: answered timed_out, the program is killed, the late answer is dropped
    check("a timeout is a sensible number", !app.setAsyncTimeout("proc.run", 10) && !app.setAsyncTimeout("proc.run", -1) && app.setAsyncTimeout("proc.run", 500));
    cancelStarted = app_now_ms();
    string timedOut = roundTrip(app, "t1", napBody);
    check("a call over its deadline is answered timed_out", startsWith(timedOut, "1 {\"code\":\"timed_out\"") && app_now_ms() - cancelStarted < 8000.0);
    app_test_sleep_ms(400);
    drain(app, 200);
    check("and the program's own late answer is not delivered", app_test_response_ready(app.handle) == 0);
    app.setAsyncTimeout("proc.run", 0);

    // cooperative work stops on its own when the call times out, and says so
    string mark = cbase + "/cooperative.mark";
    app.setAsyncTimeout("acoop", 300);
    Item coopArgs = createArray();
    addItemToArray(coopArgs, createString(mark));
    string coop = roundTrip(app, "c1", requestText("acoop", coopArgs));
    check("work that checks callCancelled is answered timed_out", startsWith(coop, "1 {\"code\":\"timed_out\""));
    int markWait = 0;
    while (app_test_exists(mark) == 0 && markWait < 100) {
        app_test_sleep_ms(20);
        markWait = markWait + 1;
    }
    check("and stopped by itself soon after (it left its mark long before its 6 s)", app_test_exists(mark) == 1);
    drain(app, 100);
    app.setAsyncTimeout("acoop", 0);

    // closing the window while a program runs: it is killed, the jobs end, nothing waits for 20 seconds
    App closing = new App();
    closing.open("t4", 100, 100, "<html></html>", "", false);
    closing.allowFolder(cbase);
    closing.allowProgram("napper", helper, pNap, 30000, 1000);
    closing.enableProcessCommands();
    app_test_inject(closing.handle, "k1", napBody);
    closing.serveOne(300);
    cancelStarted = app_now_ms();
    app_test_close_window(closing.handle);
    closing.run();
    check("closing the window ends the loop and cancels what was running", app_cancelled_after_close(closing.handle));
    closing.close();
    app_test_sleep_ms(100);
    check("the program that was running is already dead (the job ended long before 20 s)", app_now_ms() - cancelStarted < 8000.0);
    app.gate.clear();
    app_test_remove_tree(cbase);

    // ---- the native runner checks nothing: toolRunOk is the one place that vets what it is given ----
    string vetDir = "";
    app_test_make_temp_dir(vetDir);
    ToolRun vetGood = app.toolRun(helper, emptyArgs(), vetDir, 5000, 1000);
    check("a run with absolute paths and sane limits is fit to pass", toolRunOk(vetGood));
    check("a relative program is not", !toolRunOk(app.toolRun("relative-program", emptyArgs(), vetDir, 5000, 1000)));
    check("a relative working folder is not", !toolRunOk(app.toolRun(helper, emptyArgs(), "relative/dir", 5000, 1000)));
    string withNul = "a";
    withNul.push_back(char(0));
    std::vector<string> nulArgs;
    nulArgs.push_back(withNul);
    check("an argument with a NUL byte is not", !toolRunOk(app.toolRun(helper, nulArgs, vetDir, 5000, 1000)));
    std::vector<string> badUtf8Args;
    string broken = "a";
    broken.push_back(char(255));
    badUtf8Args.push_back(broken);
    check("an argument that is not UTF-8 is not", !toolRunOk(app.toolRun(helper, badUtf8Args, vetDir, 5000, 1000)));
    ToolRun vetEnv = app.toolRun(helper, emptyArgs(), vetDir, 5000, 1000);
    vetEnv.env.push_back("NO_EQUALS_SIGN");
    check("an environment entry without = is not", !toolRunOk(vetEnv));
    check("a timeout of zero is not", !toolRunOk(app.toolRun(helper, emptyArgs(), vetDir, 0, 1000)));
    check("a timeout beyond ten minutes is not", !toolRunOk(app.toolRun(helper, emptyArgs(), vetDir, 700000, 1000)));
    check("an output cap beyond 64 MiB is not", !toolRunOk(app.toolRun(helper, emptyArgs(), vetDir, 5000, 67108865)));
    check("runTool refuses what is not fit, without starting anything", runTool(app.toolRun("relative-program", emptyArgs(), vetDir, 5000, 1000)).status == 5);
    app_test_remove_tree(vetDir);

    // ---- arguments decoded into a struct by the compiler ------------------------------------------------
    string okTags = "[\"a\",\"b\"]";
    string okMore = "[{\"x\":5,\"y\":6}]";
    check("a struct is filled from the page's object (extra keys ignored)", roundTrip(app, "d1", "[\"decoded\"," + demoJson("3", okTags, "2", okMore) + "]") == "0 \"n:3:2:2:1:flag\"");
    check("a missing field is refused by name", roundTrip(app, "d2", "[\"decoded\",{\"count\":1}]") == "1 {\"code\":\"invalid_argument\",\"message\":\"`name` must be a string\"}");
    check("a field of the wrong type is refused", roundTrip(app, "d3", "[\"decoded\"," + demoJson("\"3\"", okTags, "2", okMore) + "]") == "1 {\"code\":\"invalid_argument\",\"message\":\"`count` must be a number\"}");
    check("a fractional number is not an int", startsWith(roundTrip(app, "d4", "[\"decoded\"," + demoJson("1.5", okTags, "2", okMore) + "]"), "1 {\"code\":\"invalid_argument\",\"message\":\"`count` must be a whole number"));
    check("a number beyond int is refused, not wrapped", startsWith(roundTrip(app, "d5", "[\"decoded\"," + demoJson("1e20", okTags, "2", okMore) + "]"), "1 {\"code\":\"invalid_argument\",\"message\":\"`count` must be a whole number"));
    check("an array element of the wrong type is named", roundTrip(app, "d6", "[\"decoded\"," + demoJson("3", "[\"a\",7]", "2", okMore) + "]") == "1 {\"code\":\"invalid_argument\",\"message\":\"`tags[1]` must be a string\"}");
    check("a nested field is named with its path", roundTrip(app, "d7", "[\"decoded\"," + demoJson("3", okTags, "false", okMore) + "]") == "1 {\"code\":\"invalid_argument\",\"message\":\"`spot.y` must be a number\"}");
    check("a struct inside an array is named with its path", roundTrip(app, "d8", "[\"decoded\"," + demoJson("3", okTags, "2", "[{\"x\":5}]") + "]") == "1 {\"code\":\"invalid_argument\",\"message\":\"`more[0].y` must be a number\"}");
    check("arguments that are not an object are refused", roundTrip(app, "d9", "[\"decoded\",[1]]") == "1 {\"code\":\"invalid_argument\",\"message\":\"expected an object\"}");
    check("no arguments at all are refused", roundTrip(app, "d10", "[\"decoded\"]") == "1 {\"code\":\"invalid_argument\",\"message\":\"expected an object\"}");

    // ---- a worker asks the main thread through Channels ---------------------------------------------------
    string pumpDir = "";
    app_test_make_temp_dir(pumpDir);
    app.allowFolder(pumpDir);
    app_test_write_raw(pumpDir + "/note.txt", "pumped text");
    Item pumpArgs = createArray();
    addItemToArray(pumpArgs, createString(pumpDir + "/note.txt"));
    check("a worker reads an allowed file through the main thread's pump", roundTrip(app, "p1", requestText("viapump", pumpArgs)) == "0 \"pumped text\"");
    Item pumpOutside = createArray();
    addItemToArray(pumpOutside, createString(pumpDir + "/../nope.txt"));
    check("the pump applies the file policy: a path outside the allowed folders is refused", roundTrip(app, "p2", requestText("viapump", pumpOutside)) == "0 \"ERR\"");
    check("pumps are registered by a plain name; an empty one is refused", app.onPump("other", closure Pump [] (FileGate gate) { }) && !app.onPump("", closure Pump [] (FileGate gate) { }));
    app_test_remove_tree(pumpDir);

    // a producer thread and this thread use one Channel at the same time (TSan watches this one: see tests/run_sanitizers.sh, control 3)
    Channel<int> stream;
    spawn(closure Job [stream] () {
        int n = 0;
        while (n < 500) {
            while (!stream.send(n)) {
                app_test_sleep_ms(1);
            }
            n = n + 1;
        }
        stream.close();
    });
    int streamed = 0;
    int streamSum = 0;
    while (stream.wait(5000)) {
        streamSum = streamSum + stream.take();
        streamed = streamed + 1;
    }
    check("a Channel carries 500 values from a producer thread, in order, with no loss", streamed == 500 && streamSum == 124750);


    // ---- development server addresses ---------------------------------------------------------------------
    check("localhost with a port is a development server", devServerOrigin("http://localhost:5173/") == "http://localhost:5173");
    check("the path after the host does not matter", devServerOrigin("http://127.0.0.1:3000/app/index.html?x=1") == "http://127.0.0.1:3000");
    check("no port is fine", devServerOrigin("http://localhost") == "http://localhost");
    check("IPv6 loopback", devServerOrigin("http://[::1]:8080/") == "http://[::1]:8080");
    check("another host is refused", devServerOrigin("http://example.com/") == "");
    check("a host that merely starts with localhost is refused", devServerOrigin("http://localhost.evil.test:80/") == "");
    check("a user name in front of the host is refused", devServerOrigin("http://localhost@evil.test/") == "");
    check("https is refused", devServerOrigin("https://localhost:5173/") == "");
    check("a port out of range is refused", devServerOrigin("http://localhost:70000/") == "" && devServerOrigin("http://localhost:0/") == "" && devServerOrigin("http://localhost:abc/") == "");
    check("an empty port is refused", devServerOrigin("http://localhost:/") == "");
    App dev = new App();
    check("openDevServer refuses a stranger's address", !dev.openDevServer("t", 100, 100, "http://example.com/"));
    check("openDevServer opens a local one", dev.openDevServer("t", 100, 100, "http://localhost:5173/"));
    dev.close();

    // ---- several windows in one application ---------------------------------------------------------------
    App mw = new App();
    CallContext mwd = mw.dispatcher.caller;
    mw.command("who", closure Command [mwd] (Item args) {
        return createNumber(double(mwd.handle));
    });
    mw.command("echo", closure Command [] (Item args) {
        return args;
    });
    mw.asyncCommand("aspin", closure AsyncCommand [] (Item args, string id, int handle) {
        spawn(closure Job [id, handle] () {
            int waited = 0;
            while (!callCancelled(handle, id) && waited < 1500) {
                app_test_sleep_ms(10);
                waited = waited + 10;
            }
            if (callCancelled(handle, id)) {
                replyOk(handle, id, "\"cancelled\"");
            } else {
                replyOk(handle, id, "\"timeout\"");
            }
        });
    });
    mw.asyncCommand("ahandle", closure AsyncCommand [] (Item args, string id, int handle) {
        spawn(closure Job [id, handle] () {
            app_test_sleep_ms(30);
            replyOk(handle, id, intToString(handle));
        });
    });
    string mwDir = "";
    app_test_make_temp_dir(mwDir);
    mw.allowFolder(mwDir);
    mw.enableFileCommands(1000);
    mw.enableWatchCommands();
    mw.enableWindowCommands();
    check("no window is open before open", mw.windows.count() == 0 && mw.handle == 0 && mw.serveOne(10) == 0);
    check("the first window opens and is the primary one", mw.open("a", 100, 100, "<html></html>", "", false) && mw.windows.count() == 1);
    int wa = mw.handle;
    int wb = mw.openWindow("b", 100, 100, false, "");
    int wc = mw.openWindow("c", 100, 100, false, "");
    check("more windows open; each has its own handle", wb != 0 && wc != 0 && wa != wb && wb != wc && wa != wc && mw.windows.count() == 3);
    check("the first stays the primary window", mw.handle == wa);
    check("a path that is not in a site is refused", mw.openWindow("x", 100, 100, false, "/second.html") == 0 && mw.openWindow("x", 100, 100, false, "http://example.com/") == 0);

    check("a sync command learns which window called it (a)", roundTripOn(mw, wa, "1", "[\"who\"]") == "0 " + intToString(wa));
    check("a sync command learns which window called it (b), with the same call id", roundTripOn(mw, wb, "1", "[\"who\"]") == "0 " + intToString(wb));
    check("outside a command nobody is calling", mwd.handle == 0);

    // the same call id in flight in two windows at once: each page gets its own answer
    app_test_inject(wa, "same", "[\"ahandle\"]");
    app_test_inject(wb, "same", "[\"ahandle\"]");
    app_test_inject(wc, "same", "[\"ahandle\"]");
    string ansA = answerOn(mw, wa);
    string ansB = answerOn(mw, wb);
    string ansC = answerOn(mw, wc);
    check("one async call id in three windows is answered three times, each to its own window", ansA == "0 " + intToString(wa) && ansB == "0 " + intToString(wb) && ansC == "0 " + intToString(wc));

    // a cancel tag only names a call of the window that sent it
    app_test_inject(wa, "spinA", "[\"aspin\",null,\"t\"]");
    app_test_inject(wb, "spinB", "[\"aspin\",null,\"t\"]");
    mw.serveOne(200);
    mw.serveOne(200);
    // (the cancel call is answered "null" and the cancelled call "cancelled", in either order: the worker may notice the cancel before the main loop has
    // sent the answer to the $cancel call itself)
    app_test_inject(wb, "stop", "[\"$cancel\",\"t\"]");
    string firstB = answerOn(mw, wb);
    string secondB = answerOn(mw, wb);
    check("cancelling tag t from window b ends b's call", (firstB == "0 \"cancelled\"" && secondB == "0 null") || (firstB == "0 null" && secondB == "0 \"cancelled\""));
    check("and leaves a's call with the same tag and id running", app_test_response_ready(wa) == 0);
    app_test_inject(wa, "stop", "[\"$cancel\",\"t\"]");
    string firstA = answerOn(mw, wa);
    string secondA = answerOn(mw, wa);
    check("a's own cancel ends it", (firstA == "0 \"cancelled\"" && secondA == "0 null") || (firstA == "0 null" && secondA == "0 \"cancelled\""));

    // a Later is registered for one window's call id
    Counted tally = new Counted();
    mw.later(wa, "pending", closure Later [tally] (int h, string callId, int status, string payload) {
        tally.count = tally.count + 1;
        tally.last = "a:" + payload;
    });
    mw.later(wb, "pending", closure Later [tally] (int h, string callId, int status, string payload) {
        tally.count = tally.count + 1;
        tally.last = "b:" + payload;
    });
    string lrec = "later";
    lrec.push_back(char(0));
    lrec = lrec + "pending";
    lrec.push_back(char(0));
    lrec = lrec + "1";
    lrec.push_back(char(0));
    lrec = lrec + "x";
    lrec.push_back(char(0));
    app_test_push_internal(wb, lrec);
    drain(mw, 100);
    check("a record for window b settles b's pending call only", tally.count == 1 && tally.last == "b:x");
    app_test_push_internal(wa, lrec);
    drain(mw, 100);
    check("and a's own record settles a's", tally.count == 2 && tally.last == "a:x");

    // watches belong to the window that started them (32 each, and one window cannot stop another's)
    Item watched = createObject();
    addStringToObject(watched, "path", mwDir);
    string startedA = roundTripOn(mw, wa, "w1", requestText("fs.watch", watched));
    string startedB = roundTripOn(mw, wb, "w1", requestText("fs.watch", watched));
    check("a watch starts in window a and another in window b", startsWith(startedA, "0 {\"id\":") && startsWith(startedB, "0 {\"id\":"));
    int idA = int(decimalValue(startedA.substr(8, startedA.length() - 9)));
    int idB = int(decimalValue(startedB.substr(8, startedB.length() - 9)));
    Item stopA = createObject();
    addNumberToObject(stopA, "id", double(idA));
    Item stopB = createObject();
    addNumberToObject(stopB, "id", double(idB));
    check("window b cannot stop a's watch", roundTripOn(mw, wb, "w2", requestText("fs.unwatch", stopA)) == "1 {\"code\":\"not_found\",\"message\":\"no such watch\"}");
    check("window a can stop its own", roundTripOn(mw, wa, "w3", requestText("fs.unwatch", stopA)) == "0 null");
    check("and b its own", roundTripOn(mw, wb, "w3", requestText("fs.unwatch", stopB)) == "0 null");
    check("each window's book is its own", mw.windows.get(wa).watches.states.size() == 0);

    // command lists: the application's default and a window's own
    std::vector<string> noCommands;
    mw.allowOnlyCommands(noCommands);
    check("an empty default list closes every window", startsWith(roundTripOn(mw, wa, "d1", "[\"who\"]"), "1 {\"code\":\"forbidden\"") && startsWith(roundTripOn(mw, wc, "d1", "[\"who\"]"), "1 {\"code\":\"forbidden\""));
    Window winB = mw.windows.get(wb);
    std::vector<string> onlyWho;
    onlyWho.push_back("who");
    check("a window can have a list of its own", winB.allowOnlyCommands(onlyWho));
    check("it then calls what its own list allows", roundTripOn(mw, wb, "d2", "[\"who\"]") == "0 " + intToString(wb));
    check("and nothing else", startsWith(roundTripOn(mw, wb, "d3", "[\"echo\",1]"), "1 {\"code\":\"forbidden\""));
    check("another window keeps the default", startsWith(roundTripOn(mw, wc, "d4", "[\"who\"]"), "1 {\"code\":\"forbidden\""));
    std::vector<string> everything;
    everything.push_back("who");
    everything.push_back("echo");
    everything.push_back("ahandle");
    everything.push_back("aspin");
    everything.push_back("window.setTitle");
    everything.push_back("fs.watch");
    everything.push_back("fs.unwatch");
    mw.allowOnlyCommands(everything);
    check("the default list can be widened again", roundTripOn(mw, wa, "d5", "[\"echo\",7]") == "0 7");
    check("a window with a list of its own is not affected by it", startsWith(roundTripOn(mw, wb, "d6", "[\"echo\",7]"), "1 {\"code\":\"forbidden\""));

    // window.* acts on the window that called it
    Item mwTitle = createObject();
    addStringToObject(mwTitle, "title", "renamed");
    string mwLog = "";
    while (app_test_take_window_log(wa, mwLog) == 1) { }
    while (app_test_take_window_log(wc, mwLog) == 1) { }
    roundTripOn(mw, wc, "t1", requestText("window.setTitle", mwTitle));
    check("window.setTitle renames the window that asked", app_test_take_window_log(wc, mwLog) == 1 && mwLog == "title|renamed");
    check("and no other", app_test_take_window_log(wa, mwLog) == 0);

    // an event for everyone
    string mwEval = "";
    while (app_test_take_eval(wa, mwEval) == 1) { }
    while (app_test_take_eval(wb, mwEval) == 1) { }
    while (app_test_take_eval(wc, mwEval) == 1) { }
    check("emit reaches every open window", mw.emit("tick", "1") && app_test_take_eval(wa, mwEval) == 1 && app_test_take_eval(wb, mwEval) == 1 && app_test_take_eval(wc, mwEval) == 1);
    Window winC = mw.windows.get(wc);
    winC.emit("only", "2");
    check("Window.emit reaches one", app_test_take_eval(wc, mwEval) == 1 && app_test_take_eval(wa, mwEval) == 0 && app_test_take_eval(wb, mwEval) == 0);

    // a page asks for a window (refusals here; a real opening needs a site, see tests/site_main.clg)
    check("window.open is not registered until it is enabled", startsWith(roundTripOn(mw, wa, "o0", "[\"window.open\",{\"start\":\"/x.html\"}]"), "1 {\"code\":\"forbidden\"") || startsWith(roundTripOn(mw, wa, "o0b", "[\"window.open\",{\"start\":\"/x.html\"}]"), "1 {\"code\":\"unknown_command\""));
    check("the cap must be sensible", !mw.enableWindowOpenCommand(0) && !mw.enableWindowOpenCommand(33) && mw.enableWindowOpenCommand(3));
    std::vector<string> noneAtAll;
    mw.allowOnlyCommands(noneAtAll);
    check("a default list that does not name window.open keeps it closed", startsWith(roundTripOn(mw, wa, "o1", "[\"window.open\",{\"start\":\"/x.html\"}]"), "1 {\"code\":\"forbidden\""));
    std::vector<string> openOnly;
    openOnly.push_back("window.open");
    mw.allowOnlyCommands(openOnly);
    check("a start outside the site is refused", startsWith(roundTripOn(mw, wa, "o2", "[\"window.open\",{\"start\":\"http://example.com/\"}]"), "1 {\"code\":\"invalid_argument\"") && startsWith(roundTripOn(mw, wa, "o3", "[\"window.open\",{\"start\":\"/../secret.html\"}]"), "1 {\"code\":\"invalid_argument\""));
    check("a start must be given", startsWith(roundTripOn(mw, wa, "o4", "[\"window.open\",{}]"), "1 {\"code\":\"invalid_argument\""));
    check("a size out of range is refused", startsWith(roundTripOn(mw, wa, "o5", "[\"window.open\",{\"start\":\"/x.html\",\"width\":50}]"), "1 {\"code\":\"invalid_argument\""));
    check("a fractional size is not a whole number", startsWith(roundTripOn(mw, wa, "o5b", "[\"window.open\",{\"start\":\"/x.html\",\"width\":800.5}]"), "1 {\"code\":\"invalid_argument\",\"message\":\"`width` must be a whole number"));
    check("three windows are open and the cap is three: no more", startsWith(roundTripOn(mw, wa, "o6", "[\"window.open\",{\"start\":\"/x.html\"}]"), "1 {\"code\":\"too_many\""));

    // closing windows one by one
    std::vector<string> echoOnly;
    echoOnly.push_back("echo");
    mw.allowOnlyCommands(echoOnly);
    app_test_close_window(wb);
    drain(mw, 50);
    check("two windows are left after b closed", mw.windows.count() == 2 && mw.handle == wa);
    check("window a still works", roundTripOn(mw, wa, "e1", "[\"echo\",3]") == "0 3");
    app_test_close_window(wa);
    drain(mw, 50);
    check("when the primary closes the next window becomes the primary", mw.windows.count() == 1 && mw.handle == wc);
    check("window c still works", roundTripOn(mw, wc, "e2", "[\"echo\",4]") == "0 4");
    app_test_close_window(wc);
    check("when the last window closes serveOne reports it", mw.serveOne(500) == 0 && mw.windows.count() == 0);
    mw.close();
    app_test_remove_tree(mwDir);

    // ---- a window's own list of commands ----------------------------------------------------------------
    App narrow = new App();
    narrow.command("add", closure Command [] (Item args) {
        return createNumber(numberAt(args, 0) + numberAt(args, 1));
    });
    narrow.command("echo", closure Command [] (Item args) {
        return args;
    });
    narrow.asyncCommand("aecho", closure AsyncCommand [] (Item args, string id, int handle) {
        replyOk(handle, id, "\"async\"");
    });
    narrow.open("t5", 100, 100, "<html></html>", "", false);
    check("before a list every registered command is open", roundTrip(narrow, "w1", "[\"echo\",1]") == "0 1");
    std::vector<string> typo;
    typo.push_back("add");
    typo.push_back("ad");
    check("a name that is not registered is refused, and nothing changes", !narrow.allowOnlyCommands(typo) && roundTrip(narrow, "w2", "[\"echo\",2]") == "0 2");
    std::vector<string> two;
    two.push_back("add");
    two.push_back("aecho");
    check("a list of registered names is accepted", narrow.allowOnlyCommands(two));
    check("a listed command works", roundTrip(narrow, "w3", "[\"add\",[2,3]]") == "0 5");
    check("a listed async command works", roundTrip(narrow, "w4", "[\"aecho\"]") == "0 \"async\"");
    check("a registered command that is not listed is forbidden", roundTrip(narrow, "w5", "[\"echo\",3]") == "1 {\"code\":\"forbidden\",\"message\":\"this window may not call that command\"}");
    check("an unknown name gets the same answer, so names cannot be probed", roundTrip(narrow, "w6", "[\"nope\",3]") == "1 {\"code\":\"forbidden\",\"message\":\"this window may not call that command\"}");
    check("cancelling is always allowed", roundTrip(narrow, "w7", "[\"$cancel\",\"x\"]") == "0 null");
    std::vector<string> nothing;
    check("an empty list closes everything", narrow.allowOnlyCommands(nothing) && startsWith(roundTrip(narrow, "w8", "[\"add\",[1,1]]"), "1 {\"code\":\"forbidden\""));
    narrow.close();

    // ---- window control -------------------------------------------------------------------------------
    app.enableWindowCommands();
    string wl = "";
    while (app_test_take_window_log(app.handle, wl) == 1) { }
    Item titleArgs = createObject();
    addStringToObject(titleArgs, "title", "Report - draft");
    check("window.setTitle", roundTrip(app, "k1", requestText("window.setTitle", titleArgs)) == "0 null" && app_test_take_window_log(app.handle, wl) == 1 && wl == "title|Report - draft");
    Item emptyTitle = createObject();
    addStringToObject(emptyTitle, "title", "");
    check("an empty title is refused", startsWith(roundTrip(app, "k2", requestText("window.setTitle", emptyTitle)), "1 {\"code\":\"invalid_argument\"") && app_test_take_window_log(app.handle, wl) == 0);
    Item longWindowTitle = createObject();
    addStringToObject(longWindowTitle, "title", repeated("t", 201));
    check("an over-long title is refused", startsWith(roundTrip(app, "k3", requestText("window.setTitle", longWindowTitle)), "1 {\"code\":\"invalid_argument\""));
    check("a title must be a string", startsWith(roundTrip(app, "k4", requestText("window.setTitle", createObject())), "1 {\"code\":\"invalid_argument\""));
    Item sizeArgs = createObject();
    addNumberToObject(sizeArgs, "width", 800.0);
    addNumberToObject(sizeArgs, "height", 600.0);
    check("window.setSize", roundTrip(app, "k5", requestText("window.setSize", sizeArgs)) == "0 null" && app_test_take_window_log(app.handle, wl) == 1 && wl == "size|800|600");
    Item tiny = createObject();
    addNumberToObject(tiny, "width", 10.0);
    addNumberToObject(tiny, "height", 600.0);
    check("a tiny window is refused", startsWith(roundTrip(app, "k6", requestText("window.setSize", tiny)), "1 {\"code\":\"invalid_argument\""));
    Item huge = createObject();
    addNumberToObject(huge, "width", 800.0);
    addNumberToObject(huge, "height", 100000.0);
    check("a huge window is refused", startsWith(roundTrip(app, "k7", requestText("window.setSize", huge)), "1 {\"code\":\"invalid_argument\""));
    Item textSize = createObject();
    addStringToObject(textSize, "width", "800");
    addNumberToObject(textSize, "height", 600.0);
    check("a size must be numbers", startsWith(roundTrip(app, "k8", requestText("window.setSize", textSize)), "1 {\"code\":\"invalid_argument\""));
    check("nothing reached the window for the refused ones", app_test_take_window_log(app.handle, wl) == 0);
    check("window.minimize", roundTrip(app, "k9", requestText("window.minimize", createObject())) == "0 null" && app_test_take_window_log(app.handle, wl) == 1 && wl == "state|1");
    check("window.maximize", roundTrip(app, "k10", requestText("window.maximize", createObject())) == "0 null" && app_test_take_window_log(app.handle, wl) == 1 && wl == "state|2");
    check("window.restore", roundTrip(app, "k11", requestText("window.restore", createObject())) == "0 null" && app_test_take_window_log(app.handle, wl) == 1 && wl == "state|0");
    check("window.focus", roundTrip(app, "k12", requestText("window.focus", createObject())) == "0 null" && app_test_take_window_log(app.handle, wl) == 1 && wl == "state|3");

    // closing with unsaved work asks first; the box is the application's, the page cannot change its text
    App second = new App();
    second.allowNavigation("http://localhost:5173/");
    second.open("t2", 100, 100, "<html></html>", "", false);
    check("the window is told which addresses it may load", app_test_take_window_log(second.handle, wl) == 1 && wl == "navigation|http://localhost:5173/");
    second.enableWindowCommands();
    Item dirtyArgs = createObject();
    addBoolToObject(dirtyArgs, "dirty", true);
    check("window.setDirty", roundTrip(second, "k13", requestText("window.setDirty", dirtyArgs)) == "0 null");
    check("confirmClose turns the guard on", second.confirmClose("Unsaved work", "Close without saving?") && app_test_take_window_log(second.handle, wl) == 1 && wl == "guard|1");
    app_test_dialog_push("button:4");
    app_test_close_window(second.handle);
    drain(second, 150);
    check("the box asks the application's question", latestRequest() == "message|Unsaved work|Close without saving?|3|2");
    check("answering no keeps the window open", second.serveOne(20) == 2);
    app_test_dialog_push("button:3");
    app_test_close_window(second.handle);
    drain(second, 150);
    check("answering yes closes it", second.serveOne(20) == 0);

    App third = new App();
    third.open("t3", 100, 100, "<html></html>", "", false);
    third.confirmClose("Unsaved work", "Close without saving?");
    latestRequest();
    app_test_close_window(third.handle);
    drain(third, 150);
    check("with nothing unsaved the close button closes at once, without asking", latestRequest() == "" && third.serveOne(20) == 0);

    drain(app, 300);          // (the watches above end now that their folder is gone; their records come first)
    check("without confirmClose the close button just closes", app_test_close_window(app.handle) == 1 && app.serveOne(20) == 0);
    app.window.handle = 0;
    return 0;
}
