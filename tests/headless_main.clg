#include "app.clh"

ext_fn int app_test_inject(int handle, string id, string request);
ext_fn int app_test_take_response(int handle, ref string id, ref int status, ref string json);
ext_fn int app_test_close_window(int handle);
ext_fn int app_test_take_eval(int handle, ref string js);
ext_fn int app_fs_test_make_temp_dir(ref string out);
ext_fn int app_fs_test_remove_tree(string path);
ext_fn int app_fs_test_make_dir_link(string link, string target);
ext_fn int app_fs_allow(string dir);
ext_fn int app_dialog_test_push(string answer);
ext_fn int app_dialog_test_take_request(ref string request);
ext_fn int app_proc_test_helper(ref string path);

void check(string name, bool ok) {
    if (ok) {
        std::cout << "PASS " << name << std::endl;
    } else {
        std::cout << "FAIL " << name << std::endl;
    }
}

bool containsText(string text, string needle) {
    int i = 0;
    while (i + needle.length() <= text.length()) {
        if (text.substr(i, needle.length()) == needle) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

string repeated(string unit, int times) {
    string out = "";
    int i = 0;
    while (i < times) {
        out = out + unit;
        i = i + 1;
    }
    return out;
}

// the most recent dialog request the shim saw (earlier ones are drained)
string latestRequest() {
    string last = "";
    string one = "";
    while (app_dialog_test_take_request(one) == 1) {
        last = one;
    }
    return last;
}

bool startsWith(string text, string prefix) {
    return text.length() >= prefix.length() && text.substr(0, prefix.length()) == prefix;
}

// {"path": p}
Item pathArgs(string p) {
    Item o = createObject();
    addStringToObject(o, "path", p);
    return o;
}

// The request text ["command", args]
string requestText(string command, Item args) {
    Item arr = createArray();
    addItemToArray(arr, createString(command));
    addItemToArray(arr, args);
    return printUnformatted(arr);
}

// Sends one request through the whole pipeline and returns "<status> <json>".
string roundTrip(App app, string id, string request) {
    app_test_inject(app.handle, id, request);
    app_test_close_window(app.handle);
    app.run();
    string gotId = "";
    int status = 0;
    string json = "";
    int r = app_test_take_response(app.handle, gotId, status, json);
    if (r != 1) {
        return "NO RESPONSE";
    }
    if (gotId != id) {
        return "WRONG ID " + gotId;
    }
    return intToString(status) + " " + json;
}

// a plain-value struct: copied into the worker, the main thread changes its own copy afterwards
struct Work {
public:
    int times;
    string word;
    std::vector<int> extra;
    Work(int t, string w) {
        times = t;
        word = w;
    }
};

// a flat class object: MOVED into the worker, which then owns it alone
class Tally {
public:
    int count;
    int total;
    std::vector<int> seen;
    Tally() {
        count = 0;
        total = 0;
    }
    void add(int x) {
        seen.push_back(x);
        count = count + 1;
        total = total + x;
    }
};

int main() {
    App app = new App();
    app.command("add", closure Command [] (Item args) {
        return createNumber(numberAt(args, 0) + numberAt(args, 1));
    });
    app.command("echo", closure Command [] (Item args) {
        return duplicate(args, true);
    });
    app.command("fail", closure Command [] (Item args) {
        throw "refused";
    });
    app.command("greet", closure Command [] (Item args) {
        return createString("hello, " + stringAt(args, 0));
    });
    app.command("field", closure Command [] (Item args) {
        return duplicate(fieldOf(args, "x"), true);
    });
    // async commands: the worker rebuilds its own JSON tree from a string and answers the page itself
    app.asyncCommand("aecho", closure AsyncCommand [] (Item args, string id, int handle) {
        string payload = printUnformatted(args);
        spawn(closure Job [payload, id, handle] () {
            Item mine = parse(payload);
            replyOk(handle, id, printUnformatted(mine));
        });
    });
    // args [milliseconds, tag]: answers the tag after sleeping
    app.asyncCommand("aslow", closure AsyncCommand [] (Item args, string id, int handle) {
        int ms = int(numberAt(args, 0));
        string tag = stringAt(args, 1);
        spawn(closure Job [ms, tag, id, handle] () {
            app_sleep_ms(ms);
            replyOk(handle, id, "\"" + tag + "\"");
        });
    });
    app.asyncCommand("afail", closure AsyncCommand [] (Item args, string id, int handle) {
        spawn(closure Job [id, handle] () {
            replyError(handle, id, "worker_failed", "the job gave up");
        });
    });
    // args [times, word]: the worker repeats the word; the struct is built here and COPIED into the job
    app.asyncCommand("arepeat", closure AsyncCommand [] (Item args, string id, int handle) {
        Work w = new Work(int(numberAt(args, 0)), stringAt(args, 1));
        w.extra.push_back(1);
        spawn(closure Job [w, id, handle] () {
            string out = "";
            int i = 0;
            while (i < w.times) {
                out = out + w.word;
                i = i + 1;
            }
            replyOk(handle, id, "\"" + out + "\"");
        });
        w.times = 0;
        w.word = "changed after spawn";
    });
    // args [numbers...]: the Tally is built here and moved into the worker, which replies with count and total
    app.asyncCommand("atally", closure AsyncCommand [] (Item args, string id, int handle) {
        Tally t = new Tally();
        int i = 0;
        while (i < getArraySize(args)) {
            t.add(int(numberAt(args, i)));
            i = i + 1;
        }
        spawn(closure Job [t, id, handle] () {
            replyOk(handle, id, "[" + intToString(t.count) + "," + intToString(t.total) + "]");
        });
    });
    // a job that throws: the dispatcher's default failure handler must answer the page with a rejection
    app.asyncCommand("athrow", closure AsyncCommand [] (Item args, string id, int handle) {
        spawn(closure Job [id] () {
            throw "kaboom";
        });
    });
    // args [milliseconds]: holds a slot of the worker pool for that long, counted by the shim's gauge
    app.asyncCommand("agauge", closure AsyncCommand [] (Item args, string id, int handle) {
        int ms = int(numberAt(args, 0));
        spawn(closure Job [ms, id, handle] () {
            app_gauge_enter();
            app_sleep_ms(ms);
            app_gauge_leave();
            replyOk(handle, id, "1");
        });
    });
    // emits from a worker thread through emitEvent, then replies
    app.asyncCommand("aemit", closure AsyncCommand [] (Item args, string id, int handle) {
        spawn(closure Job [id, handle] () {
            emitEvent(handle, "fromWorker", "{\"ok\":true}");
            replyOk(handle, id, "true");
        });
    });
    app.open("t", 100, 100, "<html></html>", "", false);

    check("add", roundTrip(app, "1", "[\"add\",[2,3]]") == "0 5");
    check("echo object", roundTrip(app, "2", "[\"echo\",{\"a\":[1,true,null]}]") == "0 {\"a\":[1,true,null]}");
    check("echo no args", roundTrip(app, "3", "[\"echo\"]") == "0 null");
    check("greet", roundTrip(app, "4", "[\"greet\",[\"web\"]]") == "0 \"hello, web\"");
    check("string with quote", roundTrip(app, "5", "[\"echo\",\"a\\\"b\"]") == "0 \"a\\\"b\"");

    check("unknown command", roundTrip(app, "6", "[\"nope\",1]") == "1 {\"code\":\"unknown_command\",\"message\":\"no command named nope\"}");
    check("bad json", roundTrip(app, "7", "[\"add\",") == "1 {\"code\":\"bad_request\",\"message\":\"the request is not valid JSON\"}");
    check("not an array", roundTrip(app, "8", "{\"add\":1}") == "1 {\"code\":\"bad_request\",\"message\":\"the request must be a JSON array [command, args]\"}");
    check("empty array", roundTrip(app, "9", "[]") == "1 {\"code\":\"bad_request\",\"message\":\"the request must be a JSON array [command, args]\"}");
    check("command not a string", roundTrip(app, "10", "[7,1]") == "1 {\"code\":\"bad_request\",\"message\":\"the command name must be a string\"}");

    check("handler throws", roundTrip(app, "11", "[\"fail\"]") == "1 {\"code\":\"command_failed\",\"message\":\"refused\"}");
    check("missing args", roundTrip(app, "12", "[\"add\"]") == "1 {\"code\":\"command_failed\",\"message\":\"argument 0 must be a number\"}");
    check("wrong arg type", roundTrip(app, "13", "[\"add\",[1,\"x\"]]") == "1 {\"code\":\"command_failed\",\"message\":\"argument 1 must be a number\"}");
    check("args not an array", roundTrip(app, "14", "[\"greet\",5]") == "1 {\"code\":\"command_failed\",\"message\":\"argument 0 must be a string\"}");
    check("missing field", roundTrip(app, "15", "[\"field\",{\"y\":1}]") == "1 {\"code\":\"command_failed\",\"message\":\"missing field x\"}");
    check("field present", roundTrip(app, "16", "[\"field\",{\"x\":[4]}]") == "0 [4]");

    // a large payload goes through unchanged
    string big = "";
    int i = 0;
    while (i < 20000) {
        big.push_back('a');
        i = i + 1;
    }
    check("large payload", roundTrip(app, "17", "[\"echo\",\"" + big + "\"]") == "0 \"" + big + "\"");

    // the server survives all of the above: one more good call at the end
    check("still serving", roundTrip(app, "18", "[\"add\",[40,2]]") == "0 42");

    // two requests queued together are answered in order
    app_test_inject(app.handle, "a", "[\"add\",[1,1]]");
    app_test_inject(app.handle, "b", "[\"add\",[2,2]]");
    app_test_close_window(app.handle);
    app.run();
    string id1 = "";
    string id2 = "";
    int s1 = 0;
    int s2 = 0;
    string j1 = "";
    string j2 = "";
    app_test_take_response(app.handle, id1, s1, j1);
    app_test_take_response(app.handle, id2, s2, j2);
    check("ordering", id1 == "a" && j1 == "2" && id2 == "b" && j2 == "4");

    // ---- async commands -------------------------------------------------------------------------
    check("async echo", roundTrip(app, "x1", "[\"aecho\",{\"k\":[1,2]}]") == "0 {\"k\":[1,2]}");
    check("async worker error", roundTrip(app, "x2", "[\"afail\"]") == "1 {\"code\":\"worker_failed\",\"message\":\"the job gave up\"}");
    check("async start rejects bad args", roundTrip(app, "x3", "[\"aslow\",[\"no\",\"t\"]]") == "1 {\"code\":\"command_failed\",\"message\":\"argument 0 must be a number\"}");

    check("struct copied into worker", roundTrip(app, "x4", "[\"arepeat\",[3,\"ab\"]]") == "0 \"ababab\"");

    check("object moved into worker", roundTrip(app, "x5", "[\"atally\",[4,5,6]]") == "0 [3,15]");

    check("throwing job rejects the promise", roundTrip(app, "x6", "[\"athrow\"]") == "1 {\"code\":\"command_failed\",\"message\":\"kaboom\"}");

    // a slow job started first answers LAST; replies are matched by id, not by order
    app_test_inject(app.handle, "slow", "[\"aslow\",[400,\"slow\"]]");
    app_test_inject(app.handle, "fast", "[\"aslow\",[5,\"fast\"]]");
    app_test_close_window(app.handle);
    app.run();
    string firstId = "";
    string secondId = "";
    int st1 = 0;
    int st2 = 0;
    string body1 = "";
    string body2 = "";
    app_test_take_response(app.handle, firstId, st1, body1);
    app_test_take_response(app.handle, secondId, st2, body2);
    check("out-of-order replies", firstId == "fast" && body1 == "\"fast\"" && secondId == "slow" && body2 == "\"slow\"");

    // a sync and an async call queued together are both answered, whichever comes first
    app_test_inject(app.handle, "m1", "[\"add\",[1,2]]");
    app_test_inject(app.handle, "m2", "[\"aecho\",[\"x\"]]");
    app_test_close_window(app.handle);
    app.run();
    string mixA = "";
    string mixB = "";
    int ms1 = 0;
    int ms2 = 0;
    string mb1 = "";
    string mb2 = "";
    app_test_take_response(app.handle, mixA, ms1, mb1);
    app_test_take_response(app.handle, mixB, ms2, mb2);
    bool mixedOk = false;
    if (mixA == "m1") {
        mixedOk = mb1 == "3" && mixB == "m2" && mb2 == "[\"x\"]";
    } else {
        mixedOk = mixA == "m2" && mb1 == "[\"x\"]" && mixB == "m1" && mb2 == "3";
    }
    check("sync and async mixed", mixedOk);

    // many concurrent jobs: every call answered exactly once with its own payload
    int total = 50;
    int n = 0;
    while (n < total) {
        app_test_inject(app.handle, "c" + intToString(n), "[\"aecho\",[" + intToString(n) + "]]");
        n = n + 1;
    }
    app_test_close_window(app.handle);
    app.run();
    std::vector<int> seen;
    int k = 0;
    while (k < total) {
        seen.push_back(0);
        k = k + 1;
    }
    bool allOk = true;
    k = 0;
    while (k < total) {
        string rid = "";
        int rst = 0;
        string rbody = "";
        int got = app_test_take_response(app.handle, rid, rst, rbody);
        if (got != 1 || rst != 0 || rid.length() < 2) {
            allOk = false;
        } else {
            int idx = 0;
            int pos = 1;
            while (pos < rid.length()) {
                idx = idx * 10 + (int(rid[pos]) - 48);
                pos = pos + 1;
            }
            if (idx < 0 || idx >= total || rbody != "[" + intToString(idx) + "]") {
                allOk = false;
            } else {
                if (seen[idx] != 0) {
                    allOk = false;
                }
                seen[idx] = 1;
            }
        }
        k = k + 1;
    }
    check("50 concurrent jobs", allOk);

    // ---- the worker limit -------------------------------------------------------------------------
    // 6 jobs of 80 ms with at most 2 running at once: all answered, and the gauge never saw more than 2 inside
    app.setWorkerLimit(2);
    int a = 0;
    while (a < 6) {
        app_test_inject(app.handle, "g" + intToString(a), "[\"agauge\",[80]]");
        a = a + 1;
    }
    app_test_close_window(app.handle);
    app.run();
    int answered = 0;
    a = 0;
    while (a < 6) {
        string gid = "";
        int gst = 0;
        string gbody = "";
        if (app_test_take_response(app.handle, gid, gst, gbody) == 1 && gst == 0 && gbody == "1") {
            answered = answered + 1;
        }
        a = a + 1;
    }
    check("limit 2: all 6 jobs answered", answered == 6);
    check("limit 2: never more than 2 at once", app_gauge_peak() <= 2 && app_gauge_peak() >= 1);

    // control: without the cap the same jobs overlap more, so the check above could have failed
    app.setWorkerLimit(0);
    a = 0;
    while (a < 6) {
        app_test_inject(app.handle, "h" + intToString(a), "[\"agauge\",[80]]");
        a = a + 1;
    }
    app_test_close_window(app.handle);
    app.run();
    a = 0;
    while (a < 6) {
        string hid = "";
        int hst = 0;
        string hbody = "";
        app_test_take_response(app.handle, hid, hst, hbody);
        a = a + 1;
    }
    check("control: default limit lets more than 2 overlap", app_gauge_peak() > 2);
    // ---- events: CeeLing -> page ---------------------------------------------------------------
    string js = "";
    check("emit builds the call", app.emit("tick", "{\"n\":1}") && app_test_take_eval(app.handle, js) == 1 && js == "window.__cling_emit([\"tick\",{\"n\":1}]);");
    check("emit re-prints the payload", app.emit("t", "{ \"a\" : [ 1 , 2 ] }") && app_test_take_eval(app.handle, js) == 1 && js == "window.__cling_emit([\"t\",{\"a\":[1,2]}]);");
    // a name and a payload that try to break out of the script stay string literals
    check("emit cannot inject script", app.emit("a\"b", "\"x\\\");alert(1);(\\\"\"") && app_test_take_eval(app.handle, js) == 1 && js == "window.__cling_emit([\"a\\\"b\",\"x\\\");alert(1);(\\\"\"]);");
    check("emit rejects invalid JSON", !app.emit("bad", "{oops") && app_test_take_eval(app.handle, js) == 0);
    check("emit rejects a payload with trailing script", !app.emit("bad", "1);alert(1") && app_test_take_eval(app.handle, js) == 0);
    app.emit("one", "1");
    app.emit("two", "2");
    string firstJs = "";
    string secondJs = "";
    app_test_take_eval(app.handle, firstJs);
    app_test_take_eval(app.handle, secondJs);
    check("events keep their order", firstJs == "window.__cling_emit([\"one\",1]);" && secondJs == "window.__cling_emit([\"two\",2]);");

    // a worker job can emit: the event arrives while the job runs, then it answers
    int waited = 0;
    string workerJs = "";
    check("worker emits then replies", roundTrip(app, "x7", "[\"aemit\"]") == "0 true");
    while (app_test_take_eval(app.handle, workerJs) == 0 && waited < 100) {
        app_sleep_ms(20);
        waited = waited + 1;
    }
    check("worker's event arrived", workerJs == "window.__cling_emit([\"fromWorker\",{\"ok\":true}]);");

    // ---- file commands ----------------------------------------------------------------------------
    app.enableFileCommands(16);
    string base = "";
    app_fs_test_make_temp_dir(base);
    string allowed = base + "/allowed";
    string outside = base + "/outside";
    check("a folder that does not exist cannot be allowed", !app.allowFolder(base + "/nope"));
    app.allowFolder(base);
    app_fs_mkdir(allowed, 0);
    app_fs_mkdir(outside, 0);
    app_fs_write(outside + "/secret.txt", "TOP SECRET", 0);
    string badBytes = "";
    badBytes.push_back(char(255));
    app_fs_write(allowed + "/binary.dat", badBytes, 0);
    app_fs_clear();
    check("allowFolder accepts a real folder", app.allowFolder(allowed));

    Item writeArgs = pathArgs("note.txt");
    addStringToObject(writeArgs, "text", "hello");
    check("fs.write then fs.read", roundTrip(app, "f1", requestText("fs.write", writeArgs)) == "0 null" &&
          roundTrip(app, "f2", requestText("fs.read", pathArgs("note.txt"))) == "0 {\"text\":\"hello\"}");
    check("fs.stat describes the file", startsWith(roundTrip(app, "f3", requestText("fs.stat", pathArgs("note.txt"))),
          "0 {\"name\":\"note.txt\",\"kind\":\"file\",\"size\":5,\"modified\":"));
    string listed = roundTrip(app, "f4", requestText("fs.list", pathArgs(".")));
    check("fs.list shows it", startsWith(listed, "0 [{\"name\":") && listed.length() > 40);
    check("fs.exists true", roundTrip(app, "f6", requestText("fs.exists", pathArgs("note.txt"))) == "0 true");
    check("fs.exists false", roundTrip(app, "f7", requestText("fs.exists", pathArgs("absent.txt"))) == "0 false");
    check("missing file is not_found", startsWith(roundTrip(app, "f8", requestText("fs.read", pathArgs("absent.txt"))),
          "1 {\"code\":\"not_found\",\"message\":\"cannot read absent.txt\"}"));

    check("dot-dot escape is forbidden", startsWith(roundTrip(app, "f9", requestText("fs.read", pathArgs("../outside/secret.txt"))),
          "1 {\"code\":\"forbidden\""));
    check("absolute path outside is forbidden", startsWith(roundTrip(app, "f10", requestText("fs.read", pathArgs(outside + "/secret.txt"))),
          "1 {\"code\":\"forbidden\""));
    check("exists does not leak outside", startsWith(roundTrip(app, "f11", requestText("fs.exists", pathArgs(outside + "/secret.txt"))),
          "1 {\"code\":\"forbidden\"") &&
          startsWith(roundTrip(app, "f12", requestText("fs.exists", pathArgs(outside + "/no-such-file"))), "1 {\"code\":\"forbidden\""));
    check("write without text is invalid_argument", startsWith(roundTrip(app, "f13", requestText("fs.write", pathArgs(outside + "/planted.txt"))), "1 {\"code\":\"invalid_argument\""));
    Item plant = pathArgs(outside + "/planted.txt");
    addStringToObject(plant, "text", "x");
    check("write outside with all arguments is forbidden", startsWith(roundTrip(app, "f14", requestText("fs.write", plant)), "1 {\"code\":\"forbidden\""));

    string link = allowed + "/linkout";
    app_fs_test_make_dir_link(link, outside);
    check("a link that leads out is forbidden", startsWith(roundTrip(app, "f15", requestText("fs.read", pathArgs("linkout/secret.txt"))), "1 {\"code\":\"forbidden\""));
    check("listing through that link is forbidden", startsWith(roundTrip(app, "f16", requestText("fs.list", pathArgs("linkout"))), "1 {\"code\":\"forbidden\""));
    check("removing the link leaves its target", startsWith(roundTrip(app, "f17", requestText("fs.remove", pathArgs("linkout"))), "0 null") &&
          startsWith(roundTrip(app, "f18", requestText("fs.exists", pathArgs(outside + "/secret.txt"))), "1 {\"code\":\"forbidden\""));

    check("a missing path argument is invalid_argument", roundTrip(app, "f19", requestText("fs.read", createObject())) ==
          "1 {\"code\":\"invalid_argument\",\"message\":\"`path` must be a string\"}");
    check("a non-object argument is invalid_argument", startsWith(roundTrip(app, "f20", "[\"fs.read\",5]"), "1 {\"code\":\"invalid_argument\""));
    Item badMode = pathArgs("m.txt");
    addStringToObject(badMode, "text", "x");
    addStringToObject(badMode, "mode", "overwrite");
    check("an unknown mode is invalid_argument", startsWith(roundTrip(app, "f21", requestText("fs.write", badMode)), "1 {\"code\":\"invalid_argument\""));

    Item createOnly = pathArgs("once.txt");
    addStringToObject(createOnly, "text", "1");
    addStringToObject(createOnly, "mode", "create");
    check("create mode creates", roundTrip(app, "f22", requestText("fs.write", createOnly)) == "0 null");
    check("create mode refuses an existing name", startsWith(roundTrip(app, "f23", requestText("fs.write", createOnly)), "1 {\"code\":\"already_exists\""));
    Item appendArgs = pathArgs("once.txt");
    addStringToObject(appendArgs, "text", "2");
    addStringToObject(appendArgs, "mode", "append");
    check("append mode", roundTrip(app, "f24", requestText("fs.write", appendArgs)) == "0 null" &&
          roundTrip(app, "f25", requestText("fs.read", pathArgs("once.txt"))) == "0 {\"text\":\"12\"}");

    Item bigArgs = pathArgs("big.txt");
    addStringToObject(bigArgs, "text", "this text is longer than sixteen bytes");
    roundTrip(app, "f26", requestText("fs.write", bigArgs));
    check("a file over the read limit is too_large", startsWith(roundTrip(app, "f27", requestText("fs.read", pathArgs("big.txt"))), "1 {\"code\":\"too_large\""));
    check("a file that is not UTF-8 is not_text", startsWith(roundTrip(app, "f28", requestText("fs.read", pathArgs("binary.dat"))), "1 {\"code\":\"not_text\""));

    Item dirArgs = pathArgs("a/b/c");
    addBoolToObject(dirArgs, "parents", true);
    check("mkdir with parents", roundTrip(app, "f29", requestText("fs.mkdir", dirArgs)) == "0 null" &&
          roundTrip(app, "f30", requestText("fs.mkdir", dirArgs)) == "0 null");
    check("mkdir without parents needs the parent", startsWith(roundTrip(app, "f31", requestText("fs.mkdir", pathArgs("x/y/z"))), "1 {\"code\":\"not_found\""));
    check("removing a folder with entries is not_empty", startsWith(roundTrip(app, "f32", requestText("fs.remove", pathArgs("a"))), "1 {\"code\":\"not_empty\""));
    check("removing an empty folder", roundTrip(app, "f33", requestText("fs.remove", pathArgs("a/b/c"))) == "0 null");
    check("the allowed folder itself cannot be removed", startsWith(roundTrip(app, "f34", requestText("fs.remove", pathArgs(allowed))), "1 {\"code\":\"forbidden\""));
    check("reading a folder is is_directory", startsWith(roundTrip(app, "f35", requestText("fs.read", pathArgs("a"))), "1 {\"code\":\"is_directory\""));
    check("the secret outside was never touched", app_fs_allow(outside) == 0 && app_fs_read(outside + "/secret.txt", 100, badBytes) == 0 && badBytes == "TOP SECRET" &&
          app_fs_stat(outside + "/planted.txt", badBytes) == 2);
    app_fs_clear();
    app_fs_allow(base);
    app_fs_remove(outside + "/secret.txt");
    app_fs_clear();
    app_fs_test_remove_tree(base);

    // ---- dialog commands: a pick is a grant of exactly what was picked ---------------------------------
    app.enableDialogCommands();
    string dbase = "";
    app_fs_test_make_temp_dir(dbase);
    app_fs_allow(dbase);
    app_fs_write(dbase + "/picked.txt", "chosen", 0);
    app_fs_write(dbase + "/neighbour.txt", "other", 0);
    app_fs_mkdir(dbase + "/chosen_folder", 0);
    app_fs_write(dbase + "/chosen_folder/inside.txt", "inside", 0);
    app_fs_clear();

    check("nothing is reachable before the user picks", startsWith(roundTrip(app, "d1", requestText("fs.read", pathArgs(dbase + "/picked.txt"))), "1 {\"code\":\"forbidden\""));
    app_dialog_test_push("cancel");
    check("cancel answers null and grants nothing", roundTrip(app, "d2", requestText("dialog.open", createObject())) == "0 null" &&
          startsWith(roundTrip(app, "d3", requestText("fs.read", pathArgs(dbase + "/picked.txt"))), "1 {\"code\":\"forbidden\""));

    Item openArgs = createObject();
    addStringToObject(openArgs, "title", "Open a note");
    Item filterList = addArrayToObject(openArgs, "filters");
    Item textFilter = createObject();
    addStringToObject(textFilter, "name", "Text");
    Item textExts = addArrayToObject(textFilter, "extensions");
    addItemToArray(textExts, createString("txt"));
    addItemToArray(textExts, createString("md"));
    addItemToArray(filterList, textFilter);
    Item allFilter = createObject();
    addStringToObject(allFilter, "name", "Everything");
    addItemToArray(filterList, allFilter);
    app_dialog_test_push("path:" + dbase + "/picked.txt");
    string pickReply = roundTrip(app, "d4", requestText("dialog.open", openArgs));
    check("a pick answers the path", startsWith(pickReply, "0 {\"path\":\"") && containsText(pickReply, "picked.txt"));
    check("the dialog was asked with the title and two filters", latestRequest() == "open|Open a note|2");
    check("the picked file is now readable", roundTrip(app, "d5", requestText("fs.read", pathArgs(dbase + "/picked.txt"))) == "0 {\"text\":\"chosen\"}");
    check("its neighbour is not", startsWith(roundTrip(app, "d6", requestText("fs.read", pathArgs(dbase + "/neighbour.txt"))), "1 {\"code\":\"forbidden\""));
    check("neither is the folder listing", startsWith(roundTrip(app, "d7", requestText("fs.list", pathArgs(dbase))), "1 {\"code\":\"forbidden\""));

    Item saveArgs = createObject();
    addStringToObject(saveArgs, "defaultName", "export.txt");
    app_dialog_test_push("path:" + dbase + "/export.txt");
    check("save as grants a file that does not exist yet", startsWith(roundTrip(app, "d8", requestText("dialog.save", saveArgs)), "0 {\"path\":\"") &&
          latestRequest() == "save||export.txt|0");
    Item exportWrite = pathArgs(dbase + "/export.txt");
    addStringToObject(exportWrite, "text", "exported");
    addStringToObject(exportWrite, "mode", "create");
    check("which the page may then create", roundTrip(app, "d9", requestText("fs.write", exportWrite)) == "0 null");
    Item otherWrite = pathArgs(dbase + "/other.txt");
    addStringToObject(otherWrite, "text", "x");
    check("but not a second file beside it", startsWith(roundTrip(app, "d10", requestText("fs.write", otherWrite)), "1 {\"code\":\"forbidden\""));

    app_dialog_test_push("path:" + dbase + "/chosen_folder");
    check("a folder pick grants the folder", startsWith(roundTrip(app, "d11", requestText("dialog.folder", createObject())), "0 {\"path\":\"") &&
          roundTrip(app, "d12", requestText("fs.read", pathArgs(dbase + "/chosen_folder/inside.txt"))) == "0 {\"text\":\"inside\"}");

    app.revokeGrants();
    check("revoking withdraws every grant", startsWith(roundTrip(app, "d13", requestText("fs.read", pathArgs(dbase + "/picked.txt"))), "1 {\"code\":\"forbidden\"") &&
          startsWith(roundTrip(app, "d14", requestText("fs.read", pathArgs(dbase + "/chosen_folder/inside.txt"))), "1 {\"code\":\"forbidden\""));

    Item msgArgs = createObject();
    addStringToObject(msgArgs, "title", "Delete?");
    addStringToObject(msgArgs, "message", "Really delete the note?");
    addStringToObject(msgArgs, "kind", "question");
    addStringToObject(msgArgs, "buttons", "yesno");
    app_dialog_test_push("button:3");
    check("a message box answers the button", roundTrip(app, "d15", requestText("dialog.message", msgArgs)) == "0 {\"button\":\"yes\"}" &&
          latestRequest() == "message|Delete?|question|yesno");
    app_dialog_test_push("button:4");
    check("and the other button", roundTrip(app, "d16", requestText("dialog.message", msgArgs)) == "0 {\"button\":\"no\"}");

    Item badKind = createObject();
    addStringToObject(badKind, "message", "x");
    addStringToObject(badKind, "kind", "alarm");
    check("an unknown kind is invalid_argument", startsWith(roundTrip(app, "d17", requestText("dialog.message", badKind)), "1 {\"code\":\"invalid_argument\""));
    Item noMessage = createObject();
    check("a message box needs a message", startsWith(roundTrip(app, "d18", requestText("dialog.message", noMessage)), "1 {\"code\":\"invalid_argument\""));
    Item badFilters = createObject();
    addStringToObject(badFilters, "filters", "txt");
    check("filters must be an array", startsWith(roundTrip(app, "d19", requestText("dialog.open", badFilters)), "1 {\"code\":\"invalid_argument\""));
    Item badExtension = createObject();
    Item badList = addArrayToObject(badExtension, "filters");
    Item oddFilter = createObject();
    addStringToObject(oddFilter, "name", "Odd");
    Item oddExts = addArrayToObject(oddFilter, "extensions");
    addItemToArray(oddExts, createString("a;b"));
    addItemToArray(badList, oddFilter);
    check("an extension with odd characters is refused", startsWith(roundTrip(app, "d20", requestText("dialog.open", badExtension)), "1 {\"code\":\"invalid_argument\""));
    Item longTitle = createObject();
    addStringToObject(longTitle, "title", repeated("x", 201));
    check("an over-long title is refused", startsWith(roundTrip(app, "d21", requestText("dialog.open", longTitle)), "1 {\"code\":\"invalid_argument\""));
    Item badName = createObject();
    addStringToObject(badName, "defaultName", "../escape.txt");
    check("a default name with a folder in it is refused", startsWith(roundTrip(app, "d22", requestText("dialog.save", badName)), "1 {\"code\":\"invalid_argument\""));
    check("with nothing scripted the dialog is unsupported", startsWith(roundTrip(app, "d23", requestText("dialog.folder", createObject())), "1 {\"code\":\"unsupported\""));
    app_fs_clear();
    app_fs_test_remove_tree(dbase);

    // ---- program commands: the page names an entry of a table, never a command line ---------------------
    string helper = "";
    app_proc_test_helper(helper);
    string pbase = "";
    app_fs_test_make_temp_dir(pbase);
    app_fs_allow(pbase);
    app_fs_write(pbase + "/f.txt", "file", 0);
    app_fs_mkdir(pbase + "/sub", 0);
    string pout = "";
    app_fs_test_make_temp_dir(pout);

    std::vector<string> pEcho;
    pEcho.push_back("fixed");
    pEcho.push_back("{a:text:50}");
    pEcho.push_back("n={n:int:1:100}");
    pEcho.push_back("{t:token}");
    pEcho.push_back("--file={f:file}");
    pEcho.push_back("@cwd={dir:folder}");
    check("allowProgram accepts a good template", app.allowProgram("echo", helper, pEcho, 5000, 100000));

    std::vector<string> pExit;
    pExit.push_back("--exit");
    pExit.push_back("{code:int:0:255}");
    pExit.push_back("@cwd={dir:folder}");
    std::vector<string> pSleepy;
    pSleepy.push_back("--sleep");
    pSleepy.push_back("{ms:int:0:60000}");
    pSleepy.push_back("@cwd={dir:folder}");
    std::vector<string> pBig;
    pBig.push_back("--big");
    pBig.push_back("{n:int:0:5000000}");
    pBig.push_back("@cwd={dir:folder}");
    std::vector<string> pBytes;
    pBytes.push_back("--bytes");
    pBytes.push_back("{hex:token}");
    pBytes.push_back("@cwd={dir:folder}");
    std::vector<string> pSleeper;
    pSleeper.push_back("--leave-sleeper");
    pSleeper.push_back("@cwd={dir:folder}");
    std::vector<string> pCwd;
    pCwd.push_back("--cwd");
    pCwd.push_back("@cwd={dir:folder}");
    std::vector<string> pWhere;
    pWhere.push_back("--cwd");
    app.allowProgram("exit", helper, pExit, 5000, 1000);
    app.allowProgram("sleepy", helper, pSleepy, 300, 1000);
    app.allowProgram("big", helper, pBig, 20000, 1000);
    app.allowProgram("bytes", helper, pBytes, 5000, 1000);
    app.allowProgram("sleeper", helper, pSleeper, 20000, 1000);
    app.allowProgram("cwd", helper, pCwd, 5000, 1000);
    app.allowProgram("where", helper, pWhere, 5000, 1000);
    app.enableProcessCommands();

    // the template itself is checked when it is registered
    std::vector<string> bad1;
    bad1.push_back("{a:wrongkind}");
    std::vector<string> bad2;
    bad2.push_back("{a:int:5}");
    std::vector<string> bad3;
    bad3.push_back("x{a:text:5}{b:text:5}");
    std::vector<string> bad4;
    bad4.push_back("{a:text:5");
    std::vector<string> bad5;
    bad5.push_back("@cwd={a:folder}");
    bad5.push_back("@cwd={b:folder}");
    std::vector<string> bad6;
    bad6.push_back("{a:text:5}");
    bad6.push_back("{a:token}");
    std::vector<string> bad7;
    bad7.push_back("@cwd={a:file}");
    std::vector<string> bad8;
    bad8.push_back("{a:int:9:3}");
    std::vector<string> fine;
    check("a slot of an unknown kind is refused", !app.allowProgram("t1", helper, bad1, 1000, 1000));
    check("an int slot needs min and max", !app.allowProgram("t2", helper, bad2, 1000, 1000));
    check("two slots in one argument are refused", !app.allowProgram("t3", helper, bad3, 1000, 1000));
    check("an unclosed brace is refused", !app.allowProgram("t4", helper, bad4, 1000, 1000));
    check("two working folders are refused", !app.allowProgram("t5", helper, bad5, 1000, 1000));
    check("the same slot name twice is refused", !app.allowProgram("t6", helper, bad6, 1000, 1000));
    check("the working folder must be a folder slot", !app.allowProgram("t7", helper, bad7, 1000, 1000));
    check("an int range must be ordered", !app.allowProgram("t8", helper, bad8, 1000, 1000));
    check("a program that does not exist is refused", !app.allowProgram("t9", pbase + "/nothing.exe", fine, 1000, 1000));
    check("a bare name that is not on PATH is refused", !app.allowProgram("t10", "surely-not-installed-xyz", fine, 1000, 1000));
    check("a name with a space is refused", !app.allowProgram("has space", helper, fine, 1000, 1000));
    check("a taken name is refused", !app.allowProgram("echo", helper, fine, 1000, 1000));
    check("a timeout below 100 ms is refused", !app.allowProgram("t11", helper, fine, 50, 1000));
    check("a relative program path is refused", !app.allowProgram("t12", "./helper.exe", fine, 1000, 1000));

    Item eArgs = createObject();
    addStringToObject(eArgs, "a", "plain");
    addNumberToObject(eArgs, "n", 7.0);
    addStringToObject(eArgs, "t", "main");
    addStringToObject(eArgs, "f", "f.txt");
    addStringToObject(eArgs, "dir", pbase);
    Item eReq = createObject();
    addStringToObject(eReq, "program", "echo");
    addItemToObject(eReq, "args", eArgs);
    string eReply = roundTrip(app, "p1", requestText("proc.run", eReq));
    check("a program runs and its output comes back", startsWith(eReply, "0 {\"exitCode\":0,\"stdout\":\"[1]=fixed") && containsText(eReply, "[3]=n=7") &&
          containsText(eReply, "[4]=main") && containsText(eReply, "f.txt") && containsText(eReply, "\"timedOut\":false"));

    // shell characters in a value stay inside ONE argument
    Item i1 = createObject();
    addStringToObject(i1, "a", "x; calc & echo hi | find > out");
    addNumberToObject(i1, "n", 1.0);
    addStringToObject(i1, "t", "main");
    addStringToObject(i1, "f", "f.txt");
    addStringToObject(i1, "dir", pbase);
    Item iReq = createObject();
    addStringToObject(iReq, "program", "echo");
    addItemToObject(iReq, "args", i1);
    string iReply = roundTrip(app, "p2", requestText("proc.run", iReq));
    check("shell characters are not interpreted", containsText(iReply, "[2]=x; calc & echo hi | find > out") && containsText(iReply, "\"exitCode\":0"));

    Item optionLike = createObject();
    addStringToObject(optionLike, "a", "--help");
    addNumberToObject(optionLike, "n", 1.0);
    addStringToObject(optionLike, "t", "main");
    addStringToObject(optionLike, "f", "f.txt");
    addStringToObject(optionLike, "dir", pbase);
    Item oReq = createObject();
    addStringToObject(oReq, "program", "echo");
    addItemToObject(oReq, "args", optionLike);
    check("a whole argument cannot start with a dash", startsWith(roundTrip(app, "p3", requestText("proc.run", oReq)), "1 {\"code\":\"invalid_argument\""));

    Item tokenBad = createObject();
    addStringToObject(tokenBad, "a", "ok");
    addNumberToObject(tokenBad, "n", 1.0);
    addStringToObject(tokenBad, "t", "a;b");
    addStringToObject(tokenBad, "f", "f.txt");
    addStringToObject(tokenBad, "dir", pbase);
    Item tReq = createObject();
    addStringToObject(tReq, "program", "echo");
    addItemToObject(tReq, "args", tokenBad);
    check("a token with a semicolon is refused", startsWith(roundTrip(app, "p4", requestText("proc.run", tReq)), "1 {\"code\":\"invalid_argument\""));

    Item intBad = createObject();
    addStringToObject(intBad, "a", "ok");
    addNumberToObject(intBad, "n", 101.0);
    addStringToObject(intBad, "t", "main");
    addStringToObject(intBad, "f", "f.txt");
    addStringToObject(intBad, "dir", pbase);
    Item nReq = createObject();
    addStringToObject(nReq, "program", "echo");
    addItemToObject(nReq, "args", intBad);
    check("an int above its range is refused", startsWith(roundTrip(app, "p5", requestText("proc.run", nReq)), "1 {\"code\":\"invalid_argument\""));
    Item intFrac = createObject();
    addStringToObject(intFrac, "a", "ok");
    addNumberToObject(intFrac, "n", 1.5);
    addStringToObject(intFrac, "t", "main");
    addStringToObject(intFrac, "f", "f.txt");
    addStringToObject(intFrac, "dir", pbase);
    Item fReq = createObject();
    addStringToObject(fReq, "program", "echo");
    addItemToObject(fReq, "args", intFrac);
    check("a fraction is not an int", startsWith(roundTrip(app, "p6", requestText("proc.run", fReq)), "1 {\"code\":\"invalid_argument\""));
    Item intStr = createObject();
    addStringToObject(intStr, "a", "ok");
    addStringToObject(intStr, "n", "5");
    addStringToObject(intStr, "t", "main");
    addStringToObject(intStr, "f", "f.txt");
    addStringToObject(intStr, "dir", pbase);
    Item sReq = createObject();
    addStringToObject(sReq, "program", "echo");
    addItemToObject(sReq, "args", intStr);
    check("a string is not an int", startsWith(roundTrip(app, "p7", requestText("proc.run", sReq)), "1 {\"code\":\"invalid_argument\""));

    Item fileOutside = createObject();
    addStringToObject(fileOutside, "a", "ok");
    addNumberToObject(fileOutside, "n", 1.0);
    addStringToObject(fileOutside, "t", "main");
    addStringToObject(fileOutside, "f", pout + "/secret.txt");
    addStringToObject(fileOutside, "dir", pbase);
    Item oReq2 = createObject();
    addStringToObject(oReq2, "program", "echo");
    addItemToObject(oReq2, "args", fileOutside);
    check("a file slot outside the allowed folders is forbidden", startsWith(roundTrip(app, "p8", requestText("proc.run", oReq2)), "1 {\"code\":\"forbidden\""));
    Item fileEscape = createObject();
    addStringToObject(fileEscape, "a", "ok");
    addNumberToObject(fileEscape, "n", 1.0);
    addStringToObject(fileEscape, "t", "main");
    addStringToObject(fileEscape, "f", "../outside.txt");
    addStringToObject(fileEscape, "dir", pbase);
    Item eReq2 = createObject();
    addStringToObject(eReq2, "program", "echo");
    addItemToObject(eReq2, "args", fileEscape);
    check("a file slot with dot-dot is forbidden", startsWith(roundTrip(app, "p9", requestText("proc.run", eReq2)), "1 {\"code\":\"forbidden\""));
    Item fileMissing = createObject();
    addStringToObject(fileMissing, "a", "ok");
    addNumberToObject(fileMissing, "n", 1.0);
    addStringToObject(fileMissing, "t", "main");
    addStringToObject(fileMissing, "f", "missing.txt");
    addStringToObject(fileMissing, "dir", pbase);
    Item mReq = createObject();
    addStringToObject(mReq, "program", "echo");
    addItemToObject(mReq, "args", fileMissing);
    check("a missing file is not_found", startsWith(roundTrip(app, "p10", requestText("proc.run", mReq)), "1 {\"code\":\"not_found\""));
    Item fileIsDir = createObject();
    addStringToObject(fileIsDir, "a", "ok");
    addNumberToObject(fileIsDir, "n", 1.0);
    addStringToObject(fileIsDir, "t", "main");
    addStringToObject(fileIsDir, "f", "sub");
    addStringToObject(fileIsDir, "dir", pbase);
    Item dReq = createObject();
    addStringToObject(dReq, "program", "echo");
    addItemToObject(dReq, "args", fileIsDir);
    check("a folder where a file is wanted", startsWith(roundTrip(app, "p11", requestText("proc.run", dReq)), "1 {\"code\":\"is_directory\""));

    Item extra = createObject();
    addStringToObject(extra, "a", "ok");
    addNumberToObject(extra, "n", 1.0);
    addStringToObject(extra, "t", "main");
    addStringToObject(extra, "f", "f.txt");
    addStringToObject(extra, "dir", pbase);
    addStringToObject(extra, "extra", "--delete-everything");
    Item xReq = createObject();
    addStringToObject(xReq, "program", "echo");
    addItemToObject(xReq, "args", extra);
    check("a parameter the template does not have is refused", containsText(roundTrip(app, "p12", requestText("proc.run", xReq)), "`extra` is not a parameter of echo"));
    Item lacking = createObject();
    addStringToObject(lacking, "a", "ok");
    Item lReq = createObject();
    addStringToObject(lReq, "program", "echo");
    addItemToObject(lReq, "args", lacking);
    check("a missing parameter is refused", startsWith(roundTrip(app, "p13", requestText("proc.run", lReq)), "1 {\"code\":\"invalid_argument\""));

    Item unknown = createObject();
    addStringToObject(unknown, "program", "rm");
    check("an unregistered program name", startsWith(roundTrip(app, "p14", requestText("proc.run", unknown)), "1 {\"code\":\"unknown_program\""));
    Item pathProgram = createObject();
    addStringToObject(pathProgram, "program", helper);
    check("a program path from the page is just an unknown name", startsWith(roundTrip(app, "p15", requestText("proc.run", pathProgram)), "1 {\"code\":\"unknown_program\""));
    check("the program name must be given", startsWith(roundTrip(app, "p16", requestText("proc.run", createObject())), "1 {\"code\":\"invalid_argument\""));
    Item argsNotObject = createObject();
    addStringToObject(argsNotObject, "program", "echo");
    addStringToObject(argsNotObject, "args", "-rf /");
    check("args must be an object", startsWith(roundTrip(app, "p17", requestText("proc.run", argsNotObject)), "1 {\"code\":\"invalid_argument\""));

    Item exitArgs = createObject();
    addNumberToObject(exitArgs, "code", 7.0);
    addStringToObject(exitArgs, "dir", pbase);
    Item xitReq = createObject();
    addStringToObject(xitReq, "program", "exit");
    addItemToObject(xitReq, "args", exitArgs);
    string xitReply = roundTrip(app, "p18", requestText("proc.run", xitReq));
    check("a non-zero exit code is a result, not an error", startsWith(xitReply, "0 {\"exitCode\":7,") && containsText(xitReply, "\"timedOut\":false"));

    Item sleepArgs = createObject();
    addNumberToObject(sleepArgs, "ms", 20000.0);
    addStringToObject(sleepArgs, "dir", pbase);
    Item slReq = createObject();
    addStringToObject(slReq, "program", "sleepy");
    addItemToObject(slReq, "args", sleepArgs);
    string slReply = roundTrip(app, "p19", requestText("proc.run", slReq));
    check("a program over its time limit is killed", startsWith(slReply, "0 {\"exitCode\":-1,") && containsText(slReply, "\"timedOut\":true"));

    Item bigArgs2 = createObject();
    addNumberToObject(bigArgs2, "n", 1000000.0);
    addStringToObject(bigArgs2, "dir", pbase);
    Item bgReq = createObject();
    addStringToObject(bgReq, "program", "big");
    addItemToObject(bgReq, "args", bigArgs2);
    string bgReply = roundTrip(app, "p20", requestText("proc.run", bgReq));
    check("output beyond the cap is cut and says so", containsText(bgReply, "\"truncated\":{\"stdout\":true,\"stderr\":false}") && bgReply.length() < 2000);

    Item bytesArgs = createObject();
    addStringToObject(bytesArgs, "hex", "41ff42");
    addStringToObject(bytesArgs, "dir", pbase);
    Item byReq = createObject();
    addStringToObject(byReq, "program", "bytes");
    addItemToObject(byReq, "args", bytesArgs);
    string byReply = roundTrip(app, "p21", requestText("proc.run", byReq));
    check("output that is not UTF-8 is cleaned and flagged", containsText(byReply, "\"lossy\":true") && containsText(byReply, "A") && startsWith(byReply, "0 {"));

    Item sleeperArgs = createObject();
    addStringToObject(sleeperArgs, "dir", pbase);
    Item spReq = createObject();
    addStringToObject(spReq, "program", "sleeper");
    addItemToObject(spReq, "args", sleeperArgs);
    string spReply = roundTrip(app, "p22", requestText("proc.run", spReq));
    check("something left running behind the program is killed", containsText(spReply, "left a sleeper") && containsText(spReply, "\"exitCode\":0"));

    Item cwdIn = createObject();
    addStringToObject(cwdIn, "dir", pbase + "/sub");
    Item cwReq = createObject();
    addStringToObject(cwReq, "program", "cwd");
    addItemToObject(cwReq, "args", cwdIn);
    check("the working folder is the one named", containsText(roundTrip(app, "p23", requestText("proc.run", cwReq)), "sub"));
    Item cwdOut = createObject();
    addStringToObject(cwdOut, "dir", pout);
    Item cwReq2 = createObject();
    addStringToObject(cwReq2, "program", "cwd");
    addItemToObject(cwReq2, "args", cwdOut);
    check("a working folder outside the allowed folders is forbidden", startsWith(roundTrip(app, "p24", requestText("proc.run", cwReq2)), "1 {\"code\":\"forbidden\""));
    Item cwdFile = createObject();
    addStringToObject(cwdFile, "dir", "f.txt");
    Item cwReq3 = createObject();
    addStringToObject(cwReq3, "program", "cwd");
    addItemToObject(cwReq3, "args", cwdFile);
    check("a file is not a working folder", startsWith(roundTrip(app, "p25", requestText("proc.run", cwReq3)), "1 {\"code\":\"not_directory\""));
    Item whereReq = createObject();
    addStringToObject(whereReq, "program", "where");
    check("without a working folder it is the first allowed folder", containsText(roundTrip(app, "p26", requestText("proc.run", whereReq)), "app-cling-fs-"));

    // many at once: the pool serves them, every one is answered with its own result
    int pn = 0;
    while (pn < 24) {
        Item eachArgs = createObject();
        addNumberToObject(eachArgs, "code", double(pn));
        addStringToObject(eachArgs, "dir", pbase);
        Item eachReq = createObject();
        addStringToObject(eachReq, "program", "exit");
        addItemToObject(eachReq, "args", eachArgs);
        app_test_inject(app.handle, "q" + intToString(pn), requestText("proc.run", eachReq));
        pn = pn + 1;
    }
    app_test_close_window(app.handle);
    app.run();
    int pmatched = 0;
    pn = 0;
    while (pn < 24) {
        string qid = "";
        int qst = 0;
        string qbody = "";
        if (app_test_take_response(app.handle, qid, qst, qbody) == 1 && qst == 0 && qid.length() >= 2) {
            int idx = 0;
            int pos = 1;
            while (pos < qid.length()) {
                idx = idx * 10 + (int(qid[pos]) - 48);
                pos = pos + 1;
            }
            if (startsWith(qbody, "{\"exitCode\":" + intToString(idx) + ",")) {
                pmatched = pmatched + 1;
            }
        }
        pn = pn + 1;
    }
    check("24 programs at once, each answered with its own exit code", pmatched == 24);
    app_fs_clear();
    app_fs_test_remove_tree(pbase);
    app_fs_test_remove_tree(pout);
    return 0;
}
